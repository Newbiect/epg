<programme start="20261016050000 +0000" stop="20261016055100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Historia Principal</sub-title><desc lang="es">Gibbs y el equipo investigan cuando el libro ficticio de McGee sobre un agente del NCIS se vuelve realidad. McGee se horroriza cuando un suboficial en el que basó el personaje de su último libro resulta asesinado.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.19.0/1</episode-num><episode-num system="onscreen">S04E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016055100 +0000" stop="20261016064300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Hermano En Armas</sub-title><desc lang="es">El director Shepard corre un gran riesgo y acepta reunirse con un informante a solas para hablar sobre &quot;La Grenouille&quot;, pero la reunión sale mal y su contacto muere.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.20.0/1</episode-num><episode-num system="onscreen">S04E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016064300 +0000" stop="20261016073500 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">En La Oscuridad</sub-title><desc lang="es">Gibbs y el equipo investigan cuando un fotógrafo ciego toma sin darse cuenta la fotografía del asesinato de un suboficial.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.21.0/1</episode-num><episode-num system="onscreen">S04E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016073500 +0000" stop="20261016082700 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Caballo De Troya</sub-title><desc lang="es">Gibbs ignora la burocracia asociada con sus deberes de director &quot;interino&quot; y dirige una investigación sobre una víctima de asesinato encontrada en un taxi que se dirigía a la sede del NCIS. Además, Jenny descubre un secreto sobre su pasado.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.22.0/1</episode-num><episode-num system="onscreen">S04E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016082700 +0000" stop="20261016091900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Àngel De La Muerte</sub-title><desc lang="es">El director del NCIS regresa de una polémica gira europea. Gibbs y sus agentes se preparan a regañadientes para las pruebas de polígrafo del Departamento de Seguridad Nacional. Se revelan secretos del equipo.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.23.0/1</episode-num><episode-num system="onscreen">S04E24</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016091900 +0000" stop="20261016101100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Yanqui blanco</sub-title><desc lang="es">Mientras estaba en el Air Force One, muere un comandante de la Marina. Los agentes del NCIS deciden tomar la investigación en sus propias manos y también obligan a la agente del Servicio Secreto Kate Todd a ayudar.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20030101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016101100 +0000" stop="20261016110300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Caída libre</sub-title><desc lang="es">Durante un ejercicio de entrenamiento, el paracaídas de un infante de marina no se abre y choca contra un auto estacionado. El equipo de NCIS se dirige a la escena y tiene que determinar si la muerte del infante de marina fue accidental o un asesinato.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20030101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016110300 +0000" stop="20261016115400 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Lobo de mar</sub-title><desc lang="es">Cuando el cuerpo de un comandante de la Marina llega a la costa junto con los cuerpos de dos traficantes de drogas, Gibbs se niega a creer que el marinero asesinado era corrupto.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20030101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016115400 +0000" stop="20261016124600 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Los inmortales</sub-title><desc lang="es">El equipo del NCIS investiga cuando se encuentra el cuerpo de un marinero en el fondo del mar vestido de blanco y con una espada ceremonial. Descubren que era adicto a un juego de rol al estilo Magos y Guerreros.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20030101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016124600 +0000" stop="20261016133800 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">La maldición</sub-title><desc lang="es">Un teniente de la Marina desapareció hace casi diez años y un cazador de ciervos encontró el cadáver. Cuando el equipo del NCIS llega al lugar para investigar, ven que sus restos han sido momificados.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20030101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016133800 +0000" stop="20261016142900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Alta mar</sub-title><desc lang="es">Un agente del NCIS que solía trabajar con Gibbs solicita la ayuda del equipo para investigar un caso en el que los marineros de un portaaviones mueren por una sobredosis de drogas, pero no tienen antecedentes de abuso de ningún tipo de de sustancias.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20030101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.5.0/1</episode-num><episode-num system="onscreen">S01E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016142900 +0000" stop="20261016152100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Sub Rosa</sub-title><desc lang="es">Se descubre un cadáver descompuesto en una tina de ácido en una base naval. Ducky y Abby descubren que la víctima era un submarinista.</desc><credits><actor>Mark Harmon</actor><actor>Sasha Alexander</actor><actor>David Mccallum</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor></credits><date>20030101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.6.0/1</episode-num><episode-num system="onscreen">S01E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016152100 +0000" stop="20261016161300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Seguridad mínima</sub-title><desc lang="es">El equipo del NCIS va a Cuba para investigar la conexión entre un traductor de la Marina y el contrabando en un centro de detención después que este muriera repentinamente al volante de su automóvil cuando regresaba a EE. UU. desde la Bahía de Guantánamo.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20030101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.7.0/1</episode-num><episode-num system="onscreen">S01E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016161300 +0000" stop="20261016170400 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Marino abatido</sub-title><desc lang="es">La viuda de un marino recibe una llamada de su esposo muerto y el equipo de NCIS se hace cargo del caso. Tiene que exhumar el cuerpo para deducir si la llamada fue una broma o no.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20030101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.8.0/1</episode-num><episode-num system="onscreen">S01E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016170400 +0000" stop="20261016175600 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Dada por muerta</sub-title><desc lang="es">Tras ser enterrada viva, una mujer sale de la tumba con amnesia y lo único que recuerda es que hay una bomba a bordo de un barco de la Marina.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.9.0/1</episode-num><episode-num system="onscreen">S01E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016175600 +0000" stop="20261016184800 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Ojo espía</sub-title><desc lang="es">Un comandante de la Marina, exasesor técnico de un contratista civil que creaba un escáner de sonar portátil, es hallado sin vida en la playa. El equipo del NCIS investiga el asesinato utilizando tecnología satelital.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.10.0/1</episode-num><episode-num system="onscreen">S01E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016184800 +0000" stop="20261016194000 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Mi otro pie izquierdo</sub-title><desc lang="es">El equipo del NCIS es llamado a la escena cuando encuentran una pierna cortada con un tatuaje de la Marina en un basurero, lo que los lleva a un pequeño pueblo donde se está tramando un asesinato.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.11.0/1</episode-num><episode-num system="onscreen">S01E12</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016194000 +0000" stop="20261016203000 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Un disparo, un muerto</sub-title><desc lang="es">El equipo investiga cuando un oficial de reclutamiento de la Marina es asesinado a tiros por un francotirador con rencor, quien deja una pluma blanca detrás.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.12.0/1</episode-num><episode-num system="onscreen">S01E13</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016203000 +0000" stop="20261016212100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">El buen samaritano</sub-title><desc lang="es">El equipo investiga un asesinato con la ayuda de Charley, un sheriff local, cuando se enteran de casos similares: el de un empleado civil de la Marina y el de un piloto que estaba pasando por un desagradable divorcio.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.13.0/1</episode-num><episode-num system="onscreen">S01E14</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
