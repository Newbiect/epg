<programme start="20261101011300 +0000" stop="20261101014000 +0000" channel="40 y 20"><title lang="es">40 y 20</title><sub-title lang="es">Ni me digan que me regreso</sub-title><desc lang="es">El motivo por el cual Paco despide a Toña. Los hombres llevan a cabo un casting para elegir a la mujer correcta para cumplir con las labores domésticas.</desc><credits><actor>Jorge Van Rankin</actor><actor>Mauricio Garza</actor><actor>Michelle Rodríguez</actor><actor>Mónica Huarte</actor><actor>Begoña Narváez</actor><actor>Oswaldo Zárate</actor><actor>Gerardo Taracena</actor><actor>Armando Hernández</actor><actor>Pascacio López</actor><actor>Sophié Alexander</actor><actor>Jessica Mas</actor><actor>María Aura</actor><actor>Luis Gatica</actor></credits><date>20201120</date><episode-num system="xmltv_ns">4.0.0/1</episode-num><episode-num system="onscreen">S05E01</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/cms/images/32c58707e62cf7649b10cc8d2a61edfca03c3d74.JPEG"/></programme>
<programme start="20261101014000 +0000" stop="20261101020800 +0000" channel="40 y 20"><title lang="es">40 y 20</title><sub-title lang="es">Pool party</sub-title><desc lang="es">Beto propone un proyecto para que el edificio luzca mejor. La reacción de la licenciada Horcasitas cuando conoce a Fran.</desc><credits><actor>Jorge Van Rankin</actor><actor>Mauricio Garza</actor><actor>Michelle Rodríguez</actor><actor>Mónica Huarte</actor><actor>Begoña Narváez</actor><actor>Oswaldo Zárate</actor><actor>Gerardo Taracena</actor><actor>Armando Hernández</actor><actor>Pascacio López</actor><actor>Sophié Alexander</actor><actor>Jessica Mas</actor><actor>María Aura</actor><actor>Luis Gatica</actor></credits><date>20201126</date><episode-num system="xmltv_ns">4.1.0/1</episode-num><episode-num system="onscreen">S05E02</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/cms/images/7f9b575f815ba21b8f2a8dd3dcc1a779d7b2cd47.JPEG"/></programme>
