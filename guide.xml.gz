<programme start="20261015100000 +0000" stop="20261015110000 +0000" channel="Smithsonian Channel"><title lang="en">Combat Ships</title><sub-title lang="en">Sunk</sub-title><desc lang="en">New high-tech investigations uncover what sunk a World War I cruiser, a World War II submarine, a British destroyer from the Falklands War, and more.</desc><credits><actor>Ben Major</actor></credits><category lang="en">Documentary</category><category lang="en">History</category><rating system="MPA"><value>TV-PG</value></rating><icon src="https://cdn.tvpassport.com/image/show/960x540/v2/p13658854_b_v12_ai.jpg"/></programme>
