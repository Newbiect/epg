<programme start="20261112053400 +0000" stop="20261112060400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El secreto de Remon</sub-title><desc lang="es">Boruto y Konohamaru visitan la aldea de Remon, pero están desconcertados por el frío comportamiento de Lemon.</desc><credits><actor>Alan Velázquez</actor><actor>Azul Valadez</actor><actor>Emilio Treviño</actor><actor>Isabel Martiñón</actor><actor>Karen Valleo</actor><actor>Monserrat Aguilar</actor><actor>Tommy Rojas</actor><actor>Victor Ugarte</actor></credits><date>20190728</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.116.0/1</episode-num><episode-num system="onscreen">S01E117</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65240b9f4827fc001a05ae1d/tile_1769464802152.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112060400 +0000" stop="20261112063400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El devorador de recuerdos</sub-title><desc lang="es">Konohamaru intenta rescatar a Remon por medio de controlar a Kankitsu, pero es capturado y llevado a la fuerza de regreso a la Aldea de la Hoja.</desc><credits><actor>Alan Velázquez</actor><actor>Azul Valadez</actor><actor>Emilio Treviño</actor><actor>Isabel Martiñón</actor><actor>Karen Valleo</actor><actor>Monserrat Aguilar</actor><actor>Tommy Rojas</actor><actor>Victor Ugarte</actor></credits><date>20190804</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.117.0/1</episode-num><episode-num system="onscreen">S01E118</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65240b9f4827fc001a05ae1d/tile_1769464802152.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
