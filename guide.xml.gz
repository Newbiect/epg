<programme start="20261012182800 +0000" stop="20261012185500 +0000" channel="Las Tortugas Ninja"><title lang="es">Teenage Mutant Ninja Turtles LT</title><sub-title lang="es">La Guerra de la Dimensión X</sub-title><desc lang="es">En el espacio, las Tortugas, junto a Fugitoid, viajan en la nave pequeña en búsqueda de la siguiente pieza del generador de agujeros negros.</desc><credits><actor>Rob Paulsen</actor><actor>Greg Cipes</actor><actor>Sean Astin</actor></credits><date>20160101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.7.0/1</episode-num><episode-num system="onscreen">S04E08</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/63ff6e23689edb0013bce4e7/tile_1769238721082.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012185500 +0000" stop="20261012192200 +0000" channel="Las Tortugas Ninja"><title lang="es">Teenage Mutant Ninja Turtles LT</title><sub-title lang="es">El Océano Cósmico</sub-title><desc lang="es">Las tortugas viajan a través de una especie de océano, un área del espacio.</desc><credits><actor>Rob Paulsen</actor><actor>Greg Cipes</actor><actor>Sean Astin</actor></credits><date>20160101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.8.0/1</episode-num><episode-num system="onscreen">S04E09</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/63ff6e23689edb0013bce4e7/tile_1769238721082.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012192200 +0000" stop="20261012194900 +0000" channel="Las Tortugas Ninja"><title lang="es">Teenage Mutant Ninja Turtles LT</title><sub-title lang="es">Tortugas Transdimensionales</sub-title><desc lang="es">Las cuatro Tortugas Ninja son atraídas por un portal. Ahora ellos están en una dimensión diferente, una bidimensional donde se encuentran con sus contrapartes de 1980.</desc><credits><actor>Rob Paulsen</actor><actor>Greg Cipes</actor><actor>Sean Astin</actor></credits><date>20160101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.9.0/1</episode-num><episode-num system="onscreen">S04E10</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/63ff6e23689edb0013bce4e7/tile_1769238721082.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
