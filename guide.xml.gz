<programme start="20261030042500 +0000" stop="20261030045400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Presencia</sub-title><desc lang="es">Debido al riesgo de que Code intente matar a Boruto y Kawaki, se les asigna un guardia.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230305</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.289.0/1</episode-num><episode-num system="onscreen">S20E290</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
