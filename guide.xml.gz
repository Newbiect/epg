<programme start="20261029232700 +0000" stop="20261030002600 +0000" channel="The Walking Dead Channel"><title lang="es">The Walking Dead</title><sub-title lang="es">The Key</sub-title><desc lang="es">Hilltop&apos;s leadership faces a difficult dilemma after the arrival of unexpected visitors; Rick comes face to face with an adversary.</desc><credits><director>Greg Nicotero</director><actor>Andrew Lincoln</actor><actor>Norman Reedus</actor><actor>Lauren Cohan</actor><actor>Danai Gurira</actor><actor>Melissa McBride</actor><actor>Lennie James</actor><actor>Alanna Masterson</actor><actor>Josh McDermitt</actor><actor>Christian Serratos</actor><actor>Jeffrey Dean Morgan</actor><actor>Seth Gilliam</actor><actor>Ross Marquand</actor><actor>Austin Amelio</actor><actor>Tom Payne</actor><actor>Xander Berkeley</actor></credits><date>20180318</date><episode-num system="xmltv_ns">7.11.0/1</episode-num><episode-num system="onscreen">S08E12</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/6be82a8411b3fce4fac3d27c8fd0f37a8c08f8fa.jpg"/></programme>
