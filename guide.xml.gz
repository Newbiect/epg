<programme start="20261107225503 +0000" stop="20261107232303 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora salva el Día de los Reyes Magos</sub-title><desc lang="es">¡Es el día de los Reyes Magos! Dora, Botas y Diego se disfrazan como reyes y se dirigen a la fiesta, pero necesitarán tu ayuda cuando Zorro aparece y espanta a los animales del lugar.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.2.0/1</episode-num><episode-num system="onscreen">S05E03</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261107232303 +0000" stop="20261107235003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La aventura pirata de Dora - PARTE UNO</sub-title><desc lang="es">Dora, Botas y sus amigos preparan una obra de piratas para sus familias. Cuando está por comenzar, los Cerditos Piratas se roban los disfraces.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080713</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.24.0/1</episode-num><episode-num system="onscreen">S03E25</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261107235003 +0000" stop="20261108002203 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La aventura pirata de Dora - PARTE DOS</sub-title><desc lang="es">Dora, Botas y sus amigos se embarcan en esta aventura musical para recuperar el cofre que los Cerditos Piratas les robaron. Tendrán que llegar a la Isla del Tesoro y regresar a tiempo para la obra. ¿Lo lograrán?</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080713</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.25.0/1</episode-num><episode-num system="onscreen">S03E26</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108002203 +0000" stop="20261108005003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Las cosas favoritas de Zorro</sub-title><desc lang="es">Zorro estaba usando su Giro-Súper- Zorro para empacar todas sus cosas favoritas y llevarlas a casa de su abuela. Cuando llegó un fuerte viento y todas sus cosas salieron volando. ¡Zorro necesita ayuda para encontrar sus cosas favoritas!</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.19.0/1</episode-num><episode-num system="onscreen">S06E20</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108005003 +0000" stop="20261108011903 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">¡Al Polo Sur!</sub-title><desc lang="es">El Camión de Rescate llega al Centro de Animales de Diego para dejar un animalito perdido: ¡un pingüino! Es el trabajo de Dora, Botas y Diego llevar a Pingüino hasta su casa en el Polo Sur.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080711</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.12.0/1</episode-num><episode-num system="onscreen">S03E13</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108011903 +0000" stop="20261108014803 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Somos un equipo</sub-title><desc lang="es">Dora y sus amigos están en la Súper Aventura de Carreras. Para ganar la carrera tienen que cruzar el engañoso Puente del Duende, pasar por el Volcán y atravesar la gran Muralla.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.13.0/1</episode-num><episode-num system="onscreen">S04E14</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108014803 +0000" stop="20261108021603 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El tesoro de Benny</sub-title><desc lang="es">Cuando el camión de la basura se lleva a Mochila y a Mapa por accidente, rescatarlos depende de Dora, Botas y el carrito de tesoros de Benny.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.11.0/1</episode-num><episode-num system="onscreen">S05E12</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108021603 +0000" stop="20261108024503 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Bebé cangrejo</sub-title><desc lang="es">Dora y Botas se están divirtiendo en la playa cuando, de repente, escuchan que alguien pide ayuda. ¡Es un cangrejo bebé atrapado en una red!</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.16.0/1</episode-num><episode-num system="onscreen">S04E17</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108024503 +0000" stop="20261108031403 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora salva el partido</sub-title><desc lang="es">La prima de Dora, Daisy, jugará en un partido de fútbol que se trasmitirá por la televisión. Pero al equipo le falta una jugadora. Daisy le pide a Dora que sea ella quien complete el equipo. ¡Corre, Dora, corre!</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080712</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.13.0/1</episode-num><episode-num system="onscreen">S03E14</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108031403 +0000" stop="20261108034303 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La maestra de música</sub-title><desc lang="es">¡Hoy es un gran día para ir a la escuela! La maestra de música de Botas, necesita ir a la escuela rápidamente, pero ¡su bicicleta está rota!</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.4.0/1</episode-num><episode-num system="onscreen">S04E05</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108034303 +0000" stop="20261108041203 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora, la hermana mayor</sub-title><desc lang="es">Dora tiene buenas noticias: ¡alguien nuevo se suma a la familia! Alguien que duerme en una cuna, toma de un biberón y le gusta mucho dormir. ¡Un bebé! La mamá de Dora tendrá un bebé.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.10.0/1</episode-num><episode-num system="onscreen">S04E11</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108041203 +0000" stop="20261108044003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El show de magia del Gran Pollo Rojo</sub-title><desc lang="es">En un truco de magia el Gran Pollo Rojo se convierte del tamaño de un conejo. Dora y Botas deben ir a Tierra Mágica con él, para encontrar la varita mágica y convertirlo en grande otra vez.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.10.0/1</episode-num><episode-num system="onscreen">S05E11</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108044003 +0000" stop="20261108050903 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">¡Conozcan a Diego!</sub-title><desc lang="es">Conozcan a Diego, el primo de Dora. Diego trabaja en el Centro de Rescate de Animales. Puede hacer el sonido de los animales y hablar con los animales salvajes.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20030101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">2.7.0/1</episode-num><episode-num system="onscreen">S03E08</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108050903 +0000" stop="20261108053803 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El día del trabajo</sub-title><desc lang="es">¿Qué quiéres ser cuando seas grande? Dora y Botas prueban toda clase de trabajos, desde bomberos, hasta doctores y arqueólogos. Pero, ¿qué decidirá ser Dora cuando crezca?</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080713</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.23.0/1</episode-num><episode-num system="onscreen">S03E24</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108053803 +0000" stop="20261108060803 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El adorable dinosaurio de Botas</sub-title><desc lang="es">¡Dora y Botas están haciendo una pijamada! Es la hora de irse a dormir y Dora tiene su osito de peluche, pero Botas no puede encontrar a su dinosaurio. ¡Oh, no! Su dinosaurio debe haberse caído de su mochila cuando estaban en el parque.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080712</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.17.0/1</episode-num><episode-num system="onscreen">S03E18</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108060803 +0000" stop="20261108063703 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Mejores amigos</sub-title><desc lang="es">¡Hoy es el día de los mejores amigos! En este día especial, Dora y Botas se van de picnic para celebrar. Botas lleva chocolate y Dora, deliciosas fresas. Pero, depende de nosotros ayudarlos a encontrarse en la Piedra Arco Iris.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080713</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.21.0/1</episode-num><episode-num system="onscreen">S03E22</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108063703 +0000" stop="20261108070503 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La primera bicicleta de Botas</sub-title><desc lang="es">¡Botas está listo para su primera bicicleta de chico grande! ¡Ayuda a Dora a llevarlo a la Tienda de Bicicletas, y ayuda también a otros amigos a intentar cosas nuevas por primera vez!</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.10.0/1</episode-num><episode-num system="onscreen">S06E11</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108070503 +0000" stop="20261108073403 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Roberto el robot</sub-title><desc lang="es">Dora y Botas conocen a Roberto, un robot con un cinturón de herramientas, luces, poderes de estiramiento y mucha fuerza. Pero Roberto está perdido y no encuentra a su abuelo. ¿Lo ayudamos?</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080710</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.3.0/1</episode-num><episode-num system="onscreen">S03E04</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108073403 +0000" stop="20261108080403 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Al rescate</sub-title><desc lang="es">¡Oh, no! Tres de nuestros amigos están en problemas. El bebé Jaguar está atrapado en un árbol, Isa cayó en un pozo de arena y Benny está atrapado en el Géiser Pegajoso. ¿A quién rescatamos primero?</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080712</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.16.0/1</episode-num><episode-num system="onscreen">S03E17</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108080403 +0000" stop="20261108083303 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora tiene un perrito</sub-title><desc lang="es">Abuela le da a Dora y Botas un regalo para el nuevo perrito de Dora. Pero, en su camino a casa, deberán tener cuidado con Zorro.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.9.0/1</episode-num><episode-num system="onscreen">S04E10</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108083303 +0000" stop="20261108090203 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El rugido de bebé Jaguar</sub-title><desc lang="es">¡Oh, no! El mejor amigo de Bebé Jaguar, el Bebé Oso, está atrapado en el borde de una montaña y se está por caer. Con Bebé Jaguar como líder, Dora, Botas y Diego corren al rescate.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.7.0/1</episode-num><episode-num system="onscreen">S04E08</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108090203 +0000" stop="20261108093103 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">¡Salven a Diego!</sub-title><desc lang="es">El primo de Dora, Diego, protege a todos los animales de la selva. Pero al tratar de salvar a un pajarito bebé, Diego termina atrapado y ahora necesita nuestra ayuda. ¡No te preocupes, Diego!</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.6.0/1</episode-num><episode-num system="onscreen">S04E07</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108093103 +0000" stop="20261108095903 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Desfile de Halloween</sub-title><desc lang="es">¡Dora, Botas y tú tienen que ayudar a Monstruito a encontrar un disfraz para que pueda desfilar en el Desfile de Halloween!</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.5.0/1</episode-num><episode-num system="onscreen">S06E06</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108095903 +0000" stop="20261108102803 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Atrapen a los bebés</sub-title><desc lang="es">Es una linda mañana y Dora quiere saludar a sus hermanitos bebés. Cuando Dora llega a su habitación, ellos no estaban en sus cunas. Se habían subido al carrito y estaban en peligro.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.18.0/1</episode-num><episode-num system="onscreen">S04E19</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108102803 +0000" stop="20261108105603 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El primer día de escuela</sub-title><desc lang="es">Dora acompaña a Botas y Tico a su primer día de clase. Ayúdalos a llegar a la escuela, y a practicar inglés y español en el camino.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.5.0/1</episode-num><episode-num system="onscreen">S05E06</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108105603 +0000" stop="20261108112503 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Daisy, la Quinceañera</sub-title><desc lang="es">Es la fiesta de 15 años de la prima de Dora, Daisy. Pero la fiesta no puede empezar sin Dora y Botas. Ellos les enseñarán a bailar el mambo a todos.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.5.0/1</episode-num><episode-num system="onscreen">S04E06</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108112503 +0000" stop="20261108115303 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El Deseo de Botas</sub-title><desc lang="es">El deseo de plátanos de Botas se sale de control. Tú y Dora deben ayudarlo a encontrar otra máquina de los deseos para que Botas pueda pedir un nuevo deseo.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.15.0/1</episode-num><episode-num system="onscreen">S05E16</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108115303 +0000" stop="20261108122103 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El desfile de Mochila</sub-title><desc lang="es">Dora y Botas se preparan para el gran desfile de disfraces de Mochila. Mochila está súper emocionada porque va a cantar su canción para abrir el desfile, pero no puede dejar de estornudar.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.6.0/1</episode-num><episode-num system="onscreen">S05E07</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108122103 +0000" stop="20261108125003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Animales del alfabeto</sub-title><desc lang="es">&quot;A&quot; es de Armadillo. Pero, ¿a dónde está el resto de los animales del libro del alfabeto? ¡Se han perdido! Dora y Botas se meten en el gigante libro para ayudar al armadillo a resolver el misterio.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080713</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.22.0/1</episode-num><episode-num system="onscreen">S03E23</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108125003 +0000" stop="20261108132003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La fiesta super tonta</sub-title><desc lang="es">¡Es la hora de una fiesta! A Dora y Botas los invitaron a la Gran Fiesta del Pollo Rojo. Habrá comida tonta, juegos tontos, y hasta bailes tontos. Pero, ¡el Gran Pollo Rojo ha perdido su pastel!</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080712</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.18.0/1</episode-num><episode-num system="onscreen">S03E19</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108132003 +0000" stop="20261108134803 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora salva a los tres cerditos</sub-title><desc lang="es">El Zorro se lleva las cosas de algunos Cuentos de Hadas, incluyendo los ladrillos de los Tres Cerditos, y Dora necesita tu ayuda para recuperarlas y devolverlas a su lugar en la Tierra de los Cuentos de Hada.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.9.0/1</episode-num><episode-num system="onscreen">S05E10</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108134803 +0000" stop="20261108141803 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La máquina arreglatodo</sub-title><desc lang="es">¡Oh oh! Botas tiene un hoyo en su bota, pero Dora sabe lo que debe hacer. ¡Vamos a la máquina arreglatodo!</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080712</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.19.0/1</episode-num><episode-num system="onscreen">S03E20</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108141803 +0000" stop="20261108144603 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora en Duendelandia</sub-title><desc lang="es">¡Dora y Botas necesitan tu ayuda para llegar al nuevo parque de juegos! Pero, primero tienen que salvar al Duende Gruñón que está atorado en un hoyo.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.8.0/1</episode-num><episode-num system="onscreen">S06E09</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108144603 +0000" stop="20261108151403 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La aventura de Dora y Pegaso</sub-title><desc lang="es">Dora y Botas ayudan a Pegaso, la constelación del caballo alado, a buscar a sus amigos y volver a sus casas, en una aventura de alto vuelo antes de que salga el Sol.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.0.0/1</episode-num><episode-num system="onscreen">S06E01</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108151403 +0000" stop="20261108154303 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Botas al rescate</sub-title><desc lang="es">¡Oh, no! Dora olvidó su tarea de música en el cuarto de Botas. Es una canción en inglés y español, y necesita que Botas la lleve a la escuela para poder cantarla en clase.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.11.0/1</episode-num><episode-num system="onscreen">S04E12</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108154303 +0000" stop="20261108161203 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La gran patata</sub-title><desc lang="es">Benny, el toro, encuentra una varita mágica y se convierte en una papa por accidente. Dora y Botas deberán llevar la papa al Joven Mago para que Benny pueda ser un toro otra vez.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080710</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.305.0/1</episode-num><episode-num system="onscreen">S03E306</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108161203 +0000" stop="20261108164003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El muñeco de resorte de Dora</sub-title><desc lang="es">Dora compra un muñeco de resorte a sus hermanitos que están enfermos. Únete a Dora y Botas en su viaje de regreso a casa y conoce a Helena, la amiga rusa de Dora.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.0.0/1</episode-num><episode-num system="onscreen">S05E01</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108164003 +0000" stop="20261108170803 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Feliz cumpleaños, Súper Bebés</sub-title><desc lang="es">Los hermanitos gemelos de Dora cumplen un año y necesitan tu ayuda, la de Dora y la de Botas, para salvar todos los pasteles de cumpleaños del Oso roba pasteles.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.1.0/1</episode-num><episode-num system="onscreen">S06E02</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108170803 +0000" stop="20261108173603 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El Viejo Duende Gruñón se casa</sub-title><desc lang="es">Es el casamiento del Viejo Duende Gruñón y todo está listo excepto los anillos. El Viejo Duende Gruñón los olvidó en casa de su abuela. ¡Con la ayuda de Dora, debemos buscar los anillos y llevarlos a la boda a tiempo!</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.4.0/1</episode-num><episode-num system="onscreen">S06E05</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108173603 +0000" stop="20261108180403 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La gran carrera de Benny</sub-title><desc lang="es">¡Hoy es la gran carrera de carritos y Benny, el Toro, va a competir por primera vez! Pero cuando el carrito del toro se descompone, Benny necesitará a Dora y Botas, para aprender a nunca darse por vencido.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.4.0/1</episode-num><episode-num system="onscreen">S05E05</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108180403 +0000" stop="20261108183303 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Por Favor</sub-title><desc lang="es">Dora y Botas leen un cuento sobre Kinkajou, una linda criatura del bosque, la cual está destinada a ser rey. Pero Kikajou pierde su corona porque no sabe las palabras mágicas &quot;Por Favor&quot;.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080711</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.9.0/1</episode-num><episode-num system="onscreen">S03E10</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108183303 +0000" stop="20261108190203 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Montaña estrella</sub-title><desc lang="es">Zorro le saca el collar favorito a Dora y lo lanza a la Montaña Estrella. Dora y Botas deberán subir la Escalera Estrella, escalar el Diamante y superar el hielo, el viento y la nieve para recuperarlo.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.2.0/1</episode-num><episode-num system="onscreen">S04E03</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108190203 +0000" stop="20261108193103 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Atrapa-estrellas</sub-title><desc lang="es">Dora y Botas salen en búsqueda de su primera aventura para atrapar estrellas. El viaje los llevará hasta el Castillo de la Nube, en donde intentarán rescatar a una adorable estrella bebé.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.0.0/1</episode-num><episode-num system="onscreen">S04E01</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108193103 +0000" stop="20261108200003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Super bebés</sub-title><desc lang="es">A los hermanitos de Dora les encantan las bananas tanto como las historias. Dora les cuenta la historia de &quot;Los Súper Bebés&quot;. Ellos deben recuperar sus bananas de las manos del Súper Villano Zorro.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.12.0/1</episode-num><episode-num system="onscreen">S04E13</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108200003 +0000" stop="20261108202903 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El camión se atoró</sub-title><desc lang="es">A Botas le encantan los camiones. Así que, cuando el camión de los helados queda atrapado en el parque, Dora y Botas van al rescate.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080709</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.1.0/1</episode-num><episode-num system="onscreen">S03E02</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108202903 +0000" stop="20261108205703 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">¡Vacaciones!</sub-title><desc lang="es">¡Es temporada de vacaciones! Ayuda a Dora y a Botas a empacar para encontrarse con Diego y con Bebé Jaguar para pasar una noche en el Campamento del Bosque Tropical. Y también, ayuda a los amigos de Dora a prepararse para sus viajes!</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.6.0/1</episode-num><episode-num system="onscreen">S06E07</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108205703 +0000" stop="20261108212503 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El show de baile de Dora</sub-title><desc lang="es">Dora está ansiosa por actuar en su gran show de baile, pero antes de comenzar, necesita que la ayudes a encontrar sus zapatillas de ballet.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.9.0/1</episode-num><episode-num system="onscreen">S06E10</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108212503 +0000" stop="20261108215403 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El primer viaje de Dora</sub-title><desc lang="es">Dora cuenta la historia de cuando conoció a Botas. En su primera exploración, Dora y Botas deben devolver los instrumentos a la banda Fiesta Trio para que puedan tocarle música a la malhumorada Abeja Reina.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.1.0/1</episode-num><episode-num system="onscreen">S04E02</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108215403 +0000" stop="20261108222303 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Salvando a los cachorros</sub-title><desc lang="es">¡Guau, Guau! Dora y Botas tienen un nuevo videojuego en el que un perrero mete a todos los cachorritos en jaulas. Para salvarlos, Dora y Botas tendrán que entrar en el videojuego.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080711</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.8.0/1</episode-num><episode-num system="onscreen">S03E09</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108222303 +0000" stop="20261108225103 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Las Aventuras del Bosque Encantado de Dora Parte 1, El Cuento del Rey Unicornio</sub-title><desc lang="es">Unicornio ha sido escogido el nuevo Rey del Bosque Encantado, pero primero necesita la ayuda de Dora, de Botas y de ti para descubrir que es bueno, inteligente, valiente y fuerte como para hacer el trabajo.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.12.0/1</episode-num><episode-num system="onscreen">S06E13</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108225103 +0000" stop="20261108232003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Super - espías 2: La máquina de llevarse cosas</sub-title><desc lang="es">Zorro inventó una máquina que puede llevarse cosas súper rápido y va a llevarse todos los regalos del cumpleaños de Tico. ¡Súper Espías Dora y Botas, al rescate!</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.3.0/1</episode-num><episode-num system="onscreen">S04E04</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108232003 +0000" stop="20261108234903 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora y Diego al rescate</sub-title><desc lang="es">Es una aventura a toda velocidad alrededor del mundo cuando Dora y Diego persiguen a Botas, quien está siendo llevado por un cometa gigante. Dora y Diego necesitan de tu ayuda.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.19.0/1</episode-num><episode-num system="onscreen">S04E20</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108234903 +0000" stop="20261109001703 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Botas Saltarín</sub-title><desc lang="es">Las botas de Botas han regresado del zapatero pero cuando se las prueba empieza a rebotar por todas partes. ¡Son otras botas! Dora y tu deben ayudarlo a encontrar sus botas en una aventura saltarina.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.7.0/1</episode-num><episode-num system="onscreen">S05E08</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
