<programme start="20261017034300 +0000" stop="20261017041200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Sobrecarga</sub-title><desc lang="es">Delta utiliza su rayo destructor que puede neutralizar cualquier poder regenerativo. Indomable, Naruto lo suprime a la fuerza con un Rasengan Gigante.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210516</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.198.0/1</episode-num><episode-num system="onscreen">S14E199</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017041200 +0000" stop="20261017044100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Discípulo</sub-title><desc lang="es">Delta informa a Jigen que Boruto también tiene un Karma en la palma de su mano. Al oír esto, Jigen sonríe...</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210523</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.199.0/1</episode-num><episode-num system="onscreen">S14E200</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017044100 +0000" stop="20261017051000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Lágrimas vacías</sub-title><desc lang="es">Mientras Naruto duerme, Kawaki repara la vasija que rompió. De repente, Kurama, la bestia de las Nueve colas, aparece frente a él.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210530</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.200.0/1</episode-num><episode-num system="onscreen">S14E201</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017051000 +0000" stop="20261017053900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El culto</sub-title><desc lang="es">Usando la Técnica de transportación, Sasuke llega a un extraño lugar que está cubierto de misteriosas inscripciones. Ahí encuentra muchas cosas sorprendentes sobre el Clan OTSUTSUKI.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210606</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.201.0/1</episode-num><episode-num system="onscreen">S14E202</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017053900 +0000" stop="20261017060800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Ataque sorpresa!</sub-title><desc lang="es">¡Una confrontación entre Naruto, el Séptimo Hokage, y Jigen, el líder de Kara, finalmente llega!</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210613</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.202.0/1</episode-num><episode-num system="onscreen">S14E203</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017060800 +0000" stop="20261017063700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Él es malas noticias</sub-title><desc lang="es">Naruto y Sasuke trabajan juntos para derrotar a Jigen en una feroz batalla, pero les cuesta enfrentar sus avanzadas habilidades de batalla y su misterioso jutsu.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210620</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.203.0/1</episode-num><episode-num system="onscreen">S14E204</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017063700 +0000" stop="20261017070600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Prueba</sub-title><desc lang="es">Con la aparición repentina del enemigo, Naruto, el Séptimo Hokage y líder de la aldea, ha desaparecido.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210627</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.204.0/1</episode-num><episode-num system="onscreen">S14E205</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017070600 +0000" stop="20261017073500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El nuevo equipo siete</sub-title><desc lang="es">Boruto y los demás atacan a Boro para salvar a Naruto, pero Boro los hace retroceder al liberar una misteriosa niebla oscura que paraliza a sus oponentes.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210704</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.205.0/1</episode-num><episode-num system="onscreen">S14E206</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017073500 +0000" stop="20261017080400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Regeneración</sub-title><desc lang="es">El recién formado equipo siete ataca con todo a Boro, y sus esfuerzos parece dar frutos. Sin embargo, Boro usa sus poderes regenerativos para revivir.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210711</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.206.0/1</episode-num><episode-num system="onscreen">S14E207</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017080400 +0000" stop="20261017083300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La manifestación de Momoshiki</sub-title><desc lang="es">A pesar de haber recibido bastante daño de parte del nuevo equipo siete, Boro pierde el control por completo, amenazando a Boruto y a los demás con aniquilarlos.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210718</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.207.0/1</episode-num><episode-num system="onscreen">S14E208</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017083300 +0000" stop="20261017090200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Marginado</sub-title><desc lang="es">Kawaki empieza a preocuparse de que su presencia ponga en peligro a la Aldea Oculta de la Hoja, sobre todo porque Kara le persigue.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210801</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.208.0/1</episode-num><episode-num system="onscreen">S14E209</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017090200 +0000" stop="20261017093100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Pistas hacia Kara</sub-title><desc lang="es">Para saber más sobre la relación entre Boro y Kara, Konohamaru y Sai reciben el encargo de infiltrarse en el culto de Boro.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210808</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.209.0/1</episode-num><episode-num system="onscreen">S14E210</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017093100 +0000" stop="20261017100000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Persecución</sub-title><desc lang="es">Alguien ha robado información sobre los ninja de la Hoja y se sospecha que puede haber un espía dentro del pueblo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210815</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.210.0/1</episode-num><episode-num system="onscreen">S14E211</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017100000 +0000" stop="20261017102900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Amado, el desertor</sub-title><desc lang="es">Amado, miembro principal de Kara que supervisaba su investigación y desarrollo, secuestra a Shikadai y busca asilo en la Aldea de la Hoja.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210822</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.211.0/1</episode-num><episode-num system="onscreen">S14E212</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017102900 +0000" stop="20261017105800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Verdadera Identidad</sub-title><desc lang="es">A cambio de que le concedan asilo en la Aldea Oculta entre las Hojas, Amado revela todo lo que sabe.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210829</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.212.0/1</episode-num><episode-num system="onscreen">S14E213</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017105800 +0000" stop="20261017112700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Destino Predeterminado</sub-title><desc lang="es">La batalla entre Koji Kashin y Jigen comienza en el escondite de Kara.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210905</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.213.0/1</episode-num><episode-num system="onscreen">S14E214</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017112700 +0000" stop="20261017115600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Preparado</sub-title><desc lang="es">Isshiki finalmente aparece en su verdadera forma y va a atacar la Aldea escondida de la hoja para poder capturar a Kawaki que se convertirá e su nueva vasija.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210912</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.214.0/1</episode-num><episode-num system="onscreen">S14E215</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017115600 +0000" stop="20261017122500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Sacrificio</sub-title><desc lang="es">Boruto lleva a Isshiki a otra dimensión para el enfrentamiento final. Naruto y Sasuke los siguen.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210919</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.215.0/1</episode-num><episode-num system="onscreen">S14E216</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017122500 +0000" stop="20261017125400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Decisión</sub-title><desc lang="es">Naruto y Sasuke pelean ferozmente, pero sus esfuerzos son en vano ya que Isshiki los acorrala. Boruto toma medidas desesperadas para vencerlo, pero falla.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210926</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.216.0/1</episode-num><episode-num system="onscreen">S14E217</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017125400 +0000" stop="20261017132300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Compañero</sub-title><desc lang="es">Naruto y los demás están exhaustos por la batalla contra Isshiki. Momoshiki toma el control de la conciencia de Boruto y se muestra frente a ellos como un enemigo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211003</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.217.0/1</episode-num><episode-num system="onscreen">S14E218</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017132300 +0000" stop="20261017135200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Regreso</sub-title><desc lang="es">Al finalizar la batalla contra Isshiki, Boruto y los demás regresan a la aldea. Gracias a su trabajo, la aldea se mantuvo a salvo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211010</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.218.0/1</episode-num><episode-num system="onscreen">S14E219</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017135200 +0000" stop="20261017142100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Tiempo que Queda</sub-title><desc lang="es">Aquellos con el Karma comienzan a perder el control de su mente y cuerpo mientras pasan por la Otsutsukificación.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211017</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.219.0/1</episode-num><episode-num system="onscreen">S14E220</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261017142100 +0000" stop="20261017145000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Marcas de Garras</sub-title><desc lang="es">Code adora a Isshiki Otsutsuki, que fue derrotado por Boruto y sus amigos. Para poder conocer a cierta persona, visita una propiedad que le pertenecía a Boro.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230212</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.286.0/1</episode-num><episode-num system="onscreen">S20E287</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
