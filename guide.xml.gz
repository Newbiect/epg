<programme start="20261026232600 +0000" stop="20261026235500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Compañero</sub-title><desc lang="es">Naruto y los demás están exhaustos por la batalla contra Isshiki. Momoshiki toma el control de la conciencia de Boruto y se muestra frente a ellos como un enemigo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211003</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.217.0/1</episode-num><episode-num system="onscreen">S14E218</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026235500 +0000" stop="20261027002400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Regreso</sub-title><desc lang="es">Al finalizar la batalla contra Isshiki, Boruto y los demás regresan a la aldea. Gracias a su trabajo, la aldea se mantuvo a salvo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211010</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.218.0/1</episode-num><episode-num system="onscreen">S14E219</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
