<programme start="20261018222600 +0000" stop="20261018231700 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Escape</sub-title><desc lang="es">Un convicto que había sido apresado por el agente Fornell, del FBI, escapa y lo amenaza tanto a a él como a su hija. Gibbs sale de su retiro para reabrir el caso de robo a mano armada del convicto.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.1.0/1</episode-num><episode-num system="onscreen">S04E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018231700 +0000" stop="20261019000900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">La Búsqueda</sub-title><desc lang="es">El equipo se entera de que una teniente de la Marina desaparecida había estado haciendo averiguaciones sobre unos hombres para encontrar la pareja perfecta. Descubren que ella planeaba asistir a un seminario para solteros en un hotel de la zona.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.2.0/1</episode-num><episode-num system="onscreen">S04E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019000900 +0000" stop="20261019010100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Fingiendo</sub-title><desc lang="es">El equipo del NCIS es convocado a la escena del raro asesinato de un suboficial que formaba parte de una operación de armas encubierta.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.3.0/1</episode-num><episode-num system="onscreen">S04E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019010100 +0000" stop="20261019015300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Muerto Y Desenterrado</sub-title><desc lang="es">El equipo investiga el caso de un cabo segundo muerto, que fue encontrado por un agente de bienes raíces. Descubren que el cadáver fue enterrado en un patio trasero y luego exhumado.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.4.0/1</episode-num><episode-num system="onscreen">S04E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019015300 +0000" stop="20261019024200 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Trampa De Arena</sub-title><desc lang="es">Una explosión mata a un coronel de la Marina en un campo de golf militar. El equipo del NCIS debe trabajar junto con la Unidad de Investigación Criminal del Ejército para encontrar al asesino.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.5.0/1</episode-num><episode-num system="onscreen">S04E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019024200 +0000" stop="20261019033300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Cacería De Brujas</sub-title><desc lang="es">Llaman y piden dinero por el rescate de la hija de un marine. El equipo del NCIS descubre que los padres de la niña se separaron hace poco, tras una indiscreción marital de la esposa.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.6.0/1</episode-num><episode-num system="onscreen">S04E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019033300 +0000" stop="20261019042400 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Una Vez Héroe</sub-title><desc lang="es">El equipo del NCIS investiga la muerte de un veterano de la Marina en un hotel.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.7.0/1</episode-num><episode-num system="onscreen">S04E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019042400 +0000" stop="20261019051600 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Hermana En Problemas</sub-title><desc lang="es">La hermana de McGee aparece en su puerta ensangrentada y confundida. Él intenta reconstruir lo que le ocurrió a ella la noche anterior.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.8.0/1</episode-num><episode-num system="onscreen">S04E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019051600 +0000" stop="20261019060800 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Ahumado</sub-title><desc lang="es">El equipo del NCIS se asocia a regañadientes con el FBI cuando identifican los restos de un hombre en una base de la Marina como un asesino en serie que el FBI había estado buscando durante 12 años.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.9.0/1</episode-num><episode-num system="onscreen">S04E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019060800 +0000" stop="20261019065900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Control Remoto</sub-title><desc lang="es">Un vehículo robótico altamente clasificado llamado &quot;Otto&quot; causa la muerte de un teniente de la Marina. Al principio, Gibbs y el equipo piensan que se trató de un suicidio.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.10.0/1</episode-num><episode-num system="onscreen">S04E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019065900 +0000" stop="20261019075100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Sospecha</sub-title><desc lang="es">Gibbs y el equipo se precipitan a la escena donde fue asesinado un oficial de inteligencia de alto nivel. Descubren que el crimen tuvo lugar tres días antes y fue &quot;investigado&quot; por las autoridades locales.</desc><credits><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>David Mccallum</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor><actor>Cote De Pablo</actor><actor>Lauren Holly</actor><actor>Brian Dietzen</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.11.0/1</episode-num><episode-num system="onscreen">S04E12</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019075100 +0000" stop="20261019084300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">El Regreso Del Sharif</sub-title><desc lang="es">Desaparecen diez kilogramos de armas químicas altamente tóxicas. Gibbs y su equipo se apresuran a localizarlas. El equipo del NCIS se horroriza al descubrir que el arma química mortal ahora está en manos del terrorista buscado Mamoun Sharif.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.12.0/1</episode-num><episode-num system="onscreen">S04E13</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019084300 +0000" stop="20261019093500 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">El Escape</sub-title><desc lang="es">El equipo del NCIS captura a un traficante de armas internacional. Luego, descubren que el sistema de armas altamente clasificado de la Marina está a punto de ser vendido a otro traficante de armas buscado y conocido como &quot;La Grenouille&quot; (Armand Assante).</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.13.0/1</episode-num><episode-num system="onscreen">S04E14</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019093500 +0000" stop="20261019102700 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Amigos Y Amantes</sub-title><desc lang="es">Trabajando con los funcionarios locales, el equipo del NCIS originalmente cree que un marinero murió a causa de una sobredosis de drogas no intencional en una parte sórdida de la ciudad.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.14.0/1</episode-num><episode-num system="onscreen">S04E15</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019102700 +0000" stop="20261019111900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Cadaver Deambulando</sub-title><desc lang="es">Gibbs y el equipo colaboran con un inspector de la Agencia Internacional de Energía Atómica que sufre envenenamiento por radiación. Reconstruyen su rutina intentando averiguar cuándo ocurrió la contaminación.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.15.0/1</episode-num><episode-num system="onscreen">S04E16</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019111900 +0000" stop="20261019121100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Esqueletos</sub-title><desc lang="es">Ducky y Abby confirman haber identificado los restos de al menos cinco personas. El equipo del NCIS inmediatamente comienza a notificar a las familias con la esperanza de establecer alguna conexión en la selección aparentemente aleatoria de víctimas.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.16.0/1</episode-num><episode-num system="onscreen">S04E17</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019121100 +0000" stop="20261019130300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Hombre De Hielo</sub-title><desc lang="es">El equipo del NCIS investiga la muerte de un infante de marina. Creen que murió congelado, pero se despierta en la mesa de autopsias de Ducky.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.17.0/1</episode-num><episode-num system="onscreen">S04E18</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019130300 +0000" stop="20261019135500 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Tiempo De Gracia</sub-title><desc lang="es">Gibbs y el equipo investigan cuando una llamada de fin de semana al NCIS resulta en la muerte de dos agentes. El equipo descubre que esa pista telefónica fue una trampa para terminar en la muerte de los agentes.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.18.0/1</episode-num><episode-num system="onscreen">S04E19</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019135500 +0000" stop="20261019144600 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Historia Principal</sub-title><desc lang="es">Gibbs y el equipo investigan cuando el libro ficticio de McGee sobre un agente del NCIS se vuelve realidad. McGee se horroriza cuando un suboficial en el que basó el personaje de su último libro resulta asesinado.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.19.0/1</episode-num><episode-num system="onscreen">S04E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019144600 +0000" stop="20261019153800 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Hermano En Armas</sub-title><desc lang="es">El director Shepard corre un gran riesgo y acepta reunirse con un informante a solas para hablar sobre &quot;La Grenouille&quot;, pero la reunión sale mal y su contacto muere.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.20.0/1</episode-num><episode-num system="onscreen">S04E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019153800 +0000" stop="20261019163000 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">En La Oscuridad</sub-title><desc lang="es">Gibbs y el equipo investigan cuando un fotógrafo ciego toma sin darse cuenta la fotografía del asesinato de un suboficial.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.21.0/1</episode-num><episode-num system="onscreen">S04E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261019163000 +0000" stop="20261019172200 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Caballo De Troya</sub-title><desc lang="es">Gibbs ignora la burocracia asociada con sus deberes de director &quot;interino&quot; y dirige una investigación sobre una víctima de asesinato encontrada en un taxi que se dirigía a la sede del NCIS. Además, Jenny descubre un secreto sobre su pasado.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.22.0/1</episode-num><episode-num system="onscreen">S04E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
