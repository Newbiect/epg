<programme start="20261105081700 +0000" stop="20261105084700 +0000" channel="Inuyasha"><title lang="es">Inuyasha LT</title><sub-title lang="es">La Espada Relámpago Contra El Colmillo De Acero</sub-title><desc lang="es">Inuyasha se enfrenta a Hiten mientras Shippo intenta usar su magia para rescatar a Kagome de Manten, pero los Thunder Brothers no serán derrotados tan fácilmente.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20001218</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.9.0/1</episode-num><episode-num system="onscreen">S01E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105084700 +0000" stop="20261105091700 +0000" channel="Inuyasha"><title lang="es">Inuyasha LT</title><sub-title lang="es">La Máscara Maldita</sub-title><desc lang="es">Cuando Kagome regresa al presente, el poder de la Joya Shikon incita a una antigua máscara de noh para atacar a su abuelo.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010115</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.10.0/1</episode-num><episode-num system="onscreen">S01E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105091700 +0000" stop="20261105094700 +0000" channel="Inuyasha"><title lang="es">Inuyasha LT</title><sub-title lang="es">Un Espíritu Perverso</sub-title><desc lang="es">Inuyasha ve a un demonio llamado tatarimokke que guía benevolentemente a los espíritus de los niños, mientras que Kagome se encuentra con el espíritu de una niña llamada Mayu.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010122</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.11.0/1</episode-num><episode-num system="onscreen">S01E12</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
