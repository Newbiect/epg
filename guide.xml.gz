<programme start="20261119110000 +0000" stop="20261119120000 +0000" channel="Smithsonian Channel"><title lang="en">Combat Ships</title><sub-title lang="en">Smugglers and Pirates</sub-title><desc lang="en">A look at how maritime task forces and the Coast Guard are keeping commercial vessels and US shores safe from pirates and drug smugglers.</desc><category lang="en">Documentary</category><category lang="en">History</category><rating system="MPA"><value>TV-PG</value></rating><icon src="https://cdn.tvpassport.com/image/show/960x540/v2/p13658854_b_v12_ai.jpg"/></programme>
<programme start="20261119120000 +0000" stop="20261119130000 +0000" channel="Smithsonian Channel"><title lang="en">Combat Ships</title><sub-title lang="en">Heroes of Guadalcanal</sub-title><desc lang="en">A comprehensive look at the naval battle of Guadalcanal in November 1942 and the heroic efforts of U.S. sailors who held off powerful Imperial Navy.</desc><category lang="en">Documentary</category><category lang="en">History</category><rating system="MPA"><value>TV-PG</value></rating><icon src="https://cdn.tvpassport.com/image/show/960x540/v2/p13658854_b_v12_ai.jpg"/></programme>
<programme start="20261119130000 +0000" stop="20261119140000 +0000" channel="Smithsonian Channel"><title lang="en">Combat Ships</title><sub-title lang="en">Amphibious Assaults</sub-title><desc lang="en">The evolution of amphibious assault vehicles, including the restoration of Britain&apos;s last surviving LCT 7074 landing craft, designed to carry six Churchill tanks.</desc><credits><actor>Ben Major</actor></credits><category lang="en">Documentary</category><category lang="en">History</category><rating system="MPA"><value>TV-PG</value></rating><icon src="https://cdn.tvpassport.com/image/show/960x540/v2/p13658854_b_v12_ai.jpg"/></programme>
