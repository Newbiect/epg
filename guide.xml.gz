<programme start="20261029103000 +0000" stop="20261029110000 +0000" channel="Crunchyroll 🇺🇸"><title lang="en">Welcome to Demon School, Iruma-kun!</title><sub-title lang="en">The Battler&apos;s Presentation</sub-title><desc lang="en">The Masekyam arrests Sullivan, so he cannot attend the Batra Party; Iruma, unaware of his arrest, prepares for the magical tool research presentation.</desc><credits><actor>Lee Kyung-tae</actor><actor>Min Eung-sik</actor><actor>Kim Myungjun</actor><actor>Kang Eun-ae</actor><actor>Yoon Yong-sik</actor><actor>Lee Saebyeok</actor></credits><date>20210922</date><episode-num system="xmltv_ns">0.13.0/1</episode-num><episode-num system="onscreen">S01E14</episode-num><rating><value>US_MPAA_UR</value></rating><icon src="http://p-img.movetv.com/1920x1080/36a3f8f53ba538148de9bd76c8a25443.jpeg"/></programme>
