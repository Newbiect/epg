<programme start="20261108020800 +0000" stop="20261108023700 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">La maldición de DIO</sub-title><desc lang="es">Jotaro ignora las protestas de Joseph e intenta usar su Stand para eliminar el dispositivo de control mental implantado por Dio en el cerebro de Kakyoin.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140418</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.2.0/1</episode-num><episode-num system="onscreen">S02E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108023700 +0000" stop="20261108030600 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Tower of Gray</sub-title><desc lang="es">Kakyoin se enfrenta a un Stand sin conocer a su usuario mientras Jotaro y su equipo se encuentran con uno de los matones de Dio en el vuelo a Egipto.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140425</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.3.0/1</episode-num><episode-num system="onscreen">S02E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108030600 +0000" stop="20261108033500 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Silver Chariot</sub-title><desc lang="es">La victoria de Avdol sobre Polnareff, el asesino controlado mentalmente por Dio y dotado de poderes excepcionales, se presenta complicada.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140502</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.4.0/1</episode-num><episode-num system="onscreen">S02E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108033500 +0000" stop="20261108040400 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Dark Blue Moon</sub-title><desc lang="es">Jotaro y su equipo ponen rumbo a Singapur en barco. Poco después de descubrir un polizón a bordo, un Stand con un usuario desconocido ataca a Jotaro.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140509</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.5.0/1</episode-num><episode-num system="onscreen">S02E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108040400 +0000" stop="20261108043300 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Strength</sub-title><desc lang="es">El grupo de Jotaro se topa con un carguero abandonado en el que hay un orangután. Durante el reconocimiento del buque, la grúa se pone en marcha repentinamente.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140516</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.6.0/1</episode-num><episode-num system="onscreen">S02E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108043300 +0000" stop="20261108050300 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Devil</sub-title><desc lang="es">Jotaro y su equipo llegan al hotel en Singapur. Sin embargo, al llegar a su habitación, Polnareff cae en la trampa que le ha tendido un Stand.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140523</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.7.0/1</episode-num><episode-num system="onscreen">S02E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108050300 +0000" stop="20261108053200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Yellow Temperance</sub-title><desc lang="es">Mientras dan una vuelta por Singapur, Jotaro empieza a sospechar que Kakyoin está poseído al ver que se comporta de manera extraña y le propina una paliza a un ladrón.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140530</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.8.0/1</episode-num><episode-num system="onscreen">S02E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108053200 +0000" stop="20261108060300 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Emperor y Hanged Man, parte 1</sub-title><desc lang="es">Polnareff decide vengar a su hermana por su cuenta tras ser víctima del ataque de un extraño Stand al que solo puede ver reflejado en un espejo.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140606</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.9.0/1</episode-num><episode-num system="onscreen">S02E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108060300 +0000" stop="20261108063200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Emperor y Hanged Man, parte 2</sub-title><desc lang="es">Kakyoin trata de convencer a Polnareff de que huya al darse cuenta de que su aliado está librando una batalla perdida contra el Stand enemigo.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140613</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.10.0/1</episode-num><episode-num system="onscreen">S02E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108063200 +0000" stop="20261108070000 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Jueves 15 de julio, parte 1</sub-title><desc lang="es">Yoshihiro, seguro de que Kawajiri es su hijo, toma medidas para protegerlo de Jotaro. Josuke y Okuyasu se encuentran con un hombre que vive en una torre de alta tensión.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20161028</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.30.0/1</episode-num><episode-num system="onscreen">S03E31</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108070000 +0000" stop="20261108072900 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Jueves 15 de julio, parte 2</sub-title><desc lang="es">Un excéntrico arquitecto llamado Masazo Kinoto visita a Rohan para revisar las consecuencias del incendio en la casa. Josuke y Kanedachi se pelean subidos a la torre.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20161104</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.31.0/1</episode-num><episode-num system="onscreen">S03E32</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108072900 +0000" stop="20261108075800 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Jueves 15 de julio, parte 3</sub-title><desc lang="es">Rohan tiene problemas después de haberle visto la espalda a Kinoto. Entretanto, un joven se presenta ante Josuke y le muestra un papel que esconde algo.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20161111</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.32.0/1</episode-num><episode-num system="onscreen">S03E33</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108075800 +0000" stop="20261108082700 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Jueves 15 de julio, parte 4</sub-title><desc lang="es">Rohan le pide ayuda a Koichi porque está en apuros, pero Koichi no le cree. A pesar del riesgo al que se expone, Rohan se dirige al hotel de Jotaro.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20161118</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.33.0/1</episode-num><episode-num system="onscreen">S03E34</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108082700 +0000" stop="20261108085600 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Bites the Dust, parte 1</sub-title><desc lang="es">Kawajiri logra matar a Hayato. Al enterarse del asesinato, Rohan y el resto van a inspeccionar la casa de Kawajiri. La flecha de Yoshihiro perfora a Kawajiri.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20161125</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.34.0/1</episode-num><episode-num system="onscreen">S03E35</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108085600 +0000" stop="20261108092500 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Bites the Dust, parte 2</sub-title><desc lang="es">Hayato se da cuenta de que la gente que obtiene información de Kira a través de él acaba mal. Sin embargo, está decidido a derrotar a Kira.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20161202</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.35.0/1</episode-num><episode-num system="onscreen">S03E36</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108092500 +0000" stop="20261108095400 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Shining Diamond es irrompible parte 1</sub-title><desc lang="es">Kira tiene como objetivo destruir el tercer poder mientras Hayato hacía volar por los aires a varias personas. Pero alguien se presenta delante de Kira.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20161209</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.36.0/1</episode-num><episode-num system="onscreen">S03E37</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108095400 +0000" stop="20261108102300 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Shining Diamond es irrompible parte 2</sub-title><desc lang="es">Cae una bomba en la casa donde se esconden Josuke y Hayato. Ninguno de los dos logra adivinar cómo el proyectil pudo detectarlos.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20161216</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.37.0/1</episode-num><episode-num system="onscreen">S03E38</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108102300 +0000" stop="20261108105200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Adiós, Morioh. Un corazón de oro.</sub-title><desc lang="es">A pesar de estar acorralado, Kira no se rinde. Usa el tercer poder con un rescatista e intenta hacer volar el tiempo por los aires activando uno de sus Stands.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20161223</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.38.0/1</episode-num><episode-num system="onscreen">S03E39</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108105200 +0000" stop="20261108112100 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Vento aureo</sub-title><desc lang="es">Con el Stand más adecuado para la tarea, Koichi Hirose llega a Nápoles para localizar al joven Haruno Shiobana, un hombre del que se teme que sea hijo de Dio Brando.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181006</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.0.0/1</episode-num><episode-num system="onscreen">S04E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108112100 +0000" stop="20261108115000 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Llega Bucciarati</sub-title><desc lang="es">La vida de Giorno, un niño abandonado, cambia cuando ayuda a un mafioso a evitar la muerte. Giorno aprende más sobre sus poderes mientras se enfrenta a Bruno Bucciarati.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181013</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.1.0/1</episode-num><episode-num system="onscreen">S04E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108115000 +0000" stop="20261108121900 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El mafioso al otro lado del cristal</sub-title><desc lang="es">Decidido a unirse al grupo mafioso Passione, Giorno visita a Polpo, un miembro importante, en prisión, donde se le somete a una prueba de iniciación imposible.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181020</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.2.0/1</episode-num><episode-num system="onscreen">S04E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108121900 +0000" stop="20261108124800 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Iniciación en las bandas</sub-title><desc lang="es">Giorno lucha contra el Stand de Polpo, que puede maniobrar libremente entre las sombras. Koichi le habla a Giorno del Stand que ha aparecido con una flecha.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181027</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.3.0/1</episode-num><episode-num system="onscreen">S04E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108124800 +0000" stop="20261108131700 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">¡A por el tesoro de Polpo!</sub-title><desc lang="es">Cuando la noticia del alijo oculto de Polpo se extiende entre la gente de Passione, Bucciarati y su banda se embarcan para recuperarlo ellos mismos.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181103</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.4.0/1</episode-num><episode-num system="onscreen">S04E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108131700 +0000" stop="20261108134600 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El contraataque de Moody Jazz</sub-title><desc lang="es">Tras la misteriosa desaparición de la tripulación de Bucciarati bajo cubierta, Abbacchio pone en marcha su Stand, Moody Jazz, para investigar el inquietante fenómeno.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181110</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.5.0/1</episode-num><episode-num system="onscreen">S04E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108134600 +0000" stop="20261108141500 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Aparece Six Bullets (Primera parte)</sub-title><desc lang="es">La banda se entera de que una amenaza aguarda su llegada a Capri. Con Giorno, Mista procede a neutralizar al enemigo con su Stand, Six Bullets.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181117</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.6.0/1</episode-num><episode-num system="onscreen">S04E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108141500 +0000" stop="20261108144400 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Aparece Six Bullets (Segunda parte)</sub-title><desc lang="es">Sale atrae a Mista a un camión en marcha que controla con su Stand, Arts and Crafts, que muestra su capacidad de controlar la energía de las balas de Six Bullets.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181124</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.7.0/1</episode-num><episode-num system="onscreen">S04E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108144400 +0000" stop="20261108151300 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">La primera misión del jefe</sub-title><desc lang="es">Tras entregar el alijo oculto de joyas de valor incalculable de Polpo, Pericolo, un caporegime de Passione, nombra a Bucciarati miembro de alto rango de la organización.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181201</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.8.0/1</episode-num><episode-num system="onscreen">S04E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108151300 +0000" stop="20261108154200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El equipo de sicarios</sub-title><desc lang="es">Formaggio, miembro del equipo Hitman, intercepta a Narancia mientras este viaja para abastecerse. Formaggio encoge a Narancia usando el poder de Tiny Feet.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181208</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.9.0/1</episode-num><episode-num system="onscreen">S04E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108154200 +0000" stop="20261108161100 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El Li&apos;l Bomber de Narancia</sub-title><desc lang="es">Narancia, cada vez más débil, lucha por mantenerse con vida mientras Formaggio sigue presionándole para averiguar el paradero de la hija del jefe.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181215</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.10.0/1</episode-num><episode-num system="onscreen">S04E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108161100 +0000" stop="20261108164000 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">La segunda misión del jefe</sub-title><desc lang="es">Bucciarati envía a Giorno y a sus hombres a las ruinas de Pompeya, donde un encontronazo con Illuso hace que Fugo quede atrapado en un mundo en un espejo sin su Stand.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181222</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.11.0/1</episode-num><episode-num system="onscreen">S04E12</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108164000 +0000" stop="20261108170900 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Mirror Man y Purple Smoke</sub-title><desc lang="es">Abbacchio procede a recuperar la llave necesaria para poner a salvo a la hija del jefe, pero antes debe enfrentarse a Illuso dentro del mundo del espejo.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20181229</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.12.0/1</episode-num><episode-num system="onscreen">S04E13</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108170900 +0000" stop="20261108173800 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Tren rápido a Florencia</sub-title><desc lang="es">Los hombres de Bucciarati tienen órdenes de subir a un tren rápido con destino a Florencia, pero no saben cómo utilizar la llave y los sicarios se acercan.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190112</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.13.0/1</episode-num><episode-num system="onscreen">S04E14</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108173800 +0000" stop="20261108180700 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Muerte agradecida (Primera parte)</sub-title><desc lang="es">Mista aparece para investigar un ataque desconocido que hace envejecer rápidamente a la tripulación de Bucciarati, pero pronto se verá atrapado por el Stand Beach Boy.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190119</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.14.0/1</episode-num><episode-num system="onscreen">S04E15</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108180700 +0000" stop="20261108183600 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Muerte Agradecida (Segunda parte)</sub-title><desc lang="es">Conmovido por la determinación del moribundo Prosciutto de mantener activado su Stand Thankful Death, Pesci decide enfrentarse a Bucciarati.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190126</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.15.0/1</episode-num><episode-num system="onscreen">S04E16</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108183600 +0000" stop="20261108190500 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Cabecita</sub-title><desc lang="es">Melone utiliza el cuerpo de una joven inocente para engendrar un Stand que envía a la caza de Trish, quien muestra signos de ser ella misma una usuaria de Stand.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190202</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.16.0/1</episode-num><episode-num system="onscreen">S04E17</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108190500 +0000" stop="20261108193400 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">¡Dirigíos a Venecia!</sub-title><desc lang="es">Mientras Babyhead intenta hacerlo pedazos mediante la manipulación de la materia, Giorno utiliza los poderes generadores de vida de Golden Wind y contraataca.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190209</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.17.0/1</episode-num><episode-num system="onscreen">S04E18</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108193400 +0000" stop="20261108200300 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Hielo blanco</sub-title><desc lang="es">Giorno y Mista llegan a Venecia para recuperar el disco de datos, pero el Stand White Ice de Ghiaccio frustra su misión congelando todo lo que tienen a la vista.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor><actor>Ray Chase</actor><actor>Sean Chiplock</actor><actor>Kellen Goff</actor><actor>Katsuyuki Konishi</actor></credits><date>20190215</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.18.0/1</episode-num><episode-num system="onscreen">S04E19</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108200300 +0000" stop="20261108203200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">La última misión del jefe</sub-title><desc lang="es">Bucciarati escolta a Trish hasta el campanario para entregarla finalmente a su padre, pero una devastadora traición pone en peligro la vida de ambos.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190223</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.19.0/1</episode-num><episode-num system="onscreen">S04E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108203200 +0000" stop="20261108210100 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El misterio de Emperor Crimson</sub-title><desc lang="es">Al darse cuenta de que le habían engañado, Bucciarati decide derrotar a su jefe traidor y salvar a Trish, pero Emperor Crimson sigue llevando las de ganar.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190302</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.20.0/1</episode-num><episode-num system="onscreen">S04E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108210100 +0000" stop="20261108213000 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Con un par</sub-title><desc lang="es">Ahora que son traidores a Passione, la banda de Bucciarati debe pensar en su próximo movimiento, pero escapar del jefe no será fácil.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190316</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.21.0/1</episode-num><episode-num system="onscreen">S04E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108213000 +0000" stop="20261108215900 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Aplasta y Habla la Boca</sub-title><desc lang="es">Giorno está incapacitado por el ataque de Squalo y Narancia utiliza su habilidad de radar del Stand Aerosmith para buscar y destruir la amenaza que se aproxima.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190323</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.22.0/1</episode-num><episode-num system="onscreen">S04E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108215900 +0000" stop="20261108222800 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Persecución notoria</sub-title><desc lang="es">Bucciarati y su tripulación se preparan para partir hacia Cerdeña para descubrir el pasado de su jefe, pero un extraño usuario de Stand aparece antes de que despeguen.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190330</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.23.0/1</episode-num><episode-num system="onscreen">S04E24</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108222800 +0000" stop="20261108225700 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Mujer picante</sub-title><desc lang="es">Trish, que se encuentra sola en la cabaña y la están atacando, recibe de repente la ayuda de un extraño ser que se hace llamar Spicy Lady, su propio Stand.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190406</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.24.0/1</episode-num><episode-num system="onscreen">S04E25</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
