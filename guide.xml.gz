<programme start="20261113214000 +0000" stop="20261113220500 +0000" channel="Yu-Gi-Oh"><title lang="es">Yu-Gi-Oh!</title><sub-title lang="es">Mi enemiga Valentin, segunda parte</sub-title><desc lang="es">¡Aprovechando el Sello de Orichalcos, Mai coordina a sus Damas Harpie para reducir las fuerzas de Joey a la basura! ¿Es esto lo último que veremos de él, o un guardián legendario reconocerá a Joey como un verdadero duelista?</desc><credits><actor>Tea Gardner</actor><actor>Joey Wheeler</actor><actor>Yugi Muto</actor></credits><date>20040102</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.8.0/1</episode-num><episode-num system="onscreen">S04E09</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f19972aefe562001369966c/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
