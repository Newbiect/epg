<programme start="20261031193000 +0000" stop="20261031203000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Grissom contra el volcán</sub-title><desc lang="es">El sheriff está sometido a presiones políticas para que descubra quién mató a un comisario aéreo con un coche bomba del que el sheriff fue testigo.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20031211</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">3.8.0/1</episode-num><episode-num system="onscreen">S04E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031203000 +0000" stop="20261031213000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Acceso de furia</sub-title><desc lang="es">Un adolescente aparece asesinado en una obra en construcción. Grissom, Sara y Warrick siguen la pista de la sangre en un martillo.</desc><credits><actor>Robert Hall</actor><actor>Wallace Langham</actor><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Jorja Fox</actor></credits><date>20031218</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">3.9.0/1</episode-num><episode-num system="onscreen">S04E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031213000 +0000" stop="20261031223000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Miembros furiosos de un jurado</sub-title><desc lang="es">El único miembro del jurado que se resistía a votar aparece muerto en la sala del jurado. Los once jurados que votaban culpable y que odiaban al jurado muerto son los sospechosos naturales.</desc><credits><actor>Robert Hall</actor><actor>Wallace Langham</actor><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Jorja Fox</actor></credits><date>20040108</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">3.10.0/1</episode-num><episode-num system="onscreen">S04E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
