<programme start="20261108193100 +0000" stop="20261108202300 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">La Serpiente</sub-title><desc lang="es">Consiguen lanzar una misión para rellenar los suministros de agua de &quot;El Rancho&quot;. Para ello, tratarán de buscar la ayuda en otras comunidades.</desc><credits><director>Josef Wladyka</director><actor>Kim Dickens</actor><actor>Cliff Curtis</actor><actor>Frank Dillane</actor><actor>Alycia Debnam-Carey</actor><actor>Elizabeth Rodriguez</actor><actor>Mercedes Mason</actor><actor>Ruben Blades</actor><actor>Lorenzo Henrie</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Daniel Sharman</actor><actor>Sam Underwood</actor><actor>Lisandra Tena</actor><actor>Michael Greyeyes</actor><actor>Jesse Borrego</actor></credits><date>20170917</date><episode-num system="xmltv_ns">2.10.0/1</episode-num><episode-num system="onscreen">S03E11</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/2c4b428e5207fa810c346897b49870d4576e2949.jpg"/></programme>
<programme start="20261108202300 +0000" stop="20261108211300 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Guardián del hermano</sub-title><desc lang="es">Nick y Jake tienen que lidiar con una situación delicada. El Rancho se prepara para afrontar la peor amenaza contra la que ha combatido hasta el momento.</desc><credits><director>Alrick Riley</director><actor>Kim Dickens</actor><actor>Cliff Curtis</actor><actor>Frank Dillane</actor><actor>Alycia Debnam-Carey</actor><actor>Elizabeth Rodriguez</actor><actor>Mercedes Mason</actor><actor>Ruben Blades</actor><actor>Lorenzo Henrie</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Daniel Sharman</actor><actor>Sam Underwood</actor><actor>Lisandra Tena</actor><actor>Michael Freeman</actor><actor>Justin Rain</actor><actor>Kalani Queypo</actor><actor>Linda Gehringer</actor><actor>Luke Roberts</actor><actor>Matt Lasky</actor></credits><date>20170924</date><episode-num system="xmltv_ns">2.11.0/1</episode-num><episode-num system="onscreen">S03E12</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/5f0b1b3a6d322cb065167c759befcc5a8886591e.jpg"/></programme>
