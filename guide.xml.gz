<programme start="20261105120900 +0000" stop="20261105130100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Llamada del silencio</sub-title><desc lang="es">Gibbs y su equipo deben limpiar el nombre de un infante de marina anciano que confiesa haber asesinado a su mejor amigo hace casi 60 años.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">1.0.0/1</episode-num><episode-num system="onscreen">S02E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105130100 +0000" stop="20261105135100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Club de las buenas esposas</sub-title><desc lang="es">El equipo de NCIS investiga el hallazgo del cadáver en descomposición de una mujer. Estaba vestida de novia en una celda debajo de una vivienda militar abandonada.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">1.1.0/1</episode-num><episode-num system="onscreen">S02E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105135100 +0000" stop="20261105144300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">No ver el mal</sub-title><desc lang="es">Cuando la esposa y la hija ciega de nueve años de un capitán de la Marina son secuestradas, Gibbs y su equipo se enfrentan a un desafío único.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">1.2.0/1</episode-num><episode-num system="onscreen">S02E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105144300 +0000" stop="20261105153500 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Desaparecido</sub-title><desc lang="es">El equipo de NCIS investiga el hallazgo, en medio de unos cultivos, de un helicóptero de la Marina que funciona perfectamente.</desc><credits><actor>Mark Harmon</actor><actor>Sasha Alexander</actor><actor>David Mccallum</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">1.3.0/1</episode-num><episode-num system="onscreen">S02E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
