<programme start="20261025034600 +0000" stop="20261025041500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Vidas que desaparecen</sub-title><desc lang="es">Como sujetos de prueba van cayendo uno por uno, y Boruto intenta mantener a todos con vida.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221127</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.276.0/1</episode-num><episode-num system="onscreen">S18E277</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025041500 +0000" stop="20261025044400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El juego de las sillas</sub-title><desc lang="es">Mientras todos están exhaustos por los experimentos de Ouga, un sujeto de prueba habla de sus objetivos, lo que hace que todos los demás hablen sobre lo que quieren hacer si sobreviven.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221204</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.277.0/1</episode-num><episode-num system="onscreen">S18E278</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025044400 +0000" stop="20261025051300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El obstáculo: siete</sub-title><desc lang="es">Mientras Boruto y los demás son forzados a participar en los experimentos de Ouga, Sarada y su equipo investigan la desaparición de Boruto y descubren de la existencia de un individuo sospechoso.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221211</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.278.0/1</episode-num><episode-num system="onscreen">S18E279</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025051300 +0000" stop="20261025054200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Solución</sub-title><desc lang="es">Ignorando el peligro en el que está su vida, Boruto le dice a los demás sujetos de prueba que escapen mientras se encarga de la persona que podría estar trabajando con Ouga. Pero deciden quedarse a ayudar a Boruto a pelear con el sospechoso.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221218</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.279.0/1</episode-num><episode-num system="onscreen">S18E280</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025054200 +0000" stop="20261025061100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La octava verdad</sub-title><desc lang="es">Boruto vuelve a despertar para darse cuenta de que está en la primera sala. \&quot;No confíes en nada\&quot; son las palabras que dejó otro sujeto de prueba.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221225</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.280.0/1</episode-num><episode-num system="onscreen">S18E281</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025061100 +0000" stop="20261025064000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Historia de Sasuke: Infiltración</sub-title><desc lang="es">Naruto se enferma, y Sasuke va al Observatorio Tatar, un centro de detención en la tierra de Redaku, para intentar encontrar una cura.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230108</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">18.281.0/1</episode-num><episode-num system="onscreen">S19E282</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7a1d0bf777112241ea779/tile_1780325503224.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025064000 +0000" stop="20261025070900 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Suena un réquiem oscuro (Primera parte)</sub-title><desc lang="es">Mientras Emperor Crimson se lanza sobre Polnareff, la flecha alcanza a Silver Chariot. Los que están dentro del Coliseo caen en un sueño misterioso.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190615</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.33.0/1</episode-num><episode-num system="onscreen">S04E34</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025070900 +0000" stop="20261025073800 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Suena un réquiem oscuro (Segunda parte)</sub-title><desc lang="es">Como las almas de todos se han intercambiado, Mista y los demás deben recuperar la flecha antes de que Diavolo se apodere de ella.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190622</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.34.0/1</episode-num><episode-num system="onscreen">S04E35</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025073800 +0000" stop="20261025080700 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Diavolo resurge</sub-title><desc lang="es">Mientras Silver Chariot Requiem provoca que las entidades a su alrededor muten, Giorno deduce que el alma de Diavolo debe de estar poseyendo a uno de sus tripulantes.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190629</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.35.0/1</episode-num><episode-num system="onscreen">S04E36</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025080700 +0000" stop="20261025083600 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Rey de reyes</sub-title><desc lang="es">A pesar de sus esfuerzos, la flecha termina en manos de Diavolo. Pero justo antes de que el jefe pueda atravesar su propio Stand con ella, Bucciarati actúa.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190706</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.36.0/1</episode-num><episode-num system="onscreen">S04E37</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025083600 +0000" stop="20261025090500 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Golden Wind Requiem</sub-title><desc lang="es">El Stand de Giorno evoluciona a Golden Wind Requiem. Diavolo intenta anular sus ataques, pero una nueva y espeluznante realidad acecha al jefe de la mafia.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190729</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.37.0/1</episode-num><episode-num system="onscreen">S04E38</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025090500 +0000" stop="20261025093400 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Los esclavos durmientes</sub-title><desc lang="es">Mientras investiga el misterio del sospechoso suicidio de la hija del florista, Mista se encuentra cara a cara con una usuaria de Stand llamada Scolippi.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190729</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.38.0/1</episode-num><episode-num system="onscreen">S04E39</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025093400 +0000" stop="20261025100300 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Dio el invasor</sub-title><desc lang="es">Tras la muerte de su padre, Dio Brando es adoptado por una familia de aristócratas y, en secreto, jura arrebatarle todo al heredero: Jonathan “JoJo” Joestar.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121005</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025100300 +0000" stop="20261025103200 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Una carta del pasado</sub-title><desc lang="es">Cuando va a Londres a investigar las sospechas de que Dio envenenó a su padre, JoJo conoce al matón callejero Speedwagon.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121012</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025103200 +0000" stop="20261025110300 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Juventud con Dio</sub-title><desc lang="es">JoJo le da el antídoto a su padre y se enfrenta a Dio, que lo ataca con un cuchillo y usa los poderes de máscara de piedra ensangrentada.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121019</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025110300 +0000" stop="20261025113200 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Quinta marcha</sub-title><desc lang="es">JoJo se reúne con su primer amor, Erina. Un hombre llamado Will A. Zeppeli le muestra a JoJo su poder y le dice que tiene que destruir la máscara de piedra.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121026</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025113200 +0000" stop="20261025120100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Los caballeros oscuros</sub-title><desc lang="es">Dio y una horda de zombis tienden una emboscada a JoJo y a sus acompañantes después de que un niño llamado Poco los llevase hasta un cementerio.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121102</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025120100 +0000" stop="20261025123000 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El coraje del mañana</sub-title><desc lang="es">El legendario caballero resucitado Bruford recupera su alma humana y confía su espada a JoJo. Tarkus ataca a JoJo con su poder aplastante.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121109</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.5.0/1</episode-num><episode-num system="onscreen">S01E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025123000 +0000" stop="20261025125900 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El sucesor afligido</sub-title><desc lang="es">Zeppeli se enfrenta a Tarkus, a pesar de sus pocas posibilidades. Como último recurso, usa la fuerza que le queda para traspasar sus poderes a su sucesor: JoJo.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121116</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.6.0/1</episode-num><episode-num system="onscreen">S01E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025125900 +0000" stop="20261025132800 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">¡Batalla sangrienta! JoJo y Dio</sub-title><desc lang="es">JoJo rescata a la hermana de Poco, pero Dio elimina a Dire, el amigo de Zeppeli. Con la espada de Bruford en las manos, JoJo se enfrenta a Dio una vez más.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121123</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.7.0/1</episode-num><episode-num system="onscreen">S01E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025132800 +0000" stop="20261025135700 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">¡El Hamon final!</sub-title><desc lang="es">JoJo y Erina pasan la luna de miel en un crucero. Para sorpresa de JoJo, uno de los sirvientes de Dio también está en el barco.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121130</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.8.0/1</episode-num><episode-num system="onscreen">S01E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025135700 +0000" stop="20261025142600 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El JoJo de Nueva York</sub-title><desc lang="es">En 1938 se descubren muchas máscaras de piedra en unas ruinas de México. Mientras tanto, el nieto de JoJo, Joseph, ayuda al joven Smokey en Nueva York.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121207</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.9.0/1</episode-num><episode-num system="onscreen">S01E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025142600 +0000" stop="20261025145500 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El Maestro del juego</sub-title><desc lang="es">Joseph lucha contra Straizo, que se convirtió en vampiro tras traicionar a su amigo Speedwagon. Después de la batalla, Straizo avisa del peligro de los hombres del pilar.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121214</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.10.0/1</episode-num><episode-num system="onscreen">S01E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025145500 +0000" stop="20261025152400 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El Hombre del Pilar</sub-title><desc lang="es">Un secuaz de Stroheim ataca a Joseph en México. Mientras tanto, Stroheim intenta despertar a Santana, uno de los hombres del pilar.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121221</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.11.0/1</episode-num><episode-num system="onscreen">S01E12</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025152400 +0000" stop="20261025155300 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">JoJo contra la forma de vida definitiva</sub-title><desc lang="es">Joseph usa su poder para escapar del cuerpo de Santana. Cuando falla, intenta exponerlo a la luz solar.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130104</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.12.0/1</episode-num><episode-num system="onscreen">S01E13</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025155300 +0000" stop="20261025162200 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Los guerreros definitivos de la antigüedad</sub-title><desc lang="es">Joseph y Speedwagon llegan a Roma. Allí, oyen hablar de los otros hombres del pilar y conocen a Caesar, el nieto de Zeppeli.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130111</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.13.0/1</episode-num><episode-num system="onscreen">S01E14</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025162200 +0000" stop="20261025165100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El requisito para ser un héroe</sub-title><desc lang="es">Wamuu, un hombre del pilar, hiere con facilidad a Caesar Zeppeli. Joseph revela su técnica secreta de reciente creación.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130118</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.14.0/1</episode-num><episode-num system="onscreen">S01E15</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025165100 +0000" stop="20261025172100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Lisa, Lisa, la maestra del Hamon</sub-title><desc lang="es">Caesar lleva a Joseph a Venecia y le presenta a su maestra Lisa Lisa, quien comienza a entrenarle con disciplina para que aprenda a controlar sus poderes.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130125</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.15.0/1</episode-num><episode-num system="onscreen">S01E16</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025172100 +0000" stop="20261025175100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Trampa sobre trampa</sub-title><desc lang="es">Lisa Lisa le cuenta a Joseph que, para destruir a los hombres del pilar, necesita la piedra Súper Aja. Joseph y Caesar se enfrentan a otros maestros con el mismo poder.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130201</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.16.0/1</episode-num><episode-num system="onscreen">S01E17</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025175100 +0000" stop="20261025182200 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El escuadrón de Stroheim contraataca</sub-title><desc lang="es">Joseph y Caesar combinan sus poderes para atacar al hombre del pilar que se apoderó del cuerpo de Suzi Q para robar la piedra roja de Aja.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130208</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.17.0/1</episode-num><episode-num system="onscreen">S01E18</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025182200 +0000" stop="20261025185100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Carrera al acantilado mortal</sub-title><desc lang="es">Stroheim empieza a luchar contra Kars con su nuevo cuerpo mecánico. Mientras tanto, Joseph y Kars se caen por un precipicio intentando conseguir la piedra roja.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130215</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.18.0/1</episode-num><episode-num system="onscreen">S01E19</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025185100 +0000" stop="20261025192100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">La solitaria juventud de Caesar</sub-title><desc lang="es">Caesar llega a la guarida del enemigo con un nuevo ataque, y Lisa Lisa le revela su pasado a Joseph.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130222</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.19.0/1</episode-num><episode-num system="onscreen">S01E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025192100 +0000" stop="20261025195100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Una estrategia de 2 contra 100</sub-title><desc lang="es">A Lisa Lisa se le ocurre un inteligente plan cuando Joseph y ella se encuentran a Wamuu y Kars esperándolos en el hotel con cientos de sus vampiros.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130301</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.20.0/1</episode-num><episode-num system="onscreen">S01E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025195100 +0000" stop="20261025202100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Un auténtico guerrero</sub-title><desc lang="es">Joseph y Wamuu empiezan su letal carrera de cuadrigas en un antiguo circo. A pesar de conseguir el arma primero, Joseph corre un grave peligro.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130308</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.21.0/1</episode-num><episode-num system="onscreen">S01E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025202100 +0000" stop="20261025205000 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El guerrero que regresa al viento</sub-title><desc lang="es">Joseph contrarresta el ataque final de Wamuu con la bandana de fuego de Caesar. Lisa Lisa reta a Kars a un duelo singular en las ruinas del templo.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130315</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.22.0/1</episode-num><episode-num system="onscreen">S01E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025205000 +0000" stop="20261025211900 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Los lazos que unen a Jojo</sub-title><desc lang="es">Joseph lucha por evitar la muerte de Lisa Lisa. Como consecuencia, Speedwagon revela los detalles del pasado de Lisa Lisa.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130322</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.23.0/1</episode-num><episode-num system="onscreen">S01E24</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025211900 +0000" stop="20261025214800 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El nacimiento de la forma de vida definitiva</sub-title><desc lang="es">La piedra roja hace a Kars prácticamente invencible. Joseph va a un volcán para atraer a Kars a una muerte segura.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130329</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.24.0/1</episode-num><episode-num system="onscreen">S01E25</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025214800 +0000" stop="20261025221700 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El hombre que se convirtió en dios</sub-title><desc lang="es">Kars surge de la lava y le raja el brazo a Joseph. Joseph, por instinto, levanta la piedra roja mientras recibe el golpe final de Kars.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130405</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.25.0/1</episode-num><episode-num system="onscreen">S01E26</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025221700 +0000" stop="20261025224600 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El hombre poseído por un espíritu maligno</sub-title><desc lang="es">En 1987 Joseph viaja a Japón tras enterarse de que su nieto Jotaro afirma estar poseído por espíritus malignos y se niega a salir del calabozo en el que está retenido.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140404</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.0.0/1</episode-num><episode-num system="onscreen">S02E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025224600 +0000" stop="20261025231500 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">¡¿Quién será el juez?!</sub-title><desc lang="es">Jotaro recobra su vida normal, pero esconde un poder sobrenatural al que su abuelo llama Stand. El día que alguien le ataca de camino a la escuela, conoce a Kakyoin.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140411</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.1.0/1</episode-num><episode-num system="onscreen">S02E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025231500 +0000" stop="20261025234400 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">La maldición de DIO</sub-title><desc lang="es">Jotaro ignora las protestas de Joseph e intenta usar su Stand para eliminar el dispositivo de control mental implantado por Dio en el cerebro de Kakyoin.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140418</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.2.0/1</episode-num><episode-num system="onscreen">S02E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025234400 +0000" stop="20261026001300 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Tower of Gray</sub-title><desc lang="es">Kakyoin se enfrenta a un Stand sin conocer a su usuario mientras Jotaro y su equipo se encuentran con uno de los matones de Dio en el vuelo a Egipto.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140425</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.3.0/1</episode-num><episode-num system="onscreen">S02E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
