<programme start="20261110165700 +0000" stop="20261110175100 +0000" channel="AMC en español"><title lang="es">The Son</title><sub-title lang="es">Numunuu</sub-title><desc lang="es">En 1852, el joven Eli lidera un asalto comanche en México. Por otro lado, en 1915, la familia McCullough debe enfrentar una amenaza a su compañía.</desc><credits><director>Kevin Dowling</director><actor>Pierce Brosnan</actor><actor>Jacob Lofland</actor><actor>Sydney Lucas</actor><actor>David Barnes</actor><actor>Jess Weixler</actor><actor>Henry Garrett</actor><actor>Elizabeth Frances</actor><actor>Paola Núñez</actor><actor>Carlos Bardem</actor><actor>James Parks</actor><actor>Zahn McClarnon</actor><actor>Shane Graham</actor><actor>David Sullivan</actor><actor>Alex Hernandez</actor><actor>Duke Roberts</actor><actor>Caleb Burgess</actor><actor>Lois Smith</actor></credits><date>20190427</date><episode-num system="xmltv_ns">1.0.0/1</episode-num><episode-num system="onscreen">S02E01</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/cms/images/d0c2f10f19e84fc172b0669762149b4d88449707.jpg"/></programme>
