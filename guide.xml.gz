<programme start="20261020230100 +0000" stop="20261020233000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Compañero</sub-title><desc lang="es">Naruto y los demás están exhaustos por la batalla contra Isshiki. Momoshiki toma el control de la conciencia de Boruto y se muestra frente a ellos como un enemigo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211003</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.217.0/1</episode-num><episode-num system="onscreen">S14E218</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020233000 +0000" stop="20261020235900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Regreso</sub-title><desc lang="es">Al finalizar la batalla contra Isshiki, Boruto y los demás regresan a la aldea. Gracias a su trabajo, la aldea se mantuvo a salvo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211010</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.218.0/1</episode-num><episode-num system="onscreen">S14E219</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020235900 +0000" stop="20261021002800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Tiempo que Queda</sub-title><desc lang="es">Aquellos con el Karma comienzan a perder el control de su mente y cuerpo mientras pasan por la Otsutsukificación.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211017</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.219.0/1</episode-num><episode-num system="onscreen">S14E220</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021002800 +0000" stop="20261021005700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Regreso de los Exámenes Chunin</sub-title><desc lang="es">Naruto propone que se celebre el Examen Chunin para levantar la moral tras el ataque de Isshiki.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211024</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.220.0/1</episode-num><episode-num system="onscreen">S15E221</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021005700 +0000" stop="20261021012600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Noche Antes de la Ronda Final</sub-title><desc lang="es">Se anuncia la ronda final del Examen Chunin. Muchos de los compañeros de Boruto que no pasaron a la ronda final del último examen lo han conseguido esta vez.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211031</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.221.0/1</episode-num><episode-num system="onscreen">S15E222</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021012600 +0000" stop="20261021015500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Inojin contra Houki</sub-title><desc lang="es">La ronda final de los exámenes por fin ha comenzado. El primer duelo es Inojin contra Houki. El equipo de Houki ha estado participando en las misiones de cazadores especiales ANBU.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211107</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.222.0/1</episode-num><episode-num system="onscreen">S15E223</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021015500 +0000" stop="20261021022400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Leyenda del Gato Monstruo</sub-title><desc lang="es">El siguiente combate de las rondas finales es entre Iwabe y Wasabi.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211114</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.223.0/1</episode-num><episode-num system="onscreen">S15E224</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021022400 +0000" stop="20261021025300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Enfrentamiento entre Mejores Amigas</sub-title><desc lang="es">Comienza el combate entre Sarada y Cho-Cho. Kawaki fue invitado por Naruto para observar, así como Shinki y otros que han venido de la Aldea Escondida de la Arena.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211121</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.224.0/1</episode-num><episode-num system="onscreen">S15E225</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021025300 +0000" stop="20261021032200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Samurái contra Ciencia</sub-title><desc lang="es">Uno después de otro, los ganadores de las finales se deciden. Solo quedan un par de encuentros, pero Boruto y Mitsuki aun no han llegado a los exámenes.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211128</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.225.0/1</episode-num><episode-num system="onscreen">S15E226</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021032200 +0000" stop="20261021035100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¿¡La Última Misión del Equipo Siete!?</sub-title><desc lang="es">Al equipo siete, con Sarada como capitana, se le asigna una misión. Mirai, que fue a una misión con Konohamaru, regresa a la aldea gravemente herida.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211205</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.226.0/1</episode-num><episode-num system="onscreen">S15E227</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021035100 +0000" stop="20261021042000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Camino de Kawaki para Convertirse en Ninja</sub-title><desc lang="es">Para que Kawaki pueda convertirse en genin, se decide que tome un examen especial que es diferente de los que se toman en la Academia Ninja.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211212</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.227.0/1</episode-num><episode-num system="onscreen">S16E228</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021042000 +0000" stop="20261021044900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Incumplimiento de Órdenes</sub-title><desc lang="es">Kawaki comienza a pensar que ser un genin no es para él.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211219</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.228.0/1</episode-num><episode-num system="onscreen">S16E229</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021044900 +0000" stop="20261021051800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Un Deseo</sub-title><desc lang="es">Cho-Cho es herida por el ataque de un ninja misterioso y el objeto que Mozuku ha estado guardando es robado.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211226</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.229.0/1</episode-num><episode-num system="onscreen">S16E230</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021051800 +0000" stop="20261021054700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Espada Oxidada</sub-title><desc lang="es">Unos feroces ladrones atacan a unos mercaderes ambulantes. Wasabi, Namida y Tsubaki, del Equipo 15, son enviadas al lugar del incidente para investigar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220109</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.230.0/1</episode-num><episode-num system="onscreen">S16E231</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021054700 +0000" stop="20261021061600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Primera Misión del Capitán Denki</sub-title><desc lang="es">Con Denki como capitán, al Equipo 5 se le asigna la misión de transportar títeres automatizados con fines mineros a una isla de la Tierra del Agua.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220116</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.231.0/1</episode-num><episode-num system="onscreen">S16E232</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021061600 +0000" stop="20261021064500 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Suma Sacerdotisa, parte 1</sub-title><desc lang="es">Jotaro y el grupo se dirigen a Egipto en submarino con la intención de enfrentarse a Dio. Cuando están a punto de llegar, una taza de café sufre una transformación.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140905</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.22.0/1</episode-num><episode-num system="onscreen">S02E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021064500 +0000" stop="20261021071400 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Suma Sacerdotisa, parte 2</sub-title><desc lang="es">Jotaro y su tripulación encuentran lo que parecen dos túneles subacuáticos tras evacuar su propio submarino para huir de un Stand enemigo que cambia de forma.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140912</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.23.0/1</episode-num><episode-num system="onscreen">S02E24</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021071400 +0000" stop="20261021074300 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Iggy de The Fool y N&apos;Doul de Geb, parte 1</sub-title><desc lang="es">Al llegar a Egipto, un helicóptero está esperando a Jotaro y su equipo. Sin embargo, el ayudante que Joseph había solicitado no parece estar en la aeronave.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150109</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.24.0/1</episode-num><episode-num system="onscreen">S02E25</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021074300 +0000" stop="20261021081200 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Iggy de The Fool y N’Doul de Geb, parte 2</sub-title><desc lang="es">Avdol diseña un plan para contrarrestar los ataques del Stand de agua, pero el enemigo se les adelanta. Mientras, el supuesto ayudante se queda dormido durante la pelea.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150116</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.25.0/1</episode-num><episode-num system="onscreen">S02E26</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021081200 +0000" stop="20261021084200 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Oingo de Jnum y Boingo de Thot</sub-title><desc lang="es">Kakyoin y Avdol buscan tratamiento médico mientras el resto de los hombres entra sin darse cuenta en un bar donde les esperan dos hermanos usuarios de Stand.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150123</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.26.0/1</episode-num><episode-num system="onscreen">S02E27</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021084200 +0000" stop="20261021091100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Anubis, parte 1</sub-title><desc lang="es">Tras encontrar una misteriosa espada, al joven Chaka se le transforma la personalidad. Entretanto, Jotaro y el grupo ponen rumbo a El Cairo.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150130</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.27.0/1</episode-num><episode-num system="onscreen">S02E28</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021091100 +0000" stop="20261021094000 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Anubis, parte 2</sub-title><desc lang="es">Al ser atacado por su barbero, Polnareff se da cuenta de que la espada de Chaka es un Stand y de que desde el último combate su poder ha ido en aumento.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150206</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.28.0/1</episode-num><episode-num system="onscreen">S02E29</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021094000 +0000" stop="20261021100900 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Mariah de Bastet, parte 1</sub-title><desc lang="es">Cuando Jotaro y el equipo llegan a Lúxor, Joseph recibe una descarga al tocar una extraña piedra que lleva incrustada una toma de corriente eléctrica.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150213</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.29.0/1</episode-num><episode-num system="onscreen">S02E30</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021100900 +0000" stop="20261021103800 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Mariah de Bastet, parte 2</sub-title><desc lang="es">Joseph y Avdol se quedan atrapados juntos por culpa de un Stand enemigo. Cuando finalmente logran separarse, los pies se les quedan enganchados en las vías del tren.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150220</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.30.0/1</episode-num><episode-num system="onscreen">S02E31</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021103800 +0000" stop="20261021110700 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Alessi de Seth, parte 1</sub-title><desc lang="es">Después de haber intentado sin éxito dar caza a un hombre que lo perseguía, Polnareff se da cuenta de que sus zapatos son varias tallas más grandes de lo que deberían.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150227</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.31.0/1</episode-num><episode-num system="onscreen">S02E32</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021110700 +0000" stop="20261021113600 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Alessi de Seth, parte 2</sub-title><desc lang="es">Polnareff debe pelear con su pequeño Stand contra Alessi, un usuario de Stand mucho más joven. Cuando las cosas se ponen feas, Polnareff recurre a lo inimaginable.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150306</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.32.0/1</episode-num><episode-num system="onscreen">S02E33</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021113600 +0000" stop="20261021120500 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">D’Arby el apostador, parte 1</sub-title><desc lang="es">Jotaro y su equipo llegan finalmente a El Cairo. Allí conocen a un hombre que afirma saber dónde está la mansión de Dio, pero la información no les va a salir gratis.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150313</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.33.0/1</episode-num><episode-num system="onscreen">S02E34</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021120500 +0000" stop="20261021123400 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">D’Arby el apostador, parte 2</sub-title><desc lang="es">Jotaro hace gala de sus habilidades como Stand para poner sobre aviso a quien tenga intención de hacer trampas en la partida de póquer en la que va a participar.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150320</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.34.0/1</episode-num><episode-num system="onscreen">S02E35</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021123400 +0000" stop="20261021130300 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Hol Horse y Mondatta, parte 1</sub-title><desc lang="es">Hol Horse llega al aeropuerto de El Cairo con la orden de matar a Jotaro y su equipo. Dentro de su maleta se oculta su nuevo e indeseado compañero.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150327</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.35.0/1</episode-num><episode-num system="onscreen">S02E36</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021130300 +0000" stop="20261021133200 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Hol Horse y Mondatta, parte 2</sub-title><desc lang="es">Hol Horse cumple todo lo que anuncia la profecía del libro. Sin embargo, cuando Jotaro y su grupo se presentan en la escena, le asaltan las dudas.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150403</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.36.0/1</episode-num><episode-num system="onscreen">S02E37</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021133200 +0000" stop="20261021140100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Pet Shop, el guardián del infierno, parte 1</sub-title><desc lang="es">En El Cairo, Avdol busca información en la mansión de Dio. Mientras pasea por la ciudad, Iggy tiene que defenderse de dos perros peligrosos.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150410</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.37.0/1</episode-num><episode-num system="onscreen">S02E38</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021140100 +0000" stop="20261021143000 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Pet Shop, el guardián del infierno, parte 2</sub-title><desc lang="es">Iggy tiene que huir por el río después de resultar gravemente herido en un enfrentamiento contra Pet Shop, que no tiene intenciones de parar.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150417</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.38.0/1</episode-num><episode-num system="onscreen">S02E39</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021143000 +0000" stop="20261021145900 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">D’Arby el jugador, parte 1</sub-title><desc lang="es">En la mansión de Dio, el mayordomo D’Arby, que dice ser el hermano de menor de D&apos;Arby el Apostador, sale a recibir a Jotaro y su equipo.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150424</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.39.0/1</episode-num><episode-num system="onscreen">S02E40</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021145900 +0000" stop="20261021152800 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">D’Arby el jugador, parte 2</sub-title><desc lang="es">Kakyoin pierde su alma en una carrera contra D’Arby. Cuando a Jotaro le toca el turno, regaña a Joseph y selecciona un juego que el mayordomo domina.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150501</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.40.0/1</episode-num><episode-num system="onscreen">S02E41</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021152800 +0000" stop="20261021155700 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Cool Ice, el misma del vacío, parte 1</sub-title><desc lang="es">A D’Arby le resultan raras las declaraciones de Jotaro, pero su Stand le ayuda a no perder la confianza. Entretanto, Avdol y los demás entran en la mansión.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150508</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.41.0/1</episode-num><episode-num system="onscreen">S02E42</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021155700 +0000" stop="20261021162600 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Cool Ice, el misma del vacío, parte 2</sub-title><desc lang="es">Polnareff e Iggy siguen adelante con el plan de destruir a Dio, pero la monstruosa Vanilla Ice les ataca por sorpresa.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150515</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.42.0/1</episode-num><episode-num system="onscreen">S02E43</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021162600 +0000" stop="20261021165500 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Cool Ice, el misma del vacío, parte 3</sub-title><desc lang="es">Iggy, mortalmente herido, hace acopio de fuerzas para salvar a Polnareff. Finalmente, Polnareff logra acuchillar a Vanilla Ice en la cabeza.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150522</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.43.0/1</episode-num><episode-num system="onscreen">S02E44</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021165500 +0000" stop="20261021172400 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">The World de Dio, parte 1</sub-title><desc lang="es">Polnareff logra por fin enfrentarse a Dio, pero una razón desconocida le impide acercarse. Para lograr vencerlo tendrá que liberar su propio Stand.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150529</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.44.0/1</episode-num><episode-num system="onscreen">S02E45</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021172400 +0000" stop="20261021175300 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">The World de Dio, parte 2</sub-title><desc lang="es">Kakyoin tiende una serie de trampas para desenmascarar la identidad del Stand de Dio. Hierophant Green ataca a Dio con toda su munición cuando este pica el cebo.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150605</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.45.0/1</episode-num><episode-num system="onscreen">S02E46</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021175300 +0000" stop="20261021182200 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">The World de Dio, parte 3</sub-title><desc lang="es">Dio para el tiempo con su Stand. Cuando está a punto de asestar el golpe definitivo, se da cuenta de que Jotaro está moviendo los dedos a pesar de estar inmovilizado.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150612</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.46.0/1</episode-num><episode-num system="onscreen">S02E47</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021182200 +0000" stop="20261021185200 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Adiós al largo viaje, amigos míos</sub-title><desc lang="es">Dio observa el cuerpo inerte de Joseph. Un Jotaro enfurecido se enfrenta a Dio, totalmente recuperado, para la gran batalla en el mundo donde se ha detenido el tiempo.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20150619</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.47.0/1</episode-num><episode-num system="onscreen">S02E48</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021185200 +0000" stop="20261021192100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">¡Jotaro Kujo conoce a Josuke Higashikata!</sub-title><desc lang="es">Jotaro Kujo se dirige a la ciudad de Morioh en busca de Josuke Higashikata. Cuando lo encuentra, ve a Josuke disculpándose ante unos matones.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20160401</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.0.0/1</episode-num><episode-num system="onscreen">S03E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021192100 +0000" stop="20261021195000 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">¡Josuke Higashikata conoce a Angelo!</sub-title><desc lang="es">El Stand de Angelo puede meterse dentro de otras personas. Justo después de que Jotaro le aconseje no consumir nada, Josuke sorprende a su madre tomando un sorbo de café.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20160408</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.1.0/1</episode-num><episode-num system="onscreen">S03E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021195000 +0000" stop="20261021201900 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Los hermanos Nijimura parte 1</sub-title><desc lang="es">Con la intención de proteger su pueblo, Jotaro busca el misterioso arco y la flecha que activaron el Stand de Angelo para destruirlos.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20160415</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.2.0/1</episode-num><episode-num system="onscreen">S03E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021201900 +0000" stop="20261021204800 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Los hermanos Nijimura parte 2</sub-title><desc lang="es">Para salvar a Koichi, Josuke va a casa de Okuyasu, pero es víctima de un ataque por parte de Keicho, el hermano de Okuyasu. Josuke intenta hacer un trato con Okuyasu.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20160422</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.3.0/1</episode-num><episode-num system="onscreen">S03E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021204800 +0000" stop="20261021211700 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Los hermanos Nijimura parte 3</sub-title><desc lang="es">Josuke y Koichi deciden ir en busca del arco y la flecha para destruirlos e impedir que haya más víctimas. Al encontrarlos en el desván, oyen un sonido escalofriante.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20160429</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.4.0/1</episode-num><episode-num system="onscreen">S03E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021211700 +0000" stop="20261021214600 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Koichi Hirose (Reverb)</sub-title><desc lang="es">De camino a la escuela, Koichi atropella a un gato con la bicicleta. Un hombre es testigo del accidente e intenta chantajear a Koichi para que pague el entierro.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20160506</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.5.0/1</episode-num><episode-num system="onscreen">S03E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021214600 +0000" stop="20261021221500 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Toshikazu Hazamada (Show Off)</sub-title><desc lang="es">Josuke y Koichi encuentran un muñeco de madera en la taquilla de su compañero de clase Toshikazu Hazamada al que investigan para saber si usa un Stand.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20160513</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.6.0/1</episode-num><episode-num system="onscreen">S03E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021221500 +0000" stop="20261021224400 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Yukako Yamagishi se enamora parte 1</sub-title><desc lang="es">Yukako Yamagishi le confiesa a Koichi que está enamorada de él. Él está encantado, pero el amor de la chica resulta excesivo y esta se acaba pasando de la raya.</desc><credits><actor>Daisuke Ono</actor><actor>Yuki Kaji</actor><actor>Yuki Ono</actor><actor>Takahiro Sakurai</actor></credits><date>20160520</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">2.7.0/1</episode-num><episode-num system="onscreen">S03E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
