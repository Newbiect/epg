<programme start="20261015235500 +0000" stop="20261016004700 +0000" channel="Homeful"><title lang="es">Holmes &amp; Holmes</title><sub-title lang="es">Debates, decisiones, diseñador</sub-title><desc lang="es">Mike y MJ añaden un segundo piso a la casa de campo. Problemas estructurales peligrosos en la casa del río los obligan a derribar el techo y las paredes del segundo piso.</desc><category lang="es">Home &amp; Lifestyle</category><category lang="es">Home &amp; Lifestyle</category><episode-num system="xmltv_ns">1.2.0/1</episode-num><episode-num system="onscreen">S02E03</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/678991f0daa3470014062bcd/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261016004700 +0000" stop="20261016013900 +0000" channel="Homeful"><title lang="es">Holmes &amp; Holmes</title><sub-title lang="es">Aquí vamos de nuevo</sub-title><desc lang="es">Mike y MJ llegan a la casa del río, encuentran un río de lodo y se apresuran a cerrar la casa antes del invierno. Compran una nueva propiedad, pero Mike interrumpe su plan de renovación y presupuesto.</desc><category lang="es">Home &amp; Lifestyle</category><category lang="es">Home &amp; Lifestyle</category><episode-num system="xmltv_ns">1.6.0/1</episode-num><episode-num system="onscreen">S02E07</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/678991f0daa3470014062bcd/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
