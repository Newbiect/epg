<programme start="20261029220800 +0000" stop="20261029223700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Vidas que desaparecen</sub-title><desc lang="es">Como sujetos de prueba van cayendo uno por uno, y Boruto intenta mantener a todos con vida.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221127</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.276.0/1</episode-num><episode-num system="onscreen">S18E277</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261029223700 +0000" stop="20261029230600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El juego de las sillas</sub-title><desc lang="es">Mientras todos están exhaustos por los experimentos de Ouga, un sujeto de prueba habla de sus objetivos, lo que hace que todos los demás hablen sobre lo que quieren hacer si sobreviven.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221204</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.277.0/1</episode-num><episode-num system="onscreen">S18E278</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
