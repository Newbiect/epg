<programme start="20261119171600 +0000" stop="20261119181600 +0000" channel="AMC en español"><title lang="es">The Son</title><sub-title lang="es">First Son of Texas</sub-title><desc lang="es">Eli McCullough sobrevive a un ataque comanche en 1849, y en 1915, dirige el imperio de su familia a través de tiempos difíciles.</desc><credits><actor>Pierce Brosnan</actor><actor>Jacob Lofland</actor><actor>Sydney Lucas</actor><actor>David Barnes</actor><actor>Jess Weixler</actor><actor>Henry Garrett</actor><actor>Elizabeth Frances</actor><actor>Paola Núñez</actor><actor>Carlos Bardem</actor><actor>James Parks</actor><actor>Zahn McClarnon</actor></credits><date>20170529</date><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/cms/images/1e2272a9b9887503ea158751b4551f069f7ac10c.jpg"/></programme>
<programme start="20261119181600 +0000" stop="20261119190600 +0000" channel="AMC en español"><title lang="es">The Son</title><sub-title lang="es">The Plum Tree</sub-title><desc lang="es">El joven Eli aprende a vivir entre los Comanches; Eli y Pete discrepan sobre cómo responder a un ataque contra su casa.</desc><credits><director>Kevin Dowling</director><actor>Pierce Brosnan</actor><actor>Jacob Lofland</actor><actor>Sydney Lucas</actor><actor>David Barnes</actor><actor>Jess Weixler</actor><actor>Henry Garrett</actor><actor>Elizabeth Frances</actor><actor>Paola Núñez</actor><actor>Carlos Bardem</actor><actor>James Parks</actor><actor>Zahn McClarnon</actor><actor>Shane Graham</actor><actor>J. Johnson</actor><actor>Matthew Posey</actor></credits><date>20170529</date><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/cms/images/a4ff202c115cb89b8ac77f14b96e04694a11dcfd.jpg"/></programme>
<programme start="20261119190600 +0000" stop="20261119195800 +0000" channel="AMC en español"><title lang="es">The Son</title><sub-title lang="es">Second Empire</sub-title><desc lang="es">El joven Eli entrena como un guerrero, pero hace enemigos; Eli y Phineas luchan por ayudar a la familia en Austin; Pete se enfrenta a sus demonios.</desc><credits><actor>Pierce Brosnan</actor><actor>Jacob Lofland</actor><actor>Sydney Lucas</actor><actor>David Barnes</actor><actor>Jess Weixler</actor><actor>Henry Garrett</actor><actor>Elizabeth Frances</actor><actor>Paola Núñez</actor><actor>Carlos Bardem</actor><actor>James Parks</actor><actor>Zahn McClarnon</actor></credits><date>20170415</date><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/cms/images/de571acf778b36792782b157e4262c051fdb32d0.jpg"/></programme>
