<programme start="20261122212100 +0000" stop="20261122215000 +0000" channel="Hunter x Hunter"><title lang="es">Hunter x Hunter LT</title><sub-title lang="es">Búsqueda x Y x Persecución</sub-title><desc lang="es">Knuckle y Shoot están esperando a Cheetu, quien cambia de dirección y desaparece. Killua y Gon sienten que alguien los está siguiendo.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.53.0/1</episode-num><episode-num system="onscreen">S02E54</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64c3c440fdd8620013a4224f/tile_1769549762368.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261122215000 +0000" stop="20261122221900 +0000" channel="Hunter x Hunter"><title lang="es">Hunter x Hunter LT</title><sub-title lang="es">Ikalgo x Y x Relámpago</sub-title><desc lang="es">El asesino Ikalgo, una Hormiga Quimera tipo pulpo, ataca a Killua con sus habilidades Nen, pero es capturado.</desc><credits><actor>Susy Moreno</actor><actor>Verania Ortiz</actor><actor>Miguel De León</actor><actor>David Ramos</actor><actor>Gerardo Reyero</actor></credits><date>20131022</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.54.0/1</episode-num><episode-num system="onscreen">S02E55</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64c3c440fdd8620013a4224f/tile_1769549762368.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261122221900 +0000" stop="20261122224800 +0000" channel="Hunter x Hunter"><title lang="es">Hunter x Hunter LT</title><sub-title lang="es">Poder x Y x Juegos</sub-title><desc lang="es">Gon intenta vincularse con una Hormiga Quimera llamada Meleoron, a pesar de que es arriesgado para un usuario del Nen revelar sus habilidades.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.0.0/1</episode-num><episode-num system="onscreen">S03E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64c3c440fdd8620013a4224f/tile_1769549762368.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
