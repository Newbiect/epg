<programme start="20261029223700 +0000" stop="20261029230600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El juego de las sillas</sub-title><desc lang="es">Mientras todos están exhaustos por los experimentos de Ouga, un sujeto de prueba habla de sus objetivos, lo que hace que todos los demás hablen sobre lo que quieren hacer si sobreviven.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221204</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.277.0/1</episode-num><episode-num system="onscreen">S18E278</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261029230600 +0000" stop="20261029233500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El obstáculo: siete</sub-title><desc lang="es">Mientras Boruto y los demás son forzados a participar en los experimentos de Ouga, Sarada y su equipo investigan la desaparición de Boruto y descubren de la existencia de un individuo sospechoso.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221211</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.278.0/1</episode-num><episode-num system="onscreen">S18E279</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261029233500 +0000" stop="20261030000400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Solución</sub-title><desc lang="es">Ignorando el peligro en el que está su vida, Boruto le dice a los demás sujetos de prueba que escapen mientras se encarga de la persona que podría estar trabajando con Ouga. Pero deciden quedarse a ayudar a Boruto a pelear con el sospechoso.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221218</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.279.0/1</episode-num><episode-num system="onscreen">S18E280</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261030000400 +0000" stop="20261030003300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La octava verdad</sub-title><desc lang="es">Boruto vuelve a despertar para darse cuenta de que está en la primera sala. \&quot;No confíes en nada\&quot; son las palabras que dejó otro sujeto de prueba.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221225</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.280.0/1</episode-num><episode-num system="onscreen">S18E281</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261030003300 +0000" stop="20261030010200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Historia de Sasuke: Infiltración</sub-title><desc lang="es">Naruto se enferma, y Sasuke va al Observatorio Tatar, un centro de detención en la tierra de Redaku, para intentar encontrar una cura.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230108</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">18.281.0/1</episode-num><episode-num system="onscreen">S19E282</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7a1d0bf777112241ea779/tile_1780325503224.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261030010200 +0000" stop="20261030013100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Historia de Sasuke: Línea de Estrellas</sub-title><desc lang="es">Sasuke fue atacado por Meno, el guardian del Observatorio, y lo envenenó.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230115</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">18.282.0/1</episode-num><episode-num system="onscreen">S19E283</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7a1d0bf777112241ea779/tile_1780325503224.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261030013100 +0000" stop="20261030020000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Historia de Sasuke: El Secreto del Anexo</sub-title><desc lang="es">Al buscar la información relacionada con las Ultra Partículas, Sasuke revisa el anexo de la habitación de Zansul, el director del observatorio, mientras un mensajero del Primer Ministro los visita desde la capital.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230122</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">18.283.0/1</episode-num><episode-num system="onscreen">S19E284</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7a1d0bf777112241ea779/tile_1780325503224.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261030020000 +0000" stop="20261030022900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Historia de Sasuke: El Cielo que cayó a la Tierra</sub-title><desc lang="es">Sasuke y Sakura trabajan juntos para reunir información acerca de las Ultra Partículas.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230129</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">18.284.0/1</episode-num><episode-num system="onscreen">S19E285</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7a1d0bf777112241ea779/tile_1780325503224.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261030022900 +0000" stop="20261030025800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Historia de Sasuke: El anillo</sub-title><desc lang="es">Una gran cantidad de Bestias Dragón de pronto aparecen en el Observatorio, causadando caos.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230205</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">18.285.0/1</episode-num><episode-num system="onscreen">S19E286</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7a1d0bf777112241ea779/tile_1780325503224.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
