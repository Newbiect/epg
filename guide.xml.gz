<programme start="20261125100400 +0000" stop="20261125103400 +0000" channel="Death Note"><title lang="es">Death Note</title><sub-title lang="es">Confesión</sub-title><desc lang="es">Light viaja a Aoyama para descubrir la identidad de el segundo Kira antes de que L sospeche más, pero Misa Amane, la nueva Kira, usa su inusual don para encontrar a Light antes de que él la encuentre.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Horror</category><episode-num system="xmltv_ns">0.12.0/1</episode-num><episode-num system="onscreen">S01E13</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73a62fb16882001b38dec6/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
