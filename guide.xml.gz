<programme start="20261024014000 +0000" stop="20261024020900 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Mujer picante</sub-title><desc lang="es">Trish, que se encuentra sola en la cabaña y la están atacando, recibe de repente la ayuda de un extraño ser que se hace llamar Spicy Lady, su propio Stand.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190406</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.24.0/1</episode-num><episode-num system="onscreen">S04E25</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
