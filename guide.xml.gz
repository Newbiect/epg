<programme start="20261114081400 +0000" stop="20261114084200 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Infierno de Hong Kong</sub-title><desc lang="es">Ryu, Ken y Chun Li intentan escapar del Palacio de Kowloon pero son atacados por un grupo de luchadores callejeros.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114084200 +0000" stop="20261114091000 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Un hombre llamado Dragón Volador</sub-title><desc lang="es">Después del incidente en el Palacio Kowloon, Ryu y los demás van a Hong Kong y terminan en una película producida por un amigo.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114091000 +0000" stop="20261114093800 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">El secreto de las Artes Marciales</sub-title><desc lang="es">Después de ayudar a un anciano moribundo, Ryu descubre la historia de una energía mística de Ki y descubre una nueva técnica de lucha.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.5.0/1</episode-num><episode-num system="onscreen">S01E06</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114093800 +0000" stop="20261114100600 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">La venganza de Ashura</sub-title><desc lang="es">Después de acechar y capturar a varios miembros de Ashura, el Capitán Dorai siente la ira de la organización criminal.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.6.0/1</episode-num><episode-num system="onscreen">S01E07</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114100600 +0000" stop="20261114103400 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">La sombra del terror</sub-title><desc lang="es">Ken y Ryu persiguen a Ashura a Tailandia, pero la caza se interrumpe cuando Ryu es arrestado por un cargo de posesión de drogas falsas.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.7.0/1</episode-num><episode-num system="onscreen">S01E08</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114103400 +0000" stop="20261114110200 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Karate contra Boxeo Tailandés</sub-title><desc lang="es">Encarcelado, Ryu se enfrenta a Sagat. Ken finalmente encuentra a la persona que incriminó a Ryu con las drogas</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.8.0/1</episode-num><episode-num system="onscreen">S01E09</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114110200 +0000" stop="20261114113000 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Antes del anochecer</sub-title><desc lang="es">Acompañados por el Capitán Dorai, Ryu y Ken deben luchar contra varios oponentes para llegar al líder de Ashura.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.9.0/1</episode-num><episode-num system="onscreen">S01E10</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114113000 +0000" stop="20261114115800 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Las garras de las fieras</sub-title><desc lang="es">Mientras viajan a lo largo del río Ganges, Ryu y Ken se encuentran con el místico Dhalsim, que se niega a enseñar el arte de Ki.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.10.0/1</episode-num><episode-num system="onscreen">S01E11</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114115800 +0000" stop="20261114122600 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">En la caverna del demonio</sub-title><desc lang="es">Después de que Dhalsim les indicó que se dirigieran al templo prohibido, Ryu y Ken encuentran dos estatuas aparentemente indestructibles.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.11.0/1</episode-num><episode-num system="onscreen">S01E12</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114122600 +0000" stop="20261114125400 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">En busca del karate Hadou</sub-title><desc lang="es">Dhalsim acepta enseñarle a Ryu y Ken una energía mística llamada Hadou, pero Ryu no puede controlar la energía y debe ingresar al templo una vez más.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.12.0/1</episode-num><episode-num system="onscreen">S01E13</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114125400 +0000" stop="20261114132200 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">El Príncipe Sanguinario</sub-title><desc lang="es">Viajando a Barcelona por un premio especial, Ryu, Ken y Chun-Li se encuentran con Vega, uno de los mejores toreros de España.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.13.0/1</episode-num><episode-num system="onscreen">S01E14</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114132200 +0000" stop="20261114135000 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Encuentro de Titanes</sub-title><desc lang="es">Mientras asiste a un misterioso baile formal en Barcelona, Ken se da cuenta de que la apariencia de Vega parece tener un efecto muy extraño en Chun-Li.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.14.0/1</episode-num><episode-num system="onscreen">S01E15</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114135000 +0000" stop="20261114141800 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">La máscara del Poderoso</sub-title><desc lang="es">Ken pierde su ventaja en la lucha contra Vega. El líder de la organización criminal Shadaloo revela su identidad.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.15.0/1</episode-num><episode-num system="onscreen">S01E16</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114141800 +0000" stop="20261114144600 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Los Tentáculos de la Muerte</sub-title><desc lang="es">Chun-Li se da cuenta de que ella y Ken están siendo engañados por Bison. Ella hace todo lo posible para detenerlo, pero sus ataques no parecen funcionar.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.16.0/1</episode-num><episode-num system="onscreen">S01E17</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114144600 +0000" stop="20261114151300 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Una Hermosa Asesina</sub-title><desc lang="es">Cuando Bison captura a Ken y Chun-Li y envía una nota de rescate, el padre de Ken envía a los pilotos de Guile y Nash Air Force para encontrarlos.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.17.0/1</episode-num><episode-num system="onscreen">S01E18</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114151300 +0000" stop="20261114154000 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Los Agentes Secreto</sub-title><desc lang="es">Guile y Nash buscan pistas sobre la desaparición de Ken en Barcelona. Bison envía al luchador ruso Zangief para capturar a Ryu.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.18.0/1</episode-num><episode-num system="onscreen">S01E19</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114154000 +0000" stop="20261114160700 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Hadou la fuerza preponderante del Cosmos</sub-title><desc lang="es">Debilitado, Ryu se ve obligado a luchar con Zangief. Cammy ataca al Capitán Dorai. Guile finalmente encuentra pistas en Barcelona.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.19.0/1</episode-num><episode-num system="onscreen">S01E20</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114160700 +0000" stop="20261114163500 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Los prisioneros del castillo</sub-title><desc lang="es">Guile y Nash planean infiltrarse en la isla donde se encuentra Ken. Bison se divierte con el nuevo dispositivo: un microchip que controla el pensamiento de las personas.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.20.0/1</episode-num><episode-num system="onscreen">S01E21</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114163500 +0000" stop="20261114170100 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">La manifestación del Hadou</sub-title><desc lang="es">Ryu usa Hadou para deshacerse de las cadenas y encontrar a sus amigos. Guile ve el talento de Ryu y decide involucrarse.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.21.0/1</episode-num><episode-num system="onscreen">S01E22</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114170100 +0000" stop="20261114172900 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">El brillo misterioso</sub-title><desc lang="es">Ken ve a Chun-Li matar a un soldado. Balrog es informado de que Dorai está muerto y envía a Cammy al hospital para confirmar.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.22.0/1</episode-num><episode-num system="onscreen">S01E23</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114172900 +0000" stop="20261114175700 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Al encuentro de una pesadilla</sub-title><desc lang="es">Bajo el control de Bison, Ryu entra en la arena de prueba. En la base, Guile y Nash deciden separarse para cubrir un área más grande.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.23.0/1</episode-num><episode-num system="onscreen">S01E24</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114175700 +0000" stop="20261114182500 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Una lucha violenta</sub-title><desc lang="es">Guile se enfrenta al poderoso Zangief. Fei-Long se enfrenta a Cammy en el hospital. Ryu se ve obligado a luchar contra Ken bajo el control de Bison.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.24.0/1</episode-num><episode-num system="onscreen">S01E25</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114182500 +0000" stop="20261114185300 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Grito último del amigo que muere</sub-title><desc lang="es">Zangief tiene una ventaja sobre Guile. Ken se ve obligado a defenderse contra Ryu. Cammy y Fei-Long continúan luchando en el hospital.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.25.0/1</episode-num><episode-num system="onscreen">S01E26</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
