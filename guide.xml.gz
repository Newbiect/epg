<programme start="20261031211800 +0000" stop="20261031221800 +0000" channel="The Walking Dead Channel"><title lang="es">The Walking Dead</title><sub-title lang="es">One More</sub-title><desc lang="es">With Maggie&apos;s map, Gabriel and Aaron search for food and supplies to bring back to Alexandria; checking out one more location, they chance upon a stash; faith is broken and optimism is fragmented when they are put to the ultimate test.</desc><credits><director>Laura Belsey</director><actor>Norman Reedus</actor><actor>Melissa McBride</actor><actor>Lauren Cohan</actor><actor>Jeffrey Dean Morgan</actor><actor>Cassady McClincy</actor><actor>Danai Gurira</actor><actor>Josh McDermitt</actor><actor>Christian Serratos</actor><actor>Seth Gilliam</actor><actor>Ross Marquand</actor><actor>Khary Payton</actor><actor>Cooper Andrews</actor><actor>Avi Nash</actor><actor>Callan McAuliffe</actor><actor>Nadia Hilker</actor><actor>Eleanor Matsuura</actor><actor>Lauren Ridloff</actor><actor>Cailey Fleming</actor><actor>Samantha Morton</actor><actor>Ryan Hurst</actor><actor>Robert Patrick</actor></credits><date>20210314</date><episode-num system="xmltv_ns">9.18.0/1</episode-num><episode-num system="onscreen">S10E19</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/2357cc38b4b41e01b1cddeb374b3f94981bf226d.jpg"/></programme>
<programme start="20261031221800 +0000" stop="20261031230800 +0000" channel="The Walking Dead Channel"><title lang="es">The Walking Dead</title><sub-title lang="es">Splinter</sub-title><desc lang="es">Eugene, Ezekiel, Yumiko, and Princess are captured and separated by the mysterious troopers that surrounded them at the rail yard; claustrophobic with mounting anxiety, Princess struggles with memories of her traumatic past and plans to escape.</desc><credits><director>Laura Belsey</director><actor>Norman Reedus</actor><actor>Melissa McBride</actor><actor>Lauren Cohan</actor><actor>Jeffrey Dean Morgan</actor><actor>Cassady McClincy</actor><actor>Danai Gurira</actor><actor>Josh McDermitt</actor><actor>Christian Serratos</actor><actor>Seth Gilliam</actor><actor>Ross Marquand</actor><actor>Khary Payton</actor><actor>Cooper Andrews</actor><actor>Avi Nash</actor><actor>Callan McAuliffe</actor><actor>Nadia Hilker</actor><actor>Eleanor Matsuura</actor><actor>Lauren Ridloff</actor><actor>Cailey Fleming</actor><actor>Samantha Morton</actor><actor>Ryan Hurst</actor></credits><date>20210321</date><episode-num system="xmltv_ns">9.19.0/1</episode-num><episode-num system="onscreen">S10E20</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/405340e42dff562a6aeca73ccf050914fe1d8514.jpg"/></programme>
