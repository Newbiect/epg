<programme start="20261108211100 +0000" stop="20261108220600 +0000" channel="The Walking Dead Channel"><title lang="es">The Walking Dead</title><sub-title lang="es">Too Far Gone</sub-title><desc lang="es">Things finally begin to calm at the prison until Rick and the group face imminent danger when the Governor arrives with his forces.</desc><credits><director>Ernest Dickerson</director><actor>Andrew Lincoln</actor><actor>Norman Reedus</actor><actor>Steven Yeun</actor><actor>Lauren Cohan</actor><actor>Chandler Riggs</actor><actor>Danai Gurira</actor><actor>Melissa McBride</actor><actor>Scott Wilson</actor><actor>David Morrissey</actor><actor>Emily Kinney</actor><actor>Chad Coleman</actor><actor>Sonequa Martin-Green</actor><actor>Lawrence Gilliard Jr.</actor><actor>Audrey Marie Anderson</actor><actor>Kirk Acevedo</actor></credits><date>20131201</date><episode-num system="xmltv_ns">3.7.0/1</episode-num><episode-num system="onscreen">S04E08</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/ce4d5f34e631e1db2edd3c904bef4ea3d4b1f7fb.jpg"/></programme>
<programme start="20261108220600 +0000" stop="20261108225900 +0000" channel="The Walking Dead Channel"><title lang="es">The Walking Dead</title><sub-title lang="es">After</sub-title><desc lang="es">Rick and Carl look for shelter while Rick deals with old wounds; those left at the prison consider whether survival alone will be enough.</desc><credits><director>Greg Nicotero</director><actor>Andrew Lincoln</actor><actor>Norman Reedus</actor><actor>Steven Yeun</actor><actor>Lauren Cohan</actor><actor>Chandler Riggs</actor><actor>Danai Gurira</actor><actor>Melissa McBride</actor><actor>Scott Wilson</actor><actor>David Morrissey</actor><actor>Emily Kinney</actor><actor>Chad Coleman</actor><actor>Sonequa Martin-Green</actor><actor>Lawrence Gilliard Jr.</actor><actor>Aldis Hodge</actor><actor>Brandon Fobbs</actor></credits><date>20140209</date><episode-num system="xmltv_ns">3.8.0/1</episode-num><episode-num system="onscreen">S04E09</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/2e4ebe6f643ed49abc403522d556c3ae26691e34.jpg"/></programme>
<programme start="20261108225900 +0000" stop="20261108235300 +0000" channel="The Walking Dead Channel"><title lang="es">The Walking Dead</title><sub-title lang="es">Inmates</sub-title><desc lang="es">Beth remains hopeful, and she and Daryl search for other survivors of the Governor&apos;s attack; the now-divided group faces obstacles in their quest for safety.</desc><credits><director>Tricia Brock</director><actor>Andrew Lincoln</actor><actor>Norman Reedus</actor><actor>Steven Yeun</actor><actor>Lauren Cohan</actor><actor>Chandler Riggs</actor><actor>Danai Gurira</actor><actor>Melissa McBride</actor><actor>Scott Wilson</actor><actor>David Morrissey</actor><actor>Emily Kinney</actor><actor>Chad Coleman</actor><actor>Sonequa Martin-Green</actor><actor>Lawrence Gilliard Jr.</actor><actor>Alanna Masterson</actor><actor>Michael Cudlitz</actor><actor>Josh McDermitt</actor><actor>Christian Serratos</actor></credits><date>20140216</date><episode-num system="xmltv_ns">3.9.0/1</episode-num><episode-num system="onscreen">S04E10</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/ce09beedfff4367e1b0b3a1d0b31cbdbc9b2f4ab.jpg"/></programme>
<programme start="20261108235300 +0000" stop="20261109004900 +0000" channel="The Walking Dead Channel"><title lang="es">The Walking Dead</title><sub-title lang="es">Claimed</sub-title><desc lang="es">Rick faces a number of threats while Carl and Michonne look for supplies; Glenn and Tara meet strangers on an important mission; other group members deal with their pasts.</desc><credits><director>Seith Mann</director><actor>Andrew Lincoln</actor><actor>Norman Reedus</actor><actor>Steven Yeun</actor><actor>Lauren Cohan</actor><actor>Chandler Riggs</actor><actor>Danai Gurira</actor><actor>Melissa McBride</actor><actor>Scott Wilson</actor><actor>David Morrissey</actor><actor>Emily Kinney</actor><actor>Chad Coleman</actor><actor>Sonequa Martin-Green</actor><actor>Lawrence Gilliard Jr.</actor><actor>Alanna Masterson</actor><actor>Michael Cudlitz</actor><actor>Josh McDermitt</actor><actor>Christian Serratos</actor></credits><date>20140223</date><episode-num system="xmltv_ns">3.10.0/1</episode-num><episode-num system="onscreen">S04E11</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/de997464f12a2cea90d0147ee8dcd8b02f1633f9.jpg"/></programme>
<programme start="20261109004900 +0000" stop="20261109014600 +0000" channel="The Walking Dead Channel"><title lang="es">The Walking Dead</title><sub-title lang="es">Still</sub-title><desc lang="es">In the woods after fleeing the prison, Beth makes a request that sends her and Daryl on an enlightening mission.</desc><credits><director>Julius Ramsay</director><actor>Andrew Lincoln</actor><actor>Norman Reedus</actor><actor>Steven Yeun</actor><actor>Lauren Cohan</actor><actor>Chandler Riggs</actor><actor>Danai Gurira</actor><actor>Melissa McBride</actor><actor>Scott Wilson</actor><actor>David Morrissey</actor><actor>Emily Kinney</actor><actor>Chad Coleman</actor><actor>Sonequa Martin-Green</actor><actor>Lawrence Gilliard Jr.</actor></credits><date>20140302</date><episode-num system="xmltv_ns">3.11.0/1</episode-num><episode-num system="onscreen">S04E12</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/80b4a85a24ffed63863b5dd298114ff9389cd79f.jpg"/></programme>
