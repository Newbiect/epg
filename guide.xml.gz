<programme start="20261026222500 +0000" stop="20261026231500 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Un disparo, un muerto</sub-title><desc lang="es">El equipo investiga cuando un oficial de reclutamiento de la Marina es asesinado a tiros por un francotirador con rencor, quien deja una pluma blanca detrás.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.12.0/1</episode-num><episode-num system="onscreen">S01E13</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026231500 +0000" stop="20261027000600 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">El buen samaritano</sub-title><desc lang="es">El equipo investiga un asesinato con la ayuda de Charley, un sheriff local, cuando se enteran de casos similares: el de un empleado civil de la Marina y el de un piloto que estaba pasando por un desagradable divorcio.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.13.0/1</episode-num><episode-num system="onscreen">S01E14</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
