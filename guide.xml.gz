<programme start="20261105001400 +0000" stop="20261105004300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El caballo negro</sub-title><desc lang="es">Nankatsu e Hirado se baten por las semifinales del Torneo Nacional. Tsubasa enfrenta al poderoso Hiroshi Jito, capitán y defensa central de Hirado.</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20190114</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.40.0/1</episode-num><episode-num system="onscreen">S01E41</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105004300 +0000" stop="20261105011300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El fénix Tsubasa</sub-title><desc lang="es">Tras una aplastante desventaja, Tsubasa decide arriesgarlo todo: intentará el famoso tiro con efecto de Roberto por la oportunidad de ganar.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190121</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.41.0/1</episode-num><episode-num system="onscreen">S01E42</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105011300 +0000" stop="20261105014300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El tigre caído</sub-title><desc lang="es">En las semifinales del Torneo, los primeros en batirse son Meiwa y Toho. Con Hyuga en el banco, Meiwa saca ventaja, haciendo sufrir a Takeshi Sawada.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190128</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.42.0/1</episode-num><episode-num system="onscreen">S01E43</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
