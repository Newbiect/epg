<programme start="20261024200000 +0000" stop="20261024210000 +0000" channel="Todo Drama"><title lang="es">La tierra prometida</title><sub-title lang="es">La llegada</sub-title><desc lang="es">La gente comienza a pelear en Jericó por agua y comida. Marek ve con terror cómo las murallas de su pueblo caen.</desc><credits><director>Alexandre Avancini</director><actor>Sidney Sampaio</actor><actor>Thaís Melchior</actor><actor>Paloma Bernardi</actor><actor>Cristiana Oliveira</actor><actor>Kadu Moliterno</actor><actor>Leonardo Miggiorin</actor><actor>Nívea Stelmann</actor><actor>Marcos Winter</actor><actor>Juliana Silveira</actor><actor>Beth Goulart</actor><actor>Luciana Braga</actor><actor>Raymundo Souza</actor><actor>Ricky Tavares</actor><actor>Ana Barroso</actor></credits><date>20261024</date><episode-num system="xmltv_ns">0.68.0/1</episode-num><episode-num system="onscreen">S01E69</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/c0fdd4670b64055db092639fe8a45f48.jpeg"/></programme>
<programme start="20261024210000 +0000" stop="20261024220000 +0000" channel="Todo Drama"><title lang="es">La tierra prometida</title><sub-title lang="es">Promesa cumplida</sub-title><desc lang="es">Tibar trata de asesinar a Rahab y su familia, pero Salmón los salva. Marek y Kalesi mueren en manos de los hebreos.</desc><credits><director>Alexandre Avancini</director><actor>Sidney Sampaio</actor><actor>Thaís Melchior</actor><actor>Paloma Bernardi</actor><actor>Cristiana Oliveira</actor><actor>Kadu Moliterno</actor><actor>Leonardo Miggiorin</actor><actor>Nívea Stelmann</actor><actor>Marcos Winter</actor><actor>Juliana Silveira</actor><actor>Beth Goulart</actor><actor>Luciana Braga</actor><actor>Raymundo Souza</actor><actor>Ricky Tavares</actor><actor>Ana Barroso</actor></credits><date>20261024</date><episode-num system="xmltv_ns">0.69.0/1</episode-num><episode-num system="onscreen">S01E70</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/7681896bf2887b89267c56e365c80bf5.jpeg"/></programme>
<programme start="20261024220000 +0000" stop="20261024230000 +0000" channel="Todo Drama"><title lang="es">La tierra prometida</title><sub-title lang="es">Traidores</sub-title><desc lang="es">Josué celebra con sus guerreros la victoria de haber conquistado Jericó. El rey Durgal enfurece al ver que Yusuf ha perdido la guerra contra Josué.</desc><credits><director>Alexandre Avancini</director><actor>Sidney Sampaio</actor><actor>Thaís Melchior</actor><actor>Paloma Bernardi</actor><actor>Cristiana Oliveira</actor><actor>Kadu Moliterno</actor><actor>Leonardo Miggiorin</actor><actor>Nívea Stelmann</actor><actor>Marcos Winter</actor><actor>Juliana Silveira</actor><actor>Beth Goulart</actor><actor>Luciana Braga</actor><actor>Raymundo Souza</actor><actor>Ricky Tavares</actor><actor>Ana Barroso</actor></credits><date>20261024</date><episode-num system="xmltv_ns">0.70.0/1</episode-num><episode-num system="onscreen">S01E71</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/452eed8fd188f8b28af2965bd1c5116e.jpeg"/></programme>
<programme start="20261024230000 +0000" stop="20261025000000 +0000" channel="Todo Drama"><title lang="es">La tierra prometida</title><sub-title lang="es">Celos incontrolables</sub-title><desc lang="es">Kamir le promete a Yusuf la mano de Melina. Samara entristece al ver el rostro de Tobías lastimado. Jessica no puede controlar sus celos al ver a Rahab cerca de Salmón.</desc><credits><director>Alexandre Avancini</director><actor>Sidney Sampaio</actor><actor>Thaís Melchior</actor><actor>Paloma Bernardi</actor><actor>Cristiana Oliveira</actor><actor>Kadu Moliterno</actor><actor>Leonardo Miggiorin</actor><actor>Nívea Stelmann</actor><actor>Marcos Winter</actor><actor>Juliana Silveira</actor><actor>Beth Goulart</actor><actor>Luciana Braga</actor><actor>Raymundo Souza</actor><actor>Ricky Tavares</actor><actor>Ana Barroso</actor></credits><date>20261024</date><episode-num system="xmltv_ns">0.71.0/1</episode-num><episode-num system="onscreen">S01E72</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/451475a2937a752afe1d352fea58d478.jpeg"/></programme>
