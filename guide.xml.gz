<programme start="20261117051000 +0000" stop="20261117061200 +0000" channel="Pluto TV Naturaleza"><title lang="es">Armería de Animales</title><sub-title lang="es">Melea y pelea</sub-title><desc lang="es">El combate cuerpo a cuerpo y la lucha cuerpo a cuerpo no son sólo dominio de los humanos, muchos animales también esgrimen estos estilos de lucha con efectos mortales.</desc><date>00010101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/66ab78c094a184001358db69/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261117061200 +0000" stop="20261117071400 +0000" channel="Pluto TV Naturaleza"><title lang="es">Armería de Animales</title><sub-title lang="es">Maestros del camuflaje</sub-title><desc lang="es">Estas criaturas comparten un rasgo asombroso, la capacidad de utilizar el entorno que las rodea para ocultarse a plena vista, para prácticamente desaparecer y camuflarse por completo.</desc><date>00010101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/66ab78c094a184001358db69/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261117071400 +0000" stop="20261117081600 +0000" channel="Pluto TV Naturaleza"><title lang="es">Armería de Animales</title><sub-title lang="es">Veneno letal</sub-title><desc lang="es">Todas estas criaturas utilizan veneno y ponzoña para atacar, defenderse y cazar, con resultados devastadores.</desc><date>00010101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/66ab78c094a184001358db69/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
