<programme start="20261020001600 +0000" stop="20261020011500 +0000" channel="Love Nature 🇺🇸"><title lang="en">Coastal Africa</title><sub-title lang="en">Sanctuary of the Indian Ocean</sub-title><desc lang="en">A narrow band of Africa&apos;s coast is home to a diverse array of marine life.</desc><credits><director>Claudio Velásquez-Rojas</director><actor>Tapfuma Makina</actor></credits><date>20160625</date><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/2b4e22a1966630b936b066dde8f355e5.jpeg"/></programme>
<programme start="20261020011500 +0000" stop="20261020021900 +0000" channel="Love Nature 🇺🇸"><title lang="en">Wild Caribbean: Rhythms of Life</title><sub-title lang="en">Corales and Quetzals</sub-title><desc lang="en">These Caribbean coasts and islands are made out of once-living creatures, and are now a labyrinth of life.</desc><credits><director>Bernhard Rübe</director></credits><date>20230426</date><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/1c645a06f851c8925f3e1415819b37ef.jpeg"/></programme>
<programme start="20261020021900 +0000" stop="20261020032100 +0000" channel="Love Nature 🇺🇸"><title lang="en">Deep Dive Australia</title><sub-title lang="en">The Cool South</sub-title><desc lang="en">Saying goodbye to the tropics and dipping into the cool southern-coast waters; witnessing grey nurse sharks, shape-shifting cuttlefish and blue whales; playing with penguins and sea lions.</desc><credits><director>Mark Woodward</director><actor>Lizzie Daly</actor></credits><date>20251122</date><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/8b9a6fd8bbf9b7bd7d4417374f68708d.jpeg"/></programme>
<programme start="20261020032100 +0000" stop="20261020042600 +0000" channel="Love Nature 🇺🇸"><title lang="en">The Magic Circle of the Reef</title><sub-title lang="en">Little Giants: The Benthonics</sub-title><desc lang="en">The ability of the Coral Triangle reef to adapt to climate change has alerted the scientific community, discovering that the main culprits are living beings of all sizes that live attached to the seabed, the so-called Benthonic.</desc><date>20231019</date><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>US_UPR_TV-G</value></rating><icon src="http://p-img.movetv.com/1920x1080/c82bbbc1c859dd3cef5c2a2fe9a7aa3d.jpeg"/></programme>
<programme start="20261020042600 +0000" stop="20261020052400 +0000" channel="Love Nature 🇺🇸"><title lang="en">Great Blue Wild</title><sub-title lang="en">Cozumel</sub-title><desc lang="en">Exploring the wild blue Caribbean waters of Cozumel, from the Paso del Cedral coral reef to the world&apos;s longest subterranean underwater cave system.</desc><credits><director>Dan Hughes</director><actor>Ross Huguet</actor></credits><date>20160120</date><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/b48fed9b355c4ad2f9ccf7e0993060ce.jpeg"/></programme>
<programme start="20261020052400 +0000" stop="20261020062700 +0000" channel="Love Nature 🇺🇸"><title lang="en">Whale with Steve Backshall</title><sub-title lang="en">Ocean Voyagers</sub-title><desc lang="en">Travel to places where migratory whales feed, breed and raise their young despite imminent danger; Swim thousands of miles for a once-in-a-lifetime encounter with a southern right whale that&apos;s about to give birth, then meet a curious humpback calf.</desc><credits><director>Chloe Juyon</director><actor>Steve Backshall</actor></credits><date>20231217</date><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/5de83dbabaff0ff1a79a704e2c71e9ad.jpeg"/></programme>
<programme start="20261020062700 +0000" stop="20261020072900 +0000" channel="Love Nature 🇺🇸"><title lang="en">The Nature of Things</title><sub-title lang="en">How the Wild Things Sleep</sub-title><desc lang="en">Unraveling the secrets of the most extreme sleepers of the animal kingdom; answering why and how animals sleep, how they deal with sleep deprivation and if animals dream.</desc><credits><actor>David Suzuki</actor></credits><date>20250201</date><episode-num system="xmltv_ns">60.10.0/1</episode-num><episode-num system="onscreen">S61E11</episode-num><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/7e0a98b76a313dc02d908108f41cc942.jpeg"/></programme>
<programme start="20261020072900 +0000" stop="20261020082800 +0000" channel="Love Nature 🇺🇸"><title lang="en">Undiscovered Vistas</title><sub-title lang="en">Iceland: Fire</sub-title><desc lang="en">Iceland is the world&apos;s largest volcanic island and new ground is born daily.</desc><credits><director>Dan Hughes</director><actor>Rod Smith</actor><actor>David Rankin</actor><actor>Nick Eyles</actor><actor>Rachel Carnahan</actor><actor>Gary Ladd</actor><actor>Kelly Stowell</actor><actor>Álvaro Barrientos</actor><actor>Jenn Lukacic</actor><actor>Lenore Keeshig</actor><actor>Carol Dersch</actor></credits><date>20170623</date><episode-num system="xmltv_ns">1.0.0/1</episode-num><episode-num system="onscreen">S02E01</episode-num><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/7e1912931a822d41cec9d1a709ce7ac7.jpeg"/></programme>
<programme start="20261020082800 +0000" stop="20261020093000 +0000" channel="Love Nature 🇺🇸"><title lang="en">Shadowlands</title><sub-title lang="en">Age of Independence</sub-title><desc lang="en">The south-eastern coast of New Zealand is the place for young marine animals to transition from novices to independent adults; young whales, dolphins and seals learn to hunt, learn the rules of society, or strike out on their own adventures.</desc><date>20231115</date><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/054cca3282d59738fa0a0749dd689995.jpeg"/></programme>
<programme start="20261020093000 +0000" stop="20261020100000 +0000" channel="Love Nature 🇺🇸"><title lang="en">Attack and Defend</title><sub-title lang="en">Masters of Defense</sub-title><desc lang="en">Many animals use mimicry, poison, and other methods to avoid predators.</desc><credits><director>Fred Frame</director><actor>Adam Brown</actor><actor>Daniel Fu</actor></credits><date>20170718</date><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/92593ad29ef9aadc00a560eb61e44a6a.jpeg"/></programme>
<programme start="20261020100000 +0000" stop="20261020110100 +0000" channel="Love Nature 🇺🇸"><title lang="en">Ireland&apos;s Wild Islands</title><sub-title lang="en">The Wilds of Winter</sub-title><desc lang="en">Enduring winter and early spring on the West Coast, where animals eke out a chilly existence; watching red deer battle on windswept Inishvickillane, welcome seal pups amid howling storms on the Inishkea Islands.</desc><credits><director>John Murray</director><actor>Eoin Warner</actor></credits><date>20250322</date><episode-num system="xmltv_ns">1.0.0/1</episode-num><episode-num system="onscreen">S02E01</episode-num><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/223c86e4250caf485a6a436e26cd8a0a.jpeg"/></programme>
<programme start="20261020110100 +0000" stop="20261020120200 +0000" channel="Love Nature 🇺🇸"><title lang="en">Undiscovered Vistas</title><sub-title lang="en">Iceland: Ice</sub-title><desc lang="en">Iceland&apos;s volcanoes generate one third of earth&apos;s land-based lava, but the land was sculpted by ice.</desc><credits><director>Dan Hughes</director><actor>Rod Smith</actor></credits><date>20170630</date><episode-num system="xmltv_ns">1.1.0/1</episode-num><episode-num system="onscreen">S02E02</episode-num><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/b84770d79b52c06e28d061b71180859a.jpeg"/></programme>
