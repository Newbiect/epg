<programme start="20261014172800 +0000" stop="20261014175700 +0000" channel="40 y 20"><title lang="es">40 y 20</title><sub-title lang="es">El regreso de Chio</sub-title><desc lang="es">Rocío decide mudarse a casa de Paco con su nuevo esposo y sus hijos, pero las cosas terminan muy mal cuando Monserrat y Toña coquetean con él.</desc><credits><actor>Jorge Van Rankin</actor><actor>Mauricio Garza</actor><actor>Michelle Rodríguez</actor><actor>Mónica Huarte</actor></credits><date>20181104</date><episode-num system="xmltv_ns">3.9.0/1</episode-num><episode-num system="onscreen">S04E10</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/cms/images/7d9cf110ea4be6ff7e355d36f6ab28f6e515334c.JPEG"/></programme>
