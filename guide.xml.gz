<programme start="20261015004300 +0000" stop="20261015011200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Regreso de los Exámenes Chunin</sub-title><desc lang="es">Naruto propone que se celebre el Examen Chunin para levantar la moral tras el ataque de Isshiki.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211024</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.220.0/1</episode-num><episode-num system="onscreen">S15E221</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015011200 +0000" stop="20261015014100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Noche Antes de la Ronda Final</sub-title><desc lang="es">Se anuncia la ronda final del Examen Chunin. Muchos de los compañeros de Boruto que no pasaron a la ronda final del último examen lo han conseguido esta vez.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211031</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.221.0/1</episode-num><episode-num system="onscreen">S15E222</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015014100 +0000" stop="20261015021000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Inojin contra Houki</sub-title><desc lang="es">La ronda final de los exámenes por fin ha comenzado. El primer duelo es Inojin contra Houki. El equipo de Houki ha estado participando en las misiones de cazadores especiales ANBU.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211107</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.222.0/1</episode-num><episode-num system="onscreen">S15E223</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015021000 +0000" stop="20261015023900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Leyenda del Gato Monstruo</sub-title><desc lang="es">El siguiente combate de las rondas finales es entre Iwabe y Wasabi.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211114</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.223.0/1</episode-num><episode-num system="onscreen">S15E224</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015023900 +0000" stop="20261015030800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Enfrentamiento entre Mejores Amigas</sub-title><desc lang="es">Comienza el combate entre Sarada y Cho-Cho. Kawaki fue invitado por Naruto para observar, así como Shinki y otros que han venido de la Aldea Escondida de la Arena.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211121</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.224.0/1</episode-num><episode-num system="onscreen">S15E225</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015030800 +0000" stop="20261015033700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Samurái contra Ciencia</sub-title><desc lang="es">Uno después de otro, los ganadores de las finales se deciden. Solo quedan un par de encuentros, pero Boruto y Mitsuki aun no han llegado a los exámenes.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211128</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.225.0/1</episode-num><episode-num system="onscreen">S15E226</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015033700 +0000" stop="20261015040600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¿¡La Última Misión del Equipo Siete!?</sub-title><desc lang="es">Al equipo siete, con Sarada como capitana, se le asigna una misión. Mirai, que fue a una misión con Konohamaru, regresa a la aldea gravemente herida.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211205</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.226.0/1</episode-num><episode-num system="onscreen">S15E227</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015040600 +0000" stop="20261015043500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Camino de Kawaki para Convertirse en Ninja</sub-title><desc lang="es">Para que Kawaki pueda convertirse en genin, se decide que tome un examen especial que es diferente de los que se toman en la Academia Ninja.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211212</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.227.0/1</episode-num><episode-num system="onscreen">S16E228</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015043500 +0000" stop="20261015050400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Incumplimiento de Órdenes</sub-title><desc lang="es">Kawaki comienza a pensar que ser un genin no es para él.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211219</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.228.0/1</episode-num><episode-num system="onscreen">S16E229</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015050400 +0000" stop="20261015053300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Un Deseo</sub-title><desc lang="es">Cho-Cho es herida por el ataque de un ninja misterioso y el objeto que Mozuku ha estado guardando es robado.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211226</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.229.0/1</episode-num><episode-num system="onscreen">S16E230</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015053300 +0000" stop="20261015060200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Espada Oxidada</sub-title><desc lang="es">Unos feroces ladrones atacan a unos mercaderes ambulantes. Wasabi, Namida y Tsubaki, del Equipo 15, son enviadas al lugar del incidente para investigar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220109</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.230.0/1</episode-num><episode-num system="onscreen">S16E231</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015060200 +0000" stop="20261015063100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Primera Misión del Capitán Denki</sub-title><desc lang="es">Con Denki como capitán, al Equipo 5 se le asigna la misión de transportar títeres automatizados con fines mineros a una isla de la Tierra del Agua.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220116</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.231.0/1</episode-num><episode-num system="onscreen">S16E232</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015063100 +0000" stop="20261015070000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Nuevo Equipo Siete Entra en Acción</sub-title><desc lang="es">El nuevo Equipo 7, con Kawaki como nuevo miembro, tiene la misión de escoltar a Katasuke a una ceremonia en la Tierra del Agua.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220123</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.232.0/1</episode-num><episode-num system="onscreen">S16E233</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015070000 +0000" stop="20261015072600 +0000" channel="Pluto TV Anime"><title lang="es">BeyBlade Gen</title><sub-title lang="es">Adivina quién volvió a la ciudad</sub-title><desc lang="es">Takao y Kyojyu están a salvo en tierra firme una vez más, pero están totalmente desconcertados tratando de descubrir por qué Kyojyu y Hiromi fueron asesinados por los dos hombres misteriosos.</desc><date>20020204</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.4.0/1</episode-num><episode-num system="onscreen">S02E05</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f9c1484e657fb001312b38f/tile_1769024881703.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015072600 +0000" stop="20261015075200 +0000" channel="Pluto TV Anime"><title lang="es">BeyBlade Gen</title><sub-title lang="es">La amenaza magtram</sub-title><desc lang="es">Los dos hombres de negro que vigilan a Takao son vistos en las instalaciones de la compañía donde trabajan. El hombre que apareció durante el combate de Takao contra un robot es presentado como Gideon, y lo acompaña el científico jefe.</desc><date>20020211</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.5.0/1</episode-num><episode-num system="onscreen">S02E06</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f9c1484e657fb001312b38f/tile_1769024881703.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015075200 +0000" stop="20261015081800 +0000" channel="Pluto TV Anime"><title lang="es">BeyBlade Gen</title><sub-title lang="es">Comienza la reunión</sub-title><desc lang="es">Takao y Kyojyu intentan determinar cuál era el material misterioso dentro de la Beyblade de Snakey que lo hacía tan magnético. Gideon ordena a los dos hombres de negro que encuentren una manera de reunir a los Bladebreakers.</desc><date>20020218</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.6.0/1</episode-num><episode-num system="onscreen">S02E07</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f9c1484e657fb001312b38f/tile_1769024881703.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015081800 +0000" stop="20261015084400 +0000" channel="Pluto TV Anime"><title lang="es">BeyBlade Gen</title><sub-title lang="es">El regreso de los Bladebreakers</sub-title><desc lang="es">Con la llegada de Max y Rei, los Bladebreakers vuelven a estar juntos. Con una semana para entrenar, Max y Kyojyu presentan la nueva tecnología desarrollada por la madre de Max, MG Core.rs.</desc><date>20020225</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.7.0/1</episode-num><episode-num system="onscreen">S02E08</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f9c1484e657fb001312b38f/tile_1769024881703.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015084400 +0000" stop="20261015091000 +0000" channel="Pluto TV Anime"><title lang="es">BeyBlade Gen</title><sub-title lang="es">La Isla Bey-Nita</sub-title><desc lang="es">Los rompe-cuchillas se despiertan en una isla (aunque inicialmente no sabían que es una isla) con brazaletes electrónicos atados a sus brazos.</desc><date>20020304</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.8.0/1</episode-num><episode-num system="onscreen">S02E09</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f9c1484e657fb001312b38f/tile_1769024881703.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015091000 +0000" stop="20261015093600 +0000" channel="Pluto TV Anime"><title lang="es">BeyBlade Gen</title><sub-title lang="es">La isla sin regreso</sub-title><desc lang="es">Los Bladebreakers deciden separarse para encontrar una salida de la isla. Hiromi, Kai y Kyojyu van al faro, donde esperan encontrar una manera de comunicarse con el mundo exterior y pedir ayuda.</desc><date>20020311</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.9.0/1</episode-num><episode-num system="onscreen">S02E10</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f9c1484e657fb001312b38f/tile_1769024881703.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015093600 +0000" stop="20261015100200 +0000" channel="Pluto TV Anime"><title lang="es">BeyBlade Gen</title><sub-title lang="es">La isla del doctor B</sub-title><desc lang="es">Kai y Figel luchan en la cima de un puente, mientras que Kyojyu intenta invadir el sistema Psykick para cerrar los mecanismos de captura de bestias. Él tiene éxito, pero Kai logra derrotar a su oponente sin tener que traer a Dranzer de todos modos.</desc><date>20020318</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.10.0/1</episode-num><episode-num system="onscreen">S02E11</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f9c1484e657fb001312b38f/tile_1769024881703.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015100200 +0000" stop="20261015102800 +0000" channel="Pluto TV Anime"><title lang="es">BeyBlade Gen</title><sub-title lang="es">¡Tráiganme a Dranzer!</sub-title><desc lang="es">Takao se está recuperando en el hospital después de ser rescatado de la isla donde luchó contra el equipo Psykick. Lejos de la escuela, Takao descubre que realmente disfruta la vida en el hospital.</desc><date>20020325</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.11.0/1</episode-num><episode-num system="onscreen">S02E12</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f9c1484e657fb001312b38f/tile_1769024881703.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015102800 +0000" stop="20261015105400 +0000" channel="Pluto TV Anime"><title lang="es">BeyBlade Gen</title><sub-title lang="es">Probando: uno, dos, tres...</sub-title><desc lang="es">Yusufu se infiltra en el laboratorio de los Psykicks y descubre que están utilizando los datos que recopilaron de Blade Breakers para crear ciber bestias basadas en los originales.</desc><date>20020401</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.12.0/1</episode-num><episode-num system="onscreen">S02E13</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f9c1484e657fb001312b38f/tile_1769024881703.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
