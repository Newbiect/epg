<programme start="20261016055100 +0000" stop="20261016064300 +0000" channel="CSI: Miami"><title lang="es">CSI: Miami</title><sub-title lang="es">El paracaídas de oro</sub-title><desc lang="es">Megan Donner regresa a la unidad de CSI a tiempo para trabajar en un accidente de avión en los Everglades. Descubren una víctima a ocho kilómetros del accidente.</desc><credits><actor>Adam Rodriguez</actor><actor>David Caruso</actor><actor>Emily Procter</actor><actor>Khandi Alexander</actor><actor>Kim Delaney</actor><actor>Rory Cochrane</actor></credits><date>20020923</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/63bc1f45a6bb3b001475e802/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
