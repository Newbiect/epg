<programme start="20261028070900 +0000" stop="20261028073700 +0000" channel="Las Tortugas Ninja"><title lang="es">Teenage Mutant Ninja Turtles LT</title><sub-title lang="es">Creo que su nombre es Baxter Stockman</sub-title><desc lang="es">Cuando las Tortugas salen contra la voluntad de Splinter, pelean con Baxter Stockman, el inventor frustrado de una armadura mecánica de batalla.</desc><credits><actor>Rob Paulsen</actor><actor>Greg Cipes</actor><actor>Sean Astin</actor></credits><date>20120101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/63ff6e23689edb0013bce4e7/tile_1769238721082.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261028073700 +0000" stop="20261028080500 +0000" channel="Las Tortugas Ninja"><title lang="es">Teenage Mutant Ninja Turtles LT</title><sub-title lang="es">Cabeza Metálica</sub-title><desc lang="es">Cansado de usar un simple bo contra la avanzada tecnología de los Kraang, Donatelo crea a Cabeza Metálica, una tortuga robot a control remoto para pelear en su lugar.</desc><credits><actor>Rob Paulsen</actor><actor>Greg Cipes</actor><actor>Sean Astin</actor></credits><date>20120101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">0.5.0/1</episode-num><episode-num system="onscreen">S01E06</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/63ff6e23689edb0013bce4e7/tile_1769238721082.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
