<programme start="20261122102703 +0000" stop="20261122105603 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El primer viaje de Dora</sub-title><desc lang="es">Dora cuenta la historia de cuando conoció a Botas. En su primera exploración, Dora y Botas deben devolver los instrumentos a la banda Fiesta Trio para que puedan tocarle música a la malhumorada Abeja Reina.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.1.0/1</episode-num><episode-num system="onscreen">S04E02</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261122105603 +0000" stop="20261122112503 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Salvando a los cachorros</sub-title><desc lang="es">¡Guau, Guau! Dora y Botas tienen un nuevo videojuego en el que un perrero mete a todos los cachorritos en jaulas. Para salvarlos, Dora y Botas tendrán que entrar en el videojuego.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.8.0/1</episode-num><episode-num system="onscreen">S03E09</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261122112503 +0000" stop="20261122115303 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Las Aventuras del Bosque Encantado de Dora Parte 1, El Cuento del Rey Unicornio</sub-title><desc lang="es">Unicornio ha sido escogido el nuevo Rey del Bosque Encantado, pero primero necesita la ayuda de Dora, de Botas y de ti para descubrir que es bueno, inteligente, valiente y fuerte como para hacer el trabajo.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.12.0/1</episode-num><episode-num system="onscreen">S06E13</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261122115303 +0000" stop="20261122122103 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Las Aventuras del Bosque Encantado de Dora Parte 2, El Secreto de la Atlántida</sub-title><desc lang="es">Dora, Botas y el Rey Unicornio dejan el Bosque Encantado para unirse a Diego y recuperar el continente perdido de la Atlántida, terminando con una antigua pelea entre unicornios y dragones.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.15.0/1</episode-num><episode-num system="onscreen">S06E16</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
