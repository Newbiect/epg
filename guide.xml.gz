<programme start="20261104104100 +0000" stop="20261104111000 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El Torneo Nacional</sub-title><desc lang="es">Nankatsu derrota a Shimizu y clasifica para el Torneo Nacional, con Tsubasa como capitán. Su primer rival será Meiwa, liderado por el temible Hyuga.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180625</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.12.0/1</episode-num><episode-num system="onscreen">S01E13</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104111000 +0000" stop="20261104113900 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Nankatsu vs Meiwa</sub-title><desc lang="es">Empieza el Torneo Nacional. Hyuga aterra al portero de Nankatsu con un cañonazo directo al rostro, que acaba en gol. ¿Podrá Morisaki superar el miedo?</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180702</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.13.0/1</episode-num><episode-num system="onscreen">S01E14</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104113900 +0000" stop="20261104120800 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">No renunciaré a mi sueño</sub-title><desc lang="es">El portero Morisaki recupera la confianza, pero los equipos logran igualar el marcador. Se inicia un duelo de capitanes en una lluvia de goles.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180709</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.14.0/1</episode-num><episode-num system="onscreen">S01E15</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
