<programme start="20261017121200 +0000" stop="20261017124000 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden</title><sub-title lang="es">LAS CRÓNICAS DE KAKASHI. LA VIDA DE UN NIÑO EN EL CAMPO DE BATALLA, PARTE 2.</sub-title><desc lang="es">Obito ignora la orden de Kakashi de continuar con la misión y la abandona para salvar a Rin.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20090730</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">5.119.0/1</episode-num><episode-num system="onscreen">S06E120</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69f0f43b8f919a54cfebf256/tile_1777398844276.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
