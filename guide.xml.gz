<programme start="20261118121000 +0000" stop="20261118124000 +0000" channel="Inuyasha"><title lang="es">Inuyasha LT</title><sub-title lang="es">Entei y Hakudoushi</sub-title><desc lang="es">El bebé de Naraku se dividió en dos. Una mitad vuelve a la vida en forma de un niño vestido de blanco.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">5.15.0/1</episode-num><episode-num system="onscreen">S06E16</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261118124000 +0000" stop="20261118131000 +0000" channel="Inuyasha"><title lang="es">Inuyasha LT</title><sub-title lang="es">3000 Leguas de Viaje en Busca del Padre</sub-title><desc lang="es">Kanta es un niño demonio nutria. La cabeza de su padre fue tomada por Hakudoshi, y él está buscando el cuerpo de su padre.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">5.16.0/1</episode-num><episode-num system="onscreen">S06E17</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261118131000 +0000" stop="20261118133900 +0000" channel="Inuyasha"><title lang="es">Inuyasha LT</title><sub-title lang="es">Housenki y el Último Fragmento</sub-title><desc lang="es">El área entre este mundo y el siguiente, donde se encuentra el fragmento de la Joya Sagrada, es el cementerio de demonios donde descansa el cadáver del padre de Inuyasha.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">5.17.0/1</episode-num><episode-num system="onscreen">S06E18</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
