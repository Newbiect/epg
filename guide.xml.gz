<programme start="20261112223700 +0000" stop="20261112230600 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden</title><sub-title lang="es">EL PAR APRIONADO</sub-title><desc lang="es">Unas ruinas se derrumban durante la batalla. Tenten y Ajisai caen entre los escombros.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20150326</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.404.0/1</episode-num><episode-num system="onscreen">S18E405</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6a0fa4f08eee0f23e77574c3/tile_1779410161636.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
