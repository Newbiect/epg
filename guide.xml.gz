<programme start="20261113230700 +0000" stop="20261113233600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Deseo de Creer</sub-title><desc lang="es">Sarada, Mitsuki y Boruto deciden reunirse con el Mizukage.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220605</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.251.0/1</episode-num><episode-num system="onscreen">S16E252</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261113233600 +0000" stop="20261114000500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Sentimientos Conflictivos</sub-title><desc lang="es">Boruto, Sarada y Mitsuki van a reunirse con Ikada, que ahora se contra la Tierra del Agua. Boruto intenta hablar con Ikada como amigo para que deje de luchar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220612</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.252.0/1</episode-num><episode-num system="onscreen">S16E253</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114000500 +0000" stop="20261114003400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Espiral de Venganza</sub-title><desc lang="es">Los desesperados intentos de Boruto por razonar con Ikada fracasan y no logra hacerle cambiar de opinión. Se dispone a dar su vida para impedir que la Tierra del Agua y los piratas luchen.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220619</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.253.0/1</episode-num><episode-num system="onscreen">S16E254</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114003400 +0000" stop="20261114010300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Una Tarea Complicada</sub-title><desc lang="es">La rebelión pirata que sacude a la Tierra del Agua es controlada. Al regresar con sus amigos a la Aldea Escondida de la Hoja, Boruto se pregunta qué ha sido de Ikada.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220626</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.254.0/1</episode-num><episode-num system="onscreen">S16E255</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114010300 +0000" stop="20261114013200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Receta Perfecta</sub-title><desc lang="es">Cho-Cho e Inojin terminan haciendo ramen para ayudar a un antiguo Shinobi y dueño de un restaurante de ramen de nombre Shingo Kumano a quien conocieron en una misión.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220703</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.255.0/1</episode-num><episode-num system="onscreen">S16E256</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114013200 +0000" stop="20261114020100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¿Konohamaru se convierte en el Hokage?</sub-title><desc lang="es">A Naruto le pidieron que actúe como él mismo en Malvado Jammer Kagemasa, una película de una popular serie. Konohamaru termina actuando ese rol.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220710</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.256.0/1</episode-num><episode-num system="onscreen">S16E257</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114020100 +0000" stop="20261114023000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La familia Uzumaki en las Aguas Termales</sub-title><desc lang="es">Boruto y Kawaki se unen a Naruto, Hinata y Himawari en un viaje familiar en las aguas termales. Los cinco se divierten jugando ping-pong y disfrutan la comida y las aguas termales de la posada.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220717</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.257.0/1</episode-num><episode-num system="onscreen">S16E258</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114023000 +0000" stop="20261114025900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Una Herida que Nunca Sana</sub-title><desc lang="es">Mitsuki, Boruto, y Sarada estás asitiendo con una patrulla a la aldea por petición del departamento de policía, que está teninedo dificultades al investigar una serie de misterioso ataques.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220724</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.258.0/1</episode-num><episode-num system="onscreen">S16E259</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114025900 +0000" stop="20261114032800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Fuegos Artificiales de Amor</sub-title><desc lang="es">Mientras pasean por la Aldea, Kakashi y Boruto se encuentran con un grupo de personas que discuten. Boruto se da cuenta de la cara triste de una joven pareja y se entera que están comprometidos, y sus abuelos están enfrentados.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220731</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.259.0/1</episode-num><episode-num system="onscreen">S16E260</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114032800 +0000" stop="20261114035700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Kawaki entra a la Academia Ninja!</sub-title><desc lang="es">Kawaki entra a la Academia Ninja y comienza las clases como novato junto a Himawari y los demás.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220807</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.260.0/1</episode-num><episode-num system="onscreen">S17E261</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114035700 +0000" stop="20261114042600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La fiesta del té de la princesa</sub-title><desc lang="es">A Kawaki le cuesta acostumbrarse a la vida escolar, pero consigue hacerse amigo de la princesa Kae, objeto de su misión de guardia. Mientras tanto,</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220814</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.261.0/1</episode-num><episode-num system="onscreen">S17E262</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114042600 +0000" stop="20261114045500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Las cualidades de Hana Sensei!</sub-title><desc lang="es">Boruto, Sarada y Mitsuki dan una conferencia especial en la Academia para estudiantes de primer año como Kawaki y Himawari.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220821</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.262.0/1</episode-num><episode-num system="onscreen">S17E263</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114045500 +0000" stop="20261114052400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡El grupo de exploración de los Siete Misterios!</sub-title><desc lang="es">Tras conocer los \&quot;Siete Misterios\&quot; en la Academia Ninja, Himawari y varios de sus compañeros deciden ir a investigarlos por la noche.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220828</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.263.0/1</episode-num><episode-num system="onscreen">S17E264</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114052400 +0000" stop="20261114055300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Duelo de equipos: ejercicios prácticos!</sub-title><desc lang="es">Kawaki y Himawari participan en una sesión de entrenamiento en el bosque cercano a la academia. La clase se divide en equipos de tres personas y Kawaki acaba en un equipo diferente al de Kae.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220904</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.264.0/1</episode-num><episode-num system="onscreen">S17E265</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114055300 +0000" stop="20261114062200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡El Secuestro de Himawari!</sub-title><desc lang="es">Osaku Kamakura es secustrada para pedir un rescate por ella, junto con Himawari. Cuando el líder de los ladrónes descubre que ella es la hija de Hokage, comienza a pensar en formas para sacarle ventaja a eso también.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220911</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.265.0/1</episode-num><episode-num system="onscreen">S17E266</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114062200 +0000" stop="20261114065100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¿Descubren el Secreto de Kawaki?</sub-title><desc lang="es">La clase de Kawaki y Himawari va a montar una obra sobre los legendarios Sannon para el festival escolar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220918</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.266.0/1</episode-num><episode-num system="onscreen">S17E267</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114065100 +0000" stop="20261114071900 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Encuentro en San Francisco</sub-title><desc lang="es">Ryu va a los Estados Unidos para visitar a Ken, su compañero de entrenamiento. Después de luchar contra los soldados en un bar, se enfrentan a un nuevo retador.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
