<programme start="20261024023800 +0000" stop="20261024030700 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Emperor Crimson contra Metallic</sub-title><desc lang="es">Risotto deduce que Doppio es algo más que un simple socio de Passione y le ataca metódicamente con la capacidad magnética de su Stand, Metallic.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190420</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.26.0/1</episode-num><episode-num system="onscreen">S04E27</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024030700 +0000" stop="20261024033600 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Bajo un cielo a punto de caer</sub-title><desc lang="es">Decidido a identificar a su jefe, Abbacchio activa su Stand para revelar al fotógrafo que fotografió a la madre de Trish 15 años antes.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190427</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.27.0/1</episode-num><episode-num system="onscreen">S04E28</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024033600 +0000" stop="20261024040500 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">¡Id al coliseo de Roma!</sub-title><desc lang="es">Cuando Bucciarati y su tripulación reciben una llamada anónima sobre la identidad de su jefe y cómo derrotarlo, se dirigen a Roma para reunirse con el informante.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190511</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.28.0/1</episode-num><episode-num system="onscreen">S04E29</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024040500 +0000" stop="20261024043400 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Green Tea y Sanctuary (Primera parte)</sub-title><desc lang="es">Para huir del Stand carnívoro de Cioccolata, Green Tea, Bucciarati y Mista intentan encontrar un coche para escapar, pero Secco está decidido a impedírselo.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190518</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.29.0/1</episode-num><episode-num system="onscreen">S04E30</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024043400 +0000" stop="20261024050300 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Green Tea y Sanctuary (Segunda parte)</sub-title><desc lang="es">Cioccolata intenta acabar con civiles inocentes con su Stand mediante un helicóptero, pero Giorno y Mista intentan acabar con él primero.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190525</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.30.0/1</episode-num><episode-num system="onscreen">S04E31</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024050300 +0000" stop="20261024053200 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Green Tea y Sanctuary (Tercera parte)</sub-title><desc lang="es">Para impedir que Secco llegue primero al Coliseo, Bucciarati le obliga a batirse en duelo en las calles de Roma.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190601</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.31.0/1</episode-num><episode-num system="onscreen">S04E32</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024053200 +0000" stop="20261024060100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Se llama Diavolo</sub-title><desc lang="es">Doppio lleva al Coliseo a Bucciarati, que está demasiado herido para darse cuenta de quién le ayuda, y revela su verdadera identidad a la persona que espera dentro.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190608</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.32.0/1</episode-num><episode-num system="onscreen">S04E33</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024060100 +0000" stop="20261024063000 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Suena un réquiem oscuro (Primera parte)</sub-title><desc lang="es">Mientras Emperor Crimson se lanza sobre Polnareff, la flecha alcanza a Silver Chariot. Los que están dentro del Coliseo caen en un sueño misterioso.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190615</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.33.0/1</episode-num><episode-num system="onscreen">S04E34</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024063000 +0000" stop="20261024065900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Nuevo Equipo Siete Entra en Acción</sub-title><desc lang="es">El nuevo Equipo 7, con Kawaki como nuevo miembro, tiene la misión de escoltar a Katasuke a una ceremonia en la Tierra del Agua.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220123</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.232.0/1</episode-num><episode-num system="onscreen">S16E233</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024065900 +0000" stop="20261024072800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Villano Liberado</sub-title><desc lang="es">Boruto visita la prisión cuando una aeronave explota durante la ceremonia.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220130</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.233.0/1</episode-num><episode-num system="onscreen">S16E234</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024072800 +0000" stop="20261024075700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Infiltrándose en la Isla Dotou</sub-title><desc lang="es">Cuando un grupo de piratas toma La Tierra del Agua, se pierde el contacto con el Equipo 5 de Denki.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220206</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.234.0/1</episode-num><episode-num system="onscreen">S16E235</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024075700 +0000" stop="20261024082600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Huida</sub-title><desc lang="es">Mientras están en las afueras de la Isla Dotou, una fortaleza gigante aparece frente a Boruto y sus amigos.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220213</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.235.0/1</episode-num><episode-num system="onscreen">S16E236</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024082600 +0000" stop="20261024085500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La fortaleza móvil</sub-title><desc lang="es">Mientras Sarada y los demás ayudan a la gente de la isla a evacuar, Boruto se pone ansioso cuando se da cuenta de que son amenazados por la fortaleza móvil, que está equipada con un arma muy poderosa.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220220</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.236.0/1</episode-num><episode-num system="onscreen">S16E237</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024085500 +0000" stop="20261024092400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Un asesino en el barco</sub-title><desc lang="es">Hay un asesinato a bordo del barco que lleva a la gente rescatada de la Isla Dotou, y Kyoho es el principal sospechoso basados en la evidencia.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220227</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.237.0/1</episode-num><episode-num system="onscreen">S16E238</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024092400 +0000" stop="20261024095300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El chico de la isla de los constructores de barcos</sub-title><desc lang="es">El barco donde van Boruto, sus amigos y la gente de la Isla Dotou está inmóvil sobre el agua.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220306</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.238.0/1</episode-num><episode-num system="onscreen">S16E239</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024095300 +0000" stop="20261024102200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El sueño de Ikada</sub-title><desc lang="es">Boruto se une a Ikada mientras zarpan hacia la fabrica donde conseguirán los componentes necesarios para reparar el barco.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220313</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.239.0/1</episode-num><episode-num system="onscreen">S16E240</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024102200 +0000" stop="20261024105100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El secreto de Ikada</sub-title><desc lang="es">Ahora que su barco está reparado, Boruto y los demás pronto se irán de la isla de los barqueros. Ikada, ahora amigo de Boruto, promete cumplir su sueño y hacerle una visita.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220320</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.240.0/1</episode-num><episode-num system="onscreen">S16E241</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024105100 +0000" stop="20261024112000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Seiren</sub-title><desc lang="es">Como represalia contra Boruto y sus amigos por destruir la fortaleza móvil de Tenma, los piratas desembarcan en la Isla de los Barqueros.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220327</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.241.0/1</episode-num><episode-num system="onscreen">S16E242</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024112000 +0000" stop="20261024114900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Hogar</sub-title><desc lang="es">Un mensaje codificado que se cree ha sido dejado por Funamushi revela que la Aldea Escondida de la Niebla está en peligro.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220403</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.242.0/1</episode-num><episode-num system="onscreen">S16E243</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024114900 +0000" stop="20261024121800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Fisura</sub-title><desc lang="es">Mientras Boruto y los demás preparan su plan, se enteran de que una unidad enemiga se dirige a la aldea antes que el resto.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220410</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.243.0/1</episode-num><episode-num system="onscreen">S16E244</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024121800 +0000" stop="20261024124700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Tenacidad de Funamushi</sub-title><desc lang="es">El escuadrón principal liderado por Funamushi se acerca a la aldea. Boruto y los demás permanecen a la espera, con la intención de utilizar trampas para frenar al enemigo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220417</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.244.0/1</episode-num><episode-num system="onscreen">S16E245</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024124700 +0000" stop="20261024131600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Un Duro Golpe</sub-title><desc lang="es">A pesar de haber sido arrastrados a una dura batalla, Boruto y los demás logran forzar a la unidad de Funamushi a retirarse, pero a un precio muy alto.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220424</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.245.0/1</episode-num><episode-num system="onscreen">S16E246</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024131600 +0000" stop="20261024134500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Por Kagura</sub-title><desc lang="es">A pesar de que había niños presentes, Funamushi pelea ferozmennte sin importar el daño que cause. Mientras tanto, Araumi es informado por su hijo mayor Isari que su hijo adoptivo Tenma fue asesinado en batalla.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220501</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.246.0/1</episode-num><episode-num system="onscreen">S16E247</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024134500 +0000" stop="20261024141400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Otra feroz batalla</sub-title><desc lang="es">Denki e Iwabe protegen a los ninños que los habían acompañado a buscar comida. Los niños fueron capaces de escapar, pero los shinobi fueron capturados por Funamushi y su escuadrón.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220508</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.247.0/1</episode-num><episode-num system="onscreen">S16E248</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024141400 +0000" stop="20261024144300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Odio creciente</sub-title><desc lang="es">Boruto y sus amigos logran salir triunfantes contra Funamushi, pero no pudieron disfrutar su victoria.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220515</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.248.0/1</episode-num><episode-num system="onscreen">S16E249</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024144300 +0000" stop="20261024151200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La sangre de los Funanto</sub-title><desc lang="es">Ikada regresa a casa después de enterarse que su hermana fue gravemente herida en batalla.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220522</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.249.0/1</episode-num><episode-num system="onscreen">S16E250</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024151200 +0000" stop="20261024154100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La determinación de ambos</sub-title><desc lang="es">Araumi está furioso por la pérdida de miembros de su familia y de muchos de sus subordinados durante las batallas libradas hasta el momento.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220529</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.250.0/1</episode-num><episode-num system="onscreen">S16E251</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024154100 +0000" stop="20261024161000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Deseo de Creer</sub-title><desc lang="es">Sarada, Mitsuki y Boruto deciden reunirse con el Mizukage.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220605</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.251.0/1</episode-num><episode-num system="onscreen">S16E252</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024161000 +0000" stop="20261024163900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Sentimientos Conflictivos</sub-title><desc lang="es">Boruto, Sarada y Mitsuki van a reunirse con Ikada, que ahora se contra la Tierra del Agua. Boruto intenta hablar con Ikada como amigo para que deje de luchar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220612</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.252.0/1</episode-num><episode-num system="onscreen">S16E253</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024163900 +0000" stop="20261024170800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Espiral de Venganza</sub-title><desc lang="es">Los desesperados intentos de Boruto por razonar con Ikada fracasan y no logra hacerle cambiar de opinión. Se dispone a dar su vida para impedir que la Tierra del Agua y los piratas luchen.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220619</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.253.0/1</episode-num><episode-num system="onscreen">S16E254</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024170800 +0000" stop="20261024173700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Una Tarea Complicada</sub-title><desc lang="es">La rebelión pirata que sacude a la Tierra del Agua es controlada. Al regresar con sus amigos a la Aldea Escondida de la Hoja, Boruto se pregunta qué ha sido de Ikada.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220626</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.254.0/1</episode-num><episode-num system="onscreen">S16E255</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024173700 +0000" stop="20261024180600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Receta Perfecta</sub-title><desc lang="es">Cho-Cho e Inojin terminan haciendo ramen para ayudar a un antiguo Shinobi y dueño de un restaurante de ramen de nombre Shingo Kumano a quien conocieron en una misión.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220703</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.255.0/1</episode-num><episode-num system="onscreen">S16E256</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024180600 +0000" stop="20261024183500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¿Konohamaru se convierte en el Hokage?</sub-title><desc lang="es">A Naruto le pidieron que actúe como él mismo en Malvado Jammer Kagemasa, una película de una popular serie. Konohamaru termina actuando ese rol.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220710</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.256.0/1</episode-num><episode-num system="onscreen">S16E257</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024183500 +0000" stop="20261024190400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La familia Uzumaki en las Aguas Termales</sub-title><desc lang="es">Boruto y Kawaki se unen a Naruto, Hinata y Himawari en un viaje familiar en las aguas termales. Los cinco se divierten jugando ping-pong y disfrutan la comida y las aguas termales de la posada.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220717</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.257.0/1</episode-num><episode-num system="onscreen">S16E258</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024190400 +0000" stop="20261024193300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Una Herida que Nunca Sana</sub-title><desc lang="es">Mitsuki, Boruto, y Sarada estás asitiendo con una patrulla a la aldea por petición del departamento de policía, que está teninedo dificultades al investigar una serie de misterioso ataques.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220724</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.258.0/1</episode-num><episode-num system="onscreen">S16E259</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024193300 +0000" stop="20261024200200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Fuegos Artificiales de Amor</sub-title><desc lang="es">Mientras pasean por la Aldea, Kakashi y Boruto se encuentran con un grupo de personas que discuten. Boruto se da cuenta de la cara triste de una joven pareja y se entera que están comprometidos, y sus abuelos están enfrentados.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220731</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.259.0/1</episode-num><episode-num system="onscreen">S16E260</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024200200 +0000" stop="20261024203100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Kawaki entra a la Academia Ninja!</sub-title><desc lang="es">Kawaki entra a la Academia Ninja y comienza las clases como novato junto a Himawari y los demás.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220807</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.260.0/1</episode-num><episode-num system="onscreen">S17E261</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024203100 +0000" stop="20261024210000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La fiesta del té de la princesa</sub-title><desc lang="es">A Kawaki le cuesta acostumbrarse a la vida escolar, pero consigue hacerse amigo de la princesa Kae, objeto de su misión de guardia. Mientras tanto,</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220814</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.261.0/1</episode-num><episode-num system="onscreen">S17E262</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024210000 +0000" stop="20261024212900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Las cualidades de Hana Sensei!</sub-title><desc lang="es">Boruto, Sarada y Mitsuki dan una conferencia especial en la Academia para estudiantes de primer año como Kawaki y Himawari.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220821</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.262.0/1</episode-num><episode-num system="onscreen">S17E263</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024212900 +0000" stop="20261024215800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡El grupo de exploración de los Siete Misterios!</sub-title><desc lang="es">Tras conocer los \&quot;Siete Misterios\&quot; en la Academia Ninja, Himawari y varios de sus compañeros deciden ir a investigarlos por la noche.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220828</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.263.0/1</episode-num><episode-num system="onscreen">S17E264</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024215800 +0000" stop="20261024222700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Duelo de equipos: ejercicios prácticos!</sub-title><desc lang="es">Kawaki y Himawari participan en una sesión de entrenamiento en el bosque cercano a la academia. La clase se divide en equipos de tres personas y Kawaki acaba en un equipo diferente al de Kae.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220904</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.264.0/1</episode-num><episode-num system="onscreen">S17E265</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
