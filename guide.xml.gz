<programme start="20261125042403 +0000" stop="20261125045203 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La aventura escolar de Pepe</sub-title><desc lang="es">¡Exploremos la escuela! ¡Ayuda a Dora, a su nuevo amigo Pepe Cerdito, y a su clase a ganar tres estrellas doradas para ir a la Fiesta de Palomitas mientras exploran la Clase de Música, la de Historia y la clase de Matemáticas también!</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.11.0/1</episode-num><episode-num system="onscreen">S06E12</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125045203 +0000" stop="20261125052003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora salva el Día de los Reyes Magos</sub-title><desc lang="es">¡Es el día de los Reyes Magos! Dora, Botas y Diego se disfrazan como reyes y se dirigen a la fiesta, pero necesitarán tu ayuda cuando Zorro aparece y espanta a los animales del lugar.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.2.0/1</episode-num><episode-num system="onscreen">S05E03</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125052003 +0000" stop="20261125054703 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La aventura pirata de Dora - PARTE UNO</sub-title><desc lang="es">Dora, Botas y sus amigos preparan una obra de piratas para sus familias. Cuando está por comenzar, los Cerditos Piratas se roban los disfraces.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080713</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.24.0/1</episode-num><episode-num system="onscreen">S03E25</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125054703 +0000" stop="20261125061903 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La aventura pirata de Dora - PARTE DOS</sub-title><desc lang="es">Dora, Botas y sus amigos se embarcan en esta aventura musical para recuperar el cofre que los Cerditos Piratas les robaron. Tendrán que llegar a la Isla del Tesoro y regresar a tiempo para la obra. ¿Lo lograrán?</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.25.0/1</episode-num><episode-num system="onscreen">S03E26</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125061903 +0000" stop="20261125064703 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Las cosas favoritas de Zorro</sub-title><desc lang="es">Zorro estaba usando su Giro-Súper- Zorro para empacar todas sus cosas favoritas y llevarlas a casa de su abuela. Cuando llegó un fuerte viento y todas sus cosas salieron volando. ¡Zorro necesita ayuda para encontrar sus cosas favoritas!</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.19.0/1</episode-num><episode-num system="onscreen">S06E20</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125064703 +0000" stop="20261125071603 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">¡Al Polo Sur!</sub-title><desc lang="es">El Camión de Rescate llega al Centro de Animales de Diego para dejar un animalito perdido: ¡un pingüino! Es el trabajo de Dora, Botas y Diego llevar a Pingüino hasta su casa en el Polo Sur.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080711</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.12.0/1</episode-num><episode-num system="onscreen">S03E13</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125071603 +0000" stop="20261125074503 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Somos un equipo</sub-title><desc lang="es">Dora y sus amigos están en la Súper Aventura de Carreras. Para ganar la carrera tienen que cruzar el engañoso Puente del Duende, pasar por el Volcán y atravesar la gran Muralla.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.13.0/1</episode-num><episode-num system="onscreen">S04E14</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125074503 +0000" stop="20261125081303 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El tesoro de Benny</sub-title><desc lang="es">Cuando el camión de la basura se lleva a Mochila y a Mapa por accidente, rescatarlos depende de Dora, Botas y el carrito de tesoros de Benny.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.11.0/1</episode-num><episode-num system="onscreen">S05E12</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125081303 +0000" stop="20261125084203 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Bebé cangrejo</sub-title><desc lang="es">Dora y Botas se están divirtiendo en la playa cuando, de repente, escuchan que alguien pide ayuda. ¡Es un cangrejo bebé atrapado en una red!</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.16.0/1</episode-num><episode-num system="onscreen">S04E17</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125084203 +0000" stop="20261125091103 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora salva el partido</sub-title><desc lang="es">La prima de Dora, Daisy, jugará en un partido de fútbol que se trasmitirá por la televisión. Pero al equipo le falta una jugadora. Daisy le pide a Dora que sea ella quien complete el equipo. ¡Corre, Dora, corre!</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080712</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.13.0/1</episode-num><episode-num system="onscreen">S03E14</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125091103 +0000" stop="20261125094003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La maestra de música</sub-title><desc lang="es">¡Hoy es un gran día para ir a la escuela! La maestra de música de Botas, necesita ir a la escuela rápidamente, pero ¡su bicicleta está rota!</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.4.0/1</episode-num><episode-num system="onscreen">S04E05</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125094003 +0000" stop="20261125100903 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora, la hermana mayor</sub-title><desc lang="es">Dora tiene buenas noticias: ¡alguien nuevo se suma a la familia! Alguien que duerme en una cuna, toma de un biberón y le gusta mucho dormir. ¡Un bebé! La mamá de Dora tendrá un bebé.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.10.0/1</episode-num><episode-num system="onscreen">S04E11</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125100903 +0000" stop="20261125103703 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El show de magia del Gran Pollo Rojo</sub-title><desc lang="es">En un truco de magia el Gran Pollo Rojo se convierte del tamaño de un conejo. Dora y Botas deben ir a Tierra Mágica con él, para encontrar la varita mágica y convertirlo en grande otra vez.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.10.0/1</episode-num><episode-num system="onscreen">S05E11</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125103703 +0000" stop="20261125110603 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">¡Conozcan a Diego!</sub-title><desc lang="es">Conozcan a Diego, el primo de Dora. Diego trabaja en el Centro de Rescate de Animales. Puede hacer el sonido de los animales y hablar con los animales salvajes.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">2.7.0/1</episode-num><episode-num system="onscreen">S03E08</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125110603 +0000" stop="20261125113503 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El día del trabajo</sub-title><desc lang="es">¿Qué quiéres ser cuando seas grande? Dora y Botas prueban toda clase de trabajos, desde bomberos, hasta doctores y arqueólogos. Pero, ¿qué decidirá ser Dora cuando crezca?</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.23.0/1</episode-num><episode-num system="onscreen">S03E24</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125113503 +0000" stop="20261125120503 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El adorable dinosaurio de Botas</sub-title><desc lang="es">¡Dora y Botas están haciendo una pijamada! Es la hora de irse a dormir y Dora tiene su osito de peluche, pero Botas no puede encontrar a su dinosaurio. ¡Oh, no! Su dinosaurio debe haberse caído de su mochila cuando estaban en el parque.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.17.0/1</episode-num><episode-num system="onscreen">S03E18</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125120503 +0000" stop="20261125123403 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Mejores amigos</sub-title><desc lang="es">¡Hoy es el día de los mejores amigos! En este día especial, Dora y Botas se van de picnic para celebrar. Botas lleva chocolate y Dora, deliciosas fresas. Pero, depende de nosotros ayudarlos a encontrarse en la Piedra Arco Iris.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.21.0/1</episode-num><episode-num system="onscreen">S03E22</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125123403 +0000" stop="20261125130203 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">La primera bicicleta de Botas</sub-title><desc lang="es">¡Botas está listo para su primera bicicleta de chico grande! ¡Ayuda a Dora a llevarlo a la Tienda de Bicicletas, y ayuda también a otros amigos a intentar cosas nuevas por primera vez!</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.10.0/1</episode-num><episode-num system="onscreen">S06E11</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125130203 +0000" stop="20261125133103 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Roberto el robot</sub-title><desc lang="es">Dora y Botas conocen a Roberto, un robot con un cinturón de herramientas, luces, poderes de estiramiento y mucha fuerza. Pero Roberto está perdido y no encuentra a su abuelo. ¿Lo ayudamos?</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080710</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.3.0/1</episode-num><episode-num system="onscreen">S03E04</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125133103 +0000" stop="20261125140103 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Al rescate</sub-title><desc lang="es">¡Oh, no! Tres de nuestros amigos están en problemas. El bebé Jaguar está atrapado en un árbol, Isa cayó en un pozo de arena y Benny está atrapado en el Géiser Pegajoso. ¿A quién rescatamos primero?</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.16.0/1</episode-num><episode-num system="onscreen">S03E17</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125140103 +0000" stop="20261125143003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora tiene un perrito</sub-title><desc lang="es">Abuela le da a Dora y Botas un regalo para el nuevo perrito de Dora. Pero, en su camino a casa, deberán tener cuidado con Zorro.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.9.0/1</episode-num><episode-num system="onscreen">S04E10</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261125143003 +0000" stop="20261125145903 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El rugido de bebé Jaguar</sub-title><desc lang="es">¡Oh, no! El mejor amigo de Bebé Jaguar, el Bebé Oso, está atrapado en el borde de una montaña y se está por caer. Con Bebé Jaguar como líder, Dora, Botas y Diego corren al rescate.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.7.0/1</episode-num><episode-num system="onscreen">S04E08</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
