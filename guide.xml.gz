<programme start="20261108140000 +0000" stop="20261108150000 +0000" channel="Smithsonian Channel"><title lang="en">Aerial America</title><sub-title lang="en">New York</sub-title><desc lang="en">Beauty of the Empire State; Central Park; tallest skyscrapers; mighty rivers; 17th century explorer Henry Hudson.</desc><category lang="en">Documentary</category><rating system="MPA"><value>TV-G</value></rating><icon src="https://cdn.tvpassport.com/image/show/960x540/v2/p8811095_b_v8_ap.jpg"/></programme>
