<programme start="20261120010503 +0000" stop="20261120013403 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Dora, la hermana mayor</sub-title><desc lang="es">Dora tiene buenas noticias: ¡alguien nuevo se suma a la familia! Alguien que duerme en una cuna, toma de un biberón y le gusta mucho dormir. ¡Un bebé! La mamá de Dora tendrá un bebé.</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.10.0/1</episode-num><episode-num system="onscreen">S04E11</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
