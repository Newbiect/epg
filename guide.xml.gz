<programme start="20261128180600 +0000" stop="20261128190700 +0000" channel="Love Nature 🇺🇸"><title lang="en">Scotland: A Wild Year</title><sub-title lang="en">Autumn</sub-title><desc lang="en">It&apos;s autumn in Scotland and the clock is ticking; as daylight diminishes and the weather cools, food resources dwindle; animals must either migrate now or prepare to face the winter head-on.</desc><credits><director>Matt Thompson</director><actor>John Hannah</actor></credits><date>20210709</date><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>US_UPR_TV-PG</value></rating><icon src="http://p-img.movetv.com/1920x1080/e43720f28634d26604fe75be6a338641.jpeg"/></programme>
