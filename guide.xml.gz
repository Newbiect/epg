<programme start="20261106053400 +0000" stop="20261106060000 +0000" channel="Yu-Gi-Oh"><title lang="es">¡Yu-Gi-Oh! VRAINS</title><sub-title lang="es">Batalla sobre las nubes</sub-title><desc lang="es">Playmaker se encuentra con Bohman, quien quiere combatir contra él. En el combate le revelará algo aterrador.</desc><credits><actor>Wayne Grayson</actor><actor>Megan Hollingshead</actor><actor>Eric Stuart</actor><actor>Darren Dunstan</actor><actor>Dan Green</actor><actor>Amy Birnbaum</actor></credits><date>20020101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.10.0/1</episode-num><episode-num system="onscreen">S02E11</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/60022cb472b3e1001a660ccc/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
