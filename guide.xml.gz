<programme start="20261112040700 +0000" stop="20261112055500 +0000" channel="Pluto TV Naturaleza"><title lang="es">Los Secretos del Mar del Norte</title><sub-title lang="es">Los Secretos del Mar del Norte</sub-title><desc lang="es">El Mar del Norte es extraordinariamente variado y sorprendentemente desconocido, con un mundo submarino diversificado a menudo difícilmente accesible.</desc><credits><actor>Jonathan Sharp</actor></credits><date>20130101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/67ae18686d9b28853dc5c6a2/tile_1769466976711.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112040700 +0000" stop="20261112055500 +0000" channel="Pluto TV Naturaleza"><title lang="es">Los Secretos del Mar del Norte</title><sub-title lang="es">Los Secretos del Mar del Norte</sub-title><desc lang="es">El Mar del Norte es extraordinariamente variado y sorprendentemente desconocido, con un mundo submarino diversificado a menudo difícilmente accesible.</desc><credits><actor>Jonathan Sharp</actor></credits><date>20130101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/67ae18686d9b28853dc5c6a2/tile_1769466976711.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112055500 +0000" stop="20261112065700 +0000" channel="Pluto TV Naturaleza"><title lang="es">Sombras en un Mar Desierto</title><sub-title lang="es">Sombras en un Mar Desierto</sub-title><desc lang="es">Este perfil visualmente aturdidor de la vida de mar se zambulle en la extensión de mil millas del echar agua a lo largo de California Baja y el Océano Pacífico.</desc><date>19920101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>G</value></rating><icon src="https://images.pluto.tv/series/5e3d97c84d0ed0663d606a4c/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112065700 +0000" stop="20261112075700 +0000" channel="Pluto TV Naturaleza"><title lang="es">Historias del Bosque Mediterráneo</title><sub-title lang="es">El guerrero blindado</sub-title><desc lang="es">Los frondosos bosques europeos son el hábitat perfecto para un animal enorme pero tímido, el jabalí. Seguimos la vida de dos hermanos jabalíes.</desc><credits><actor>Stephan Hughes</actor></credits><date>20170101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/67d82db046d66c4aa0c2f0ff/tile_1776895817047.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112075700 +0000" stop="20261112085700 +0000" channel="Pluto TV Naturaleza"><title lang="es">Historias del Bosque Mediterráneo</title><sub-title lang="es">Cuentos de primavera</sub-title><desc lang="es">¿Sabías que sólo hay dos zonas templadas de nuestro planeta en las que realmente llega la primavera? Lo que a la mayoría de nosotros nos parece el acontecimiento más normal es un verdadero milagro de la naturaleza.</desc><credits><actor>Stephan Hughes</actor></credits><date>20170101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/67d82db046d66c4aa0c2f0ff/tile_1776895817047.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112085700 +0000" stop="20261112095700 +0000" channel="Pluto TV Naturaleza"><title lang="es">Historias del Bosque Mediterráneo</title><sub-title lang="es">Los habitantes ocultos de Sierra Morena</sub-title><desc lang="es">En esta tierra donde las temperaturas en verano suelen superar los 30º Celsius (86º Fahrenheit), la vida durante los meses más calurosos del año se vuelve especialmente complicada.</desc><credits><actor>Stephan Hughes</actor></credits><date>20170101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/67d82db046d66c4aa0c2f0ff/tile_1776895817047.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112095700 +0000" stop="20261112105700 +0000" channel="Pluto TV Naturaleza"><title lang="es">Historias del Bosque Mediterráneo</title><sub-title lang="es">La reina de la noche</sub-title><desc lang="es">Muchos depredadores prefieren salir a cazar cuando la luna está alta en el cielo. Y ese es el momento en el que nuestra protagonista hace su aparición.</desc><credits><actor>Stephan Hughes</actor></credits><date>20170101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/67d82db046d66c4aa0c2f0ff/tile_1776895817047.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112105700 +0000" stop="20261112115700 +0000" channel="Pluto TV Naturaleza"><title lang="es">Historias del Bosque Mediterráneo</title><sub-title lang="es">Horario de invierno</sub-title><desc lang="es">El clima juega un papel profundo en la vida de todos los seres vivos. El ciclo de cuatro estaciones que se desarrolla en las zonas templadas del planeta condiciona profundamente la vida y el comportamiento de sus habitantes.</desc><credits><actor>Stephan Hughes</actor></credits><date>20170101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/67d82db046d66c4aa0c2f0ff/tile_1776895817047.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112115700 +0000" stop="20261112125900 +0000" channel="Pluto TV Naturaleza"><title lang="es">Sobreviviendo en la laguna</title><sub-title lang="es">Sobreviviendo en la laguna</sub-title><desc lang="es">En el corazón de un vasto océano, los atolones del Pacífico son como oasis en un extenso desierto. Cada uno contiene un entorno único e impresionante. Donde se rompe el arrecife, florece el ecosistema de la laguna.</desc><date>20181005</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67ae186b6d9b28853dc6386a/tile_1776896511337.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112125900 +0000" stop="20261112140100 +0000" channel="Pluto TV Naturaleza"><title lang="es">Las islas canarias</title><sub-title lang="es">Las islas canarias</sub-title><desc lang="es">Forjadas por el fuego y esculpidas por los vientos y las olas, las Islas Canarias ofrecen paisajes de una fuerza colosal y una belleza casi irreal.</desc><date>20140707</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67ae18756d9b28853dc6ac18/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112140100 +0000" stop="20261112150200 +0000" channel="Pluto TV Naturaleza"><title lang="es">Las facetas silvestres de Suiza</title><sub-title lang="es">Las montañas del Jura</sub-title><desc lang="es">Este episodio explora una parte relativamente oscura del país: las montañas del Jura. Es un emocionante viaje de descubrimiento a una naturaleza casi intacta a través de las estaciones.</desc><date>20180618</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67d83d28e8cf626542f03997/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112150200 +0000" stop="20261112160200 +0000" channel="Pluto TV Naturaleza"><title lang="es">Las facetas silvestres de Suiza</title><sub-title lang="es">Tesino</sub-title><desc lang="es">Este episodio se centra en Ticino, desde las escarpadas montañas de los Alpes de Tessin hasta el encantador valle de Muggio en su rincón más al sur. Es un área tan rica en contrastes que es difícil de superar.</desc><date>20180618</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67d83d28e8cf626542f03997/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112160200 +0000" stop="20261112170300 +0000" channel="Pluto TV Naturaleza"><title lang="es">Las facetas silvestres de Suiza</title><sub-title lang="es">Agua y Hielo</sub-title><desc lang="es">Realice un viaje increíble desde los picos más altos de las Tierras Altas de Berna a lo largo de los ríos Aar y Rin hasta un final espectacular en las cataratas del Rin, cerca de Schaffhausen.</desc><date>20180618</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67d83d28e8cf626542f03997/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
