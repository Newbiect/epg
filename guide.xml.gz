<programme start="20261015062800 +0000" stop="20261015065400 +0000" channel="Yu-Gi-Oh"><title lang="es">¡Yu-Gi-Oh! VRAINS</title><sub-title lang="es">El retorno de Hanoi</sub-title><desc lang="es">Los Caballeros de Hanoi preparan el rescate de la doctora Taki, Vira, para retomar sus actividades.</desc><credits><actor>Wayne Grayson</actor><actor>Megan Hollingshead</actor><actor>Eric Stuart</actor><actor>Darren Dunstan</actor><actor>Dan Green</actor><actor>Amy Birnbaum</actor></credits><date>20020102</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.12.0/1</episode-num><episode-num system="onscreen">S02E13</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/60022cb472b3e1001a660ccc/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015065400 +0000" stop="20261015072100 +0000" channel="Yu-Gi-Oh"><title lang="es">¡Yu-Gi-Oh! VRAINS</title><sub-title lang="es">Brave Max el Perdedor</sub-title><desc lang="es">Blue Angel y Ghost Girl buscan pistas sobre la identidad real de Playmaker, así que intentan investigar a Brave Max, quien dice ser su fiel amigo, en busca de pistas.</desc><credits><actor>Wayne Grayson</actor><actor>Megan Hollingshead</actor><actor>Eric Stuart</actor><actor>Darren Dunstan</actor><actor>Dan Green</actor><actor>Amy Birnbaum</actor></credits><date>20020102</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.13.0/1</episode-num><episode-num system="onscreen">S02E14</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/60022cb472b3e1001a660ccc/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
