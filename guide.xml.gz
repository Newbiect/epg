<programme start="20261015030700 +0000" stop="20261015035900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Sueño ligero</sub-title><desc lang="es">Gibbs y el equipo investigan la muerte de las esposas de dos marinos. Temen que los asesinatos tengan motivos raciales, ya que las dos mujeres son asiáticas.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.13.0/1</episode-num><episode-num system="onscreen">S03E14</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
