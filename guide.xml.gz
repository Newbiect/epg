<programme start="20261102185200 +0000" stop="20261102192200 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">La Joven que Cruzó la Barrera del Tiempo</sub-title><desc lang="es">Años después de ser sellada, el medio demonio Inuyasha es despertado por una chica de preparatoria llamada Kagome, cuyo tiempo ha regresado al período Sengoku.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20001016</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102192200 +0000" stop="20261102195200 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">Seres en Busca de la Perla de Shikon</sub-title><desc lang="es">Con el poder de controlar a Inuyasha, Kagome descubre que puede ser la reencarnación de la hermana mayor de Kaede, Kikyo, quien selló a Inuyasha.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20001023</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102195200 +0000" stop="20261102202200 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">El Regreso de Aome</sub-title><desc lang="es">Kagome e Inuyasha necesitan la habilidad del otro para reunir los fragmentos dispersos de la Joya Shikon, pero los dos no se llevan bien.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20001030</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102202200 +0000" stop="20261102205200 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">Yura, el Demonio de los Cabellos</sub-title><desc lang="es">De vuelta en el presente, Kagome se está relajando en casa cuando Inuyasha viene a buscarla, y ella regresa con él al pasado para encontrar a Yura.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20001106</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102205200 +0000" stop="20261102212200 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">El Malvado Sesshoumaru</sub-title><desc lang="es">El medio hermano de Inuyasha, Sesshomaru, aparece en busca de la tumba de su padre, que era un perro demonio. Kagome aprende sobre el pasado de Inuyasha.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20001113</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102212200 +0000" stop="20261102215200 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">La Misteriosa Espada, Colmillo de Acero</sub-title><desc lang="es">A pesar de la ayuda de Kagome para frustrarlo, Sesshomaru descubre la ubicación de la tumba del padre de Inuyasha, que contiene una espada que desea.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20001120</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.5.0/1</episode-num><episode-num system="onscreen">S01E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
