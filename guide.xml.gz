<programme start="20261111110700 +0000" stop="20261111113500 +0000" channel="Pluto TV Anime"><title lang="es">Naruto Shippuden</title><sub-title lang="es">EL OJO DEL HALCÓN</sub-title><desc lang="es">Impulsado por su deseo del Sharingan, Orochimaru finalmente le roba a Sasuke su libertad.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20090618</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">5.113.0/1</episode-num><episode-num system="onscreen">S06E114</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69f0f43b8f919a54cfebf256/tile_1777398844276.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111113500 +0000" stop="20261111120300 +0000" channel="Pluto TV Anime"><title lang="es">Naruto Shippuden</title><sub-title lang="es">LA ESPADA DE ZABUZA</sub-title><desc lang="es">Suigetsu llega a un acuerdo: si puede obtener la espada de Zabuza, se unirá a Sasuke.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20090625</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">5.114.0/1</episode-num><episode-num system="onscreen">S06E115</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69f0f43b8f919a54cfebf256/tile_1777398844276.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111120300 +0000" stop="20261111123100 +0000" channel="Pluto TV Anime"><title lang="es">Naruto Shippuden</title><sub-title lang="es">LA GUARDIANA DE LOS MUROS DE ACERO</sub-title><desc lang="es">Sasuke y Suigetsu visitan el escondite del sur para reclutar a su próximo miembro, Karin.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20090702</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">5.115.0/1</episode-num><episode-num system="onscreen">S06E116</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69f0f43b8f919a54cfebf256/tile_1777398844276.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
