<programme start="20261029003000 +0000" stop="20261029012300 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Cosas buenas aquí fuera</sub-title><desc lang="es">Madison y Morgan intentan ayudar a Nick a encontrar la paz interior. Una misión en busca de venganza le pasa factura al grupo.</desc><credits><director>Dan Liu</director><actor>Kim Dickens</actor><actor>Frank Dillane</actor><actor>Alycia Debnam-Carey</actor><actor>Ruben Blades</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Maggie Grace</actor><actor>Garret Dillahunt</actor><actor>Lennie James</actor><actor>Jenna Elfman</actor><actor>Alexa Nisenson</actor><actor>Kenneth Bradley</actor><actor>Evan Gamble</actor><actor>Kevin Zegers</actor></credits><date>20180429</date><episode-num system="xmltv_ns">3.2.0/1</episode-num><episode-num system="onscreen">S04E03</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/e0c8656c048b2a4c4957707fb96e69d348bd243e.jpg"/></programme>
<programme start="20261029012300 +0000" stop="20261029021900 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Enterrado</sub-title><desc lang="es">El interrogatorio de Al revela algunos secretos sorprendentes sobre el pasado del grupo. John Dorie recibe noticias inesperadas.</desc><credits><actor>Kim Dickens</actor><actor>Frank Dillane</actor><actor>Alycia Debnam-Carey</actor><actor>Ruben Blades</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Maggie Grace</actor><actor>Garret Dillahunt</actor><actor>Lennie James</actor><actor>Jenna Elfman</actor><actor>Kevin Zegers</actor><actor>Sebastian Sozzi</actor><actor>Evan Gamble</actor><actor>Alexa Nisenson</actor></credits><date>20180506</date><episode-num system="xmltv_ns">3.3.0/1</episode-num><episode-num system="onscreen">S04E04</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/ef95b7a9c9469e77e32f3f5efe315d7eec719a24.jpg"/></programme>
<programme start="20261029021900 +0000" stop="20261029031400 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Laura</sub-title><desc lang="es">La llegada inesperada de un visitante herido en la vida de John Dorie lo obliga a reevaluar y cambiar sus costumbres.</desc><credits><director>Michael Satrazemis</director><actor>Kim Dickens</actor><actor>Frank Dillane</actor><actor>Alycia Debnam-Carey</actor><actor>Ruben Blades</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Maggie Grace</actor><actor>Garret Dillahunt</actor><actor>Lennie James</actor><actor>Jenna Elfman</actor></credits><date>20180513</date><episode-num system="xmltv_ns">3.4.0/1</episode-num><episode-num system="onscreen">S04E05</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/aff31820c931cc2288858fa0dd83ef3876e3c94c.jpg"/></programme>
<programme start="20261029031400 +0000" stop="20261029040900 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Por si acaso</sub-title><desc lang="es">En el estadio las cosas toman un camino inesperado. Strand, por su parte, tiene problemas para aceptar la decisión de Madison.</desc><credits><director>Daisy von Scherler Mayer</director><actor>Kim Dickens</actor><actor>Frank Dillane</actor><actor>Alycia Debnam-Carey</actor><actor>Ruben Blades</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Maggie Grace</actor><actor>Garret Dillahunt</actor><actor>Lennie James</actor><actor>Jenna Elfman</actor><actor>Kevin Zegers</actor><actor>Sebastian Sozzi</actor><actor>Evan Gamble</actor><actor>Rhoda Griffis</actor><actor>Alexa Nisenson</actor><actor>E. Jason Liebrecht</actor></credits><date>20180520</date><episode-num system="xmltv_ns">3.5.0/1</episode-num><episode-num system="onscreen">S04E06</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/7ba1c299db1f647837bf27f882d915b0e15db887.jpg"/></programme>
<programme start="20261029040900 +0000" stop="20261029050300 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">El lado malo de donde estás</sub-title><desc lang="es">La decisión de Madison de ayudar a su enemigo va a tener consecuencias trágicas. Mientras tanto, John Dorie se aferra a la vida con todas sus fuerzas.</desc><credits><director>Sarah Boyd</director><actor>Kim Dickens</actor><actor>Frank Dillane</actor><actor>Alycia Debnam-Carey</actor><actor>Maggie Grace</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Garret Dillahunt</actor><actor>Lennie James</actor><actor>Alexa Nisenson</actor><actor>Sebastian Sozzi</actor><actor>Kenneth Bradley</actor><actor>Rhoda Griffis</actor><actor>Evan Gamble</actor><actor>Kevin Zegers</actor><actor>E. Jason Liebrecht</actor><actor>Tammie Baird</actor></credits><date>20180603</date><episode-num system="xmltv_ns">3.6.0/1</episode-num><episode-num system="onscreen">S04E07</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/09c05961f1eb892ce37d7d6e6ed4d1b08df73abe.jpg"/></programme>
<programme start="20261029050300 +0000" stop="20261029055500 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Nadie se ha ido</sub-title><desc lang="es">Mientras Madison trata de proteger la vida que tanto trabajo le llevó construir, Morgan intenta hacer lo correcto.</desc><credits><director>Michael Satrazemis</director><actor>Kim Dickens</actor><actor>Frank Dillane</actor><actor>Alycia Debnam-Carey</actor><actor>Maggie Grace</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Garret Dillahunt</actor><actor>Lennie James</actor><actor>Alexa Nisenson</actor><actor>Sebastian Sozzi</actor><actor>Kenneth Bradley</actor><actor>Kevin Zegers</actor><actor>Rhoda Griffis</actor><actor>Tommy Kendrick</actor><actor>Nasir Villanueva</actor><actor>Soleil Patterson</actor></credits><date>20180610</date><episode-num system="xmltv_ns">3.7.0/1</episode-num><episode-num system="onscreen">S04E08</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/7493d0541f0e066b586950e1ba439a34ab9f99d2.jpg"/></programme>
<programme start="20261029055500 +0000" stop="20261029065000 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Como nosotros</sub-title><desc lang="es">Morgan intenta ayudar a Alicia y a este fragmentado grupo de supervivientes mientras se forma una tormenta.</desc><credits><director>Magnus Martens</director><actor>Lennie James</actor><actor>Alycia Debnam-Carey</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Garret Dillahunt</actor><actor>Maggie Grace</actor><actor>Jenna Elfman</actor><actor>Alexa Nisenson</actor></credits><date>20180812</date><episode-num system="xmltv_ns">3.8.0/1</episode-num><episode-num system="onscreen">S04E09</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/77b66feed784139bc12aea20fadc897bbaf05002.jpg"/></programme>
<programme start="20261029065000 +0000" stop="20261029074600 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Cierra los ojos</sub-title><desc lang="es">Mientras busca refugio contra una tormenta, Alicia se reencuentra con una antigua enemiga: Charlie, lo que le obliga a recordar su traumático pasado. La lluvia, el viento y los muertos vivientes ponen a ambas en peligro.</desc><credits><director>Michael Satrazemis</director><actor>Alycia Debnam-Carey</actor><actor>Alexa Nisenson</actor></credits><date>20180819</date><episode-num system="xmltv_ns">3.9.0/1</episode-num><episode-num system="onscreen">S04E10</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/b962d13f725a213ac75afff373a54649d03cf45f.jpg"/></programme>
<programme start="20261029074600 +0000" stop="20261029084100 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">El código</sub-title><desc lang="es">Morgan se oculta de la tormenta en un camión y despierta muy lejos de Texas. En su nuevo destino encuentra una estación de servicio repleta de productos, pero también a unos misteriosos desconocidos que podrían no ser quienes afirman.</desc><credits><director>Tara Weyr</director><actor>Lennie James</actor><actor>Daryl Mitchell</actor><actor>Mo Collins</actor><actor>Aaron Stanford</actor><actor>Tonya Pinkins</actor></credits><date>20180826</date><episode-num system="xmltv_ns">3.10.0/1</episode-num><episode-num system="onscreen">S04E11</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/ef2f07025ceed92fa3edf0e0135048dcd14de035.jpg"/></programme>
<programme start="20261029084100 +0000" stop="20261029093400 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Débil</sub-title><desc lang="es">June presta ayuda cuando la salud de Al se deteriora. Mientras tanto, Morgan busca a sus amigos extraviados en la tormenta.</desc><credits><director>Colman Domingo</director><actor>Lennie James</actor><actor>Garret Dillahunt</actor><actor>Maggie Grace</actor><actor>Jenna Elfman</actor><actor>Daryl Mitchell</actor><actor>Mo Collins</actor><actor>Aaron Stanford</actor><actor>Tonya Pinkins</actor><actor>Charles Harrelson</actor></credits><date>20180902</date><episode-num system="xmltv_ns">3.11.0/1</episode-num><episode-num system="onscreen">S04E12</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/a05b13e3265ccecd42e1b030e95242ea9104874d.jpg"/></programme>
<programme start="20261029093400 +0000" stop="20261029102700 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Blackjack</sub-title><desc lang="es">Strand y Dorie están abandonados. Luciana ayuda a un hombre en problemas. Los esfuerzos del grupo para ayudar a un extraño los ponen en peligro a todos.</desc><credits><director>Sharat Raju</director><actor>Lennie James</actor><actor>Alycia Debnam-Carey</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Garret Dillahunt</actor><actor>Maggie Grace</actor><actor>Jenna Elfman</actor><actor>Alexa Nisenson</actor><actor>Daryl Mitchell</actor><actor>Mo Collins</actor><actor>Aaron Stanford</actor><actor>Tonya Pinkins</actor><actor>Charles Harrelson</actor><actor>Stephen Henderson</actor></credits><date>20180909</date><episode-num system="xmltv_ns">3.12.0/1</episode-num><episode-num system="onscreen">S04E13</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/3171300a72f7547ac38443f3c928bdc69fae3699.jpg"/></programme>
