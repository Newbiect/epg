<programme start="20261014023000 +0000" stop="20261014030000 +0000" channel="Crunchyroll 🇺🇸"><title lang="en">Steins;Gate</title><sub-title lang="en">Chaos Theory Homeostasis - I</sub-title><desc lang="en">The latest experiment for Okabe and his lab mates leads to the disappearance of one of their own; they attempt to use their time travel technology to make a young boy&apos;s dream a reality.</desc><credits><director>Hiroshi Hamasaki</director><actor>J. Tatum</actor><actor>Trina Nishimura</actor><actor>Ashly Burch</actor><actor>Tyson Rinehart</actor><actor>Cherami Leigh</actor><actor>Jad Saxton</actor><actor>Lindsay Seidel</actor></credits><date>19010101</date><episode-num system="xmltv_ns">0.7.0/1</episode-num><episode-num system="onscreen">S01E08</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/aca1cdc79e3da3e3e65ad7cd93926e3d.jpeg"/></programme>
