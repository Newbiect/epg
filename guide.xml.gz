<programme start="20261018113000 +0000" stop="20261018123000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Esclavas de Las Vegas</sub-title><desc lang="es">Grissom y Catherine investigan la aparente muerte violenta de una mujer encontrada en un arenero. Su investigación les lleva al mundo clandestino de los clubes de s y m.</desc><credits><actor>Robert Hall</actor><actor>Wallace Langham</actor><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Jorja Fox</actor></credits><date>20011115</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.7.0/1</episode-num><episode-num system="onscreen">S02E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018123000 +0000" stop="20261018133000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Y después no hubo ninguno</sub-title><desc lang="es">Grissom y su equipo investigan un atraco a un casino durante el cual se disparó a víctimas inocentes, mientras que Catherine y Sara son llamadas a la escena de un asesinato en un lugar remoto del desierto.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20011122</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.8.0/1</episode-num><episode-num system="onscreen">S02E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018133000 +0000" stop="20261018143000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Ellie</sub-title><desc lang="es">Warrick se pone al mando por primera vez cuando el equipo investiga el asesinato del estafador, que ha huido con el dinero de unos turistas sólo para ser tiroteado y asesinado en el aparcamiento.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20011206</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.9.0/1</episode-num><episode-num system="onscreen">S02E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018143000 +0000" stop="20261018153000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Triturador de órganos</sub-title><desc lang="es">El equipo de CSI es llamado cuando un famoso empresario inmobiliario aparece muerto en el ascensor de un hotel.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20011213</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.10.0/1</episode-num><episode-num system="onscreen">S02E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018153000 +0000" stop="20261018163000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Tienes Hombre</sub-title><desc lang="es">Grissom y Sara son llamados a la escena del crimen cuando dos víctimas de asesinato aparecen ocultas en las tuberías de una obra en construcción en medio de un campo de alfalfa, mientras Catherine y Nick investigan un ostensible accidente de caza.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20011220</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.11.0/1</episode-num><episode-num system="onscreen">S02E12</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018163000 +0000" stop="20261018173000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Crisis de identidad</sub-title><desc lang="es">La némesis de Grissom, el asesino en serie Paul Millander, reaparece y se cobra una tercera víctima en este apasionante episodio.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20020117</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.12.0/1</episode-num><episode-num system="onscreen">S02E13</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018173000 +0000" stop="20261018183000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">El dedo</sub-title><desc lang="es">Un secuestrador ordena a Catherine que acompañe a un hombre que debe entregarle un rescate de un millón de dólares o, de lo contrario, matará a la amante del hombre.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20020131</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.13.0/1</episode-num><episode-num system="onscreen">S02E14</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018183000 +0000" stop="20261018193000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">La carga de las pruebas</sub-title><desc lang="es">Grissom investiga el asesinato de un fotógrafo de Las Vegas cuyos restos fueron arrojados a una granja de cadáveres cercana.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20020207</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.14.0/1</episode-num><episode-num system="onscreen">S02E15</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018193000 +0000" stop="20261018203000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Primun non nocere</sub-title><desc lang="es">Grissom, Catherine y Sara tienen que investigar la muerte de un jugador de hockey durante un entrenamiento. Warrick y Nick investigan la aparente muerte relacionada con las drogas de un saxofonista en un casino.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20020228</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.15.0/1</episode-num><episode-num system="onscreen">S02E16</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018203000 +0000" stop="20261018213000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Monje perverso</sub-title><desc lang="es">Grissom investiga los asesinatos de cuatro monjes que fueron tiroteados a quemarropa mientras cantaban en un templo budista.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20020307</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.16.0/1</episode-num><episode-num system="onscreen">S02E17</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018213000 +0000" stop="20261018223000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Persiguiendo el autobus</sub-title><desc lang="es">Un autobús que transportaba 23 pasajeros de Los Ángeles a Las Vegas se estrella a menos de 40 millas de su destino, matando a nueve personas.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20020328</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.17.0/1</episode-num><episode-num system="onscreen">S02E18</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
