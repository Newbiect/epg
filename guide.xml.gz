<programme start="20261114060400 +0000" stop="20261114063300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Verdadera Identidad</sub-title><desc lang="es">A cambio de que le concedan asilo en la Aldea Oculta entre las Hojas, Amado revela todo lo que sabe.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210829</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.212.0/1</episode-num><episode-num system="onscreen">S14E213</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114063300 +0000" stop="20261114070200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Destino Predeterminado</sub-title><desc lang="es">La batalla entre Koji Kashin y Jigen comienza en el escondite de Kara.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210905</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.213.0/1</episode-num><episode-num system="onscreen">S14E214</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114070200 +0000" stop="20261114073100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Preparado</sub-title><desc lang="es">Isshiki finalmente aparece en su verdadera forma y va a atacar la Aldea escondida de la hoja para poder capturar a Kawaki que se convertirá e su nueva vasija.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210912</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.214.0/1</episode-num><episode-num system="onscreen">S14E215</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114073100 +0000" stop="20261114080000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Sacrificio</sub-title><desc lang="es">Boruto lleva a Isshiki a otra dimensión para el enfrentamiento final. Naruto y Sasuke los siguen.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210919</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.215.0/1</episode-num><episode-num system="onscreen">S14E216</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114080000 +0000" stop="20261114082900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Decisión</sub-title><desc lang="es">Naruto y Sasuke pelean ferozmente, pero sus esfuerzos son en vano ya que Isshiki los acorrala. Boruto toma medidas desesperadas para vencerlo, pero falla.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210926</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.216.0/1</episode-num><episode-num system="onscreen">S14E217</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114082900 +0000" stop="20261114085800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Compañero</sub-title><desc lang="es">Naruto y los demás están exhaustos por la batalla contra Isshiki. Momoshiki toma el control de la conciencia de Boruto y se muestra frente a ellos como un enemigo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211003</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.217.0/1</episode-num><episode-num system="onscreen">S14E218</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114085800 +0000" stop="20261114092700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Regreso</sub-title><desc lang="es">Al finalizar la batalla contra Isshiki, Boruto y los demás regresan a la aldea. Gracias a su trabajo, la aldea se mantuvo a salvo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211010</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.218.0/1</episode-num><episode-num system="onscreen">S14E219</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114092700 +0000" stop="20261114095600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Tiempo que Queda</sub-title><desc lang="es">Aquellos con el Karma comienzan a perder el control de su mente y cuerpo mientras pasan por la Otsutsukificación.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211017</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.219.0/1</episode-num><episode-num system="onscreen">S14E220</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114095600 +0000" stop="20261114102500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Marcas de Garras</sub-title><desc lang="es">Code adora a Isshiki Otsutsuki, que fue derrotado por Boruto y sus amigos. Para poder conocer a cierta persona, visita una propiedad que le pertenecía a Boro.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230212</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.286.0/1</episode-num><episode-num system="onscreen">S20E287</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114102500 +0000" stop="20261114105400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Cautivados</sub-title><desc lang="es">Para poder conseguir más fuerza y pelear contra Code, Boruto invita a Kawaki a entrenar, junto con Sarada y Mitsuki.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230219</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.287.0/1</episode-num><episode-num system="onscreen">S20E288</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114105400 +0000" stop="20261114112300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Aptitudes</sub-title><desc lang="es">Con la desaparición de su Karma, Kawaki perdió sus poderes. Se preocupa de no ser capaz de proteger a Naruto o a la Aldea que él protege.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230226</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.288.0/1</episode-num><episode-num system="onscreen">S20E289</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114112300 +0000" stop="20261114115200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Presencia</sub-title><desc lang="es">Debido al riesgo de que Code intente matar a Boruto y Kawaki, se les asigna un guardia.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230305</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.289.0/1</episode-num><episode-num system="onscreen">S20E290</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114115200 +0000" stop="20261114122100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Control</sub-title><desc lang="es">Boruto llega a ayudar a Kawaki para derrotar a Code. Para poder igualar las increíbles habilidades de combate de Code, Boruto activa su Karma.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230312</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.290.0/1</episode-num><episode-num system="onscreen">S20E291</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114122100 +0000" stop="20261114125000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Hambre</sub-title><desc lang="es">En medio de una feroz batalla, el miedo de Kawaki se vuelve realidad, y Momoshiki toma el control de Boruto.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230319</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.291.0/1</episode-num><episode-num system="onscreen">S20E292</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114125000 +0000" stop="20261114131900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Despedida</sub-title><desc lang="es">Boruto toma una decisión desesperada para prevenir que Momoshiki vuelva a controlar su conciencia.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230326</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.292.0/1</episode-num><episode-num system="onscreen">S20E293</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114131900 +0000" stop="20261114134800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Camino de Kawaki para Convertirse en Ninja</sub-title><desc lang="es">Para que Kawaki pueda convertirse en genin, se decide que tome un examen especial que es diferente de los que se toman en la Academia Ninja.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211212</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.227.0/1</episode-num><episode-num system="onscreen">S16E228</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114134800 +0000" stop="20261114141700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Incumplimiento de Órdenes</sub-title><desc lang="es">Kawaki comienza a pensar que ser un genin no es para él.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211219</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.228.0/1</episode-num><episode-num system="onscreen">S16E229</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114141700 +0000" stop="20261114144600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Un Deseo</sub-title><desc lang="es">Cho-Cho es herida por el ataque de un ninja misterioso y el objeto que Mozuku ha estado guardando es robado.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211226</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.229.0/1</episode-num><episode-num system="onscreen">S16E230</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114144600 +0000" stop="20261114151500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Espada Oxidada</sub-title><desc lang="es">Unos feroces ladrones atacan a unos mercaderes ambulantes. Wasabi, Namida y Tsubaki, del Equipo 15, son enviadas al lugar del incidente para investigar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220109</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.230.0/1</episode-num><episode-num system="onscreen">S16E231</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114151500 +0000" stop="20261114154400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Primera Misión del Capitán Denki</sub-title><desc lang="es">Con Denki como capitán, al Equipo 5 se le asigna la misión de transportar títeres automatizados con fines mineros a una isla de la Tierra del Agua.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220116</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.231.0/1</episode-num><episode-num system="onscreen">S16E232</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114154400 +0000" stop="20261114161300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Nuevo Equipo Siete Entra en Acción</sub-title><desc lang="es">El nuevo Equipo 7, con Kawaki como nuevo miembro, tiene la misión de escoltar a Katasuke a una ceremonia en la Tierra del Agua.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220123</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.232.0/1</episode-num><episode-num system="onscreen">S16E233</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
