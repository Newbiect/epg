<programme start="20261102094200 +0000" stop="20261102100900 +0000" channel="Las Tortugas Ninja"><title lang="es">Teenage Mutant Ninja Turtles LT</title><sub-title lang="es">Carmaguedón</sub-title><desc lang="es">El Oasis es el sueño de todos los que viven en el desierto con muy poco agua, combustible y calor ardiente.</desc><credits><actor>Rob Paulsen</actor><actor>Greg Cipes</actor><actor>Sean Astin</actor></credits><date>20170101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.19.0/1</episode-num><episode-num system="onscreen">S05E20</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/63ff6e23689edb0013bce4e7/tile_1769238721082.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102100900 +0000" stop="20261102103600 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Caos místico</sub-title><desc lang="es">Las Tortugas descubren por primera vez que ya no son las criaturas mas extrañas en Nueva York.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102103600 +0000" stop="20261102110300 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Origami Tsunami/ Los Regalos de Donnie</sub-title><desc lang="es">Nuestros aspirantes a héroes intentan resolver el mayor problema de la ciudad. / Las Tortugas deben luchar contra sus malos hábitos y un chef mutante.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102110300 +0000" stop="20261102113000 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Guerra y Pizza / Noticiable</sub-title><desc lang="es">Las Tortugas ayudan a Abril a hacer una fiesta no tan feliz de cumpleaños. / Noticia de última hora: periodista convertido en gusano mutante reportaba noticias, ahora hace encabezados.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102113000 +0000" stop="20261102115700 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Repo Mantis / Enfermo de gripe</sub-title><desc lang="es">Tras descubrir que el auto lunar de Júpiter Jim fue embargado, las Tortugas tienen que hacer un trabajo para recuperarlo. / Las Tortugas deben soportar la gripe de Splinter y las terribles siete etapas que la acompañan.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102115700 +0000" stop="20261102122400 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Rápido y peludo / Batalla de las botargas</sub-title><desc lang="es">El tanque de tortugas recién construido de Donnie se pierde. / Para conseguir un regalo de cumpleaños para Splinter, las Tortugas tienen que enfrentarse a las famosas Mascotas de Times Square.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102122400 +0000" stop="20261102125100 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Caparazón enjaulado / El laberinto del minotauro</sub-title><desc lang="es">Leo le arrebata el título de campeón del mundo en las luchas al ídolo de Rafa. / Vence el laberinto mutante en 30 minutos o menos y la pizza es gratis.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.5.0/1</episode-num><episode-num system="onscreen">S01E06</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102125100 +0000" stop="20261102131800 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Los Caza Insectos</sub-title><desc lang="es">Las Tortugas buscan un modo de eliminar el problema de &quot;pusquitos&quot; en Nueva York.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.6.0/1</episode-num><episode-num system="onscreen">S01E07</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102131800 +0000" stop="20261102134500 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">La pelea más larga / ¡Hipno! Parte dos</sub-title><desc lang="es">Las Tortugas tienen dificultades para ver a su ídolo del patinaje mientras detienen un robo. / Hipno-Pótamo regresa y causa un caos en el baile de ex alumnos.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.7.0/1</episode-num><episode-num system="onscreen">S01E08</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102134500 +0000" stop="20261102141200 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">El Gombus / Señora Abrazos</sub-title><desc lang="es">Leo, Mikey y Abril investigan un misterioso espectron que acecha un supermercado temático. / Abril y los hermanos hacen que Rafa enfrente su mayor miedo… una adorable coneja de un show para niños.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.8.0/1</episode-num><episode-num system="onscreen">S01E09</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102141200 +0000" stop="20261102143900 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Pegados / El Regreso de Albearto</sub-title><desc lang="es">Luego de un desafortunado accidente con &quot;pegamento&quot;, las Tortugas deben pelear contra una horda de villanos. / El primer concierto público de las Tortugas es interrumpido por Albearto y su ejército de animatrónicos.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.9.0/1</episode-num><episode-num system="onscreen">S01E10</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102143900 +0000" stop="20261102150600 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">La chaqueta morada / El abismo de pizza</sub-title><desc lang="es">Un malvado club de tecnología atrae a Donnie con la promesa de una magnífica chaqueta morada. / Es la Semana de la Pizza, la mejor semana del año, pero las pizzerías favoritas de las Tortugas no paran de ser destruidas.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.10.0/1</episode-num><episode-num system="onscreen">S01E11</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102150600 +0000" stop="20261102153300 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Guarida inteligente / Sopa caliente: el juego</sub-title><desc lang="es">El nuevo invento de Inteligencia Artificial de Donnie se apodera de la Guarida y las cosas no son sólo pizza y masajes de espalda para Raph, Mikey y Leo. / Mikey va solo de misión para recuperar el juego de Lou Jitsu.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20190101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.11.0/1</episode-num><episode-num system="onscreen">S01E12</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102153300 +0000" stop="20261102160000 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">La liga malvada de mutantes – Parte 1 y 2</sub-title><desc lang="es">El Barón Draxum reúne una liga de villanos para vencer a las Tortugas.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20190101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.12.0/1</episode-num><episode-num system="onscreen">S01E13</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102160000 +0000" stop="20261102162700 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Cargo por demora / Botorones</sub-title><desc lang="es">La sencilla tarea de regresar un solo DVD se complica por la locura sin fin en Nueva York. / Las cosas se echan a perder cuando las Tortugas intentan ayudar a un mutante sin hogar.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20190101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.13.0/1</episode-num><episode-num system="onscreen">S01E14</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102162700 +0000" stop="20261102165400 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Mezcla mental / Nada más que trufas.</sub-title><desc lang="es">Donnie consigue más de lo que había contemplado después de &quot;mejorar&quot; la inteligencia de sus hermanos. / Luego de una rara transformación, Mikey y Carne Sofrita se hacen mejores amigos.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20190101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.14.0/1</episode-num><episode-num system="onscreen">S01E15</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102165400 +0000" stop="20261102172100 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">La Sombra del Mal</sub-title><desc lang="es">Mientras las Tortugas trabajan para sacar al Barón Draxum de su escondite, Splinter intenta llegar al fondo de las cosas raras que suceden en el nuevo empleo de Abril.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20190101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.15.0/1</episode-num><episode-num system="onscreen">S01E16</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102172100 +0000" stop="20261102174800 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Atraco Portal</sub-title><desc lang="es">Leo pierde a sus hermanos en un portal y debe aventurarse en la mística Ciudad Oculta para salvarlos.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20190101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.16.0/1</episode-num><episode-num system="onscreen">S01E17</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261102174800 +0000" stop="20261102181500 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Operación: Normal /Compañero de práctica</sub-title><desc lang="es">Leo y Donnie tratan con desesperación ayudar a Abril a disfrutar de un día tranquilo con una nueva amiga. / Rafa se vuelve amigo de un nuevo compañero de práctica y debe mantenerlo en secreto de sus hermanos a los que no les gusta el sujeto.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20190101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.17.0/1</episode-num><episode-num system="onscreen">S01E18</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
