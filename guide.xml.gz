<programme start="20261018194500 +0000" stop="20261018201500 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Quedan 4 minutos. Una batalla decisiva en el aire</sub-title><desc lang="es">Nankatsu debe ganar para clasificar. Hanawa consigue empatar y defiende tenazmente su portería. Tsubasa deberá pensar en algo para anotar como sea.</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20180723</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.16.0/1</episode-num><episode-num system="onscreen">S01E17</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018201500 +0000" stop="20261018204400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Adelante La final del torneo</sub-title><desc lang="es">Empiezan las semifinales. Nankatsu se enfrenta a Naniwa y su terrible portero Nakanish, quien conocerá la potencia del tiro de Tsubasa.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180730</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.17.0/1</episode-num><episode-num system="onscreen">S01E18</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018204400 +0000" stop="20261018211300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Meiwa vs Furano</sub-title><desc lang="es">Matsuyama, capitán de Furano, advierte a Hyuga sobre su individualismo. Tras una falta de Hyuga aparecerá un nuevo jugador, el arma secreta de Meiwa.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180806</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.18.0/1</episode-num><episode-num system="onscreen">S01E19</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018211300 +0000" stop="20261018214200 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El arma secreta del Musashi</sub-title><desc lang="es">Tsubasa se entera de la enfermedad de Misugi, talento de Musashi, y pierde el deseo de jugar. Molesto, Misugi intentará hacerlo reaccionar.</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20180813</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.19.0/1</episode-num><episode-num system="onscreen">S01E20</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018214200 +0000" stop="20261018221100 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El astro de cristal</sub-title><desc lang="es">Misugi encierra a Tsubasa y le impide anotar. Con ayuda de Genzo, Roberto y Misaki, Tsubasa despeja sus dudas y decide jugar con todo para ganar.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180820</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.20.0/1</episode-num><episode-num system="onscreen">S01E21</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018221100 +0000" stop="20261018224000 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Tiempo extra</sub-title><desc lang="es">Hacia el final del partido contra Musashi, Nankatsu logra empatar e ir a tiempo extra. Es su última oportunidad de vencer. ¿Derrotarán a Misugi?</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20180827</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.21.0/1</episode-num><episode-num system="onscreen">S01E22</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018224000 +0000" stop="20261018230900 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El portero estrella regresa</sub-title><desc lang="es">En la final del Torneo, Nankatsu y Meiwa se enfrentan otra vez, y también Tsubasa y Hyuga, pero esta vez Genzo ha vuelto para defender la portería.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180903</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.22.0/1</episode-num><episode-num system="onscreen">S01E23</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018230900 +0000" stop="20261018233800 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">La última oportunidad</sub-title><desc lang="es">Meiwa cambia de juego: Hyuga entiende que no está solo y empieza a jugar en equipo por primera vez, dando serios problemas a Tsubasa y su equipo.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180910</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.23.0/1</episode-num><episode-num system="onscreen">S01E24</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261018233800 +0000" stop="20261019000700 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Un flamante contraataque</sub-title><desc lang="es">A pocos minutos del fin del partido, Meiwa anota el gol de la ventaja. La situación de Nankatsu es crítica: si no empatan, quedarán fuera del Torneo.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180917</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.24.0/1</episode-num><episode-num system="onscreen">S01E25</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
