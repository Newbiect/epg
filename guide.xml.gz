<programme start="20261119032200 +0000" stop="20261119035100 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Yellow Temperance</sub-title><desc lang="es">Mientras dan una vuelta por Singapur, Jotaro empieza a sospechar que Kakyoin está poseído al ver que se comporta de manera extraña y le propina una paliza a un ladrón.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.8.0/1</episode-num><episode-num system="onscreen">S02E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261119035100 +0000" stop="20261119042200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Emperor y Hanged Man, parte 1</sub-title><desc lang="es">Polnareff decide vengar a su hermana por su cuenta tras ser víctima del ataque de un extraño Stand al que solo puede ver reflejado en un espejo.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.9.0/1</episode-num><episode-num system="onscreen">S02E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
