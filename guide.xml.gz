<programme start="20261031103000 +0000" stop="20261031113000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Dentro de la caja</sub-title><desc lang="es">Un atraco profesional a un banco provoca la muerte de un detective. Mientras investiga el caso, Grissom se enfrenta a su pérdida de audición y otro CSI recibe una revelación personal.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20030515</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">2.22.0/1</episode-num><episode-num system="onscreen">S03E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031113000 +0000" stop="20261031123000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">No des nada por seguro</sub-title><desc lang="es">Dos parejas se encuentran en un bar y una de ellas es asesinada. Cuando una segunda pareja es asesinada de forma similar, el equipo sospecha que una pareja de asesinos en serie anda suelta.</desc><credits><actor>Robert Hall</actor><actor>Wallace Langham</actor><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Jorja Fox</actor></credits><date>20030925</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">3.0.0/1</episode-num><episode-num system="onscreen">S04E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031123000 +0000" stop="20261031133000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Todo por nuestro país</sub-title><desc lang="es">Cuando los principales sospechosos del caso del asesino en serie de Grissom son asesinados, Grissom sospecha que se trata de un trabajo desde dentro.</desc><credits><actor>Robert Hall</actor><actor>Wallace Langham</actor><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Jorja Fox</actor></credits><date>20031002</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">3.1.0/1</episode-num><episode-num system="onscreen">S04E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031133000 +0000" stop="20261031143000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Cuerpos hogareños</sub-title><desc lang="es">Grissom y Warrick se ocupan del caso de una anciana encontrada momificada en su armario. Sara y Nick llegan a investigar un allanamiento de morada para encontrar a una adolescente violada.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20031009</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">3.2.0/1</episode-num><episode-num system="onscreen">S04E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031143000 +0000" stop="20261031153000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Sintiendo el calor</sub-title><desc lang="es">Durante la última ola de calor de Las Vegas, con temperaturas de tres dígitos, Gil y Catherine investigan a un bebé encerrado en un coche.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20031023</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">3.3.0/1</episode-num><episode-num system="onscreen">S04E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031153000 +0000" stop="20261031163000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Pelaje y desprecio</sub-title><desc lang="es">El equipo se introduce en el lado Furry de Las Vegas cuando un hombre es encontrado muerto a un lado de la carretera, vestido con un traje de mapache.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20031030</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">3.4.0/1</episode-num><episode-num system="onscreen">S04E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031163000 +0000" stop="20261031173000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Jackpot</sub-title><desc lang="es">Una cabeza cortada es enviada al Dr. Robbins desde Jackpot, Nevada. Grissom va a Jackpot para encontrar el resto del cuerpo y obtiene muy poca cooperación de los lugareños.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20031106</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">3.5.0/1</episode-num><episode-num system="onscreen">S04E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
