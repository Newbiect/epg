<programme start="20261023223000 +0000" stop="20261023225800 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden</title><sub-title lang="es">COLISIÓN</sub-title><desc lang="es">Naruto alcanza a Sasuke pero es demasiado tarde, ¡Sasuke ya hizo contacto con Orochimaru!</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20160128</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.445.0/1</episode-num><episode-num system="onscreen">S20E446</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6a0f5bdf1718969e3680f02e/tile_1779391456818.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261023225800 +0000" stop="20261023232600 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden</title><sub-title lang="es">OTRA LUNA</sub-title><desc lang="es">Sasuke se fue con Orochimaru, pero Naruto no se va a dar por vencido.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20160204</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.446.0/1</episode-num><episode-num system="onscreen">S20E447</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6a0f5bdf1718969e3680f02e/tile_1779391456818.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261023232600 +0000" stop="20261023235400 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden</title><sub-title lang="es">COMPAÑEROS</sub-title><desc lang="es">Hinata está al borde de la muerte, por lo que Naruto entra en modo Nueve Colas.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20160211</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.447.0/1</episode-num><episode-num system="onscreen">S20E448</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6a0f5bdf1718969e3680f02e/tile_1779391456818.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
