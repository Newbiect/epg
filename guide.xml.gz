<programme start="20261020021400 +0000" stop="20261020024300 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Lovers, parte 1</sub-title><desc lang="es">Jotaro y el equipo se enzarzan en una batalla contra un asesino despiadado que cumple las órdenes de Dio: aniquilar a su compañero sin titubear.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140718</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.15.0/1</episode-num><episode-num system="onscreen">S02E16</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020024300 +0000" stop="20261020031200 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Amantes, parte 2</sub-title><desc lang="es">Kakyoin y Polnareff descubren un Stand enemigo capaz de causar estragos en las células cerebrales al enviar sus propios Stands dentro de la cabeza de Joseph.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140725</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.16.0/1</episode-num><episode-num system="onscreen">S02E17</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020031200 +0000" stop="20261020034100 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Sol</sub-title><desc lang="es">Jotaro y la pandilla cruzan un desierto donde el sol, de aspecto sospechoso, no se pone nunca y la temperatura alcanza niveles insoportables.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140801</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.17.0/1</episode-num><episode-num system="onscreen">S02E18</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020034100 +0000" stop="20261020041000 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Muerte 13, parte 1</sub-title><desc lang="es">Kakyoin sueña con un parque de atracciones donde se oye el llanto de un bebé. De vuelta al mundo real, un bebé se une al equipo de Jotaro en un avión.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140808</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.18.0/1</episode-num><episode-num system="onscreen">S02E19</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020041000 +0000" stop="20261020043900 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Muerte 13, parte 2</sub-title><desc lang="es">Nadie se toma en serio las preocupaciones de Kakyoin sobre el bebé, pero al adentrarse en un mundo onírico se dan cuenta de lo que realmente está ocurriendo.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140815</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.19.0/1</episode-num><episode-num system="onscreen">S02E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020043900 +0000" stop="20261020050800 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Sentencia, parte 1</sub-title><desc lang="es">Jotaro y los demás conocen al padre de Avdol en una isla remota, pero el hombre se encierra en su casa. Entretanto, Polnareff descubre una extraña lámpara.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140822</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.20.0/1</episode-num><episode-num system="onscreen">S02E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020050800 +0000" stop="20261020053700 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Sentencia, parte 2</sub-title><desc lang="es">El Stand enemigo que ha salido de la lámpara resucita a Avdol con el tercer deseo de Polnareff, pero el asunto no va a resultar tan sencillo como parecía.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140829</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.21.0/1</episode-num><episode-num system="onscreen">S02E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020053700 +0000" stop="20261020060600 +0000" channel="Pluto TV Anime"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Suma Sacerdotisa, parte 1</sub-title><desc lang="es">Jotaro y el grupo se dirigen a Egipto en submarino con la intención de enfrentarse a Dio. Cuando están a punto de llegar, una taza de café sufre una transformación.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140905</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.22.0/1</episode-num><episode-num system="onscreen">S02E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020060600 +0000" stop="20261020063500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La mano</sub-title><desc lang="es">Boruto y sus amigos terminan cooperando en unas pruebas de las Herramientas científicas ninja que están en desarrollo, y les dan una misión urgente de parte del Hokage.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210124</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.182.0/1</episode-num><episode-num system="onscreen">S14E183</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020063500 +0000" stop="20261020070400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Títeres</sub-title><desc lang="es">El equipo siete, junto con KATASUKE y Chamaru, el Cazador ninja, van a la localización donde Konohamaru y Mugino perdieron la comunicación y fueron atacados por unos títeres misteriosos.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210131</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.183.0/1</episode-num><episode-num system="onscreen">S14E184</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020070400 +0000" stop="20261020073300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Herramientas</sub-title><desc lang="es">Después de dejar que Boruto y los otros escaparan, Ao es visitado por Koji Kashin.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210207</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.184.0/1</episode-num><episode-num system="onscreen">S14E185</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020073300 +0000" stop="20261020080200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Cómo se usan</sub-title><desc lang="es">El Equipo 7 trabaja en conjunto para lanzar un aluvión de ataques, pero no será fácil contrarrestar el hábil uso que hace Ao de las Herramientas Científicas Ninja.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210214</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.185.0/1</episode-num><episode-num system="onscreen">S14E186</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020080200 +0000" stop="20261020083100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Karma</sub-title><desc lang="es">Mientras Boruto y sus amigos terminan su batalla con Ao, ¡aparece Koji Kashin, un miembro de Kara!</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210221</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.186.0/1</episode-num><episode-num system="onscreen">S14E187</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020083100 +0000" stop="20261020090000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Despertar</sub-title><desc lang="es">De vuelta a la aldea, el equipo descubre a un chico inconsciente que tiene la misma extraña marca en la palma de la mano que Boruto.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210228</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.187.0/1</episode-num><episode-num system="onscreen">S14E188</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020090000 +0000" stop="20261020092900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Resonancia</sub-title><desc lang="es">Comienza la batalla entre Garo, un Outer, y Kawaki, también conocido como \&quot;la vasija\&quot;.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210307</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.188.0/1</episode-num><episode-num system="onscreen">S14E189</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020092900 +0000" stop="20261020095800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Escape</sub-title><desc lang="es">El equipo regresa al Laboratorio de Alta Tecnología con Kawaki. Konohamaru ha vuelto a la aldea para informar sobre la misión.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210314</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.189.0/1</episode-num><episode-num system="onscreen">S14E190</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020095800 +0000" stop="20261020102700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Perro vagabundo</sub-title><desc lang="es">Kawaki Escapa del Laboratorio de Alta Tecnología y se encuentra en un distrito comercial. Exhausto y hambriento, busca comida desesperadamente.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210321</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.190.0/1</episode-num><episode-num system="onscreen">S14E191</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020102700 +0000" stop="20261020105600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El pasado</sub-title><desc lang="es">Kawaki colapsa y es atormentado por las pesadillas de su infancia.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210328</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.191.0/1</episode-num><episode-num system="onscreen">S14E192</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020105600 +0000" stop="20261020112500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Coexistencia</sub-title><desc lang="es">Los Cinco Kages están de acuerdo en dejar a Kawaki bajo la custodia de Naruto. Naruto lleva a Kawaki a su casa, pero el ambiente entre Boruto y Kawaki es tenso.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210404</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.192.0/1</episode-num><episode-num system="onscreen">S14E193</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020112500 +0000" stop="20261020115400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La casa de los Uzumaki</sub-title><desc lang="es">Boruto está furioso de que Kawaki haya roto la vasija que si hermanita hizo para su mamá, avivando la rivalidad entre ellos. Como otro portador del Karma, Kawaki le hace una propuesta.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210411</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.193.0/1</episode-num><episode-num system="onscreen">S14E194</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020115400 +0000" stop="20261020122300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Un florero</sub-title><desc lang="es">Kawaki va al pueblo con Naruto para comprar una vasija nueva y reemplazar la que rompió. En el camino a la Tienda de Flores Yamanaka, Sarada se les une.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210418</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.194.0/1</episode-num><episode-num system="onscreen">S14E195</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020122300 +0000" stop="20261020125200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Una fuerza vinculante</sub-title><desc lang="es">Kawaki observa un combate Shinobi cuerpo a cuerpo entre Naruto y Boruto. Boruto utiliza su especialidad, el Jutsu clones de sombra, para enfrentarse a su padre, pero tiene dificultades.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210425</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.195.0/1</episode-num><episode-num system="onscreen">S14E196</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020125200 +0000" stop="20261020132100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Delta</sub-title><desc lang="es">Para controlar mejor sus Karmas, Boruto y Kawaki deciden entrenar en condiciones más realistas. Mientras Naruto y Himawari observan, activan sus Karmas y se enfrentan.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210502</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.196.0/1</episode-num><episode-num system="onscreen">S14E197</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020132100 +0000" stop="20261020135000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Monstruos</sub-title><desc lang="es">Delta entra a la fuerza a la Aldea de la Hoja para recuperar a Kawaki y se presenta ante Boruto y los demás.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210509</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.197.0/1</episode-num><episode-num system="onscreen">S14E198</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020135000 +0000" stop="20261020141900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Sobrecarga</sub-title><desc lang="es">Delta utiliza su rayo destructor que puede neutralizar cualquier poder regenerativo. Indomable, Naruto lo suprime a la fuerza con un Rasengan Gigante.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210516</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.198.0/1</episode-num><episode-num system="onscreen">S14E199</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020141900 +0000" stop="20261020144800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Discípulo</sub-title><desc lang="es">Delta informa a Jigen que Boruto también tiene un Karma en la palma de su mano. Al oír esto, Jigen sonríe...</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210523</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.199.0/1</episode-num><episode-num system="onscreen">S14E200</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020144800 +0000" stop="20261020151700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Lágrimas vacías</sub-title><desc lang="es">Mientras Naruto duerme, Kawaki repara la vasija que rompió. De repente, Kurama, la bestia de las Nueve colas, aparece frente a él.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210530</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.200.0/1</episode-num><episode-num system="onscreen">S14E201</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020151700 +0000" stop="20261020154600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El culto</sub-title><desc lang="es">Usando la Técnica de transportación, Sasuke llega a un extraño lugar que está cubierto de misteriosas inscripciones. Ahí encuentra muchas cosas sorprendentes sobre el Clan OTSUTSUKI.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210606</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.201.0/1</episode-num><episode-num system="onscreen">S14E202</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020154600 +0000" stop="20261020161500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Ataque sorpresa!</sub-title><desc lang="es">¡Una confrontación entre Naruto, el Séptimo Hokage, y Jigen, el líder de Kara, finalmente llega!</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210613</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.202.0/1</episode-num><episode-num system="onscreen">S14E203</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020161500 +0000" stop="20261020164400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Él es malas noticias</sub-title><desc lang="es">Naruto y Sasuke trabajan juntos para derrotar a Jigen en una feroz batalla, pero les cuesta enfrentar sus avanzadas habilidades de batalla y su misterioso jutsu.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210620</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.203.0/1</episode-num><episode-num system="onscreen">S14E204</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020164400 +0000" stop="20261020171300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Prueba</sub-title><desc lang="es">Con la aparición repentina del enemigo, Naruto, el Séptimo Hokage y líder de la aldea, ha desaparecido.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210627</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.204.0/1</episode-num><episode-num system="onscreen">S14E205</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020171300 +0000" stop="20261020174200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El nuevo equipo siete</sub-title><desc lang="es">Boruto y los demás atacan a Boro para salvar a Naruto, pero Boro los hace retroceder al liberar una misteriosa niebla oscura que paraliza a sus oponentes.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210704</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.205.0/1</episode-num><episode-num system="onscreen">S14E206</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020174200 +0000" stop="20261020181100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Regeneración</sub-title><desc lang="es">El recién formado equipo siete ataca con todo a Boro, y sus esfuerzos parece dar frutos. Sin embargo, Boro usa sus poderes regenerativos para revivir.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210711</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.206.0/1</episode-num><episode-num system="onscreen">S14E207</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020181100 +0000" stop="20261020184000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La manifestación de Momoshiki</sub-title><desc lang="es">A pesar de haber recibido bastante daño de parte del nuevo equipo siete, Boro pierde el control por completo, amenazando a Boruto y a los demás con aniquilarlos.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210718</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.207.0/1</episode-num><episode-num system="onscreen">S14E208</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020184000 +0000" stop="20261020190900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Marginado</sub-title><desc lang="es">Kawaki empieza a preocuparse de que su presencia ponga en peligro a la Aldea Oculta de la Hoja, sobre todo porque Kara le persigue.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210801</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.208.0/1</episode-num><episode-num system="onscreen">S14E209</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020190900 +0000" stop="20261020193800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Pistas hacia Kara</sub-title><desc lang="es">Para saber más sobre la relación entre Boro y Kara, Konohamaru y Sai reciben el encargo de infiltrarse en el culto de Boro.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210808</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.209.0/1</episode-num><episode-num system="onscreen">S14E210</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020193800 +0000" stop="20261020200700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Persecución</sub-title><desc lang="es">Alguien ha robado información sobre los ninja de la Hoja y se sospecha que puede haber un espía dentro del pueblo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210815</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.210.0/1</episode-num><episode-num system="onscreen">S14E211</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020200700 +0000" stop="20261020203600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Amado, el desertor</sub-title><desc lang="es">Amado, miembro principal de Kara que supervisaba su investigación y desarrollo, secuestra a Shikadai y busca asilo en la Aldea de la Hoja.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210822</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.211.0/1</episode-num><episode-num system="onscreen">S14E212</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020203600 +0000" stop="20261020210500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Verdadera Identidad</sub-title><desc lang="es">A cambio de que le concedan asilo en la Aldea Oculta entre las Hojas, Amado revela todo lo que sabe.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210829</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.212.0/1</episode-num><episode-num system="onscreen">S14E213</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020210500 +0000" stop="20261020213400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Destino Predeterminado</sub-title><desc lang="es">La batalla entre Koji Kashin y Jigen comienza en el escondite de Kara.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210905</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.213.0/1</episode-num><episode-num system="onscreen">S14E214</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261020213400 +0000" stop="20261020220300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Preparado</sub-title><desc lang="es">Isshiki finalmente aparece en su verdadera forma y va a atacar la Aldea escondida de la hoja para poder capturar a Kawaki que se convertirá e su nueva vasija.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210912</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.214.0/1</episode-num><episode-num system="onscreen">S14E215</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
