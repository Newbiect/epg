<programme start="20261104223100 +0000" stop="20261104230000 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El nacimiento de la forma de vida definitiva</sub-title><desc lang="es">La piedra roja hace a Kars prácticamente invencible. Joseph va a un volcán para atraer a Kars a una muerte segura.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130329</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.24.0/1</episode-num><episode-num system="onscreen">S01E25</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104230000 +0000" stop="20261104232900 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El hombre que se convirtió en dios</sub-title><desc lang="es">Kars surge de la lava y le raja el brazo a Joseph. Joseph, por instinto, levanta la piedra roja mientras recibe el golpe final de Kars.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130405</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.25.0/1</episode-num><episode-num system="onscreen">S01E26</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
