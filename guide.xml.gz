<programme start="20261119173900 +0000" stop="20261119180800 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Una feroz batalla comienza</sub-title><desc lang="es">Tsubasa recibe un mensaje de su viejo amigo Genzo. Decide concentrarse en ir a Brasil como sea. Hyuga viaja a Okinawa a visitar a su exentrenador.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.33.0/1</episode-num><episode-num system="onscreen">S01E34</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
