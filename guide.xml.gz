<programme start="20261029180000 +0000" stop="20261029190000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Alternos</sub-title><desc lang="es">Grissom y su equipo investigan a un sospechoso de asesinato al que pillan in fraganti enterrando a las víctimas, mientras Catherine y Warrick se encargan del caso de una mujer encontrada muerta en el spa de un hotel.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20011101</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.5.0/1</episode-num><episode-num system="onscreen">S02E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261029190000 +0000" stop="20261029200000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Enjaulada</sub-title><desc lang="es">Grissom y Nick investigan la muerte de un restaurador de libros mientras Catherine y Sara son llamadas al lugar de un accidente de tren mortal.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20011108</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.6.0/1</episode-num><episode-num system="onscreen">S02E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261029200000 +0000" stop="20261029210000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Esclavas de Las Vegas</sub-title><desc lang="es">Grissom y Catherine investigan la aparente muerte violenta de una mujer encontrada en un arenero. Su investigación les lleva al mundo clandestino de los clubes de s y m.</desc><credits><actor>Robert Hall</actor><actor>Wallace Langham</actor><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Jorja Fox</actor></credits><date>20011115</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.7.0/1</episode-num><episode-num system="onscreen">S02E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261029210000 +0000" stop="20261029220000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Y después no hubo ninguno</sub-title><desc lang="es">Grissom y su equipo investigan un atraco a un casino durante el cual se disparó a víctimas inocentes, mientras que Catherine y Sara son llamadas a la escena de un asesinato en un lugar remoto del desierto.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20011122</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.8.0/1</episode-num><episode-num system="onscreen">S02E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
