<programme start="20261114203400 +0000" stop="20261114210300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Hogar</sub-title><desc lang="es">Un mensaje codificado que se cree ha sido dejado por Funamushi revela que la Aldea Escondida de la Niebla está en peligro.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220403</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.242.0/1</episode-num><episode-num system="onscreen">S16E243</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114210300 +0000" stop="20261114213200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Fisura</sub-title><desc lang="es">Mientras Boruto y los demás preparan su plan, se enteran de que una unidad enemiga se dirige a la aldea antes que el resto.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220410</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.243.0/1</episode-num><episode-num system="onscreen">S16E244</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
