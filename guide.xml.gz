<programme start="20261128210000 +0000" stop="20261128220000 +0000" channel="Todo Drama"><title lang="es">La tierra prometida</title><sub-title lang="es">Esposa inconforme</sub-title><desc lang="es">Yusuff logra infiltrarse hasta el lugar donde duerme Josué y está muy cerca de lograr su cometido. Ravena habla con Kamil y le asegura que ella siempre estará a su lado.</desc><credits><director>Alexandre Avancini</director><actor>Sidney Sampaio</actor><actor>Thaís Melchior</actor><actor>Paloma Bernardi</actor><actor>Cristiana Oliveira</actor><actor>Kadu Moliterno</actor><actor>Leonardo Miggiorin</actor><actor>Nívea Stelmann</actor><actor>Marcos Winter</actor><actor>Juliana Silveira</actor><actor>Beth Goulart</actor><actor>Luciana Braga</actor><actor>Raymundo Souza</actor><actor>Ricky Tavares</actor><actor>Ana Barroso</actor></credits><date>20261128</date><episode-num system="xmltv_ns">0.93.0/1</episode-num><episode-num system="onscreen">S01E94</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/8d84067f97672bde02593d5983de822a.jpeg"/></programme>
<programme start="20261128220000 +0000" stop="20261128230000 +0000" channel="Todo Drama"><title lang="es">La tierra prometida</title><sub-title lang="es">Amor en peligro</sub-title><desc lang="es">Todo está listo para que se celebren las dos bodas, una entre Zaqueo y Chaya y la otra entre Melina y Yusuf, pero en ambos festejos hay problemas.</desc><credits><director>Alexandre Avancini</director><actor>Sidney Sampaio</actor><actor>Thaís Melchior</actor><actor>Paloma Bernardi</actor><actor>Cristiana Oliveira</actor><actor>Kadu Moliterno</actor><actor>Leonardo Miggiorin</actor><actor>Nívea Stelmann</actor><actor>Marcos Winter</actor><actor>Juliana Silveira</actor><actor>Beth Goulart</actor><actor>Luciana Braga</actor><actor>Raymundo Souza</actor><actor>Ricky Tavares</actor><actor>Ana Barroso</actor></credits><date>20261128</date><episode-num system="xmltv_ns">0.94.0/1</episode-num><episode-num system="onscreen">S01E95</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/112b7cd3feab10d9117fb12cc7c11d78.jpeg"/></programme>
<programme start="20261128230000 +0000" stop="20261129000000 +0000" channel="Todo Drama"><title lang="es">La tierra prometida</title><sub-title lang="es">La desaparición</sub-title><desc lang="es">Los hombres de Josué buscan a Zaqueo, ya que sospechan que fue secuestrado. La boda entre Melina y Yusuf se lleva a cabo sin contratiempos.</desc><credits><director>Alexandre Avancini</director><actor>Sidney Sampaio</actor><actor>Thaís Melchior</actor><actor>Paloma Bernardi</actor><actor>Cristiana Oliveira</actor><actor>Kadu Moliterno</actor><actor>Leonardo Miggiorin</actor><actor>Nívea Stelmann</actor><actor>Marcos Winter</actor><actor>Juliana Silveira</actor><actor>Beth Goulart</actor><actor>Luciana Braga</actor><actor>Raymundo Souza</actor><actor>Ricky Tavares</actor><actor>Ana Barroso</actor></credits><date>20261128</date><episode-num system="xmltv_ns">0.95.0/1</episode-num><episode-num system="onscreen">S01E96</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/9a10cb198906383fcf4622f06c4f8dde.jpeg"/></programme>
<programme start="20261129000000 +0000" stop="20261129010000 +0000" channel="Todo Drama"><title lang="es">La tierra prometida</title><sub-title lang="es">Viejos amigos</sub-title><desc lang="es">Orias se encuentra con Kalú y le cuenta que por culpa de Acán tuvo que abandonar a su familia. Mara insulta a Eloi.</desc><credits><director>Alexandre Avancini</director><actor>Sidney Sampaio</actor><actor>Thaís Melchior</actor><actor>Paloma Bernardi</actor><actor>Cristiana Oliveira</actor><actor>Kadu Moliterno</actor><actor>Leonardo Miggiorin</actor><actor>Nívea Stelmann</actor><actor>Marcos Winter</actor><actor>Juliana Silveira</actor><actor>Beth Goulart</actor><actor>Luciana Braga</actor><actor>Raymundo Souza</actor><actor>Ricky Tavares</actor><actor>Ana Barroso</actor></credits><date>20261128</date><episode-num system="xmltv_ns">0.96.0/1</episode-num><episode-num system="onscreen">S01E97</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/4e836533ea70f49461f85a6248ec275e.jpeg"/></programme>
