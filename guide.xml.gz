<programme start="20261122200000 +0000" stop="20261122203000 +0000" channel="Discovery Familia"><title lang="en">Rodando por América</title><sub-title lang="en">Ciudades pequeñas, sabores enormes</sub-title><desc lang="en">Sándwich de falda y crujiente panza de cerdo; sopa de curri tailandés; hamburguesa monstruosa y un giro único sobre pizza.</desc><category lang="en">Travel</category><category lang="en">Food</category><rating system="MPA"><value>TV-G</value></rating><icon src="https://cdn.tvpassport.com/image/show/960x540/v2/p185941_b_v12_cr.jpg"/></programme>
