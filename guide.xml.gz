<programme start="20261113163200 +0000" stop="20261113170100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Herramientas</sub-title><desc lang="es">Después de dejar que Boruto y los otros escaparan, Ao es visitado por Koji Kashin.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210207</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.184.0/1</episode-num><episode-num system="onscreen">S14E185</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261113170100 +0000" stop="20261113173000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Cómo se usan</sub-title><desc lang="es">El Equipo 7 trabaja en conjunto para lanzar un aluvión de ataques, pero no será fácil contrarrestar el hábil uso que hace Ao de las Herramientas Científicas Ninja.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210214</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.185.0/1</episode-num><episode-num system="onscreen">S14E186</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
