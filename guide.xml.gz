<programme start="20261027015100 +0000" stop="20261027022000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Aptitudes</sub-title><desc lang="es">Con la desaparición de su Karma, Kawaki perdió sus poderes. Se preocupa de no ser capaz de proteger a Naruto o a la Aldea que él protege.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230226</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.288.0/1</episode-num><episode-num system="onscreen">S20E289</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027022000 +0000" stop="20261027024900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Presencia</sub-title><desc lang="es">Debido al riesgo de que Code intente matar a Boruto y Kawaki, se les asigna un guardia.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230305</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.289.0/1</episode-num><episode-num system="onscreen">S20E290</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027024900 +0000" stop="20261027031800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Control</sub-title><desc lang="es">Boruto llega a ayudar a Kawaki para derrotar a Code. Para poder igualar las increíbles habilidades de combate de Code, Boruto activa su Karma.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230312</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.290.0/1</episode-num><episode-num system="onscreen">S20E291</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027031800 +0000" stop="20261027034700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Hambre</sub-title><desc lang="es">En medio de una feroz batalla, el miedo de Kawaki se vuelve realidad, y Momoshiki toma el control de Boruto.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230319</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.291.0/1</episode-num><episode-num system="onscreen">S20E292</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027034700 +0000" stop="20261027041600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Despedida</sub-title><desc lang="es">Boruto toma una decisión desesperada para prevenir que Momoshiki vuelva a controlar su conciencia.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20230326</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">19.292.0/1</episode-num><episode-num system="onscreen">S20E293</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e78f8a8f919a54cf57d7de/tile_1780325536802.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027041600 +0000" stop="20261027044500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Camino de Kawaki para Convertirse en Ninja</sub-title><desc lang="es">Para que Kawaki pueda convertirse en genin, se decide que tome un examen especial que es diferente de los que se toman en la Academia Ninja.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211212</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.227.0/1</episode-num><episode-num system="onscreen">S16E228</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027044500 +0000" stop="20261027051400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Incumplimiento de Órdenes</sub-title><desc lang="es">Kawaki comienza a pensar que ser un genin no es para él.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211219</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.228.0/1</episode-num><episode-num system="onscreen">S16E229</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027051400 +0000" stop="20261027054300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Un Deseo</sub-title><desc lang="es">Cho-Cho es herida por el ataque de un ninja misterioso y el objeto que Mozuku ha estado guardando es robado.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211226</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.229.0/1</episode-num><episode-num system="onscreen">S16E230</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027054300 +0000" stop="20261027061200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Espada Oxidada</sub-title><desc lang="es">Unos feroces ladrones atacan a unos mercaderes ambulantes. Wasabi, Namida y Tsubaki, del Equipo 15, son enviadas al lugar del incidente para investigar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220109</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.230.0/1</episode-num><episode-num system="onscreen">S16E231</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027061200 +0000" stop="20261027064100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Primera Misión del Capitán Denki</sub-title><desc lang="es">Con Denki como capitán, al Equipo 5 se le asigna la misión de transportar títeres automatizados con fines mineros a una isla de la Tierra del Agua.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220116</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.231.0/1</episode-num><episode-num system="onscreen">S16E232</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027064100 +0000" stop="20261027071000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Nuevo Equipo Siete Entra en Acción</sub-title><desc lang="es">El nuevo Equipo 7, con Kawaki como nuevo miembro, tiene la misión de escoltar a Katasuke a una ceremonia en la Tierra del Agua.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220123</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.232.0/1</episode-num><episode-num system="onscreen">S16E233</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027071000 +0000" stop="20261027073900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Villano Liberado</sub-title><desc lang="es">Boruto visita la prisión cuando una aeronave explota durante la ceremonia.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220130</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.233.0/1</episode-num><episode-num system="onscreen">S16E234</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027073900 +0000" stop="20261027080800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Infiltrándose en la Isla Dotou</sub-title><desc lang="es">Cuando un grupo de piratas toma La Tierra del Agua, se pierde el contacto con el Equipo 5 de Denki.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220206</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.234.0/1</episode-num><episode-num system="onscreen">S16E235</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027080800 +0000" stop="20261027083700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Huida</sub-title><desc lang="es">Mientras están en las afueras de la Isla Dotou, una fortaleza gigante aparece frente a Boruto y sus amigos.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220213</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.235.0/1</episode-num><episode-num system="onscreen">S16E236</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027083700 +0000" stop="20261027090600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La fortaleza móvil</sub-title><desc lang="es">Mientras Sarada y los demás ayudan a la gente de la isla a evacuar, Boruto se pone ansioso cuando se da cuenta de que son amenazados por la fortaleza móvil, que está equipada con un arma muy poderosa.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220220</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.236.0/1</episode-num><episode-num system="onscreen">S16E237</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027090600 +0000" stop="20261027093500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Un asesino en el barco</sub-title><desc lang="es">Hay un asesinato a bordo del barco que lleva a la gente rescatada de la Isla Dotou, y Kyoho es el principal sospechoso basados en la evidencia.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220227</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.237.0/1</episode-num><episode-num system="onscreen">S16E238</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027093500 +0000" stop="20261027100400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El chico de la isla de los constructores de barcos</sub-title><desc lang="es">El barco donde van Boruto, sus amigos y la gente de la Isla Dotou está inmóvil sobre el agua.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220306</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.238.0/1</episode-num><episode-num system="onscreen">S16E239</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027100400 +0000" stop="20261027103300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El sueño de Ikada</sub-title><desc lang="es">Boruto se une a Ikada mientras zarpan hacia la fabrica donde conseguirán los componentes necesarios para reparar el barco.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220313</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.239.0/1</episode-num><episode-num system="onscreen">S16E240</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027103300 +0000" stop="20261027110200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El secreto de Ikada</sub-title><desc lang="es">Ahora que su barco está reparado, Boruto y los demás pronto se irán de la isla de los barqueros. Ikada, ahora amigo de Boruto, promete cumplir su sueño y hacerle una visita.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220320</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.240.0/1</episode-num><episode-num system="onscreen">S16E241</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027110200 +0000" stop="20261027113100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Seiren</sub-title><desc lang="es">Como represalia contra Boruto y sus amigos por destruir la fortaleza móvil de Tenma, los piratas desembarcan en la Isla de los Barqueros.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220327</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.241.0/1</episode-num><episode-num system="onscreen">S16E242</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027113100 +0000" stop="20261027120000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Hogar</sub-title><desc lang="es">Un mensaje codificado que se cree ha sido dejado por Funamushi revela que la Aldea Escondida de la Niebla está en peligro.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220403</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.242.0/1</episode-num><episode-num system="onscreen">S16E243</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027120000 +0000" stop="20261027122900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Fisura</sub-title><desc lang="es">Mientras Boruto y los demás preparan su plan, se enteran de que una unidad enemiga se dirige a la aldea antes que el resto.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220410</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.243.0/1</episode-num><episode-num system="onscreen">S16E244</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027122900 +0000" stop="20261027125800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Tenacidad de Funamushi</sub-title><desc lang="es">El escuadrón principal liderado por Funamushi se acerca a la aldea. Boruto y los demás permanecen a la espera, con la intención de utilizar trampas para frenar al enemigo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220417</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.244.0/1</episode-num><episode-num system="onscreen">S16E245</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027125800 +0000" stop="20261027132700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Un Duro Golpe</sub-title><desc lang="es">A pesar de haber sido arrastrados a una dura batalla, Boruto y los demás logran forzar a la unidad de Funamushi a retirarse, pero a un precio muy alto.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220424</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.245.0/1</episode-num><episode-num system="onscreen">S16E246</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027132700 +0000" stop="20261027135600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Por Kagura</sub-title><desc lang="es">A pesar de que había niños presentes, Funamushi pelea ferozmennte sin importar el daño que cause. Mientras tanto, Araumi es informado por su hijo mayor Isari que su hijo adoptivo Tenma fue asesinado en batalla.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220501</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.246.0/1</episode-num><episode-num system="onscreen">S16E247</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027135600 +0000" stop="20261027142500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Otra feroz batalla</sub-title><desc lang="es">Denki e Iwabe protegen a los ninños que los habían acompañado a buscar comida. Los niños fueron capaces de escapar, pero los shinobi fueron capturados por Funamushi y su escuadrón.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220508</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.247.0/1</episode-num><episode-num system="onscreen">S16E248</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027142500 +0000" stop="20261027145400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Odio creciente</sub-title><desc lang="es">Boruto y sus amigos logran salir triunfantes contra Funamushi, pero no pudieron disfrutar su victoria.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220515</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.248.0/1</episode-num><episode-num system="onscreen">S16E249</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027145400 +0000" stop="20261027152300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La sangre de los Funanto</sub-title><desc lang="es">Ikada regresa a casa después de enterarse que su hermana fue gravemente herida en batalla.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220522</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.249.0/1</episode-num><episode-num system="onscreen">S16E250</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027152300 +0000" stop="20261027155200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La determinación de ambos</sub-title><desc lang="es">Araumi está furioso por la pérdida de miembros de su familia y de muchos de sus subordinados durante las batallas libradas hasta el momento.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220529</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.250.0/1</episode-num><episode-num system="onscreen">S16E251</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027155200 +0000" stop="20261027162100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Deseo de Creer</sub-title><desc lang="es">Sarada, Mitsuki y Boruto deciden reunirse con el Mizukage.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220605</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.251.0/1</episode-num><episode-num system="onscreen">S16E252</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027162100 +0000" stop="20261027165000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Sentimientos Conflictivos</sub-title><desc lang="es">Boruto, Sarada y Mitsuki van a reunirse con Ikada, que ahora se contra la Tierra del Agua. Boruto intenta hablar con Ikada como amigo para que deje de luchar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220612</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.252.0/1</episode-num><episode-num system="onscreen">S16E253</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027165000 +0000" stop="20261027171900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Espiral de Venganza</sub-title><desc lang="es">Los desesperados intentos de Boruto por razonar con Ikada fracasan y no logra hacerle cambiar de opinión. Se dispone a dar su vida para impedir que la Tierra del Agua y los piratas luchen.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220619</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.253.0/1</episode-num><episode-num system="onscreen">S16E254</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027171900 +0000" stop="20261027174800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Una Tarea Complicada</sub-title><desc lang="es">La rebelión pirata que sacude a la Tierra del Agua es controlada. Al regresar con sus amigos a la Aldea Escondida de la Hoja, Boruto se pregunta qué ha sido de Ikada.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220626</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.254.0/1</episode-num><episode-num system="onscreen">S16E255</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027174800 +0000" stop="20261027181700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Receta Perfecta</sub-title><desc lang="es">Cho-Cho e Inojin terminan haciendo ramen para ayudar a un antiguo Shinobi y dueño de un restaurante de ramen de nombre Shingo Kumano a quien conocieron en una misión.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220703</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.255.0/1</episode-num><episode-num system="onscreen">S16E256</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027181700 +0000" stop="20261027184600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¿Konohamaru se convierte en el Hokage?</sub-title><desc lang="es">A Naruto le pidieron que actúe como él mismo en Malvado Jammer Kagemasa, una película de una popular serie. Konohamaru termina actuando ese rol.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220710</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.256.0/1</episode-num><episode-num system="onscreen">S16E257</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027184600 +0000" stop="20261027191500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La familia Uzumaki en las Aguas Termales</sub-title><desc lang="es">Boruto y Kawaki se unen a Naruto, Hinata y Himawari en un viaje familiar en las aguas termales. Los cinco se divierten jugando ping-pong y disfrutan la comida y las aguas termales de la posada.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220717</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.257.0/1</episode-num><episode-num system="onscreen">S16E258</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027191500 +0000" stop="20261027194400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Una Herida que Nunca Sana</sub-title><desc lang="es">Mitsuki, Boruto, y Sarada estás asitiendo con una patrulla a la aldea por petición del departamento de policía, que está teninedo dificultades al investigar una serie de misterioso ataques.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220724</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.258.0/1</episode-num><episode-num system="onscreen">S16E259</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027194400 +0000" stop="20261027201300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Fuegos Artificiales de Amor</sub-title><desc lang="es">Mientras pasean por la Aldea, Kakashi y Boruto se encuentran con un grupo de personas que discuten. Boruto se da cuenta de la cara triste de una joven pareja y se entera que están comprometidos, y sus abuelos están enfrentados.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220731</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.259.0/1</episode-num><episode-num system="onscreen">S16E260</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027201300 +0000" stop="20261027204200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Un halcón sin alas</sub-title><desc lang="es">Boruto acompaña a Sasuke a un entrenador de halcones para conseguir un halcón mensajero. Ahí, Boruto y Sasuke oyen hablar de una persona que vende animales raros y deciden investigar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221106</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.273.0/1</episode-num><episode-num system="onscreen">S18E274</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261027204200 +0000" stop="20261027211100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">De vuelta al cielo</sub-title><desc lang="es">De repente, el halcón de Tsuzura ha sido vendido, así que hace lo que puede para recuperar a su preciada ave. Al oír lo ocurrido, Boruto ignora a Sasuke y se apresura a ayudar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221113</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.274.0/1</episode-num><episode-num system="onscreen">S18E275</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
