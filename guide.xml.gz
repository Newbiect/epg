<programme start="20261026053700 +0000" stop="20261026060700 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Quedan 4 minutos. Una batalla decisiva en el aire</sub-title><desc lang="es">Nankatsu debe ganar para clasificar. Hanawa consigue empatar y defiende tenazmente su portería. Tsubasa deberá pensar en algo para anotar como sea.</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20180723</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.16.0/1</episode-num><episode-num system="onscreen">S01E17</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026060700 +0000" stop="20261026063600 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Adelante La final del torneo</sub-title><desc lang="es">Empiezan las semifinales. Nankatsu se enfrenta a Naniwa y su terrible portero Nakanish, quien conocerá la potencia del tiro de Tsubasa.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180730</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.17.0/1</episode-num><episode-num system="onscreen">S01E18</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026063600 +0000" stop="20261026070500 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Meiwa vs Furano</sub-title><desc lang="es">Matsuyama, capitán de Furano, advierte a Hyuga sobre su individualismo. Tras una falta de Hyuga aparecerá un nuevo jugador, el arma secreta de Meiwa.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180806</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.18.0/1</episode-num><episode-num system="onscreen">S01E19</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026070500 +0000" stop="20261026073400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El arma secreta del Musashi</sub-title><desc lang="es">Tsubasa se entera de la enfermedad de Misugi, talento de Musashi, y pierde el deseo de jugar. Molesto, Misugi intentará hacerlo reaccionar.</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20180813</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.19.0/1</episode-num><episode-num system="onscreen">S01E20</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026073400 +0000" stop="20261026080300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El astro de cristal</sub-title><desc lang="es">Misugi encierra a Tsubasa y le impide anotar. Con ayuda de Genzo, Roberto y Misaki, Tsubasa despeja sus dudas y decide jugar con todo para ganar.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180820</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.20.0/1</episode-num><episode-num system="onscreen">S01E21</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026080300 +0000" stop="20261026083200 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Tiempo extra</sub-title><desc lang="es">Hacia el final del partido contra Musashi, Nankatsu logra empatar e ir a tiempo extra. Es su última oportunidad de vencer. ¿Derrotarán a Misugi?</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20180827</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.21.0/1</episode-num><episode-num system="onscreen">S01E22</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026083200 +0000" stop="20261026090100 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El portero estrella regresa</sub-title><desc lang="es">En la final del Torneo, Nankatsu y Meiwa se enfrentan otra vez, y también Tsubasa y Hyuga, pero esta vez Genzo ha vuelto para defender la portería.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180903</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.22.0/1</episode-num><episode-num system="onscreen">S01E23</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026090100 +0000" stop="20261026093000 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">La última oportunidad</sub-title><desc lang="es">Meiwa cambia de juego: Hyuga entiende que no está solo y empieza a jugar en equipo por primera vez, dando serios problemas a Tsubasa y su equipo.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180910</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.23.0/1</episode-num><episode-num system="onscreen">S01E24</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026093000 +0000" stop="20261026095900 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Un flamante contraataque</sub-title><desc lang="es">A pocos minutos del fin del partido, Meiwa anota el gol de la ventaja. La situación de Nankatsu es crítica: si no empatan, quedarán fuera del Torneo.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180917</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.24.0/1</episode-num><episode-num system="onscreen">S01E25</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026095900 +0000" stop="20261026102800 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Gol anulado</sub-title><desc lang="es">Final. Tiempo extra. Los equipos están agotados, lo que lleva a un duelo de porteros. Tsubasa logra un tiro con efecto, pero justo suena el silbato.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20180924</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.25.0/1</episode-num><episode-num system="onscreen">S01E26</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026102800 +0000" stop="20261026105700 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Momento de gloria</sub-title><desc lang="es">La final del Torneo Nacional está por terminar. Tsubasa y Misaki se recuperan y logran ir a la cabeza por un gol, pero Meiwa se empecina en empatar.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20181001</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.26.0/1</episode-num><episode-num system="onscreen">S01E27</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026105700 +0000" stop="20261026112600 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Despedida</sub-title><desc lang="es">Nankatsu gana el Torneo Nacional, pero la alegría de Tsubasa es opacada por noticias de Roberto. Decide quedarse en Japón y dice adiós a sus amigos.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20181008</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.27.0/1</episode-num><episode-num system="onscreen">S01E28</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026112600 +0000" stop="20261026115500 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Un nuevo viaje comienza</sub-title><desc lang="es">El nuevo rival de Tsubasa es Shun Nitta, exjugador de Nankatsu. El equipo deberá esforzarse si desea volver a representar a la prefectura de Shizuoka.</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20181015</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.28.0/1</episode-num><episode-num system="onscreen">S01E29</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026115500 +0000" stop="20261026122400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Camino al gran torneo. El tiro del halcón</sub-title><desc lang="es">En la final de las eliminatorias contra Otomo, Shun Nitta comprende que no puede vencer a Tsubasa en duelo frente a frente y planea otra estrategia.</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20181022</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.29.0/1</episode-num><episode-num system="onscreen">S01E30</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026122400 +0000" stop="20261026125300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Nitta contra Tsubasa</sub-title><desc lang="es">Tras varios intentos, Nitta logra perfeccionar su tiro de halcón. Mientras tanto, en las eliminatorias de Osaka, Azumaichi descalifica a Naniwa.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20181029</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.30.0/1</episode-num><episode-num system="onscreen">S01E31</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026125300 +0000" stop="20261026132200 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Superar a Tsubasa, Hyuga vs Misugi</sub-title><desc lang="es">Hyuga anota tres goles en la final de las eliminatorias de Tokio. Misugi debe entrar a la cancha antes de lo previsto para emparejar la situación.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20181105</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.31.0/1</episode-num><episode-num system="onscreen">S01E32</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026132200 +0000" stop="20261026135100 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Final de las eliminatorias de Tokio</sub-title><desc lang="es">En la final de las eliminatorias de Tokio, Hyuga se compadece de Toho y no ataca como siempre, lo que le traerá problemas al final del encuentro.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20181112</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.32.0/1</episode-num><episode-num system="onscreen">S01E33</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026135100 +0000" stop="20261026142000 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Una feroz batalla comienza</sub-title><desc lang="es">Tsubasa recibe un mensaje de su viejo amigo Genzo. Decide concentrarse en ir a Brasil como sea. Hyuga viaja a Okinawa a visitar a su exentrenador.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20181119</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.33.0/1</episode-num><episode-num system="onscreen">S01E34</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026142000 +0000" stop="20261026144900 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El poder de la navaja</sub-title><desc lang="es">Hyuga recupera el ímpetu, pero hay un nuevo obstáculo. Empieza el Torneo Nacional. Nankatsu enfrenta a Azumaichi y su temible defensa central.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20181126</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.34.0/1</episode-num><episode-num system="onscreen">S01E35</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026144900 +0000" stop="20261026151800 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Determinación</sub-title><desc lang="es">Nankatsu iguala el marcador gracias a Takasugi. ¿Anotará Tsubasa otro gol para resguardar su corona o podrá Azumaichi domar al implacable Nankatsu?</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20181203</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.35.0/1</episode-num><episode-num system="onscreen">S01E36</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026151800 +0000" stop="20261026154700 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Huracán en el cielo</sub-title><desc lang="es">Comienza el partido de Nankatsu contra Hanawa. Tsubasa se enfrenta de nuevo a los hermanos Tachibana, quienes tienen un arma secreta para derrotarlo.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20181210</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.36.0/1</episode-num><episode-num system="onscreen">S01E37</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026154700 +0000" stop="20261026161600 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El asalto de los hermanos Tachibana</sub-title><desc lang="es">Tsubasa se lesiona y debe salir temporalmente. Los hermanos Tachibana anotan el gol del empate. ¿Volverá Tsubasa antes de que termine el partido?</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20181217</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.37.0/1</episode-num><episode-num system="onscreen">S01E38</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026161600 +0000" stop="20261026164500 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Un final con efecto</sub-title><desc lang="es">Quedan pocos minutos para el final del partido, y Nankatsu no logra anotar. Los hermanos Tachibana probarán una nueva estrategia para vencer.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20181224</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.38.0/1</episode-num><episode-num system="onscreen">S01E39</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026164500 +0000" stop="20261026171400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Adelante, Furano</sub-title><desc lang="es">En el arduo segundo partido de los cuartos de final del Torneo Nacional, Matsuyama se empeña en demostrar que un partido solo se gana en equipo.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190107</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.39.0/1</episode-num><episode-num system="onscreen">S01E40</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026171400 +0000" stop="20261026174300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El caballo negro</sub-title><desc lang="es">Nankatsu e Hirado se baten por las semifinales del Torneo Nacional. Tsubasa enfrenta al poderoso Hiroshi Jito, capitán y defensa central de Hirado.</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20190114</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.40.0/1</episode-num><episode-num system="onscreen">S01E41</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026174300 +0000" stop="20261026181300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El fénix Tsubasa</sub-title><desc lang="es">Tras una aplastante desventaja, Tsubasa decide arriesgarlo todo: intentará el famoso tiro con efecto de Roberto por la oportunidad de ganar.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190121</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.41.0/1</episode-num><episode-num system="onscreen">S01E42</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026181300 +0000" stop="20261026184300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El tigre caído</sub-title><desc lang="es">En las semifinales del Torneo, los primeros en batirse son Meiwa y Toho. Con Hyuga en el banco, Meiwa saca ventaja, haciendo sufrir a Takeshi Sawada.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190128</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.42.0/1</episode-num><episode-num system="onscreen">S01E43</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026184300 +0000" stop="20261026191300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Un duelo de diez</sub-title><desc lang="es">En el último partido de las semifinales, Nankatsu se bate con los de Furano, famosos por su gran trabajo en equipo y su capitán Hikaru Matsuyama.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190204</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.43.0/1</episode-num><episode-num system="onscreen">S01E44</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026191300 +0000" stop="20261026194200 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Lágrimas en el aeropuerto</sub-title><desc lang="es">En el segundo tiempo, Furano empata. Gravemente lesionado, Tsubasa intenta hacer su tiro con efecto una vez más. Matsuyama hará todo por impedirlo.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190211</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.44.0/1</episode-num><episode-num system="onscreen">S01E45</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026194200 +0000" stop="20261026201100 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">el juego del siglo</sub-title><desc lang="es">Tsubasa espera recuperarse de su lesión para enfrentar a Toho, y Hyuga abandona su orgullo para pedirle al entrenador Kitazune que le permita jugar.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190218</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.45.0/1</episode-num><episode-num system="onscreen">S01E46</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026201100 +0000" stop="20261026204000 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Una batalla fulminante</sub-title><desc lang="es">Los capitanes de Nankatsu y Toho están empecinados en ganar. Hyuga demostrará su fuerza con su tiro de tigre; Tsubasa usará su tiro con efecto.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190225</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.46.0/1</episode-num><episode-num system="onscreen">S01E47</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026204000 +0000" stop="20261026210900 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El Toho contraataca</sub-title><desc lang="es">Toho se impone por dos goles. Tsubasa, lesionado, cae en la desesperación. Pero tiene una idea, y decide arriesgar su físico para detener a Hyuga.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190304</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.47.0/1</episode-num><episode-num system="onscreen">S01E48</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026210900 +0000" stop="20261026213900 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El tigre contra Tsubasa</sub-title><desc lang="es">Nankatsu defiende a toda costa la portería a la espera de su capitán Tsubasa, quien se empecina en volver a la cancha. Hyuga aprovecha la situación.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190311</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.48.0/1</episode-num><episode-num system="onscreen">S01E49</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026213900 +0000" stop="20261026220900 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Una feroz batalla</sub-title><desc lang="es">Nankatsu y Toho anotan tres goles cada uno. Una falta de Takasugi le regala un tiro libre a Hyuga, quien se dispone a usar su poderoso tiro de tigre.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190318</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.49.0/1</episode-num><episode-num system="onscreen">S01E50</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026220900 +0000" stop="20261026223900 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El tiro milagroso</sub-title><desc lang="es">La final va a tiempo extra. Ni Tsubasa ni Hyuga desean compartir el título, y están dispuestos a arriesgar su físico por el Torneo Nacional.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190325</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.50.0/1</episode-num><episode-num system="onscreen">S01E51</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261026223900 +0000" stop="20261026230900 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Un sueño sin fin</sub-title><desc lang="es">En la emocionante final, Hyuga y Tsubasa demuestran de qué están hechos. Es un duelo futbolístico, pero también personal. ¿Quién será el campeón?</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20190401</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.51.0/1</episode-num><episode-num system="onscreen">S01E52</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
