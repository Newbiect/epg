<programme start="20261120072300 +0000" stop="20261120082500 +0000" channel="Pluto TV Naturaleza"><title lang="es">Armería de Animales</title><sub-title lang="es">Dientes y garras</sub-title><desc lang="es">Las armas maestras del mundo animal cuando se manejan con precisión, los dientes y las garras son los mejores instrumentos para la caza, la defensa y el combate en el mundo animal.</desc><date>00010101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/66ab78c094a184001358db69/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
