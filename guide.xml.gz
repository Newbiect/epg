<programme start="20261103231900 +0000" stop="20261103234800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Sacrificio</sub-title><desc lang="es">Boruto lleva a Isshiki a otra dimensión para el enfrentamiento final. Naruto y Sasuke los siguen.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210919</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.215.0/1</episode-num><episode-num system="onscreen">S14E216</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103234800 +0000" stop="20261104001700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Decisión</sub-title><desc lang="es">Naruto y Sasuke pelean ferozmente, pero sus esfuerzos son en vano ya que Isshiki los acorrala. Boruto toma medidas desesperadas para vencerlo, pero falla.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210926</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.216.0/1</episode-num><episode-num system="onscreen">S14E217</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104001700 +0000" stop="20261104004600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Compañero</sub-title><desc lang="es">Naruto y los demás están exhaustos por la batalla contra Isshiki. Momoshiki toma el control de la conciencia de Boruto y se muestra frente a ellos como un enemigo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211003</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.217.0/1</episode-num><episode-num system="onscreen">S14E218</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104004600 +0000" stop="20261104011500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Regreso</sub-title><desc lang="es">Al finalizar la batalla contra Isshiki, Boruto y los demás regresan a la aldea. Gracias a su trabajo, la aldea se mantuvo a salvo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211010</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.218.0/1</episode-num><episode-num system="onscreen">S14E219</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104011500 +0000" stop="20261104014400 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Tiempo que Queda</sub-title><desc lang="es">Aquellos con el Karma comienzan a perder el control de su mente y cuerpo mientras pasan por la Otsutsukificación.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211017</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.219.0/1</episode-num><episode-num system="onscreen">S14E220</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104014400 +0000" stop="20261104021300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Regreso de los Exámenes Chunin</sub-title><desc lang="es">Naruto propone que se celebre el Examen Chunin para levantar la moral tras el ataque de Isshiki.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211024</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.220.0/1</episode-num><episode-num system="onscreen">S15E221</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104021300 +0000" stop="20261104024200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Noche Antes de la Ronda Final</sub-title><desc lang="es">Se anuncia la ronda final del Examen Chunin. Muchos de los compañeros de Boruto que no pasaron a la ronda final del último examen lo han conseguido esta vez.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211031</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.221.0/1</episode-num><episode-num system="onscreen">S15E222</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104024200 +0000" stop="20261104031100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Inojin contra Houki</sub-title><desc lang="es">La ronda final de los exámenes por fin ha comenzado. El primer duelo es Inojin contra Houki. El equipo de Houki ha estado participando en las misiones de cazadores especiales ANBU.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211107</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.222.0/1</episode-num><episode-num system="onscreen">S15E223</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104031100 +0000" stop="20261104034000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Leyenda del Gato Monstruo</sub-title><desc lang="es">El siguiente combate de las rondas finales es entre Iwabe y Wasabi.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211114</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.223.0/1</episode-num><episode-num system="onscreen">S15E224</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104034000 +0000" stop="20261104040900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Enfrentamiento entre Mejores Amigas</sub-title><desc lang="es">Comienza el combate entre Sarada y Cho-Cho. Kawaki fue invitado por Naruto para observar, así como Shinki y otros que han venido de la Aldea Escondida de la Arena.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211121</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.224.0/1</episode-num><episode-num system="onscreen">S15E225</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104040900 +0000" stop="20261104043800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Samurái contra Ciencia</sub-title><desc lang="es">Uno después de otro, los ganadores de las finales se deciden. Solo quedan un par de encuentros, pero Boruto y Mitsuki aun no han llegado a los exámenes.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211128</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.225.0/1</episode-num><episode-num system="onscreen">S15E226</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104043800 +0000" stop="20261104050700 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¿¡La Última Misión del Equipo Siete!?</sub-title><desc lang="es">Al equipo siete, con Sarada como capitana, se le asigna una misión. Mirai, que fue a una misión con Konohamaru, regresa a la aldea gravemente herida.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211205</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.226.0/1</episode-num><episode-num system="onscreen">S15E227</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104050700 +0000" stop="20261104053600 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Camino de Kawaki para Convertirse en Ninja</sub-title><desc lang="es">Para que Kawaki pueda convertirse en genin, se decide que tome un examen especial que es diferente de los que se toman en la Academia Ninja.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211212</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.227.0/1</episode-num><episode-num system="onscreen">S16E228</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104053600 +0000" stop="20261104060500 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Incumplimiento de Órdenes</sub-title><desc lang="es">Kawaki comienza a pensar que ser un genin no es para él.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211219</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.228.0/1</episode-num><episode-num system="onscreen">S16E229</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104060500 +0000" stop="20261104063500 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">El Misterio de Onigumo</sub-title><desc lang="es">Kaede lleva a Inuyasha y Miroku a una cueva cercana que aparece en ella y en el pasado de Kikyo. Mientras tanto, Kagome intenta reajustarse a su vida normal.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010319</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.19.0/1</episode-num><episode-num system="onscreen">S01E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104063500 +0000" stop="20261104070500 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">El Secreto de Naraku</sub-title><desc lang="es">La pelea de Inuyasha con Royakan continúa. Kagome interrumpe su cita con Hojo para regresar al santuario, donde siente la presencia de la joya.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010409</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.20.0/1</episode-num><episode-num system="onscreen">S01E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104070500 +0000" stop="20261104073500 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">Las Almas de Kikyo</sub-title><desc lang="es">Al parecer, Kikyo ha resucitado y vive como sacerdotisa de una aldea. Un monje errante se da cuenta de que no todo es como parece con ella.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010409</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.21.0/1</episode-num><episode-num system="onscreen">S01E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104073500 +0000" stop="20261104080500 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">La Voz de Aome y el Beso De Kikyo</sub-title><desc lang="es">Inuyasha busca a Kikyo, pero Kagome la encuentra primero. Kikyo toma a su prisionera y no escucha sus intentos de explicar lo que realmente sucedió.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010416</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.22.0/1</episode-num><episode-num system="onscreen">S01E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104080500 +0000" stop="20261104083500 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">La Exterminadora de Monstruos</sub-title><desc lang="es">El asesino de demonios Sango es invitado al Castillo Hitomi junto con su padre y su hermano menor, Kohaku, dejando su aldea indefensa.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010423</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.23.0/1</episode-num><episode-num system="onscreen">S01E24</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104083500 +0000" stop="20261104090500 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">El Engaño de Naraku</sub-title><desc lang="es">Creyendo que él era su enemigo, Sango busca a Inuyasha en una búsqueda equivocada de venganza ideada por Naraku, quien quiere a Inuyasha muerto.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010507</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.24.0/1</episode-num><episode-num system="onscreen">S01E25</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104090500 +0000" stop="20261104093500 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">El Secreto de Shikon</sub-title><desc lang="es">Después de que Inuyasha y sus amigos se detienen para enterrar a los muertos, Sango revela la historia secreta de los orígenes de la joya Shikon: el alma de la sacerdotisa Midoriko.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010514</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.25.0/1</episode-num><episode-num system="onscreen">S01E26</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
