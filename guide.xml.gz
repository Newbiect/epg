<programme start="20261110133100 +0000" stop="20261110142200 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Escape</sub-title><desc lang="es">Un convicto que había sido apresado por el agente Fornell, del FBI, escapa y lo amenaza tanto a a él como a su hija. Gibbs sale de su retiro para reabrir el caso de robo a mano armada del convicto.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.1.0/1</episode-num><episode-num system="onscreen">S04E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110142200 +0000" stop="20261110151400 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">La Búsqueda</sub-title><desc lang="es">El equipo se entera de que una teniente de la Marina desaparecida había estado haciendo averiguaciones sobre unos hombres para encontrar la pareja perfecta. Descubren que ella planeaba asistir a un seminario para solteros en un hotel de la zona.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.2.0/1</episode-num><episode-num system="onscreen">S04E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110151400 +0000" stop="20261110160600 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Fingiendo</sub-title><desc lang="es">El equipo del NCIS es convocado a la escena del raro asesinato de un suboficial que formaba parte de una operación de armas encubierta.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.3.0/1</episode-num><episode-num system="onscreen">S04E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
