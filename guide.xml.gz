<programme start="20261112044400 +0000" stop="20261112054200 +0000" channel="AMC en español"><title lang="es">Dark Winds</title><sub-title lang="es">Náá&apos;tsoh (Big Eyes)</sub-title><desc lang="es">Leaphorn y Chee se encuentran en una cacería humana después de hacer un descubrimiento impactante. El agente especial Washington interroga a Leaphorn sobre una persona de interés.</desc><credits><director>Michael Nankin</director><actor>Zahn McClarnon</actor><actor>Kiowa Gordon</actor><actor>Jessica Matten</actor><actor>Deanna Allison</actor><actor>Rainn Wilson</actor><actor>Elva Guerra</actor><actor>Jeremiah Bitsui</actor><actor>Eugene Brave Rock</actor><actor>Noah Emmerich</actor></credits><date>20250316</date><episode-num system="xmltv_ns">2.1.0/1</episode-num><episode-num system="onscreen">S03E02</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/1280x720/e0e721d4012a3096989efc1ff00f8d92.jpeg"/></programme>
