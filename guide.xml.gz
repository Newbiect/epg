<programme start="20261011235400 +0000" stop="20261012002300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Por Kagura</sub-title><desc lang="es">A pesar de que había niños presentes, Funamushi pelea ferozmennte sin importar el daño que cause. Mientras tanto, Araumi es informado por su hijo mayor Isari que su hijo adoptivo Tenma fue asesinado en batalla.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220501</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.246.0/1</episode-num><episode-num system="onscreen">S16E247</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012002300 +0000" stop="20261012005200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Otra feroz batalla</sub-title><desc lang="es">Denki e Iwabe protegen a los ninños que los habían acompañado a buscar comida. Los niños fueron capaces de escapar, pero los shinobi fueron capturados por Funamushi y su escuadrón.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220508</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.247.0/1</episode-num><episode-num system="onscreen">S16E248</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012005200 +0000" stop="20261012012100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Odio creciente</sub-title><desc lang="es">Boruto y sus amigos logran salir triunfantes contra Funamushi, pero no pudieron disfrutar su victoria.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220515</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.248.0/1</episode-num><episode-num system="onscreen">S16E249</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012012100 +0000" stop="20261012015000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La sangre de los Funanto</sub-title><desc lang="es">Ikada regresa a casa después de enterarse que su hermana fue gravemente herida en batalla.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220522</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.249.0/1</episode-num><episode-num system="onscreen">S16E250</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012015000 +0000" stop="20261012021900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La determinación de ambos</sub-title><desc lang="es">Araumi está furioso por la pérdida de miembros de su familia y de muchos de sus subordinados durante las batallas libradas hasta el momento.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220529</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.250.0/1</episode-num><episode-num system="onscreen">S16E251</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012021900 +0000" stop="20261012024800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Deseo de Creer</sub-title><desc lang="es">Sarada, Mitsuki y Boruto deciden reunirse con el Mizukage.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220605</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.251.0/1</episode-num><episode-num system="onscreen">S16E252</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012024800 +0000" stop="20261012031700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Sentimientos Conflictivos</sub-title><desc lang="es">Boruto, Sarada y Mitsuki van a reunirse con Ikada, que ahora se contra la Tierra del Agua. Boruto intenta hablar con Ikada como amigo para que deje de luchar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220612</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.252.0/1</episode-num><episode-num system="onscreen">S16E253</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012031700 +0000" stop="20261012034600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Espiral de Venganza</sub-title><desc lang="es">Los desesperados intentos de Boruto por razonar con Ikada fracasan y no logra hacerle cambiar de opinión. Se dispone a dar su vida para impedir que la Tierra del Agua y los piratas luchen.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220619</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.253.0/1</episode-num><episode-num system="onscreen">S16E254</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012034600 +0000" stop="20261012041500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Una Tarea Complicada</sub-title><desc lang="es">La rebelión pirata que sacude a la Tierra del Agua es controlada. Al regresar con sus amigos a la Aldea Escondida de la Hoja, Boruto se pregunta qué ha sido de Ikada.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220626</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.254.0/1</episode-num><episode-num system="onscreen">S16E255</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012041500 +0000" stop="20261012044400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Receta Perfecta</sub-title><desc lang="es">Cho-Cho e Inojin terminan haciendo ramen para ayudar a un antiguo Shinobi y dueño de un restaurante de ramen de nombre Shingo Kumano a quien conocieron en una misión.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220703</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.255.0/1</episode-num><episode-num system="onscreen">S16E256</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012044400 +0000" stop="20261012051300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¿Konohamaru se convierte en el Hokage?</sub-title><desc lang="es">A Naruto le pidieron que actúe como él mismo en Malvado Jammer Kagemasa, una película de una popular serie. Konohamaru termina actuando ese rol.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220710</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.256.0/1</episode-num><episode-num system="onscreen">S16E257</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012051300 +0000" stop="20261012054200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La familia Uzumaki en las Aguas Termales</sub-title><desc lang="es">Boruto y Kawaki se unen a Naruto, Hinata y Himawari en un viaje familiar en las aguas termales. Los cinco se divierten jugando ping-pong y disfrutan la comida y las aguas termales de la posada.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220717</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.257.0/1</episode-num><episode-num system="onscreen">S16E258</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012054200 +0000" stop="20261012061100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Una Herida que Nunca Sana</sub-title><desc lang="es">Mitsuki, Boruto, y Sarada estás asitiendo con una patrulla a la aldea por petición del departamento de policía, que está teninedo dificultades al investigar una serie de misterioso ataques.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220724</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.258.0/1</episode-num><episode-num system="onscreen">S16E259</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012061100 +0000" stop="20261012064000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Fuegos Artificiales de Amor</sub-title><desc lang="es">Mientras pasean por la Aldea, Kakashi y Boruto se encuentran con un grupo de personas que discuten. Boruto se da cuenta de la cara triste de una joven pareja y se entera que están comprometidos, y sus abuelos están enfrentados.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220731</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">15.259.0/1</episode-num><episode-num system="onscreen">S16E260</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65a2b1aab98e5ee28f276/tile_1780325420554.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012064000 +0000" stop="20261012070900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Un halcón sin alas</sub-title><desc lang="es">Boruto acompaña a Sasuke a un entrenador de halcones para conseguir un halcón mensajero. Ahí, Boruto y Sasuke oyen hablar de una persona que vende animales raros y deciden investigar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221106</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.273.0/1</episode-num><episode-num system="onscreen">S18E274</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012070900 +0000" stop="20261012073800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">De vuelta al cielo</sub-title><desc lang="es">De repente, el halcón de Tsuzura ha sido vendido, así que hace lo que puede para recuperar a su preciada ave. Al oír lo ocurrido, Boruto ignora a Sasuke y se apresura a ayudar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221113</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.274.0/1</episode-num><episode-num system="onscreen">S18E275</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012073800 +0000" stop="20261012080700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Bienvenidos al Laberinto</sub-title><desc lang="es">Boruto se queda dormido en el Tren Trueno y se despierta en un lugar que no conoce junto con otros pasajeros.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221120</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.275.0/1</episode-num><episode-num system="onscreen">S18E276</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012080700 +0000" stop="20261012083600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Vidas que desaparecen</sub-title><desc lang="es">Como sujetos de prueba van cayendo uno por uno, y Boruto intenta mantener a todos con vida.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221127</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.276.0/1</episode-num><episode-num system="onscreen">S18E277</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012083600 +0000" stop="20261012090500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El juego de las sillas</sub-title><desc lang="es">Mientras todos están exhaustos por los experimentos de Ouga, un sujeto de prueba habla de sus objetivos, lo que hace que todos los demás hablen sobre lo que quieren hacer si sobreviven.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221204</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.277.0/1</episode-num><episode-num system="onscreen">S18E278</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012090500 +0000" stop="20261012093400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El obstáculo: siete</sub-title><desc lang="es">Mientras Boruto y los demás son forzados a participar en los experimentos de Ouga, Sarada y su equipo investigan la desaparición de Boruto y descubren de la existencia de un individuo sospechoso.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221211</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.278.0/1</episode-num><episode-num system="onscreen">S18E279</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012093400 +0000" stop="20261012100300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Solución</sub-title><desc lang="es">Ignorando el peligro en el que está su vida, Boruto le dice a los demás sujetos de prueba que escapen mientras se encarga de la persona que podría estar trabajando con Ouga. Pero deciden quedarse a ayudar a Boruto a pelear con el sospechoso.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221218</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.279.0/1</episode-num><episode-num system="onscreen">S18E280</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012100300 +0000" stop="20261012103200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La octava verdad</sub-title><desc lang="es">Boruto vuelve a despertar para darse cuenta de que está en la primera sala. \&quot;No confíes en nada\&quot; son las palabras que dejó otro sujeto de prueba.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221225</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">17.280.0/1</episode-num><episode-num system="onscreen">S18E281</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e7969011a68f7704e9af07/tile_1780325473470.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012103200 +0000" stop="20261012110100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Kawaki entra a la Academia Ninja!</sub-title><desc lang="es">Kawaki entra a la Academia Ninja y comienza las clases como novato junto a Himawari y los demás.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220807</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.260.0/1</episode-num><episode-num system="onscreen">S17E261</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012110100 +0000" stop="20261012113000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La fiesta del té de la princesa</sub-title><desc lang="es">A Kawaki le cuesta acostumbrarse a la vida escolar, pero consigue hacerse amigo de la princesa Kae, objeto de su misión de guardia. Mientras tanto,</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220814</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.261.0/1</episode-num><episode-num system="onscreen">S17E262</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012113000 +0000" stop="20261012115900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Las cualidades de Hana Sensei!</sub-title><desc lang="es">Boruto, Sarada y Mitsuki dan una conferencia especial en la Academia para estudiantes de primer año como Kawaki y Himawari.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220821</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.262.0/1</episode-num><episode-num system="onscreen">S17E263</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012115900 +0000" stop="20261012122800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡El grupo de exploración de los Siete Misterios!</sub-title><desc lang="es">Tras conocer los \&quot;Siete Misterios\&quot; en la Academia Ninja, Himawari y varios de sus compañeros deciden ir a investigarlos por la noche.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220828</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.263.0/1</episode-num><episode-num system="onscreen">S17E264</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012122800 +0000" stop="20261012125700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Duelo de equipos: ejercicios prácticos!</sub-title><desc lang="es">Kawaki y Himawari participan en una sesión de entrenamiento en el bosque cercano a la academia. La clase se divide en equipos de tres personas y Kawaki acaba en un equipo diferente al de Kae.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220904</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.264.0/1</episode-num><episode-num system="onscreen">S17E265</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012125700 +0000" stop="20261012132600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡El Secuestro de Himawari!</sub-title><desc lang="es">Osaku Kamakura es secustrada para pedir un rescate por ella, junto con Himawari. Cuando el líder de los ladrónes descubre que ella es la hija de Hokage, comienza a pensar en formas para sacarle ventaja a eso también.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220911</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.265.0/1</episode-num><episode-num system="onscreen">S17E266</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012132600 +0000" stop="20261012135500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¿Descubren el Secreto de Kawaki?</sub-title><desc lang="es">La clase de Kawaki y Himawari va a montar una obra sobre los legendarios Sannon para el festival escolar.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220918</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.266.0/1</episode-num><episode-num system="onscreen">S17E267</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012135500 +0000" stop="20261012142400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Objetivo: El Festival Escolar</sub-title><desc lang="es">El festival escolar de la Academia comienza y Kawaki se encuentra con alguien que cree puede ser un asesino que intenta matar a Kae.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20220925</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.267.0/1</episode-num><episode-num system="onscreen">S17E268</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012142400 +0000" stop="20261012145300 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Sombra Furtiva</sub-title><desc lang="es">Debido a que no reportó al asesino, sacan a Kawaki de la misión. Mientras tanto, quieren apresurar el regreso a Kae a su casa por este incidente.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221002</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.268.0/1</episode-num><episode-num system="onscreen">S17E269</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012145300 +0000" stop="20261012152200 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Dos Lados de la Misma Moneda</sub-title><desc lang="es">Hana, quién ya se recuperó de sus heridas, y Kawaki que está protegiendo a Kae de nuevo, regresan a clase. La vida en la Academia poco a poco regresa a la normalidad.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221009</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.269.0/1</episode-num><episode-num system="onscreen">S17E270</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012152200 +0000" stop="20261012155100 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Isla de la Traición</sub-title><desc lang="es">La clase de Kawaki y Himawari se va de excursión a una isla deshabitada para crear nuevos recuerdos con Kae.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221016</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.270.0/1</episode-num><episode-num system="onscreen">S17E271</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012155100 +0000" stop="20261012162000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Estudiantes unidos!</sub-title><desc lang="es">El asesino que acechaba a Kae por fin ha sido revelado. Debido a sus enfrentamientos anteriores, Kawaki sabe que se trata de un enemigo poderoso.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221023</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.271.0/1</episode-num><episode-num system="onscreen">S17E272</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012162000 +0000" stop="20261012164900 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Hasta pronto, Academia Ninja!</sub-title><desc lang="es">Kae ha sido secuestrada y Kawaki debe enfrentarse a un peligroso asesino. Himawari actúa como su compañera y le proporciona apoyo durante la batalla.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20221030</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">16.272.0/1</episode-num><episode-num system="onscreen">S17E273</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65fc8a68b1a2a813eba05/tile_1780325445016.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012164900 +0000" stop="20261012171800 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Regreso de los Exámenes Chunin</sub-title><desc lang="es">Naruto propone que se celebre el Examen Chunin para levantar la moral tras el ataque de Isshiki.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211024</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.220.0/1</episode-num><episode-num system="onscreen">S15E221</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012171800 +0000" stop="20261012174700 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Noche Antes de la Ronda Final</sub-title><desc lang="es">Se anuncia la ronda final del Examen Chunin. Muchos de los compañeros de Boruto que no pasaron a la ronda final del último examen lo han conseguido esta vez.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211031</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.221.0/1</episode-num><episode-num system="onscreen">S15E222</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012174700 +0000" stop="20261012181600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Inojin contra Houki</sub-title><desc lang="es">La ronda final de los exámenes por fin ha comenzado. El primer duelo es Inojin contra Houki. El equipo de Houki ha estado participando en las misiones de cazadores especiales ANBU.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211107</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.222.0/1</episode-num><episode-num system="onscreen">S15E223</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012181600 +0000" stop="20261012184500 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Leyenda del Gato Monstruo</sub-title><desc lang="es">El siguiente combate de las rondas finales es entre Iwabe y Wasabi.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211114</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.223.0/1</episode-num><episode-num system="onscreen">S15E224</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261012184500 +0000" stop="20261012191400 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Enfrentamiento entre Mejores Amigas</sub-title><desc lang="es">Comienza el combate entre Sarada y Cho-Cho. Kawaki fue invitado por Naruto para observar, así como Shinki y otros que han venido de la Aldea Escondida de la Arena.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211121</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.224.0/1</episode-num><episode-num system="onscreen">S15E225</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
