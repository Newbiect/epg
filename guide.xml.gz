<programme start="20261022060000 +0000" stop="20261022080000 +0000" channel="AMC 🇺🇸"><title lang="en">The Amityville Horror</title><desc lang="en">Strange events take place after a family (Ryan Reynolds, Melissa George, Jesse James) moves into a new house that was the site of several gruesome murders.</desc><credits><actor>Ryan Reynolds</actor><actor>Melissa George</actor><actor>Jesse James</actor></credits><date>20050101</date><category lang="en">Movies</category><category lang="en">Horror</category><rating system="MPA"><value>TV-PG</value></rating><icon src="https://cdn.tvpassport.com/image/show/960x540/v2/p35685_p_v8_ah.jpg"/></programme>
