<programme start="20261107025200 +0000" stop="20261107034400 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Hiato, parte dos</sub-title><desc lang="es">Mientras el equipo intenta rastrear a los terroristas detrás del atentado que hirió a Gibbs, se enteran de que están planeando otro ataque similar al de las Torres Gemelas y que Gibbs tiene información sobre su plan.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.23.0/1</episode-num><episode-num system="onscreen">S03E24</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261107034400 +0000" stop="20261107043600 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Shalom</sub-title><desc lang="es">El equipo lidia con el retiro de Gibbs. El pasado de Ziva regresa para atormentarla. Sin darse cuenta, presencia el momento en que su excompañero del Mossad asesina a un agregado militar.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.0.0/1</episode-num><episode-num system="onscreen">S04E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261107043600 +0000" stop="20261107052700 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Escape</sub-title><desc lang="es">Un convicto que había sido apresado por el agente Fornell, del FBI, escapa y lo amenaza tanto a a él como a su hija. Gibbs sale de su retiro para reabrir el caso de robo a mano armada del convicto.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.1.0/1</episode-num><episode-num system="onscreen">S04E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261107052700 +0000" stop="20261107061900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">La Búsqueda</sub-title><desc lang="es">El equipo se entera de que una teniente de la Marina desaparecida había estado haciendo averiguaciones sobre unos hombres para encontrar la pareja perfecta. Descubren que ella planeaba asistir a un seminario para solteros en un hotel de la zona.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.2.0/1</episode-num><episode-num system="onscreen">S04E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261107061900 +0000" stop="20261107071100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Fingiendo</sub-title><desc lang="es">El equipo del NCIS es convocado a la escena del raro asesinato de un suboficial que formaba parte de una operación de armas encubierta.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.3.0/1</episode-num><episode-num system="onscreen">S04E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261107071100 +0000" stop="20261107080300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Muerto Y Desenterrado</sub-title><desc lang="es">El equipo investiga el caso de un cabo segundo muerto, que fue encontrado por un agente de bienes raíces. Descubren que el cadáver fue enterrado en un patio trasero y luego exhumado.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.4.0/1</episode-num><episode-num system="onscreen">S04E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261107080300 +0000" stop="20261107085200 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Trampa De Arena</sub-title><desc lang="es">Una explosión mata a un coronel de la Marina en un campo de golf militar. El equipo del NCIS debe trabajar junto con la Unidad de Investigación Criminal del Ejército para encontrar al asesino.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.5.0/1</episode-num><episode-num system="onscreen">S04E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261107085200 +0000" stop="20261107094300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Cacería De Brujas</sub-title><desc lang="es">Llaman y piden dinero por el rescate de la hija de un marine. El equipo del NCIS descubre que los padres de la niña se separaron hace poco, tras una indiscreción marital de la esposa.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.6.0/1</episode-num><episode-num system="onscreen">S04E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
