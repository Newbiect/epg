<programme start="20261122123300 +0000" stop="20261122132600 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Bienvenidos al club</sub-title><desc lang="es">Virginia obliga a Alicia y Strand a eliminar una amenaza zombi fuera de lo común. Un encuentro con un nuevo aliado le da a Strand una idea que podría ser la clave de su libertad.</desc><credits><actor>Lennie James</actor><actor>Alycia Debnam-Carey</actor><actor>Maggie Grace</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Garret Dillahunt</actor><actor>Austin Amelio</actor><actor>Alexa Nisenson</actor><actor>Karen David</actor><actor>Jenna Elfman</actor><actor>Ruben Blades</actor><actor>Mo Collins</actor><actor>Colby Hollman</actor><actor>Zoe Colletti</actor><actor>Colby Minifie</actor><actor>Holly Curran</actor><actor>Craig Nigh</actor></credits><date>20201018</date><episode-num system="xmltv_ns">5.1.0/1</episode-num><episode-num system="onscreen">S06E02</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/186c5e0b5882a7f04d117ab56fb0ff7f97b941e0.JPEG"/></programme>
<programme start="20261122132600 +0000" stop="20261122141500 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Alaska</sub-title><desc lang="es">Al y Dwight van en una misión de reconocimiento para que Ginny siga una pista que pensaron que se había perdido, pero Al debe elegir entre lo que tiene ahora y lo que está persiguiendo.</desc><credits><actor>Lennie James</actor><actor>Alycia Debnam-Carey</actor><actor>Maggie Grace</actor><actor>Colman Domingo</actor><actor>Danay Garcia</actor><actor>Garret Dillahunt</actor><actor>Austin Amelio</actor><actor>Alexa Nisenson</actor><actor>Karen David</actor><actor>Jenna Elfman</actor><actor>Ruben Blades</actor><actor>Mo Collins</actor><actor>Colby Hollman</actor><actor>Zoe Colletti</actor><actor>Brigitte Canales</actor><actor>Devyn Tyler</actor></credits><date>20201025</date><episode-num system="xmltv_ns">5.2.0/1</episode-num><episode-num system="onscreen">S06E03</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/d4bbc50a4a6752b8625b295a8fd5539cee9a9802.JPEG"/></programme>
