<programme start="20261121164000 +0000" stop="20261121170900 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Un final con efecto</sub-title><desc lang="es">Quedan pocos minutos para el final del partido, y Nankatsu no logra anotar. Los hermanos Tachibana probarán una nueva estrategia para vencer.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.38.0/1</episode-num><episode-num system="onscreen">S01E39</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
