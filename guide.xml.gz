<programme start="20261108012400 +0000" stop="20261108015100 +0000" channel="Las Tortugas Ninja"><title lang="es">Teenage Mutant Ninja Turtles LT</title><sub-title lang="es">El Guerrero de la Estepa</sub-title><desc lang="es">El mundo cambió. Es un desierto sin fin ahora. No quedó ningún humano, sólo mutantes.</desc><credits><actor>Rob Paulsen</actor><actor>Greg Cipes</actor><actor>Sean Astin</actor></credits><date>20170101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.17.0/1</episode-num><episode-num system="onscreen">S05E18</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/63ff6e23689edb0013bce4e7/tile_1769238721082.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108015100 +0000" stop="20261108021800 +0000" channel="Las Tortugas Ninja"><title lang="es">Teenage Mutant Ninja Turtles LT</title><sub-title lang="es">El Desierto Imposible</sub-title><desc lang="es">Por sus viajes por el desierto, Donnie y Raph conocen a Mira, del Clan de los Suricatos salvajes. ella está en busca de un lugar legendario, el Oasis. Para ello, salen en busca de un ser misterioso.</desc><credits><actor>Rob Paulsen</actor><actor>Greg Cipes</actor><actor>Sean Astin</actor></credits><date>20170101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.18.0/1</episode-num><episode-num system="onscreen">S05E19</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/63ff6e23689edb0013bce4e7/tile_1769238721082.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108021800 +0000" stop="20261108024500 +0000" channel="Las Tortugas Ninja"><title lang="es">Teenage Mutant Ninja Turtles LT</title><sub-title lang="es">Carmaguedón</sub-title><desc lang="es">El Oasis es el sueño de todos los que viven en el desierto con muy poco agua, combustible y calor ardiente.</desc><credits><actor>Rob Paulsen</actor><actor>Greg Cipes</actor><actor>Sean Astin</actor></credits><date>20170101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.19.0/1</episode-num><episode-num system="onscreen">S05E20</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/63ff6e23689edb0013bce4e7/tile_1769238721082.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261108024500 +0000" stop="20261108031200 +0000" channel="Las Tortugas Ninja"><title lang="es">Rise of the Teenage Mutant Ninja Turtles</title><sub-title lang="es">Caos místico</sub-title><desc lang="es">Las Tortugas descubren por primera vez que ya no son las criaturas mas extrañas en Nueva York.</desc><credits><actor>Ben Schwartz</actor><actor>Brandon Mychal Smith</actor><actor>Omar Benson Miller</actor><actor>Josh Brener</actor><actor>Eric Bauza</actor><actor>Kat Graham</actor></credits><date>20180101</date><category lang="es">Children &amp; Family</category><category lang="es">Ages 8-10</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/6695435c94a1840013240314/tile_1769470201785.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
