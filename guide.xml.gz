<programme start="20261113220000 +0000" stop="20261113230000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Esclavas de Las Vegas</sub-title><desc lang="es">Grissom y Catherine investigan la aparente muerte violenta de una mujer encontrada en un arenero. Su investigación les lleva al mundo clandestino de los clubes de s y m.</desc><credits><actor>Robert Hall</actor><actor>Wallace Langham</actor><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Jorja Fox</actor></credits><date>20011115</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.7.0/1</episode-num><episode-num system="onscreen">S02E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
