<programme start="20261115020200 +0000" stop="20261115030500 +0000" channel="History 🇺🇸"><title lang="en">The UnXplained</title><sub-title lang="en">Earth&apos;s Unsolved Mysteries</sub-title><desc lang="en">The world is full of displays of natural phenomena; seeing if science can explain Earth&apos;s mysteries or if human knowledge of the Earth has only scratched the surface.</desc><category lang="en">Paranormal</category><category lang="en">Documentary</category><rating system="MPA"><value>TV-14</value></rating><icon src="https://cdn.tvpassport.com/image/show/960x540/v2/p17027962_b_v12_bt.jpg"/></programme>
<programme start="20261115030500 +0000" stop="20261115040500 +0000" channel="History 🇺🇸"><title lang="en">The UnXplained</title><sub-title lang="en">Impossible Ancient Inventions</sub-title><desc lang="en">There are stories of advanced technology from the ancient past that seem too impossible to be true; these technologies challenge everything humanity thought about the innovation of ancestors.</desc><category lang="en">Paranormal</category><category lang="en">Documentary</category><rating system="MPA"><value>TV-14</value></rating><icon src="https://cdn.tvpassport.com/image/show/960x540/v2/p17027962_b_v12_bt.jpg"/></programme>
