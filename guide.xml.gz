<programme start="20261015045100 +0000" stop="20261015054300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Secreto familiar</sub-title><desc lang="es">El equipo investiga la misteriosa explosión de una ambulancia que supuestamente transportaba los restos de un marine muerto en un accidente de auto.</desc><credits><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>David Mccallum</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor><actor>Cote De Pablo</actor><actor>Lauren Holly</actor><actor>Brian Dietzen</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.15.0/1</episode-num><episode-num system="onscreen">S03E16</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
