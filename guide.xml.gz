<programme start="20261030162200 +0000" stop="20261030164900 +0000" channel="Naruto"><title lang="es">Naruto: La Luz Contra La Oscuridad. Las Dos Caras De Gaara</title><sub-title lang="es">La Luz Contra La Oscuridad. Las Dos Caras De Gaara</sub-title><desc lang="es">Naruto está indefenso ante el inmenso poder de Gaara. A diferencia de Naruto, que manifiesta que pelea por sus compañeros, Gaara dice que él solo lucha por sí mismo.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040331</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.76.0/1</episode-num><episode-num system="onscreen">S02E77</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261030164900 +0000" stop="20261030171600 +0000" channel="Naruto"><title lang="es">Naruto: El Manual Ninja De Naruto</title><sub-title lang="es">El Manual Ninja De Naruto</sub-title><desc lang="es">Naruto está indefenso ante la fuerza abrumadora de Gaara. Sin embargo, después de ver a Sasuke arriesgándolo todo para salvarlos a él y a Sakura…</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040407</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.77.0/1</episode-num><episode-num system="onscreen">S02E78</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261030171600 +0000" stop="20261030174300 +0000" channel="Naruto"><title lang="es">Naruto: Más Allá Del Límite De La Oscuridad Y La Luz</title><sub-title lang="es">Más Allá Del Límite De La Oscuridad Y La Luz</sub-title><desc lang="es">Gaara utiliza su Jutsu de muerte falsa, que permite que el espíritu de la arena de su interior, Shukaku, muestre su verdadero poder.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040414</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.78.0/1</episode-num><episode-num system="onscreen">S02E79</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
