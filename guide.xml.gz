<programme start="20261111031100 +0000" stop="20261111033800 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Una Hermosa Asesina</sub-title><desc lang="es">Cuando Bison captura a Ken y Chun-Li y envía una nota de rescate, el padre de Ken envía a los pilotos de Guile y Nash Air Force para encontrarlos.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.17.0/1</episode-num><episode-num system="onscreen">S01E18</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111033800 +0000" stop="20261111040500 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Los Agentes Secreto</sub-title><desc lang="es">Guile y Nash buscan pistas sobre la desaparición de Ken en Barcelona. Bison envía al luchador ruso Zangief para capturar a Ryu.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.18.0/1</episode-num><episode-num system="onscreen">S01E19</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111040500 +0000" stop="20261111043200 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Hadou la fuerza preponderante del Cosmos</sub-title><desc lang="es">Debilitado, Ryu se ve obligado a luchar con Zangief. Cammy ataca al Capitán Dorai. Guile finalmente encuentra pistas en Barcelona.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.19.0/1</episode-num><episode-num system="onscreen">S01E20</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111050000 +0000" stop="20261111052600 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">La manifestación del Hadou</sub-title><desc lang="es">Ryu usa Hadou para deshacerse de las cadenas y encontrar a sus amigos. Guile ve el talento de Ryu y decide involucrarse.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.21.0/1</episode-num><episode-num system="onscreen">S01E22</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111052600 +0000" stop="20261111055400 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">El brillo misterioso</sub-title><desc lang="es">Ken ve a Chun-Li matar a un soldado. Balrog es informado de que Dorai está muerto y envía a Cammy al hospital para confirmar.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.22.0/1</episode-num><episode-num system="onscreen">S01E23</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111055400 +0000" stop="20261111062200 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Al encuentro de una pesadilla</sub-title><desc lang="es">Bajo el control de Bison, Ryu entra en la arena de prueba. En la base, Guile y Nash deciden separarse para cubrir un área más grande.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.23.0/1</episode-num><episode-num system="onscreen">S01E24</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111062200 +0000" stop="20261111065000 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Una lucha violenta</sub-title><desc lang="es">Guile se enfrenta al poderoso Zangief. Fei-Long se enfrenta a Cammy en el hospital. Ryu se ve obligado a luchar contra Ken bajo el control de Bison.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.24.0/1</episode-num><episode-num system="onscreen">S01E25</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111065000 +0000" stop="20261111071800 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Grito último del amigo que muere</sub-title><desc lang="es">Zangief tiene una ventaja sobre Guile. Ken se ve obligado a defenderse contra Ryu. Cammy y Fei-Long continúan luchando en el hospital.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.25.0/1</episode-num><episode-num system="onscreen">S01E26</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111071800 +0000" stop="20261111074600 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Energías Hadou al límite</sub-title><desc lang="es">Guile derrota a Zangief, pero termina recibiendo una trágica sorpresa. Fei-Long le explica a Cammy que Shadaloo la engañó.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.26.0/1</episode-num><episode-num system="onscreen">S01E27</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111074600 +0000" stop="20261111081400 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Fuerza de destrucción de tornado</sub-title><desc lang="es">La gran explosión causada por el Hadou combinado de Ryu y Ken desplaza el chip de la cabeza de Ryu y destruye toda la base.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.27.0/1</episode-num><episode-num system="onscreen">S01E28</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111081400 +0000" stop="20261111084300 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Inojin contra Houki</sub-title><desc lang="es">La ronda final de los exámenes por fin ha comenzado. El primer duelo es Inojin contra Houki. El equipo de Houki ha estado participando en las misiones de cazadores especiales ANBU.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211107</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.222.0/1</episode-num><episode-num system="onscreen">S15E223</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111084300 +0000" stop="20261111091200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">La Leyenda del Gato Monstruo</sub-title><desc lang="es">El siguiente combate de las rondas finales es entre Iwabe y Wasabi.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211114</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.223.0/1</episode-num><episode-num system="onscreen">S15E224</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111091200 +0000" stop="20261111094100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Enfrentamiento entre Mejores Amigas</sub-title><desc lang="es">Comienza el combate entre Sarada y Cho-Cho. Kawaki fue invitado por Naruto para observar, así como Shinki y otros que han venido de la Aldea Escondida de la Arena.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211121</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.224.0/1</episode-num><episode-num system="onscreen">S15E225</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111094100 +0000" stop="20261111101000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Samurái contra Ciencia</sub-title><desc lang="es">Uno después de otro, los ganadores de las finales se deciden. Solo quedan un par de encuentros, pero Boruto y Mitsuki aun no han llegado a los exámenes.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211128</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.225.0/1</episode-num><episode-num system="onscreen">S15E226</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261111101000 +0000" stop="20261111103900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¿¡La Última Misión del Equipo Siete!?</sub-title><desc lang="es">Al equipo siete, con Sarada como capitana, se le asigna una misión. Mirai, que fue a una misión con Konohamaru, regresa a la aldea gravemente herida.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211205</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">14.226.0/1</episode-num><episode-num system="onscreen">S15E227</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e65ba7fe5af3622322b3fc/tile_1780324211201.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
