<programme start="20261109195300 +0000" stop="20261109202200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Tower of Gray</sub-title><desc lang="es">Kakyoin se enfrenta a un Stand sin conocer a su usuario mientras Jotaro y su equipo se encuentran con uno de los matones de Dio en el vuelo a Egipto.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140425</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.3.0/1</episode-num><episode-num system="onscreen">S02E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261109202200 +0000" stop="20261109205100 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Silver Chariot</sub-title><desc lang="es">La victoria de Avdol sobre Polnareff, el asesino controlado mentalmente por Dio y dotado de poderes excepcionales, se presenta complicada.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140502</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.4.0/1</episode-num><episode-num system="onscreen">S02E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261109205100 +0000" stop="20261109212000 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Dark Blue Moon</sub-title><desc lang="es">Jotaro y su equipo ponen rumbo a Singapur en barco. Poco después de descubrir un polizón a bordo, un Stand con un usuario desconocido ataca a Jotaro.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140509</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.5.0/1</episode-num><episode-num system="onscreen">S02E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
