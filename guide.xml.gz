<programme start="20261124010900 +0000" stop="20261124013900 +0000" channel="40 y 20"><title lang="es">40 y 20</title><sub-title lang="es">Cuando el bótox nos alcance</sub-title><desc lang="es">En una fiesta de Lucas, una guapa chica le dice a Paco que no está tan mal, pero que se podría ver mejor si se da una manita de gato.</desc><credits><actor>Jorge Van Rankin</actor><actor>Mauricio Garza</actor><actor>Michelle Rodríguez</actor><actor>Mónica Huarte</actor><actor>Begoña Narváez</actor><actor>Oswaldo Zárate</actor><actor>Gerardo Taracena</actor><actor>Armando Hernández</actor><actor>Pascacio López</actor><actor>Sophié Alexander</actor><actor>Jessica Mas</actor><actor>María Aura</actor><actor>Luis Gatica</actor></credits><date>20221229</date><episode-num system="xmltv_ns">8.8.0/1</episode-num><episode-num system="onscreen">S09E09</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/d49f17e1988ab745c17d22573270814b.jpeg"/></programme>
<programme start="20261124013900 +0000" stop="20261124020900 +0000" channel="40 y 20"><title lang="es">40 y 20</title><sub-title lang="es">Una visita inesperada</sub-title><desc lang="es">Brayan y Toña van al velorio de la abuelita de su primo el Natas, pero de regreso se traen un espíritu del panteón.</desc><credits><actor>Jorge Van Rankin</actor><actor>Mauricio Garza</actor><actor>Michelle Rodríguez</actor><actor>Mónica Huarte</actor><actor>Begoña Narváez</actor><actor>Oswaldo Zárate</actor><actor>Gerardo Taracena</actor><actor>Armando Hernández</actor><actor>Pascacio López</actor><actor>Sophié Alexander</actor><actor>Jessica Mas</actor><actor>María Aura</actor><actor>Luis Gatica</actor></credits><date>20221229</date><episode-num system="xmltv_ns">8.9.0/1</episode-num><episode-num system="onscreen">S09E10</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/a0f00c4f4e9df4835e29f5d1018b502b.jpeg"/></programme>
<programme start="20261124020900 +0000" stop="20261124023900 +0000" channel="40 y 20"><title lang="es">40 y 20</title><sub-title lang="es">El onomástico de Toña</sub-title><desc lang="es">El cumpleaños de Toña parece una típica celebración hasta que, al calor de las copas, las cosas se salen de control y llega la policía.</desc><credits><actor>Jorge Van Rankin</actor><actor>Mauricio Garza</actor><actor>Michelle Rodríguez</actor><actor>Mónica Huarte</actor><actor>Begoña Narváez</actor><actor>Oswaldo Zárate</actor><actor>Gerardo Taracena</actor><actor>Armando Hernández</actor><actor>Pascacio López</actor><actor>Sophié Alexander</actor><actor>Jessica Mas</actor><actor>María Aura</actor><actor>Luis Gatica</actor></credits><date>20221230</date><episode-num system="xmltv_ns">8.10.0/1</episode-num><episode-num system="onscreen">S09E11</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/1920x1080/900c199f24b72fb810c0def900af0fb0.jpeg"/></programme>
