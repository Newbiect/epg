<programme start="20261103035200 +0000" stop="20261103042200 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">Aome Regresa a su Época</sub-title><desc lang="es">Kagome se lesiona durante la pelea de Inuyasha con Sesshomaru, y cuando Inuyasha se entera del plan de Naraku, teme por su vida.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010312</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.18.0/1</episode-num><episode-num system="onscreen">S01E19</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103042200 +0000" stop="20261103045200 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">El Misterio de Onigumo</sub-title><desc lang="es">Kaede lleva a Inuyasha y Miroku a una cueva cercana que aparece en ella y en el pasado de Kikyo. Mientras tanto, Kagome intenta reajustarse a su vida normal.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010319</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.19.0/1</episode-num><episode-num system="onscreen">S01E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103045200 +0000" stop="20261103052200 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">El Secreto de Naraku</sub-title><desc lang="es">La pelea de Inuyasha con Royakan continúa. Kagome interrumpe su cita con Hojo para regresar al santuario, donde siente la presencia de la joya.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010409</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.20.0/1</episode-num><episode-num system="onscreen">S01E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103052200 +0000" stop="20261103055200 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">Las Almas de Kikyo</sub-title><desc lang="es">Al parecer, Kikyo ha resucitado y vive como sacerdotisa de una aldea. Un monje errante se da cuenta de que no todo es como parece con ella.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010409</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.21.0/1</episode-num><episode-num system="onscreen">S01E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103055200 +0000" stop="20261103062200 +0000" channel="Pluto TV Anime"><title lang="es">Inuyasha LT</title><sub-title lang="es">La Voz de Aome y el Beso De Kikyo</sub-title><desc lang="es">Inuyasha busca a Kikyo, pero Kagome la encuentra primero. Kikyo toma a su prisionera y no escucha sus intentos de explicar lo que realmente sucedió.</desc><credits><actor>Alfredo Basurto (Sesshomaru)</actor><actor>Ana Lobo (Aome Higurashi)</actor><actor>Enzo Fortuny (Inuyasha)</actor><actor>Gabriel Gama (Miroku)</actor><actor>Georgina Sánchez (Kikyo)</actor><actor>Liliana Barba (Sango)</actor></credits><date>20010416</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.22.0/1</episode-num><episode-num system="onscreen">S01E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64a83d8df56d820013a09168/tile_1769549401567.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
