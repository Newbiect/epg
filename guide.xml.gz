<programme start="20261027063700 +0000" stop="20261027073000 +0000" channel="AMC en español"><title lang="es">Fear the Walking Dead</title><sub-title lang="es">Todos caemos</sub-title><desc lang="es">El grupo busca refugiarse con una familia de sobrevivientes. Madison rastrea los verdaderos motivos familiares mientras Salazar trata de descubrir a Strand.</desc><credits><actor>Kim Dickens</actor><actor>Cliff Curtis</actor><actor>Frank Dillane</actor><actor>Alycia Debnam-Carey</actor><actor>Elizabeth Rodriguez</actor><actor>Mercedes Mason</actor><actor>Ruben Blades</actor><actor>Lorenzo Henrie</actor><actor>Colman Domingo</actor><actor>Catherine Dent</actor><actor>David Warshofsky</actor><actor>Aria Leabu</actor><actor>Jake Walker</actor></credits><date>20160417</date><episode-num system="xmltv_ns">1.1.0/1</episode-num><episode-num system="onscreen">S02E02</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/d793804b8c01204f5f91ffd0488607a93cd69201.jpg"/></programme>
