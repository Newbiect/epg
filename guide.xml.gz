<programme start="20261106191603 +0000" stop="20261106194503 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Daisy, la Quinceañera</sub-title><desc lang="es">Es la fiesta de 15 años de la prima de Dora, Daisy. Pero la fiesta no puede empezar sin Dora y Botas. Ellos les enseñarán a bailar el mambo a todos.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20040101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">3.5.0/1</episode-num><episode-num system="onscreen">S04E06</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261106194503 +0000" stop="20261106201303 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El Deseo de Botas</sub-title><desc lang="es">El deseo de plátanos de Botas se sale de control. Tú y Dora deben ayudarlo a encontrar otra máquina de los deseos para que Botas pueda pedir un nuevo deseo.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.15.0/1</episode-num><episode-num system="onscreen">S05E16</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261106201303 +0000" stop="20261106204103 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">El desfile de Mochila</sub-title><desc lang="es">Dora y Botas se preparan para el gran desfile de disfraces de Mochila. Mochila está súper emocionada porque va a cantar su canción para abrir el desfile, pero no puede dejar de estornudar.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20080101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">4.6.0/1</episode-num><episode-num system="onscreen">S05E07</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261106204103 +0000" stop="20261106211003 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Animales del alfabeto</sub-title><desc lang="es">&quot;A&quot; es de Armadillo. Pero, ¿a dónde está el resto de los animales del libro del alfabeto? ¡Se han perdido! Dora y Botas se meten en el gigante libro para ayudar al armadillo a resolver el misterio.</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080713</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.22.0/1</episode-num><episode-num system="onscreen">S03E23</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
