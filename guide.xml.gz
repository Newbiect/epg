<programme start="20261114010100 +0000" stop="20261114015300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Muerto Y Desenterrado</sub-title><desc lang="es">El equipo investiga el caso de un cabo segundo muerto, que fue encontrado por un agente de bienes raíces. Descubren que el cadáver fue enterrado en un patio trasero y luego exhumado.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.4.0/1</episode-num><episode-num system="onscreen">S04E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114015300 +0000" stop="20261114024200 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Trampa De Arena</sub-title><desc lang="es">Una explosión mata a un coronel de la Marina en un campo de golf militar. El equipo del NCIS debe trabajar junto con la Unidad de Investigación Criminal del Ejército para encontrar al asesino.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.5.0/1</episode-num><episode-num system="onscreen">S04E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
