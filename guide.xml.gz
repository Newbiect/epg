<programme start="20261120042703 +0000" stop="20261120045603 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Roberto el robot</sub-title><desc lang="es">Dora y Botas conocen a Roberto, un robot con un cinturón de herramientas, luces, poderes de estiramiento y mucha fuerza. Pero Roberto está perdido y no encuentra a su abuelo. ¿Lo ayudamos?</desc><credits><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>Marc Weiner</actor><actor>Sasha Toro</actor><actor>Jake Burbage</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunningham</actor><actor>Leisha Medina</actor><actor>Giannina Jurado</actor><actor>Alfonso Soto</actor></credits><date>20080710</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.3.0/1</episode-num><episode-num system="onscreen">S03E04</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261120045603 +0000" stop="20261120052603 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Al rescate</sub-title><desc lang="es">¡Oh, no! Tres de nuestros amigos están en problemas. El bebé Jaguar está atrapado en un árbol, Isa cayó en un pozo de arena y Benny está atrapado en el Géiser Pegajoso. ¿A quién rescatamos primero?</desc><date>00010101</date><category lang="es">Children &amp; Family</category><category lang="es">Family Animation</category><episode-num system="xmltv_ns">2.16.0/1</episode-num><episode-num system="onscreen">S03E17</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
