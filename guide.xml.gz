<programme start="20261031092800 +0000" stop="20261031095300 +0000" channel="Yu-Gi-Oh"><title lang="es">Yu-Gi-Oh!</title><sub-title lang="es">Jugando con un Parásito, Segunda Parte</sub-title><desc lang="es">Joey acaba de aplastar a Perfectamente Máxima Gran Palomilla cuando Weevil suelta a la Reina Insecto Feroz, ¡la joya coronada de los insectos que se pone mas poderosa con cada insecto que canibaliza!</desc><credits><actor>Joey Wheeler</actor><actor>Mai Valentine</actor><actor>Maximillion Pegasus</actor><actor>Seto Kaiba</actor><actor>Tea Gardner</actor><actor>Yugi Moto</actor></credits><date>20020102</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.14.0/1</episode-num><episode-num system="onscreen">S02E15</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f19972aefe562001369966c/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031095300 +0000" stop="20261031102000 +0000" channel="Yu-Gi-Oh"><title lang="es">Yu-Gi-Oh!</title><sub-title lang="es">El Mimo, Primera Parte</sub-title><desc lang="es">¡Yugi se enfrenta contra el silencioso pero mortal Strings! Strings desactiva todo los ataques de Yugi usando Revival Jam, ¡una baba resbaladiza que resuscita cada vez que se destruye!</desc><credits><actor>Joey Wheeler</actor><actor>Mai Valentine</actor><actor>Maximillion Pegasus</actor><actor>Seto Kaiba</actor><actor>Tea Gardner</actor><actor>Yugi Moto</actor></credits><date>20020102</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.15.0/1</episode-num><episode-num system="onscreen">S02E16</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f19972aefe562001369966c/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031102000 +0000" stop="20261031104500 +0000" channel="Yu-Gi-Oh"><title lang="es">Yu-Gi-Oh!</title><sub-title lang="es">El Mimo, Segunda Parte</sub-title><desc lang="es">Strings convoca a uno de los monstruos más poderosos en la historia de Duel Monsters... El Monstruo Dios Egipcio Slifer el Dragón del Cielo! ¿Que chance tendrán los monstruos mortales de Yugi contra el poder de un Dios Egipcio?</desc><credits><actor>Joey Wheeler</actor><actor>Mai Valentine</actor><actor>Maximillion Pegasus</actor><actor>Seto Kaiba</actor><actor>Tea Gardner</actor><actor>Yugi Moto</actor></credits><date>20020102</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.16.0/1</episode-num><episode-num system="onscreen">S02E17</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f19972aefe562001369966c/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
