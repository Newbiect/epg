<programme start="20261015093500 +0000" stop="20261015100200 +0000" channel="Yu-Gi-Oh"><title lang="es">¡Yu-Gi-Oh! VRAINS</title><sub-title lang="es">Earth, el Ignis de tierra</sub-title><desc lang="es">Playmaker recibe un mensaje del Ignis de Tierra diciendo que quiere verlo, pero ¿será una trampa de Blood Shepherd?</desc><credits><actor>Wayne Grayson</actor><actor>Megan Hollingshead</actor><actor>Eric Stuart</actor><actor>Darren Dunstan</actor><actor>Dan Green</actor><actor>Amy Birnbaum</actor></credits><date>20020101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.19.0/1</episode-num><episode-num system="onscreen">S02E20</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/60022cb472b3e1001a660ccc/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015100200 +0000" stop="20261015103000 +0000" channel="Yu-Gi-Oh"><title lang="es">¡Yu-Gi-Oh! VRAINS</title><sub-title lang="es">El anhelo de las IA</sub-title><desc lang="es">Playmaker sigue su duelo contra Earth, el Ignis de tierra, quien intenta decidir si ponerse del lado de los humanos o en su contra.</desc><credits><actor>Wayne Grayson</actor><actor>Megan Hollingshead</actor><actor>Eric Stuart</actor><actor>Darren Dunstan</actor><actor>Dan Green</actor><actor>Amy Birnbaum</actor></credits><date>20020101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.20.0/1</episode-num><episode-num system="onscreen">S02E21</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/60022cb472b3e1001a660ccc/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015103000 +0000" stop="20261015105700 +0000" channel="Yu-Gi-Oh"><title lang="es">¡Yu-Gi-Oh! VRAINS</title><sub-title lang="es">Reunión secreta</sub-title><desc lang="es">Ai desaparece y Playmaker intenta encontrar su paradero solo para descubrir que podría haber caído en una trampa de Windy.</desc><credits><actor>Wayne Grayson</actor><actor>Megan Hollingshead</actor><actor>Eric Stuart</actor><actor>Darren Dunstan</actor><actor>Dan Green</actor><actor>Amy Birnbaum</actor></credits><date>20020101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.21.0/1</episode-num><episode-num system="onscreen">S02E22</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/60022cb472b3e1001a660ccc/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015105700 +0000" stop="20261015112400 +0000" channel="Yu-Gi-Oh"><title lang="es">¡Yu-Gi-Oh! VRAINS</title><sub-title lang="es">Una misión que cumplir</sub-title><desc lang="es">Varis se prepara para enfrentarse a Windy con intenciones de destruirlo y luego acabar con el resto de los Ignis, pero Playmaker y su compañero IA siguen atrapados y no pueden intervenir.</desc><credits><actor>Wayne Grayson</actor><actor>Megan Hollingshead</actor><actor>Eric Stuart</actor><actor>Darren Dunstan</actor><actor>Dan Green</actor><actor>Amy Birnbaum</actor></credits><date>20020102</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.22.0/1</episode-num><episode-num system="onscreen">S02E23</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/60022cb472b3e1001a660ccc/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015112400 +0000" stop="20261015115100 +0000" channel="Yu-Gi-Oh"><title lang="es">¡Yu-Gi-Oh! VRAINS</title><sub-title lang="es">Se forma una tormenta</sub-title><desc lang="es">Poco a poco los Ignis se reúnen en la sala donde Windy y se baten en duelo. ¿Habrá alguna esperanza de detener la guerra entre humanos e Ignis?</desc><credits><actor>Wayne Grayson</actor><actor>Megan Hollingshead</actor><actor>Eric Stuart</actor><actor>Darren Dunstan</actor><actor>Dan Green</actor><actor>Amy Birnbaum</actor></credits><date>20020102</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.23.0/1</episode-num><episode-num system="onscreen">S02E24</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/60022cb472b3e1001a660ccc/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015115100 +0000" stop="20261015121800 +0000" channel="Yu-Gi-Oh"><title lang="es">¡Yu-Gi-Oh! VRAINS</title><sub-title lang="es">Una decisión lógica</sub-title><desc lang="es">Lightning explica a Ai y a Flame la verdad sobre lo ocurrido con el Cyberse, lo cual perturba a todos por igual.</desc><credits><actor>Wayne Grayson</actor><actor>Megan Hollingshead</actor><actor>Eric Stuart</actor><actor>Darren Dunstan</actor><actor>Dan Green</actor><actor>Amy Birnbaum</actor></credits><date>20020101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.24.0/1</episode-num><episode-num system="onscreen">S02E25</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/60022cb472b3e1001a660ccc/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
