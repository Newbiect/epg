<programme start="20261114020000 +0000" stop="20261114030000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Tienes Hombre</sub-title><desc lang="es">Grissom y Sara son llamados a la escena del crimen cuando dos víctimas de asesinato aparecen ocultas en las tuberías de una obra en construcción en medio de un campo de alfalfa, mientras Catherine y Nick investigan un ostensible accidente de caza.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20011220</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.11.0/1</episode-num><episode-num system="onscreen">S02E12</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114030000 +0000" stop="20261114040000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Crisis de identidad</sub-title><desc lang="es">La némesis de Grissom, el asesino en serie Paul Millander, reaparece y se cobra una tercera víctima en este apasionante episodio.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20020117</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.12.0/1</episode-num><episode-num system="onscreen">S02E13</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261114040000 +0000" stop="20261114050000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">El dedo</sub-title><desc lang="es">Un secuestrador ordena a Catherine que acompañe a un hombre que debe entregarle un rescate de un millón de dólares o, de lo contrario, matará a la amante del hombre.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20020131</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">1.13.0/1</episode-num><episode-num system="onscreen">S02E14</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
