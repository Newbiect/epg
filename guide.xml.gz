<programme start="20261113135300 +0000" stop="20261113150800 +0000" channel="Pluto TV Naturaleza"><title lang="es">océano salvaje</title><sub-title lang="es">Color y camuflaje</sub-title><desc lang="es">Frente a la costa de Filipinas se encuentran algunas de las criaturas marinas más asombrosas del mundo. Conozca la influencia del color cerca de los arrecifes de coral.</desc><credits><actor>Dilly Barlow</actor></credits><date>20200101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67d83a766baaac5c467dcfa2/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261113150800 +0000" stop="20261113162300 +0000" channel="Pluto TV Naturaleza"><title lang="es">océano salvaje</title><sub-title lang="es">Indonesia</sub-title><desc lang="es">El archipiélago de Indonesia es uno de los lugares con mayor biodiversidad del planeta. Con un litoral que se extiende hasta 17.000 islas.</desc><credits><actor>Dilly Barlow</actor></credits><date>20200108</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67d83a766baaac5c467dcfa2/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261113162300 +0000" stop="20261113173800 +0000" channel="Pluto TV Naturaleza"><title lang="es">océano salvaje</title><sub-title lang="es">Japón</sub-title><desc lang="es">Una nación insular moldeada por su proximidad y relación con el agua, las costas únicas de Japón albergan algunos de los ecosistemas marinos más diversos.</desc><credits><actor>Dilly Barlow</actor></credits><date>20200531</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67d83a766baaac5c467dcfa2/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261113173800 +0000" stop="20261113185300 +0000" channel="Pluto TV Naturaleza"><title lang="es">océano salvaje</title><sub-title lang="es">Tailandia</sub-title><desc lang="es">La fauna marina de Tailandia no se parece a ninguna otra. Descubra cómo las criaturas marinas de Tailandia han desarrollado sistemas complejos para evadir a los depredadores, capturar presas, reproducirse y vivir una vida sana.</desc><credits><actor>Dilly Barlow</actor></credits><date>20200201</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67d83a766baaac5c467dcfa2/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261113185300 +0000" stop="20261113192500 +0000" channel="Pluto TV Naturaleza"><title lang="es">carrera de la vida</title><sub-title lang="es">La supervivencia del más fuerte</sub-title><desc lang="es">La historia evolutiva en el mundo natural significa que los animales se adaptan mediante pequeñas mutaciones aleatorias para competir de manera más efectiva por alimento, agua y espacio.</desc><date>20150104</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67d82ae0763d6b068f6a2f19/tile_1790724974335.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261113192500 +0000" stop="20261113195700 +0000" channel="Pluto TV Naturaleza"><title lang="es">carrera de la vida</title><sub-title lang="es">Los grandes felinos</sub-title><desc lang="es">Elegantes, peligrosos, rápidos, crueles y venerados por su belleza y vitalidad, nadie corre la &quot;carrera de la vida&quot; más rápido que los grandes felinos en sus entornos naturales.</desc><date>20150111</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67d82ae0763d6b068f6a2f19/tile_1790724974335.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261113195700 +0000" stop="20261113202900 +0000" channel="Pluto TV Naturaleza"><title lang="es">carrera de la vida</title><sub-title lang="es">La gran carrera del desierto</sub-title><desc lang="es">Los desiertos no son lugares fáciles para que vivan los animales. Los animales del desierto han evolucionado para soportar el calor y la falta de agua del desierto.</desc><date>20150118</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/67d82ae0763d6b068f6a2f19/tile_1790724974335.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
