<programme start="20261017191200 +0000" stop="20261017194000 +0000" channel="40 y 20"><title lang="es">40 y 20</title><sub-title lang="es">Clavado en La Quebrada</sub-title><desc lang="es">Toña se va de fiesta a Acapulco para olvidar a Brayan. Él quiere recuperarla, pero, para volver con ella, tendrá que saltar de La Quebrada.</desc><credits><actor>Jorge Van Rankin</actor><actor>Mauricio Garza</actor><actor>Michelle Rodríguez</actor><actor>Mónica Huarte</actor><actor>Begoña Narváez</actor><actor>Oswaldo Zárate</actor><actor>Gerardo Taracena</actor><actor>Armando Hernández</actor><actor>Pascacio López</actor><actor>Sophié Alexander</actor><actor>Jessica Mas</actor><actor>María Aura</actor><actor>Luis Gatica</actor></credits><date>20211120</date><episode-num system="xmltv_ns">6.0.0/1</episode-num><episode-num system="onscreen">S07E01</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/cms/images/9742ba96c305c85f4b4ead712234b749307d7f00.JPEG"/></programme>
<programme start="20261017194000 +0000" stop="20261017200700 +0000" channel="40 y 20"><title lang="es">40 y 20</title><sub-title lang="es">Y volver volver</sub-title><desc lang="es">Brayan se avienta de La Quebrada para obtener el perdón de Toña, pero todo se complica cuando Irmita visita a un Brayan convaleciente.</desc><credits><actor>Jorge Van Rankin</actor><actor>Mauricio Garza</actor><actor>Michelle Rodríguez</actor><actor>Mónica Huarte</actor><actor>Begoña Narváez</actor><actor>Oswaldo Zárate</actor><actor>Gerardo Taracena</actor><actor>Armando Hernández</actor><actor>Pascacio López</actor><actor>Sophié Alexander</actor><actor>Jessica Mas</actor><actor>María Aura</actor><actor>Luis Gatica</actor></credits><date>20211120</date><episode-num system="xmltv_ns">6.1.0/1</episode-num><episode-num system="onscreen">S07E02</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/cms/images/581524a6a32472f74c5f4b1ed4a46dce660f422c.JPEG"/></programme>
<programme start="20261017200700 +0000" stop="20261017203500 +0000" channel="40 y 20"><title lang="es">40 y 20</title><sub-title lang="es">Adiós, Miranda</sub-title><desc lang="es">Paco cree que Miranda lo irá a buscar para pedirle perdón por su infidelidad en Acapulco, pero ella le confiesa que está embarazada.</desc><credits><actor>Jorge Van Rankin</actor><actor>Mauricio Garza</actor><actor>Michelle Rodríguez</actor><actor>Mónica Huarte</actor><actor>Begoña Narváez</actor><actor>Oswaldo Zárate</actor><actor>Gerardo Taracena</actor><actor>Armando Hernández</actor><actor>Pascacio López</actor><actor>Sophié Alexander</actor><actor>Jessica Mas</actor><actor>María Aura</actor><actor>Luis Gatica</actor></credits><date>20211127</date><episode-num system="xmltv_ns">6.2.0/1</episode-num><episode-num system="onscreen">S07E03</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/cms/images/91cd9e78a706d4514adc7fdddb327197d3de251c.JPEG"/></programme>
