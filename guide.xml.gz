<programme start="20261015083000 +0000" stop="20261015093000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Mamá odiada</sub-title><desc lang="es">Resolver el caso de un abogado defensor adinerado asesinado en la boda de su hijo, se ve comprometido cuando todas las pruebas son robadas junto con el auto de Nick.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20060427</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">5.20.0/1</episode-num><episode-num system="onscreen">S06E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015093000 +0000" stop="20261015103000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">La hora de tu muerte</sub-title><desc lang="es">La evidencia demuestra que las apariencias engañan en el caso de un jugador de alto riesgo y mujeriego, asesinado fuera de un casino después de una noche de juerga.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20060504</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">5.21.0/1</episode-num><episode-num system="onscreen">S06E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015103000 +0000" stop="20261015113000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Disparos</sub-title><desc lang="es">Un hombre acusado de asesinar a su esposa y compañeros de trabajo lidera a los CSI en una persecución salvaje a través de un concurrido casino de Las Vegas.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20060511</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">5.22.0/1</episode-num><episode-num system="onscreen">S06E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015113000 +0000" stop="20261015123000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Entre la vida y la muerte</sub-title><desc lang="es">El equipo de CSI se reúne en torno a uno de los suyos, al recibir un disparo en mientras cumplía su trabajo y es posible que no sobreviva en el final de la sexta temporada.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20060518</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">5.23.0/1</episode-num><episode-num system="onscreen">S06E24</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015123000 +0000" stop="20261015133000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Etiquetas en los pies</sub-title><desc lang="es">Mientras Grissom guía a un grupo de universitarios en un tour por CSI, los muertos hablan mientras los CSI investigan, cada uno narrando su propio caso</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20060921</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">6.0.0/1</episode-num><episode-num system="onscreen">S07E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015133000 +0000" stop="20261015143000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Hecho para matar, parte 1</sub-title><desc lang="es">Los CSI investigan de primera mano los entresijos del Cirque du Soleil para determinar qué pudo contribuir a la prematura muerte de una joven bailarina.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20060928</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">6.1.0/1</episode-num><episode-num system="onscreen">S07E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015143000 +0000" stop="20261015153000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Hecho para matar, parte 2</sub-title><desc lang="es">Grissom se siente fascinado cuando cada detalle de una miniatura es idéntico al de la escena de un crimen real, y se pone manos a la obra para intentar resolver el caso utilizando las pistas proporcionadas.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20061005</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">6.2.0/1</episode-num><episode-num system="onscreen">S07E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015153000 +0000" stop="20261015163000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Sacudir riñoneras</sub-title><desc lang="es">Cuando un hombre inocente es brutalmente atacado y golpeado hasta la muerte por lo que parece un monstruo con una capa negra, los CSI son llamados para investigar, sólo para enterarse de que un ataque similar tuvo lugar minutos después.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20061012</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">6.3.0/1</episode-num><episode-num system="onscreen">S07E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015163000 +0000" stop="20261015173000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Traición</sub-title><desc lang="es">Cuando una mujer muerta aparece colgada de una cruz en el interior de una iglesia, el equipo sigue las pruebas para descubrir un extraño triángulo amoroso que se remonta a los días de instituto de la víctima.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20061019</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">6.4.0/1</episode-num><episode-num system="onscreen">S07E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015173000 +0000" stop="20261015183000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Reducir a cenizas</sub-title><desc lang="es">Cuando se denuncia la desaparición de dos niños, el principal sospechoso es un conocido delincuente sexual del barrio.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20061102</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">6.5.0/1</episode-num><episode-num system="onscreen">S07E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015183000 +0000" stop="20261015193000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Post Mortem</sub-title><desc lang="es">Mientras investiga el asesinato de una anciana, Grissom recibe una réplica en miniatura de la escena del crimen; Greg asiste a una vista para determinar su culpabilidad en la muerte accidental de un adolescente.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20061109</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">6.6.0/1</episode-num><episode-num system="onscreen">S07E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015193000 +0000" stop="20261015203000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Casualidad</sub-title><desc lang="es">Cuando dos gemelas idénticas aparecen muertas, las pruebas en ambos casos no demuestran inmediatamente una conexión entre las dos muertes.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20061116</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">6.7.0/1</episode-num><episode-num system="onscreen">S07E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261015203000 +0000" stop="20261015213000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Leyenda viva</sub-title><desc lang="es">Grissom y su equipo investigan una serie de asesinatos en Las Vegas que podrían estar relacionados con un infame jefe de la mafia de los años 70 que desapareció hace muchos años.</desc><credits><actor>Robert Hall</actor><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20061123</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">6.8.0/1</episode-num><episode-num system="onscreen">S07E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
