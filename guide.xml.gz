<programme start="20261119045100 +0000" stop="20261119052000 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Empress</sub-title><desc lang="es">A Jotaro le ha salido un bulto en el brazo que no para de crecer. Cuando un médico intenta extirparlo, en el tumor aparece una cara que asegura ser un Stand.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.11.0/1</episode-num><episode-num system="onscreen">S02E12</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
