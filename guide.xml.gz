<programme start="20261030224000 +0000" stop="20261030230700 +0000" channel="Naruto"><title lang="es">Naruto: La herencia, el collar de la muerte</title><sub-title lang="es">La herencia, el collar de la muerte</sub-title><desc lang="es">Naruto se enfurece al ver que Tsunade no respeta su posición de Hokage y la reta a un combate.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040714</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.90.0/1</episode-num><episode-num system="onscreen">S02E91</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261030230700 +0000" stop="20261030233400 +0000" channel="Naruto"><title lang="es">Naruto: “Una Oferta Sospechosa: La Elección De Tsunade”</title><sub-title lang="es">“Una Oferta Sospechosa: La Elección De Tsunade”</sub-title><desc lang="es">Naruto practica con todas sus fuerzas para obtener el collar de Tsunade. Mientras tanto, Tsunade no sabe qué responder a la oferta de Orochimaru.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040721</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.91.0/1</episode-num><episode-num system="onscreen">S02E92</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261030233400 +0000" stop="20261031000100 +0000" channel="Naruto"><title lang="es">Naruto: La Gran Crisis: Se Acabó El Trato.</title><sub-title lang="es">La Gran Crisis: Se Acabó El Trato.</sub-title><desc lang="es">Empujada por el deseo de ver a Nawaki y Dan, Tsunade está a punto de aceptar la tentadora oferta de Orochimaru.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040728</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.92.0/1</episode-num><episode-num system="onscreen">S02E93</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031000100 +0000" stop="20261031002800 +0000" channel="Naruto"><title lang="es">Naruto: Ataque, La Furia Del Rasengan</title><sub-title lang="es">Ataque, La Furia Del Rasengan</sub-title><desc lang="es">Orochimaru y Kabuto utilizan un Jutsu de Invocación para hacer aparecer una serpiente gigante. Aún aturdido por la poción e incapaz de usar su chakra por completo, Jiraiya invoca al pequeño Gamakichi.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040804</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.93.0/1</episode-num><episode-num system="onscreen">S02E94</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031002800 +0000" stop="20261031005500 +0000" channel="Naruto"><title lang="es">Naruto: El Quinto Hokage, Una Vida Al Limite</title><sub-title lang="es">El Quinto Hokage, Una Vida Al Limite</sub-title><desc lang="es">Naruto piensa que un verdadero ninja no debería romper nunca sus promesas. Herido de gravedad por Kabuto, Naruto se encuentra al borde de la muerte.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040811</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.94.0/1</episode-num><episode-num system="onscreen">S02E95</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031005500 +0000" stop="20261031012200 +0000" channel="Naruto"><title lang="es">Naruto: Punto Muerto, El Enfrentamiento Sannin</title><sub-title lang="es">Punto Muerto, El Enfrentamiento Sannin</sub-title><desc lang="es">Jiraiya, Tsunade y Orochimaru desatan su Jutsu de Invocación. ¡Comienza una frenética batalla!</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040811</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.95.0/1</episode-num><episode-num system="onscreen">S02E96</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031012200 +0000" stop="20261031014900 +0000" channel="Naruto"><title lang="es">Naruto: ¡Secuestro! ¡La Aventura De Naruto En El Balneario!</title><sub-title lang="es">¡Secuestro! ¡La Aventura De Naruto En El Balneario!</sub-title><desc lang="es">Tsunade, Naruto y los demás se dirigen a la Aldea Escondida entre las Hojas, donde Tsunade se convertirá oficialmente en el Quinto Hokage. A petición de Tsunade, el grupo se detiene en un pueblo con balneario.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040818</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.96.0/1</episode-num><episode-num system="onscreen">S02E97</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031014900 +0000" stop="20261031021600 +0000" channel="Naruto"><title lang="es">Naruto: La Advertencia De Tsunade:Ya No Seas Ninja</title><sub-title lang="es">La Advertencia De Tsunade:Ya No Seas Ninja</sub-title><desc lang="es">Naruto le pide a Tsunade que cure a Sasuke y Lee antes de tomar el papel de Hokage. Después de examinar a Lee, Tsunade le aconseja que encuentre otro camino que no sea el de un shinobi.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040825</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.97.0/1</episode-num><episode-num system="onscreen">S02E98</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031021600 +0000" stop="20261031024300 +0000" channel="Naruto"><title lang="es">Naruto: La Voluntad De Fuego Sigue Ardiendo</title><sub-title lang="es">La Voluntad De Fuego Sigue Ardiendo</sub-title><desc lang="es">Lee tiene dudas cuando Tsunade le pregunta si prefiere dejar de ser ninja o someterse a una arriesgada operación con solo un cincuenta por ciento de posibilidades de éxito.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040901</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.98.0/1</episode-num><episode-num system="onscreen">S02E99</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031024300 +0000" stop="20261031031000 +0000" channel="Naruto"><title lang="es">Naruto: Sensei Y Alumno: El Vínculo Del Shinobi</title><sub-title lang="es">Sensei Y Alumno: El Vínculo Del Shinobi</sub-title><desc lang="es">Después de que Tsunade le aconsejara dejar el camino del shinobi, Lee recuerda su primer encuentro con su maestro, Guy. Incapaz de dominar el ninjutsu y el genjutsu, Lee siempre ha sido despreciado por los otros.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040908</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.99.0/1</episode-num><episode-num system="onscreen">S02E100</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031031000 +0000" stop="20261031033700 +0000" channel="Naruto"><title lang="es">Naruto: Hay Que Verlo, Hay Que Conocerlo, ¿El Verdadero Rostro De Kakashi Sensei?</title><sub-title lang="es">Hay Que Verlo, Hay Que Conocerlo, ¿El Verdadero Rostro De Kakashi Sensei?</sub-title><desc lang="es">Naruto y sus dos compañeros siempre han querido ver el aspecto de Kakashi sin su máscara. Los tres hacen todo lo posible para ver su rostro completo.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040915</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.100.0/1</episode-num><episode-num system="onscreen">S02E101</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031033700 +0000" stop="20261031040400 +0000" channel="Naruto"><title lang="es">Naruto: Misión: Ayudar A Un Viejo Amigo En La Tierra Del Té</title><sub-title lang="es">Misión: Ayudar A Un Viejo Amigo En La Tierra Del Té</sub-title><desc lang="es">A Naruto, Sasuke y Sakura se les asigna una misión de rango B en la Tierra del Té. Allí deben proteger a los participantes de una carrera durante el ritual ceremonial del Santuario Todoroki, que se celebra cada cuatro años.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040922</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.101.0/1</episode-num><episode-num system="onscreen">S02E102</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031040400 +0000" stop="20261031043100 +0000" channel="Naruto"><title lang="es">Naruto: La Carrera Comenzó, Problema En Altamar</title><sub-title lang="es">La Carrera Comenzó, Problema En Altamar</sub-title><desc lang="es">Los sirvientes del jefe piensan que Idate ha hecho que su gran festival tradicional parezca una farsa. Jirocho cree que Idate ha huido y que está planeando algo.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20040929</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.102.0/1</episode-num><episode-num system="onscreen">S02E103</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031043100 +0000" stop="20261031045800 +0000" channel="Naruto"><title lang="es">Naruto: ¡Corre, Idate, corre! ¡La isla Nagi espera!</title><sub-title lang="es">¡Corre, Idate, corre! ¡La isla Nagi espera!</sub-title><desc lang="es">Naruto y su equipo consiguen alcanzar a Idate, pero lo encuentran herido e inconsciente cerca de Aoi.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041013</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.103.0/1</episode-num><episode-num system="onscreen">S02E104</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031045800 +0000" stop="20261031052500 +0000" channel="Naruto"><title lang="es">Naruto: La Gran Batalla Del Rayo Ondulado</title><sub-title lang="es">La Gran Batalla Del Rayo Ondulado</sub-title><desc lang="es">A pesar de que Aoi intenta impedirlo, Idate continúa corriendo. Idate sigue sin confiar en nadie y se revela que, durante los Exámenes Chunin, el hermano mayor de Idate era el examinador que propuso la décima pregunta.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041020</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.104.0/1</episode-num><episode-num system="onscreen">S02E105</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031052500 +0000" stop="20261031055200 +0000" channel="Naruto"><title lang="es">Naruto: El Ultimo Esfuerzo, Un Acto Final De Desesperación</title><sub-title lang="es">El Ultimo Esfuerzo, Un Acto Final De Desesperación</sub-title><desc lang="es">El jefe Jirocho espera, seguro de que Idate va a ganar. Pero Aoi, el ninja enviado por el Clan Wagarashi, se interpone en su camino.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041027</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">1.105.0/1</episode-num><episode-num system="onscreen">S02E106</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031055200 +0000" stop="20261031062200 +0000" channel="Naruto"><title lang="es">Naruto: La Batalla Comienza, Naruto Contra Sasuke</title><sub-title lang="es">La Batalla Comienza, Naruto Contra Sasuke</sub-title><desc lang="es">Shikamaru es ascendido a chunin y lo celebra junto con sus compañeros en un restaurante de barbacoa. En el hospital, Lee decide someterse a una operación peligrosa para reparar su cuerpo y seguir siendo un ninja.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041103</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.106.0/1</episode-num><episode-num system="onscreen">S03E107</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031062200 +0000" stop="20261031065200 +0000" channel="Naruto"><title lang="es">Naruto: Rivales Resentidos Y Vínculos Rotos</title><sub-title lang="es">Rivales Resentidos Y Vínculos Rotos</sub-title><desc lang="es">Naruto y Sasuke desatan sus armas más poderosas el uno sobre el otro y Kakashi llega justo a tiempo para detener la pelea.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041110</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.107.0/1</episode-num><episode-num system="onscreen">S03E108</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031065200 +0000" stop="20261031072200 +0000" channel="Naruto"><title lang="es">Naruto: Una Invitación Por Parte Del Sonido</title><sub-title lang="es">Una Invitación Por Parte Del Sonido</sub-title><desc lang="es">Los Cuatro Ninja del Sonido, Kidomaru, Sakon, Jirobo y Tayuya, aparecen de repente ante Sasuke. Sakura está preocupada acerca de la marca de maldición que Orochimaru puso en Sasuke…</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041117</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.108.0/1</episode-num><episode-num system="onscreen">S03E109</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031072200 +0000" stop="20261031075200 +0000" channel="Naruto"><title lang="es">Naruto: Formación: El Escuadrón De Rescate De Sasuke</title><sub-title lang="es">Formación: El Escuadrón De Rescate De Sasuke</sub-title><desc lang="es">Las súplicas de Sakura caen en oídos sordos y Sasuke deja la Aldea Escondida entre las Hojas. Cuando Tsunade se entera, llama a Shikamaru para asignarle su primera misión como chunin.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041124</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.109.0/1</episode-num><episode-num system="onscreen">S03E110</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031075200 +0000" stop="20261031082200 +0000" channel="Naruto"><title lang="es">Naruto: Sonido Contra Hoja</title><sub-title lang="es">Sonido Contra Hoja</sub-title><desc lang="es">Los Cuatro Ninja del Sonido se apresuran hacia la guarida de Orochimaru, llevando a Sasuke. Los jonin Genma y Raido los descubren y deciden desafiarlos.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041124</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.110.0/1</episode-num><episode-num system="onscreen">S03E111</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031082200 +0000" stop="20261031085200 +0000" channel="Naruto"><title lang="es">Naruto: Amotinamiento En El Escuadrón: Todo Fracasa</title><sub-title lang="es">Amotinamiento En El Escuadrón: Todo Fracasa</sub-title><desc lang="es">Naruto y sus compañeros son atrapados en la Prisión de Domo de Tierra de Jirobo. Aunque intentan abrirse camino a base de golpes, los muros se regeneran en cuanto son destruidos.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041201</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.111.0/1</episode-num><episode-num system="onscreen">S03E112</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031085200 +0000" stop="20261031092200 +0000" channel="Naruto"><title lang="es">Naruto: Poder A Fondo, Choji En Llamas</title><sub-title lang="es">Poder A Fondo, Choji En Llamas</sub-title><desc lang="es">Después de liberarse de la Prisión de Domo de Tierra, Shikamaru y el resto persiguen a los ninjas del sonido restantes mientras que Choji permanece allí.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041208</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.112.0/1</episode-num><episode-num system="onscreen">S03E113</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031092200 +0000" stop="20261031095200 +0000" channel="Naruto"><title lang="es">Naruto: Adiós Viejo Amigo, Siempre Creeré en Ti</title><sub-title lang="es">Adiós Viejo Amigo, Siempre Creeré en Ti</sub-title><desc lang="es">Después de tomar la píldora amarilla, parece que Choji va a ganar el combate hasta que Jirobo alcanza su segunda etapa, lo que le concede un inmenso poder.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041215</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.113.0/1</episode-num><episode-num system="onscreen">S03E114</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031095200 +0000" stop="20261031102200 +0000" channel="Naruto"><title lang="es">Naruto: Tu Oponente Soy Yo</title><sub-title lang="es">Tu Oponente Soy Yo</sub-title><desc lang="es">Asumiendo que el equipo de la hoja no podría superar a Jirobo, los demás ninjas del sonido no se molestan en dejar trampas por el camino.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20041222</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.114.0/1</episode-num><episode-num system="onscreen">S03E115</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031102200 +0000" stop="20261031105200 +0000" channel="Naruto"><title lang="es">Naruto: Visión De 360 Grados: El Punto Ciego Del Byakugan</title><sub-title lang="es">Visión De 360 Grados: El Punto Ciego Del Byakugan</sub-title><desc lang="es">Neji se enfrenta a Kidomaru mientras los demás continúan con su persecución de Sasuke y el resto de los ninjas del sonido.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20050105</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.115.0/1</episode-num><episode-num system="onscreen">S03E116</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031105200 +0000" stop="20261031112200 +0000" channel="Naruto"><title lang="es">Naruto: Perder No Es Una Opción</title><sub-title lang="es">Perder No Es Una Opción</sub-title><desc lang="es">Kidomaru cambia de táctica y crea un arco y flecha para atacar el punto ciego de Neji.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20050105</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.116.0/1</episode-num><episode-num system="onscreen">S03E117</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031112200 +0000" stop="20261031115200 +0000" channel="Naruto"><title lang="es">Naruto: El Contenedor Llega Muy Tarde</title><sub-title lang="es">El Contenedor Llega Muy Tarde</sub-title><desc lang="es">Naruto, Shikamaru, Kiba y Akamaru persiguen a Sasuke y los ninjas del sonido. Naruto y Kiba están molestos por no haber podido alcanzarlos y preparan un ataque sorpresa durante la noche.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20050112</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.117.0/1</episode-num><episode-num system="onscreen">S03E118</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031115200 +0000" stop="20261031122200 +0000" channel="Naruto"><title lang="es">Naruto: Un Mal Cálculo, Aparece Un Nuevo Enemigo</title><sub-title lang="es">Un Mal Cálculo, Aparece Un Nuevo Enemigo</sub-title><desc lang="es">Akamaru prepara explosivos en los árboles para atrapar a Sakon. Pero un enfurecido Sakon le da a la vuelta a la situación y los explosivos acaban lanzando a Kiba, Akamaru y Sakon por un precipicio.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20050119</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.118.0/1</episode-num><episode-num system="onscreen">S03E119</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031122200 +0000" stop="20261031125200 +0000" channel="Naruto"><title lang="es">Naruto: Gruñe Y Aúlla, Un Trabajo Final En Equipo</title><sub-title lang="es">Gruñe Y Aúlla, Un Trabajo Final En Equipo</sub-title><desc lang="es">Shikamaru está decidido a detener a Tayuya, pero esta utiliza su Jutsu de Invocación para hacer aparecer a tres gigantes. Mientras tanto, en las llanuras, el combate entre Kimimaro y Naruto está a punto de comenzar.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20050202</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.119.0/1</episode-num><episode-num system="onscreen">S03E120</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031125200 +0000" stop="20261031132200 +0000" channel="Naruto"><title lang="es">Naruto: Cada quien lucha su propia batalla</title><sub-title lang="es">Cada quien lucha su propia batalla</sub-title><desc lang="es">Ukon, que es capaz de infiltrarse en los cuerpos ajenos, se introduce en el cuerpo de Kiba e intenta unirse con sus células.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20050209</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.120.0/1</episode-num><episode-num system="onscreen">S03E121</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031132200 +0000" stop="20261031135200 +0000" channel="Naruto"><title lang="es">Naruto: El Engaño: Shikamaru De Vuelta</title><sub-title lang="es">El Engaño: Shikamaru De Vuelta</sub-title><desc lang="es">Akamaru y Kiba, herido, apenas consiguen escapar de Sakon y Ukon. Naruto combate frenéticamente con Kimimaro…</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20050216</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.121.0/1</episode-num><episode-num system="onscreen">S03E122</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031135200 +0000" stop="20261031142200 +0000" channel="Naruto"><title lang="es">Naruto: El guapísimo de la aldea de la hoja</title><sub-title lang="es">El guapísimo de la aldea de la hoja</sub-title><desc lang="es">Shikamaru consigue atrapar a Tayuya con su Jutsu de Posesión de Sombra, pero Tayuya alcanza su segunda etapa y pelea con una fuerza descomunal.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20050223</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.122.0/1</episode-num><episode-num system="onscreen">S03E123</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261031142200 +0000" stop="20261031145200 +0000" channel="Naruto"><title lang="es">Naruto: La bestia interna</title><sub-title lang="es">La bestia interna</sub-title><desc lang="es">Rock Lee está listo para enfrentarse a Kimimaro, por lo que Naruto puede ir a encontrarse con Sasuke, que se ha despertado.</desc><credits><actor>Isabel Martion (Naruto Uzumaki)</actor><actor>Christine Byrd (Sakura Haruno)</actor><actor>Victor Ugarte (Sasuke Uchiha)</actor><actor>Alfonso Obreg (Kakashi Hatake)</actor></credits><date>20050302</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">2.123.0/1</episode-num><episode-num system="onscreen">S03E124</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5e73b850e40c9f001a0a9fb4/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
