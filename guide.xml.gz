<programme start="20261103022400 +0000" stop="20261103031600 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Guerra de plata</sub-title><desc lang="es">Gibbs y el equipo son convocados cuando se encuentra a un hombre recientemente fallecido encerrado en una tumba de la época de la Guerra Civil. El cadáver es de un sargento desaparecido que, según Ducky, fue enterrado vivo.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.4.0/1</episode-num><episode-num system="onscreen">S03E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103031600 +0000" stop="20261103040800 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">El sitio web del mirón</sub-title><desc lang="es">Gibbs y el equipo investigan el asesinato de la esposa de un infante de marina que se habría transmitido por Internet.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.5.0/1</episode-num><episode-num system="onscreen">S03E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103040800 +0000" stop="20261103045900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Código de honor</sub-title><desc lang="es">Gibbs y el equipo investigan cuando un niño de seis años informa al NCIS que su padre fue secuestrado.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.6.0/1</episode-num><episode-num system="onscreen">S03E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103045900 +0000" stop="20261103055000 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Encubiertos</sub-title><desc lang="es">Cuando los cadáveres de dos asesinos son entregados al NCIS desde el extranjero, Tony y Ziva asumen identidades encubiertas y asisten a una cita sexy en un hotel de lujo para encontrar a su objetivo.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.7.0/1</episode-num><episode-num system="onscreen">S03E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103055000 +0000" stop="20261103064200 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Falsa culpa</sub-title><desc lang="es">Cuando se encuentra una parte del cuerpo de una mujer en Quantico, el equipo del NCIS investiga y se sorprende al descubrir que todas las pruebas forenses apuntan a Tony como el principal sospechoso.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.8.0/1</episode-num><episode-num system="onscreen">S03E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103064200 +0000" stop="20261103073400 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Novato</sub-title><desc lang="es">Cuando McGee mata a un hombre durante una misión, el equipo del NCIS interviene para respaldarlo al descubrir que se trataba de un oficial de policía encubierto.</desc><credits><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>David Mccallum</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor><actor>Cote De Pablo</actor><actor>Lauren Holly</actor><actor>Brian Dietzen</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.9.0/1</episode-num><episode-num system="onscreen">S03E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103073400 +0000" stop="20261103082600 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Comportamiento ejemplar</sub-title><desc lang="es">Gibbs y el equipo investigan el asesinato de una supermodelo que filmaba un programa de televisión en una base de la Marina.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.10.0/1</episode-num><episode-num system="onscreen">S03E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103082600 +0000" stop="20261103091700 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Engaño</sub-title><desc lang="es">Gibbs y el equipo son convocados un fin de semana cuando aparentemente secuestran a un teniente comandante de la Marina que está a cargo de un envío de armas nucleares.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.11.0/1</episode-num><episode-num system="onscreen">S03E12</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103091700 +0000" stop="20261103100900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Encerrados</sub-title><desc lang="es">Gibbs y el equipo se apresuran a encontrar a Tony y Ziva, quienes quedan atrapados en el contenedor de un astillero después de buscar refugio durante un tiroteo.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.12.0/1</episode-num><episode-num system="onscreen">S03E13</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103100900 +0000" stop="20261103110100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Sueño ligero</sub-title><desc lang="es">Gibbs y el equipo investigan la muerte de las esposas de dos marinos. Temen que los asesinatos tengan motivos raciales, ya que las dos mujeres son asiáticas.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.13.0/1</episode-num><episode-num system="onscreen">S03E14</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103110100 +0000" stop="20261103115300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Decapitado</sub-title><desc lang="es">El equipo del NCIS se sorprende cuando descubren la cabeza cortada de un marino en un taller de desguace automotriz ilegal dirigido por infantes de marina.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.14.0/1</episode-num><episode-num system="onscreen">S03E15</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103115300 +0000" stop="20261103124500 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Secreto familiar</sub-title><desc lang="es">El equipo investiga la misteriosa explosión de una ambulancia que supuestamente transportaba los restos de un marine muerto en un accidente de auto.</desc><credits><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>David Mccallum</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor><actor>Cote De Pablo</actor><actor>Lauren Holly</actor><actor>Brian Dietzen</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.15.0/1</episode-num><episode-num system="onscreen">S03E16</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103124500 +0000" stop="20261103133700 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Voraz</sub-title><desc lang="es">Gibbs y el equipo son convocados para investigar cuando un grupo de adolescentes descubre placas de identificación marinas en un bosque nacional durante una caminata.</desc><credits><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>David Mccallum</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor><actor>Cote De Pablo</actor><actor>Lauren Holly</actor><actor>Brian Dietzen</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.16.0/1</episode-num><episode-num system="onscreen">S03E17</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103133700 +0000" stop="20261103142900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Carnada</sub-title><desc lang="es">Gibbs y el equipo son llamados cuando un estudiante adolescente en una preparatoria de la base de Quantico coloca una bomba en su cuerpo y toma como rehenes a sus compañeros.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.17.0/1</episode-num><episode-num system="onscreen">S03E18</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103142900 +0000" stop="20261103152100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Congelados</sub-title><desc lang="es">Gibbs y el equipo son llamados cuando un par de niños se topan con el cadáver de un marine desaparecido en un lago congelado. Mientras el equipo busca pistas en el lecho del lago, se encuentran con otros tres cadáveres acribillados a balazos.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.18.0/1</episode-num><episode-num system="onscreen">S03E19</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103152100 +0000" stop="20261103161300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Intocable</sub-title><desc lang="es">Gibbs y el equipo son llamados cuando aparentemente se suicida un criptógrafo del Pentágono sospechado de espiar. Con su principal sospechoso muerto, el equipo del NCIS debe descubrir si ella era o no el topo del Pentágono.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.19.0/1</episode-num><episode-num system="onscreen">S03E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103161300 +0000" stop="20261103170500 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Matanza</sub-title><desc lang="es">Tras descubrir que se montó una espeluznante escena de asesinato, el equipo descubre que Abby era el objetivo previsto cuando una evidencia clave contamina su laboratorio y casi la mata.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.20.0/1</episode-num><episode-num system="onscreen">S03E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103170500 +0000" stop="20261103175700 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Peligro</sub-title><desc lang="es">Ziva entra en shock cuando muere un sospechoso tras aplicarle una táctica común para someterlo. Ducky y Abby trabajan para limpiar el nombre de Ziva. Gibbs se entera de que el director Shepard fue secuestrado por el hermano del muerto.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.21.0/1</episode-num><episode-num system="onscreen">S03E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103175700 +0000" stop="20261103184900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Hiato, parte uno</sub-title><desc lang="es">Los miembros del NCIS se angustian porque Gibbs resulta herido en una explosión terrorista mientras estaba en una misión.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.22.0/1</episode-num><episode-num system="onscreen">S03E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103184900 +0000" stop="20261103194100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Hiato, parte dos</sub-title><desc lang="es">Mientras el equipo intenta rastrear a los terroristas detrás del atentado que hirió a Gibbs, se enteran de que están planeando otro ataque similar al de las Torres Gemelas y que Gibbs tiene información sobre su plan.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20060101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.23.0/1</episode-num><episode-num system="onscreen">S03E24</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
