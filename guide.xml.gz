<programme start="20261102114900 +0000" stop="20261102124000 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Agua negra</sub-title><desc lang="es">El equipo de NCIS investiga cuando el cadáver de un oficial naval desaparecido durante dos años aparece en el fondo de un lago.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">1.10.0/1</episode-num><episode-num system="onscreen">S02E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
