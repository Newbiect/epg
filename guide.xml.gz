<programme start="20261112011300 +0000" stop="20261112013800 +0000" channel="Yu-Gi-Oh"><title lang="es">Yu-Gi-Oh!</title><sub-title lang="es">Héroes legendarios, Segunda Parte</sub-title><desc lang="es">La cruzada para salvar a Kaiba continua con un poco de ayuda de…¿Mai? ¿Podrán Yugi y sus amigos adaptarse a un mundo virtual en cual las reglas siguen cambiando?</desc><credits><actor>Amy Brinbaum</actor><actor>Darren Dunstan</actor><actor>Wayne Grayson</actor><actor>Dan Green</actor><actor>Eric Stuart</actor></credits><date>20021019</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.43.0/1</episode-num><episode-num system="onscreen">S01E44</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f19972aefe562001369966c/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
