<programme start="20261121123100 +0000" stop="20261121130300 +0000" channel="Pluto TV Naturaleza"><title lang="es">Horas de desesperación</title><sub-title lang="es">EPIDEMIAS</sub-title><desc lang="es">Incidentes : ¿qué hay detrás de un nombre? Cuando el nombre es ébola, sars, viruela, cólera, influenza aviar, “gripe aviar”.</desc><date>00010101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/5e0e730dec5579c50887b338/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261121130300 +0000" stop="20261121133500 +0000" channel="Pluto TV Naturaleza"><title lang="es">Horas de desesperación</title><sub-title lang="es">INCENDIOS</sub-title><desc lang="es">Incidentes : el incendio en un club nocturno de Rhode Island, Nueva York. El incendio de la tienda departamental L’Innovation, en Bruselas, 1967. En casi todos los ejemplos, el fuego comenzó o se avivó por negligencia o mala intención.</desc><date>00010101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/5e0e730dec5579c50887b338/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261121133500 +0000" stop="20261121140700 +0000" channel="Pluto TV Naturaleza"><title lang="es">Horas de desesperación</title><sub-title lang="es">VIENTO</sub-title><desc lang="es">Incidentes : el Huracán Katrina, en el Golfo de México; Donna, en Bangladesh; Sandy, en el litoral noreste de Estados Unidos. Todos terribles, cada uno a su manera, aún cuando tenían nombres que no sonaban nada amenazadores.</desc><date>00010101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/5e0e730dec5579c50887b338/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261121140700 +0000" stop="20261121143800 +0000" channel="Pluto TV Naturaleza"><title lang="es">Horas de desesperación</title><sub-title lang="es">INUNDACIONES</sub-title><desc lang="es">Incidentes : las crecidas repentinas en Brasil, la inundación que dejó el Huracán Katrina y el desbordamiento tras el sunami de 2015 en el Océano Índico, estos son todos, en cierta medida, fenómenos naturales.</desc><date>00010101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.5.0/1</episode-num><episode-num system="onscreen">S01E06</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/5e0e730dec5579c50887b338/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261121143800 +0000" stop="20261121151000 +0000" channel="Pluto TV Naturaleza"><title lang="es">Horas de desesperación</title><sub-title lang="es">DESASTRES GEOLÓGICOS</sub-title><desc lang="es">Incidentes: avalanchas en Afganistán, Paquistán y Nepal. Desprendimientos en Colombia y Nepal. Olas de calor en Estados Unidos, Europa e India. La cuestión extraña de los sumideros, incluyendo uno en Bosnia.</desc><date>00010101</date><category lang="es">Documentary</category><category lang="es">Documentary</category><episode-num system="xmltv_ns">0.6.0/1</episode-num><episode-num system="onscreen">S01E07</episode-num><rating><value>TV-PG</value></rating><icon src="https://images.pluto.tv/series/5e0e730dec5579c50887b338/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
