<programme start="20261121131700 +0000" stop="20261121134600 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Superar a Tsubasa, Hyuga vs Misugi</sub-title><desc lang="es">Hyuga anota tres goles en la final de las eliminatorias de Tokio. Misugi debe entrar a la cancha antes de lo previsto para emparejar la situación.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.31.0/1</episode-num><episode-num system="onscreen">S01E32</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261121134600 +0000" stop="20261121141500 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Final de las eliminatorias de Tokio</sub-title><desc lang="es">En la final de las eliminatorias de Tokio, Hyuga se compadece de Toho y no ataca como siempre, lo que le traerá problemas al final del encuentro.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.32.0/1</episode-num><episode-num system="onscreen">S01E33</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261121141500 +0000" stop="20261121144400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Una feroz batalla comienza</sub-title><desc lang="es">Tsubasa recibe un mensaje de su viejo amigo Genzo. Decide concentrarse en ir a Brasil como sea. Hyuga viaja a Okinawa a visitar a su exentrenador.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.33.0/1</episode-num><episode-num system="onscreen">S01E34</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261121144400 +0000" stop="20261121151300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El poder de la navaja</sub-title><desc lang="es">Hyuga recupera el ímpetu, pero hay un nuevo obstáculo. Empieza el Torneo Nacional. Nankatsu enfrenta a Azumaichi y su temible defensa central.</desc><date>00010101</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.34.0/1</episode-num><episode-num system="onscreen">S01E35</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
