<programme start="20261102002700 +0000" stop="20261102005200 +0000" channel="Yu-Gi-Oh"><title lang="es">Yu-Gi-Oh!</title><sub-title lang="es">Por el Camino Equivocado, primera parte</sub-title><desc lang="es">Una expedición a campo traviesa se vuelve trágica cuando los nuevos duelistas de Dartz separan a Yugi de Joey para capturar sus almas por separado.</desc><credits><actor>Tea Gardner</actor><actor>Joey Wheeler</actor><actor>Yugi Muto</actor></credits><date>20040102</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.15.0/1</episode-num><episode-num system="onscreen">S04E16</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/5f19972aefe562001369966c/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
