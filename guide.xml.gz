<programme start="20261116163000 +0000" stop="20261116173000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Cambio de parejas</sub-title><desc lang="es">Grissom y Sara investigan el asesinato de una mujer tras una fiesta de intercambio en la que los matrimonios del barrio se reúnen y cambian de pareja.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20041028</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">4.4.0/1</episode-num><episode-num system="onscreen">S05E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261116173000 +0000" stop="20261116183000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">¿Qué come Gilbert Grissom?</sub-title><desc lang="es">Cuando un grupo de miembros de una fraternidad encuentra un lugar cubierto de gusanos, Grissom investiga la escena y cree que un estudiante está proporcionando la carne a los gusanos.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20041104</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">4.5.0/1</episode-num><episode-num system="onscreen">S05E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261116183000 +0000" stop="20261116193000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Formalidades</sub-title><desc lang="es">Grissom es llamado por el asesinato de una joven de 17 años en el ático de un casino. Todo el equipo se ve involucrado cuando se descubre que se ha producido un secuestro junto con el asesinato.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20041111</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">4.6.0/1</episode-num><episode-num system="onscreen">S05E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
