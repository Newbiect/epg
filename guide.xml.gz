<programme start="20261114043700 +0000" stop="20261114050600 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Pistas hacia Kara</sub-title><desc lang="es">Para saber más sobre la relación entre Boro y Kara, Konohamaru y Sai reciben el encargo de infiltrarse en el culto de Boro.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210808</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.209.0/1</episode-num><episode-num system="onscreen">S14E210</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
