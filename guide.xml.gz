<programme start="20261013103000 +0000" stop="20261013113000 +0000" channel="CSI en Español"><title lang="es">CSI en español</title><sub-title lang="es">Líneas de sangre</sub-title><desc lang="es">Una empleada de un casino es golpeada y violada cuando vuelve a casa del trabajo, pero sobrevive e identifica a su agresor.</desc><credits><actor>William Petersen</actor><actor>Marg Helgenberger</actor><actor>Gary Dourdan</actor><actor>George Eads</actor><actor>Robert Hall</actor><actor>Eric Szmanda</actor><actor>Paul Guilfoyle</actor><actor>Wallace Langham</actor><actor>Jorja Fox</actor></credits><date>20040520</date><category lang="es">Drama</category><category lang="es">Crime Drama</category><episode-num system="xmltv_ns">3.22.0/1</episode-num><episode-num system="onscreen">S04E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/625db3e23f03ed0013c61cb9/tile_1782231481254.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
