<programme start="20261022043000 +0000" stop="20261022050000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El secreto tras la sala subterránea</sub-title><desc lang="es">Konohamaru y Mugino consiguen información de que el Señor Feudal de la Tierra de los Valles va a visitar la compañía, dándoles la oportunidad de revisar el interior de sus instalaciones secretas.</desc><credits><actor>Victor Ugarte</actor><actor>Tommy Rojas</actor><actor>Monserrat Aguilar</actor><actor>Karen Valleo</actor><actor>Isabel Martiñón</actor><actor>Emilio Treviño</actor><actor>Azul Valadez</actor><actor>Alan Velázquez</actor></credits><date>20201108</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.172.0/1</episode-num><episode-num system="onscreen">S01E173</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65240b9f4827fc001a05ae1d/tile_1769464802152.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261022050000 +0000" stop="20261022053000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El renacimiento del Árbol Divino</sub-title><desc lang="es">Boruto y Sarada corren hacía el laboratorio de investigación de Víctor donde se encuentran con la horrible planta que roba el chakra de las personas cercanas.</desc><credits><actor>Victor Ugarte</actor><actor>Tommy Rojas</actor><actor>Monserrat Aguilar</actor><actor>Karen Valleo</actor><actor>Isabel Martiñón</actor><actor>Emilio Treviño</actor><actor>Azul Valadez</actor><actor>Alan Velázquez</actor></credits><date>20201115</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.173.0/1</episode-num><episode-num system="onscreen">S01E174</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65240b9f4827fc001a05ae1d/tile_1769464802152.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261022053000 +0000" stop="20261022060000 +0000" channel="Boruto: Naruto Next Generations"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">¡Más allá de los límites!</sub-title><desc lang="es">Separado de Boruto y Sarada, Konohamaru pelea contra Víctor. Pero alguien inesperado llega para pelear a su lado.</desc><credits><actor>Victor Ugarte</actor><actor>Tommy Rojas</actor><actor>Monserrat Aguilar</actor><actor>Karen Valleo</actor><actor>Isabel Martiñón</actor><actor>Emilio Treviño</actor><actor>Azul Valadez</actor><actor>Alan Velázquez</actor></credits><date>20201122</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.174.0/1</episode-num><episode-num system="onscreen">S01E175</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65240b9f4827fc001a05ae1d/tile_1769464802152.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
