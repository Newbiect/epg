<programme start="20261015215700 +0000" stop="20261015222500 +0000" channel="Nosotros Los Guapos"><title lang="es">Nosotros los guapos</title><sub-title lang="es">Echando los perros</sub-title><desc lang="es">Albertano descubre que tiene un talento especial para calmar a los perros y convence a Vítor para que ambos entren a trabajar a una veterinaria.</desc><credits><director>Guillermo del Bosque</director><actor>Malillany Marín</actor><actor>Adrián Uribe</actor><actor>Ariel Miramontes</actor><actor>Carmen Salinas</actor><actor>Juan Castellanos</actor></credits><date>20170828</date><episode-num system="xmltv_ns">2.1.0/1</episode-num><episode-num system="onscreen">S03E02</episode-num><rating><value>US_UPR_TV-14</value></rating><icon src="http://p-img.movetv.com/cms/images/1efaa2b63b229a9c9d827ed88fe9e6f6fef4a980.JPEG"/></programme>
