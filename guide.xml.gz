<programme start="20261109214900 +0000" stop="20261109221900 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Devil</sub-title><desc lang="es">Jotaro y su equipo llegan al hotel en Singapur. Sin embargo, al llegar a su habitación, Polnareff cae en la trampa que le ha tendido un Stand.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140523</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.7.0/1</episode-num><episode-num system="onscreen">S02E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261109221900 +0000" stop="20261109224800 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Yellow Temperance</sub-title><desc lang="es">Mientras dan una vuelta por Singapur, Jotaro empieza a sospechar que Kakyoin está poseído al ver que se comporta de manera extraña y le propina una paliza a un ladrón.</desc><credits><actor>Daisuke Ono</actor><actor>Unsho Ishizuka</actor><actor>Kenta Miyake</actor><actor>Daisuke Hirakawa</actor><actor>Fuminori Komatsu</actor><actor>Takehito Koyasu</actor></credits><date>20140530</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">1.8.0/1</episode-num><episode-num system="onscreen">S02E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
