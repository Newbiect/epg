<programme start="20261024215800 +0000" stop="20261024222700 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden - Epílogos finales</title><sub-title lang="es">LA HISTORIA SECRETA DE LA HOJA: PARTE 2: UN REGALO DE BODAS TODO PODEROSO</sub-title><desc lang="es">El día de la boda de Naruto y Hinata ha sido decidido.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20170216</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">21.494.0/1</episode-num><episode-num system="onscreen">S22E495</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6a10ced21718969e367d78c7/tile_1779486419497.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024222700 +0000" stop="20261024225600 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden - Epílogos finales</title><sub-title lang="es">LA HISTORIA SECRETA DE LA HOJA: UN DÍA PERFECTO PARA CASARSE, PARTE 3: VAPOR Y PÍLDORAS DE ALIMENTO</sub-title><desc lang="es">La misión encontrar un regalo para Naruto y Hinata parece ser muy difícil para Shikamaru.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20170223</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">21.495.0/1</episode-num><episode-num system="onscreen">S22E496</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6a10ced21718969e367d78c7/tile_1779486419497.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024225600 +0000" stop="20261024232500 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden - Epílogos finales</title><sub-title lang="es">LA HISTORIA SECRETA DE LA HOJA: PARTE 4: EL REGALO DE BODAS DEL KAZEKAGE</sub-title><desc lang="es">El Tsuchikage y el Raikage, mencionan que ya tienen preparado un regalo para la boda de Naruto.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20170302</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">21.496.0/1</episode-num><episode-num system="onscreen">S22E497</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6a10ced21718969e367d78c7/tile_1779486419497.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024232500 +0000" stop="20261024235400 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden - Epílogos finales</title><sub-title lang="es">LA HISTORIA SECRETA DE LA HOJA: UN DÍA PERFECTO PARA CASARSE, PARTE 5: LA ÚLTIMA MISIÓN</sub-title><desc lang="es">Shino y Kiba aun no tienen un regalo de bodas para Hinata.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20170309</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">21.497.0/1</episode-num><episode-num system="onscreen">S22E498</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6a10ced21718969e367d78c7/tile_1779486419497.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261024235400 +0000" stop="20261025002300 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden - Epílogos finales</title><sub-title lang="es">LA HISTORIA SECRETA DE LA HOJA: PARTE 6: EL RESULTADO DE LA MISIÓN SECRETA</sub-title><desc lang="es">Los amigos de Naruto ya tienen sus regalos listos y estos serán juzgados.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20170316</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">21.498.0/1</episode-num><episode-num system="onscreen">S22E499</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6a10ced21718969e367d78c7/tile_1779486419497.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025002300 +0000" stop="20261025005100 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden - Epílogos finales</title><sub-title lang="es">LA HISTORIA SECRETA DE LA HOJA: UN DÍA PERFECTO PARA CASARSE, PARTE 7: EL MENSAJE</sub-title><desc lang="es">Las palabras de Iruka y su presencia apoyaron a Naruto hasta este día, eso mostrará en su mensaje.</desc><credits><actor>Isabel Martiñón</actor><actor>Víctor Ugarte</actor><actor>Montserrat Aguilar</actor><actor>Alfonso Obregón</actor><actor>Javier Olguín</actor><actor>Alondra Hidalgo</actor></credits><date>20170323</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">21.499.0/1</episode-num><episode-num system="onscreen">S22E500</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6a10ced21718969e367d78c7/tile_1779486419497.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025005100 +0000" stop="20261025030300 +0000" channel="Naruto Shippuden"><title lang="es">The Last: Naruto the Movie</title><sub-title lang="es">The Last: Naruto the Movie</sub-title><desc lang="es">¡La luna se acerca peligrosamente! Naruto, Sakura, Shikamaru, Sai y Hinata, se disponen a investigar y se encuentran con un plan determinado y su increíble mente maestra al acecho.</desc><credits><actor>Isabel Martiñón</actor><actor>Humberto Solórzano</actor><actor>Montserrat Aguilar</actor><actor>Javier Olguín</actor><actor>Víctor Ugarte</actor><actor>Alondra Hidalgo</actor><actor>Alfonso Obregón</actor><actor>Junko Takeuchi</actor><actor>Nana Mizuki</actor><actor>Jun Fukuyama</actor></credits><date>20141206</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6515bdc391ee7c001a20874a/tile_1782276130348.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025030300 +0000" stop="20261025033200 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: De Vuelta A Casa</title><sub-title lang="es">De Vuelta A Casa</sub-title><desc lang="es">En la Aldea Oculta en las Hojas, el equipo de Konohamaru es promovido y puede ir a misiones de rango D. De repente, una figura atraviesa las puertas. Es un Naruto mayor, que regresó de un viaje con Jiraiya. ¡Naruto Uzumaki está de vuelta!</desc><credits><actor>Isabel Martion</actor></credits><date>20070215</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.220.0/1</episode-num><episode-num system="onscreen">S01E221</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025033200 +0000" stop="20261025040100 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Primer Movimiento De Los Akatsuki</title><sub-title lang="es">El Primer Movimiento De Los Akatsuki</sub-title><desc lang="es">Jiraiya ha terminado su novela para deleite de Kakashi. Sin embargo, da noticias secretas de que Akatsuki está en movimiento. En el pueblo de arena, Gaara ahora es el Kazekage y los miembros de Akatsuki se infiltran en el pueblo.</desc><credits><actor>Isabel Martion</actor></credits><date>20070215</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.221.0/1</episode-num><episode-num system="onscreen">S01E222</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025040100 +0000" stop="20261025043000 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Resultado Del Entrenamiento</title><sub-title lang="es">El Resultado Del Entrenamiento</sub-title><desc lang="es">Naruto y Sakura obligan a Kakashi a usar su Sharingan. Naruto libera su jutsus mientras Sakura usa técnicas aprendidas de Tsunade. En las afueras de la Villa de la Arena, Deidara de Akatsuki comienza una operación secreta para encontrar a Gaara.</desc><credits><actor>Isabel Martion</actor></credits><date>20070222</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.222.0/1</episode-num><episode-num system="onscreen">S01E223</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025043000 +0000" stop="20261025045900 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Jinchuriki De La Arena</title><sub-title lang="es">El Jinchuriki De La Arena</sub-title><desc lang="es">Gaara detecta rápidamente a Deidara en su pájaro y comienza una batalla aérea. Yura es un agente encubierto de Akatsuki y Sand Village está dañado. Naruto y Sakura continúan con su desafío y confirman el poder de Kakashi.</desc><credits><actor>Isabel Martion</actor></credits><date>20070301</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.223.0/1</episode-num><episode-num system="onscreen">S01E224</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025045900 +0000" stop="20261025052800 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Kazekage Se Mantiene En Pie</title><sub-title lang="es">El Kazekage Se Mantiene En Pie</sub-title><desc lang="es">Naruto y Sakura vencieron a Kakashi. Tsunade los asigna a un escuadrón de tres hombres dirigido por Kakashi. En Aldea, Gaara y Deidara continúan su batalla. A Baki le preocupa que el Shukaku se materialice y Kankuro se ría de él.</desc><credits><actor>Isabel Martion</actor></credits><date>20070315</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.224.0/1</episode-num><episode-num system="onscreen">S01E225</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025052800 +0000" stop="20261025055700 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Misión Cumplida</title><sub-title lang="es">Misión Cumplida</sub-title><desc lang="es">Gaara usa su chakra y crea un escudo de arena para proteger la aldea. Gaara queda débil al ser atacado y no le queda nada para contrarrestar las múltiples trampas de Deidara. Gaara cae en las manos de Deidara pese a la ayuda de sus amigos.</desc><credits><actor>Isabel Martion</actor></credits><date>20070329</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.225.0/1</episode-num><episode-num system="onscreen">S01E226</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025055700 +0000" stop="20261025062600 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Corre, Kankuro</title><sub-title lang="es">Corre, Kankuro</sub-title><desc lang="es">Gaara es capturado por Deidara. Kankuro y un pelotón se disponen a salvar a Gaara. Los ninja caen en las trampas de los Akatsuki. Kankuro solo, los alcanza. En Leaf Village, el nuevo escuadrón de Naruto le da la bienvenida el día de su primera misión.</desc><credits><actor>Isabel Martion</actor></credits><date>20070329</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.226.0/1</episode-num><episode-num system="onscreen">S01E227</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025062600 +0000" stop="20261025065500 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Entra En Acción El Equipo Kakashi</title><sub-title lang="es">Entra En Acción El Equipo Kakashi</sub-title><desc lang="es">Un mensaje advierte del secuestro del Kazekage por parte de los Akatsuki. Tsunade envía al equipo Kakashi a la aldea. Kankuro comienza su batalla contra los Akatsuki pero es neutralizado.</desc><credits><actor>Isabel Martion</actor></credits><date>20070412</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.227.0/1</episode-num><episode-num system="onscreen">S01E228</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025065500 +0000" stop="20261025072400 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Las Lágrimas Del Jinchuriki</title><sub-title lang="es">Las Lágrimas Del Jinchuriki</sub-title><desc lang="es">Temari se encuentra con Kakashi y el equipo. Como alguien que alberga una bestia de cola, Naruto entiende el sufrimiento de Gaara. Kankuro es rescatado, pero muere cuando se infecta con veneno. Si no se encuentra el antídoto, solo le quedan días de vida.</desc><credits><actor>Isabel Martion</actor></credits><date>20070412</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.228.0/1</episode-num><episode-num system="onscreen">S01E229</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025072400 +0000" stop="20261025075300 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Jutsu De Sello: Los Nueve Dragones Fantasma</title><sub-title lang="es">Jutsu De Sello: Los Nueve Dragones Fantasma</sub-title><desc lang="es">Arena ninja lucha contra el tiempo para curar a Kankuro. La esperanza está en Naruto, Sakura y Kakashi, pero una tormenta los retrasa. Mientras tanto, los Akatsuki comienzan con el Seal Jutsu en Gaara: Los Nueve Dragones Fantasma.</desc><credits><actor>Isabel Martion</actor></credits><date>20070419</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.229.0/1</episode-num><episode-num system="onscreen">S01E230</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025075300 +0000" stop="20261025082200 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: La Discípula De Un Ninja Médico</title><sub-title lang="es">La Discípula De Un Ninja Médico</sub-title><desc lang="es">Sakura trata a Kankuro y se dan cuenta de que ahora es una Medic Ninja de pleno derecho. Con su vida fuera de peligro, Kankuro proporciona información sobre Akatsuki. Kakashi inmediatamente a un sabueso ninja en su búsqueda.</desc><credits><actor>Isabel Martion</actor></credits><date>20070426</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.230.0/1</episode-num><episode-num system="onscreen">S01E231</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025082200 +0000" stop="20261025085100 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: La Determinación De La Abuela Retirada</title><sub-title lang="es">La Determinación De La Abuela Retirada</sub-title><desc lang="es">Pakkun encuentra el escondite de los Akatsuki. Kakashi y Temari se preparan para rescatar a Gaara. Pakkun se encuentra con el equipo de Guy, siguen a Pakkun al escondite de Akatsuki, pero el enemigo los nota.</desc><credits><actor>Isabel Martion</actor></credits><date>20070503</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.231.0/1</episode-num><episode-num system="onscreen">S01E232</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025085100 +0000" stop="20261025092000 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Un Encuentro Con El Destino</title><sub-title lang="es">Un Encuentro Con El Destino</sub-title><desc lang="es">Kakashi advierte a todos a no mirar a los Ojos Sharingan de Itachi. Kakashi lo combate y le pide a Naruto que le cubra. Guy y su equipo pelean con Kisame quien libera un poderoso chakra y su jutsu atrapa a Neji, Lee y Tenten en una prisión de agua.</desc><credits><actor>Isabel Martion</actor></credits><date>20070510</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.232.0/1</episode-num><episode-num system="onscreen">S01E233</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025092000 +0000" stop="20261025094900 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Crecimiento De Naruto</title><sub-title lang="es">El Crecimiento De Naruto</sub-title><desc lang="es">Guy lamenta que sus estudiantes quedaran atrapados y determinado en detener a Kisame. lo enfrenta usando su nunchaku. Tenten se debilita rápidamente y Guy se prepara para usar un jutsu secreto prohibido. Naruto cae en el genjutsu de Itachi.</desc><credits><actor>Isabel Martion</actor></credits><date>20070517</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.233.0/1</episode-num><episode-num system="onscreen">S01E234</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025094900 +0000" stop="20261025101800 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Arma Secreta Tiene Nombre</title><sub-title lang="es">El Arma Secreta Tiene Nombre</sub-title><desc lang="es">Abuela Chiyo y Sakura rescatan a Naruto y Kakashi comienza a contraatacar. Guy logra derrotar a Kisame con un jutsu llamado Asakujak. La fuerza del ninja de la aldea debe haber destrozado a sus enemigos, pero ...</desc><credits><actor>Isabel Martion</actor></credits><date>20070524</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.234.0/1</episode-num><episode-num system="onscreen">S01E235</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025101800 +0000" stop="20261025121100 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: The Movie</title><sub-title lang="es">Naruto Shippuden: The Movie</sub-title><desc lang="es">Hace mucho tiempo, un espíritu poderoso llevó al mundo al borde de la destrucción. La última misión de Naruto es proteger a Shion, una sacerdotisa de la Tierra de los Ogros, a quien persigue un espíritu.</desc><credits><actor>Isabel Martiñón</actor><actor>Humberto Solórzano</actor><actor>Montserrat Aguilar</actor><actor>Javier Olguín</actor><actor>Víctor Ugarte</actor><actor>Alondra Hidalgo</actor><actor>Alfonso Obregón</actor><actor>Junko Takeuchi</actor><actor>Chie Nakamura</actor><actor>Yôichi Masukawa</actor></credits><date>20070804</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6515d2d34827fc001aac7247/tile_1782273261261.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025121100 +0000" stop="20261025124000 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Secreto De Los Jinchuriki</title><sub-title lang="es">El Secreto De Los Jinchuriki</sub-title><desc lang="es">Sus enemigos vencidos, Kisame e Itachi, son copias hechas con el Jutsu de suplantación. Los Akatsuki han comenzado su proceso de extracción de la Bestia. Chiyo explica a Naruto y Sakura la conexión entre las Bestias y los Jinchuriki, el cuerpo portador.</desc><credits><actor>Isabel Martion</actor></credits><date>20070531</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.235.0/1</episode-num><episode-num system="onscreen">S01E236</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025124000 +0000" stop="20261025130900 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: La Muerte De Gaara</title><sub-title lang="es">La Muerte De Gaara</sub-title><desc lang="es">Los equipos de Kakashi y Guy descansan un poco. Chiyo se pregunta por qué Naruto quiere rescatar a Gaara. Kakashi dice que Naruto también es un Jinchuriki. El Akatsuki completa el Jutsu de Sellado: Los Nueve Dragones Fantasmas.</desc><credits><actor>Isabel Martion</actor></credits><date>20070607</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.236.0/1</episode-num><episode-num system="onscreen">S01E237</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025130900 +0000" stop="20261025133800 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Cambio De Táctica, Entrada De Gancho</title><sub-title lang="es">Cambio De Táctica, Entrada De Gancho</sub-title><desc lang="es">Los equipos Kakashi y Guy llegan al escondite de Akatsuki. Hay una barrera de cinco sellos, por lo que Negi usa Byakugan para localizar los sellos y destruir la barrera. Los Akatsuki los descubren. Una trampa espera al Team Guy!</desc><credits><actor>Isabel Martion</actor></credits><date>20070621</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.237.0/1</episode-num><episode-num system="onscreen">S01E238</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025133800 +0000" stop="20261025140700 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Trampas Activadas, Los Enemigos Del Equipo Guy</title><sub-title lang="es">Trampas Activadas, Los Enemigos Del Equipo Guy</sub-title><desc lang="es">Al romper la barrera se liberó una trampa, y tiene al equipo Guy peleando contra copias de ellos mismos. Deidara y Sasori luchan por el Jinchuriki de Nueve Colas. Deidara carga a Gaara,Naruto los persigue. Kakashi les dice a que no hagan nada imprudente.</desc><credits><actor>Isabel Martion</actor></credits><date>20070705</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.238.0/1</episode-num><episode-num system="onscreen">S01E239</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025140700 +0000" stop="20261025143600 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Hiruko Contra Las Dos Kunoichi</title><sub-title lang="es">Hiruko Contra Las Dos Kunoichi</sub-title><desc lang="es">El duelo comienza.La apariencia de Sasori confunde y Chiyo dice que se trata de Hiruko,que usa de protección y para derrotarla debe destruir a Hiruko pero su veneno es letal.Solo su abuela comprende las trampas de Sasori.Sakura debe dar el golpe final.</desc><credits><actor>Isabel Martion</actor></credits><date>20070719</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.239.0/1</episode-num><episode-num system="onscreen">S01E240</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025143600 +0000" stop="20261025150500 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Verdadero Rostro De Sasori</title><sub-title lang="es">El Verdadero Rostro De Sasori</sub-title><desc lang="es">Chiyo y Sakura exponen a Sasori. Sasori, fue el autor intelectual detrás de la desaparición del Kazekage hace diez años. Chiyo se indigna al saber que su nieto ha atacado el Kazekage. Un equipo de ninjas dirigido por Temari se dirige a alguna parte.</desc><credits><actor>Isabel Martion</actor></credits><date>20070726</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.240.0/1</episode-num><episode-num system="onscreen">S01E241</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025150500 +0000" stop="20261025153400 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Las Habilidades Secretas De Chiyo</title><sub-title lang="es">Las Habilidades Secretas De Chiyo</sub-title><desc lang="es">Sakura es atrapada por Sasori y rodeada por una nube de veneno. Para proteger a Sakura del ataque de Sasori la abuela invoca a dos títeres expresamente destinados para esta batalla. Mientras tanto, Naruto y Kakashi están en plena persecución de Deidara.</desc><credits><actor>Isabel Martion</actor></credits><date>20070802</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.241.0/1</episode-num><episode-num system="onscreen">S01E242</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025153400 +0000" stop="20261025160200 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Padre y Madre</title><sub-title lang="es">Padre y Madre</sub-title><desc lang="es">Sasori ataca y Chiyo contraataca para proteger a Sakura. Sasori se apresura cuando Sakura toma una decisión.</desc><credits><actor>Isabel Martion</actor></credits><date>20070802</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.242.0/1</episode-num><episode-num system="onscreen">S01E243</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025160200 +0000" stop="20261025163000 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Tercer Kazekage</title><sub-title lang="es">El Tercer Kazekage</sub-title><desc lang="es">Sakura contrarresta la marioneta del tercer Kazekage. Ella usa la habilidad para evadir un ataque y comienza a leer los patrones de ataque de Sasori. Sasori usa su jutsu Iron Arena para capturar al objetivo. Sakura es herida y envenenada.</desc><credits><actor>Isabel Martion</actor></credits><date>20070809</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.243.0/1</episode-num><episode-num system="onscreen">S01E244</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025163000 +0000" stop="20261025165800 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Tres Minutos Entre la Vida y la Muerte</title><sub-title lang="es">Tres Minutos Entre la Vida y la Muerte</sub-title><desc lang="es">Sakura destruye el tercer Kazekage gracias a un antídoto secreto y dice que convirtió el veneno en proteína durante tres minutos. Chiyo y Sakura pretenden derrotar a Sasori en ese momento. Naruto y Kakashi planean capturar a Deidara.</desc><credits><actor>Isabel Martion</actor></credits><date>20070816</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.244.0/1</episode-num><episode-num system="onscreen">S01E245</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025165800 +0000" stop="20261025172600 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Lucha de Títeres: 10 Contra 100</title><sub-title lang="es">Lucha de Títeres: 10 Contra 100</sub-title><desc lang="es">Sakura y Chiyo pelean contra Sasori que se convierte en una marioneta humana. Lo derrotan en el límite de tiempo, pero él revive. El antídoto de Sakura se ha agotado, pero se une a Chiyo y ambos atacan en una batalla final.</desc><credits><actor>Isabel Martion</actor></credits><date>20070823</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.245.0/1</episode-num><episode-num system="onscreen">S01E246</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025172600 +0000" stop="20261025175400 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Un Sueño Imposible</title><sub-title lang="es">Un Sueño Imposible</sub-title><desc lang="es">Chiyo está envenenado y usa el último antídoto en Sakura. Sasori intenta terminar con la vida de Chiyo, pero es derrotado. Sakura está al borde de la muerte y lo único que puede salvar a Sakura es un jutsu que Chiyo había creado para Sasori.</desc><credits><actor>Isabel Martion</actor></credits><date>20070830</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.246.0/1</episode-num><episode-num system="onscreen">S01E247</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025175400 +0000" stop="20261025182200 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Resurgimiento de las Bestias</title><sub-title lang="es">El Resurgimiento de las Bestias</sub-title><desc lang="es">El equipo Guy siente el resultado de la batalla de Chiyo y Sakura. Estan cansados pero sus copias siguen. Lee enciende el espíritu de pelea de los demas. Naruto va tras Deidara, quien capturo a Gaara.</desc><credits><actor>Isabel Martion</actor></credits><date>20070913</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.247.0/1</episode-num><episode-num system="onscreen">S01E248</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025182200 +0000" stop="20261025185000 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Kakashi Iluminado</title><sub-title lang="es">Kakashi Iluminado</sub-title><desc lang="es">Sakura se apresura con Chiyo para llegar a Naruto quien está envenenado. Team Guy ayuda a Kakashi, quien revela su Mangekyo Sharingan que transporta cualquier cosa que el ojo pueda ver en otra dimensión. Naruto rescata a Gaara atrapando a Deidara.</desc><credits><actor>Isabel Martion</actor></credits><date>20070927</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.248.0/1</episode-num><episode-num system="onscreen">S01E249</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025185000 +0000" stop="20261025191800 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Estética de un Instante</title><sub-title lang="es">Estética de un Instante</sub-title><desc lang="es">El Zorro de Nueve Colas se apodera de Naruto. Kakashi es capaz de reprimir al Zorro de Nueve Colas. Deidara, descubre la derrota de Sasori cuando aparecen Sakura y Chiyo. El equipo de Guy llega y queda atrapado. Deidara intenta explotar con el ninja Hoja.</desc><credits><actor>Isabel Martion</actor></credits><date>20070927</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.249.0/1</episode-num><episode-num system="onscreen">S01E250</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025191800 +0000" stop="20261025194600 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Legado</title><sub-title lang="es">El Legado</sub-title><desc lang="es">El espíritu del Zorro de Nueve Colas domina a Naruto. Kakashi apenas logra suprimirlo. Deidara se entera de la derrota de Sasori al llegar Sakura y Chiyo. El equipo Guy es capturado. Deidara intenta explotarse a sí mismo junto con los ninja de la Hoja.</desc><credits><actor>Isabel Martion</actor></credits><date>20071018</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.250.0/1</episode-num><episode-num system="onscreen">S01E251</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025194600 +0000" stop="20261025213700 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden the Movie: Bonds</title><sub-title lang="es">Naruto Shippuden the Movie: Bonds</sub-title><desc lang="es">Misteriosos ninja voladores han lanzado un ataque repentino contra la Hoja, dejando tras de sí una estela de destrucción. Para salvar su aldea, Naruto y sus amigos se propusieron detener esta nueva amenaza.</desc><credits><actor>Isabel Martiñón</actor><actor>Humberto Solórzano</actor><actor>Montserrat Aguilar</actor><actor>Javier Olguín</actor><actor>Víctor Ugarte</actor><actor>Alondra Hidalgo</actor><actor>Alfonso Obregón</actor><actor>Junko Takeuchi</actor><actor>Chie Nakamura</actor><actor>Noriaki Sugiyama</actor></credits><date>20080802</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/6515cd39619680001a502cfb/tile_1782276127534.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025213700 +0000" stop="20261025220500 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Regreso del Kazekage</title><sub-title lang="es">El Regreso del Kazekage</sub-title><desc lang="es">Gaara y los demás regresan al pueblo. Después de que muestran respeto en la tumba de Chiyo, Naruto y el ninja se van. Naruto le da la mano a Gaara. Un Deidara herido aparece frente a Zetsu y Tobi.</desc><credits><actor>Isabel Martion</actor></credits><date>20071025</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.251.0/1</episode-num><episode-num system="onscreen">S01E252</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025220500 +0000" stop="20261025223500 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: El Nuevo Objetivo</title><sub-title lang="es">El Nuevo Objetivo</sub-title><desc lang="es">Kakashi está hospitalizado pero tiene previsto reunirse con el contacto de Orochimaru. Tsunade dice que enviará al equipo de Kakashi para hacer el trabajo y Naruto se apresura a buscar refuerzos, es atacado en el camino por el misterioso Sai.</desc><credits><actor>Isabel Martion</actor></credits><date>20071108</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.252.0/1</episode-num><episode-num system="onscreen">S01E253</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025223500 +0000" stop="20261025230300 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Formación, El Nuevo Equipo Kakashi</title><sub-title lang="es">Formación, El Nuevo Equipo Kakashi</sub-title><desc lang="es">Después de atacar, Sai predice que se encontrarán nuevamente y se va. Tsunade se encuentra con Homura y Koharu, quienes dicen que Naruto, como Jinchuuriki, no debe ser enviado a misiones que involucren a Akatsuki.</desc><credits><actor>Isabel Martion</actor></credits><date>20071115</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.253.0/1</episode-num><episode-num system="onscreen">S01E254</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025230300 +0000" stop="20261025233100 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Una Adición Innecesaria</title><sub-title lang="es">Una Adición Innecesaria</sub-title><desc lang="es">Naruto se enfurece cuando descubre que Sai lo atacó para probar su fuerza. La tensión crece entre el equipo. Tsunade, Jiraiya, Yamato y Shizune se encuentran con Kakashi.</desc><credits><actor>Isabel Martion</actor></credits><date>20071122</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.254.0/1</episode-num><episode-num system="onscreen">S01E255</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025233100 +0000" stop="20261025235900 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Una Sonrisa Falsa</title><sub-title lang="es">Una Sonrisa Falsa</sub-title><desc lang="es">El equipo de Kakashi se dirige a Tenchikyo. Sai muestra su desprecio por Sasuke. Yamato entra para calmarlo usando el ninjutsu estilo madera que el Primer Hokage conocía. Yamato decide que pasarán la noche en una posada.</desc><credits><actor>Isabel Martion</actor></credits><date>20071129</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.255.0/1</episode-num><episode-num system="onscreen">S01E256</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261025235900 +0000" stop="20261026002700 +0000" channel="Naruto Shippuden"><title lang="es">Naruto Shippuden: Sin Título</title><sub-title lang="es">Sin Título</sub-title><desc lang="es">Sakura encuentra con Sai trabajando en pintura abstracta y encuentra un libro ilustrado inusual en las cosas de Sai. El grupo se dirige a Tenchikyo pero en guardia para cualquier emboscada. Yamato empareja a todos en caso de que comience una batalla.</desc><credits><actor>Isabel Martion</actor></credits><date>20071129</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.256.0/1</episode-num><episode-num system="onscreen">S01E257</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/5ed68438af4720001a024113/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
