<programme start="20261103232303 +0000" stop="20261103235103 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Las Aventuras del Bosque Encantado de Dora Parte 1, El Cuento del Rey Unicornio</sub-title><desc lang="es">Unicornio ha sido escogido el nuevo Rey del Bosque Encantado, pero primero necesita la ayuda de Dora, de Botas y de ti para descubrir que es bueno, inteligente, valiente y fuerte como para hacer el trabajo.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.12.0/1</episode-num><episode-num system="onscreen">S06E13</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261103235103 +0000" stop="20261104001903 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Las Aventuras del Bosque Encantado de Dora Parte 2, El Secreto de la Atlántida</sub-title><desc lang="es">Dora, Botas y el Rey Unicornio dejan el Bosque Encantado para unirse a Diego y recuperar el continente perdido de la Atlántida, terminando con una antigua pelea entre unicornios y dragones.</desc><credits><actor>Chris Gifford</actor><actor>Eric Weiner</actor><actor>Kathleen Herles</actor><actor>Harrison Chad</actor><actor>George Chialtas</actor><actor>Jake Burbage</actor><actor>Rosmary Contreras</actor><actor>Sherie Pollack</actor><actor>Ashley Fleming</actor><actor>Muhammad Cunninham</actor></credits><date>20100101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">5.15.0/1</episode-num><episode-num system="onscreen">S06E16</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261104001903 +0000" stop="20261104004803 +0000" channel="Dora La Exploradora"><title lang="es">Dora The Explorer LT</title><sub-title lang="es">Viaje al Planeta Púrpura</sub-title><desc lang="es">Viaja al espacio exterior junto a Dora y Botas y ayúdalos a regresar a cinco criaturas espaciales de vuelta a su casa en el Planeta Púrpura.</desc><credits><actor>Ashley Fleming</actor><actor>Jake Burbage</actor><actor>Sasha Toro</actor><actor>Marc Weiner</actor><actor>Harrison Chad</actor><actor>Kathleen Herles</actor></credits><date>20030101</date><category lang="es">Children &amp; Family</category><category lang="es">Cartoons</category><episode-num system="xmltv_ns">2.5.0/1</episode-num><episode-num system="onscreen">S03E06</episode-num><rating><value>TV-G</value></rating><icon src="https://images.pluto.tv/series/654e4f4891ee7c001ad64f5d/tile_1783671842014.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
