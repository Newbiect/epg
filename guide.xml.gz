<programme start="20261106130200 +0000" stop="20261106135300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Encubiertos</sub-title><desc lang="es">Cuando los cadáveres de dos asesinos son entregados al NCIS desde el extranjero, Tony y Ziva asumen identidades encubiertas y asisten a una cita sexy en un hotel de lujo para encontrar a su objetivo.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.7.0/1</episode-num><episode-num system="onscreen">S03E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261106135300 +0000" stop="20261106144500 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Falsa culpa</sub-title><desc lang="es">Cuando se encuentra una parte del cuerpo de una mujer en Quantico, el equipo del NCIS investiga y se sorprende al descubrir que todas las pruebas forenses apuntan a Tony como el principal sospechoso.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20050101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">2.8.0/1</episode-num><episode-num system="onscreen">S03E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
