<programme start="20261105051500 +0000" stop="20261105060700 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Pesadilla</sub-title><desc lang="es">Un terrorista retiene a Ducky, Gerald y Kate como rehenes mientras el resto del equipo del NCIS intenta descubrir cómo entró el criminal y cómo sacar a su gente de manera segura.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.15.0/1</episode-num><episode-num system="onscreen">S01E16</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105060700 +0000" stop="20261105065800 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">La verdad está ahí afuera</sub-title><desc lang="es">Encuentran el cadáver de un infante de marina después de una fiesta en un club nocturno ilegal. El equipo investiga una serie de posibles pistas, incluido un chantaje y una muerte accidental.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.16.0/1</episode-num><episode-num system="onscreen">S01E17</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105065800 +0000" stop="20261105075000 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Ex-SEAL</sub-title><desc lang="es">El equipo busca a un ex-SEAL que escapó de prisión en busca de venganza. Está decidido a encontrar al verdadero asesino de su esposa.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.17.0/1</episode-num><episode-num system="onscreen">S01E18</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105075000 +0000" stop="20261105084200 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">El muerto que habla</sub-title><desc lang="es">Un agente del NCIS fue asesinado mientras investigaba un caso y el trabajo del equipo es averiguar qué sucedió.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.18.0/1</episode-num><episode-num system="onscreen">S01E19</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105084200 +0000" stop="20261105093400 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Desaparecido</sub-title><desc lang="es">Un infante de marina desaparece después de una cita con un periodista. Durante la investigación, el equipo descubre que tres exmiembros de su unidad están muertos y sospecha que el comandante es un asesino en serie.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.19.0/1</episode-num><episode-num system="onscreen">S01E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105093400 +0000" stop="20261105102600 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Decisión dividida</sub-title><desc lang="es">Cuando se encuentra el cadáver de un infante de marina asesinado en el bosque, la investigación lleva a la milicia local y a una venta de armas que salió mal.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.20.0/1</episode-num><episode-num system="onscreen">S01E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261105102600 +0000" stop="20261105111700 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Punto débil</sub-title><desc lang="es">Gibbs y su equipo investigan la muerte de un SEAL, que falleció realizando un ejercicio de entrenamiento.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20040101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.21.0/1</episode-num><episode-num system="onscreen">S01E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
