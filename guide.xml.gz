<programme start="20261028211100 +0000" stop="20261028220200 +0000" channel="CSI: Miami"><title lang="es">CSI: Miami</title><sub-title lang="es">Día de la liquidación</sub-title><desc lang="es">Se suponía que era un viaje encubierto de rutina al incinerador para deshacerse de pruebas de drogas, pero emboscan a los oficiales de policía.</desc><credits><actor>Adam Rodriguez</actor><actor>David Caruso</actor><actor>Emily Procter</actor><actor>Khandi Alexander</actor><actor>Rory Cochrane</actor></credits><date>20030310</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.17.0/1</episode-num><episode-num system="onscreen">S01E18</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/63bc1f45a6bb3b001475e802/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261028220200 +0000" stop="20261028225500 +0000" channel="CSI: Miami"><title lang="es">CSI: Miami</title><sub-title lang="es">Doble tapadera</sub-title><desc lang="es">El caso de Horatio de una mujer asesinada se ve comprometido cuando se involucran los agentes federales, que tienen su propio plan a seguir.</desc><credits><actor>Adam Rodriguez</actor><actor>David Caruso</actor><actor>Emily Procter</actor><actor>Khandi Alexander</actor><actor>Rory Cochrane</actor></credits><date>20030331</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.18.0/1</episode-num><episode-num system="onscreen">S01E19</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/63bc1f45a6bb3b001475e802/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261028225500 +0000" stop="20261028234800 +0000" channel="CSI: Miami"><title lang="es">CSI: Miami</title><sub-title lang="es">Unos chicos difíciles</sub-title><desc lang="es">Un ex-convicto que Horatio envió a la cárcel le pide que lo ayude a encontrar a su hijo desaparecido. Él encuentra marihuana mientras busca en la habitación del chico.</desc><credits><actor>Adam Rodriguez</actor><actor>David Caruso</actor><actor>Emily Procter</actor><actor>Khandi Alexander</actor><actor>Rory Cochrane</actor></credits><date>20030414</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.19.0/1</episode-num><episode-num system="onscreen">S01E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/63bc1f45a6bb3b001475e802/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
