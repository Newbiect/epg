<programme start="20261111234000 +0000" stop="20261112000900 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Persecución notoria</sub-title><desc lang="es">Bucciarati y su tripulación se preparan para partir hacia Cerdeña para descubrir el pasado de su jefe, pero un extraño usuario de Stand aparece antes de que despeguen.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190330</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.23.0/1</episode-num><episode-num system="onscreen">S04E24</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112000900 +0000" stop="20261112003800 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Mujer picante</sub-title><desc lang="es">Trish, que se encuentra sola en la cabaña y la están atacando, recibe de repente la ayuda de un extraño ser que se hace llamar Spicy Lady, su propio Stand.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190406</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.24.0/1</episode-num><episode-num system="onscreen">S04E25</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112003800 +0000" stop="20261112010700 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Viaje al pasado (Me llamo Doppio)</sub-title><desc lang="es">Durante una misión para localizar a Trish en Cerdeña para su jefe, el leal subordinado Doppio se encuentra con el traidor Risotto.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190413</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.25.0/1</episode-num><episode-num system="onscreen">S04E26</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112010700 +0000" stop="20261112013600 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Emperor Crimson contra Metallic</sub-title><desc lang="es">Risotto deduce que Doppio es algo más que un simple socio de Passione y le ataca metódicamente con la capacidad magnética de su Stand, Metallic.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190420</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.26.0/1</episode-num><episode-num system="onscreen">S04E27</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112013600 +0000" stop="20261112020500 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Bajo un cielo a punto de caer</sub-title><desc lang="es">Decidido a identificar a su jefe, Abbacchio activa su Stand para revelar al fotógrafo que fotografió a la madre de Trish 15 años antes.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190427</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.27.0/1</episode-num><episode-num system="onscreen">S04E28</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112020500 +0000" stop="20261112023400 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">¡Id al coliseo de Roma!</sub-title><desc lang="es">Cuando Bucciarati y su tripulación reciben una llamada anónima sobre la identidad de su jefe y cómo derrotarlo, se dirigen a Roma para reunirse con el informante.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190511</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.28.0/1</episode-num><episode-num system="onscreen">S04E29</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112023400 +0000" stop="20261112030300 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Green Tea y Sanctuary (Primera parte)</sub-title><desc lang="es">Para huir del Stand carnívoro de Cioccolata, Green Tea, Bucciarati y Mista intentan encontrar un coche para escapar, pero Secco está decidido a impedírselo.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190518</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.29.0/1</episode-num><episode-num system="onscreen">S04E30</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112030300 +0000" stop="20261112033200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Green Tea y Sanctuary (Segunda parte)</sub-title><desc lang="es">Cioccolata intenta acabar con civiles inocentes con su Stand mediante un helicóptero, pero Giorno y Mista intentan acabar con él primero.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190525</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.30.0/1</episode-num><episode-num system="onscreen">S04E31</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112033200 +0000" stop="20261112040100 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Green Tea y Sanctuary (Tercera parte)</sub-title><desc lang="es">Para impedir que Secco llegue primero al Coliseo, Bucciarati le obliga a batirse en duelo en las calles de Roma.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190601</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.31.0/1</episode-num><episode-num system="onscreen">S04E32</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112040100 +0000" stop="20261112043000 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Se llama Diavolo</sub-title><desc lang="es">Doppio lleva al Coliseo a Bucciarati, que está demasiado herido para darse cuenta de quién le ayuda, y revela su verdadera identidad a la persona que espera dentro.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190608</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.32.0/1</episode-num><episode-num system="onscreen">S04E33</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112043000 +0000" stop="20261112045900 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Suena un réquiem oscuro (Primera parte)</sub-title><desc lang="es">Mientras Emperor Crimson se lanza sobre Polnareff, la flecha alcanza a Silver Chariot. Los que están dentro del Coliseo caen en un sueño misterioso.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190615</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.33.0/1</episode-num><episode-num system="onscreen">S04E34</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112045900 +0000" stop="20261112052800 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Suena un réquiem oscuro (Segunda parte)</sub-title><desc lang="es">Como las almas de todos se han intercambiado, Mista y los demás deben recuperar la flecha antes de que Diavolo se apodere de ella.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190622</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.34.0/1</episode-num><episode-num system="onscreen">S04E35</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112052800 +0000" stop="20261112055700 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Diavolo resurge</sub-title><desc lang="es">Mientras Silver Chariot Requiem provoca que las entidades a su alrededor muten, Giorno deduce que el alma de Diavolo debe de estar poseyendo a uno de sus tripulantes.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190629</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.35.0/1</episode-num><episode-num system="onscreen">S04E36</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112055700 +0000" stop="20261112062600 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Rey de reyes</sub-title><desc lang="es">A pesar de sus esfuerzos, la flecha termina en manos de Diavolo. Pero justo antes de que el jefe pueda atravesar su propio Stand con ella, Bucciarati actúa.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190706</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.36.0/1</episode-num><episode-num system="onscreen">S04E37</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112062600 +0000" stop="20261112065500 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Golden Wind Requiem</sub-title><desc lang="es">El Stand de Giorno evoluciona a Golden Wind Requiem. Diavolo intenta anular sus ataques, pero una nueva y espeluznante realidad acecha al jefe de la mafia.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190729</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.37.0/1</episode-num><episode-num system="onscreen">S04E38</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112065500 +0000" stop="20261112072400 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Los esclavos durmientes</sub-title><desc lang="es">Mientras investiga el misterio del sospechoso suicidio de la hija del florista, Mista se encuentra cara a cara con una usuaria de Stand llamada Scolippi.</desc><credits><actor>Kensho Ono</actor><actor>Yuichi Nakamura</actor><actor>Junichi Suwabe</actor><actor>Kohsuke Toriumi</actor><actor>Daiki Yamashita</actor><actor>Junya Enoki</actor></credits><date>20190729</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">3.38.0/1</episode-num><episode-num system="onscreen">S04E39</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112072400 +0000" stop="20261112075300 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Dio el invasor</sub-title><desc lang="es">Tras la muerte de su padre, Dio Brando es adoptado por una familia de aristócratas y, en secreto, jura arrebatarle todo al heredero: Jonathan “JoJo” Joestar.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121005</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112075300 +0000" stop="20261112082200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Una carta del pasado</sub-title><desc lang="es">Cuando va a Londres a investigar las sospechas de que Dio envenenó a su padre, JoJo conoce al matón callejero Speedwagon.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121012</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112082200 +0000" stop="20261112085300 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Juventud con Dio</sub-title><desc lang="es">JoJo le da el antídoto a su padre y se enfrenta a Dio, que lo ataca con un cuchillo y usa los poderes de máscara de piedra ensangrentada.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121019</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112085300 +0000" stop="20261112092200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Quinta marcha</sub-title><desc lang="es">JoJo se reúne con su primer amor, Erina. Un hombre llamado Will A. Zeppeli le muestra a JoJo su poder y le dice que tiene que destruir la máscara de piedra.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121026</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112092200 +0000" stop="20261112095100 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Los caballeros oscuros</sub-title><desc lang="es">Dio y una horda de zombis tienden una emboscada a JoJo y a sus acompañantes después de que un niño llamado Poco los llevase hasta un cementerio.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121102</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112095100 +0000" stop="20261112102000 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El coraje del mañana</sub-title><desc lang="es">El legendario caballero resucitado Bruford recupera su alma humana y confía su espada a JoJo. Tarkus ataca a JoJo con su poder aplastante.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121109</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.5.0/1</episode-num><episode-num system="onscreen">S01E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112102000 +0000" stop="20261112104900 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El sucesor afligido</sub-title><desc lang="es">Zeppeli se enfrenta a Tarkus, a pesar de sus pocas posibilidades. Como último recurso, usa la fuerza que le queda para traspasar sus poderes a su sucesor: JoJo.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121116</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.6.0/1</episode-num><episode-num system="onscreen">S01E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112104900 +0000" stop="20261112111800 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">¡Batalla sangrienta! JoJo y Dio</sub-title><desc lang="es">JoJo rescata a la hermana de Poco, pero Dio elimina a Dire, el amigo de Zeppeli. Con la espada de Bruford en las manos, JoJo se enfrenta a Dio una vez más.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121123</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.7.0/1</episode-num><episode-num system="onscreen">S01E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112111800 +0000" stop="20261112114700 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">¡El Hamon final!</sub-title><desc lang="es">JoJo y Erina pasan la luna de miel en un crucero. Para sorpresa de JoJo, uno de los sirvientes de Dio también está en el barco.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121130</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.8.0/1</episode-num><episode-num system="onscreen">S01E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112114700 +0000" stop="20261112121600 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El JoJo de Nueva York</sub-title><desc lang="es">En 1938 se descubren muchas máscaras de piedra en unas ruinas de México. Mientras tanto, el nieto de JoJo, Joseph, ayuda al joven Smokey en Nueva York.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121207</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.9.0/1</episode-num><episode-num system="onscreen">S01E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112121600 +0000" stop="20261112124500 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El Maestro del juego</sub-title><desc lang="es">Joseph lucha contra Straizo, que se convirtió en vampiro tras traicionar a su amigo Speedwagon. Después de la batalla, Straizo avisa del peligro de los hombres del pilar.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121214</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.10.0/1</episode-num><episode-num system="onscreen">S01E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112124500 +0000" stop="20261112131400 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El Hombre del Pilar</sub-title><desc lang="es">Un secuaz de Stroheim ataca a Joseph en México. Mientras tanto, Stroheim intenta despertar a Santana, uno de los hombres del pilar.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20121221</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.11.0/1</episode-num><episode-num system="onscreen">S01E12</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112131400 +0000" stop="20261112134300 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">JoJo contra la forma de vida definitiva</sub-title><desc lang="es">Joseph usa su poder para escapar del cuerpo de Santana. Cuando falla, intenta exponerlo a la luz solar.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130104</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.12.0/1</episode-num><episode-num system="onscreen">S01E13</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112134300 +0000" stop="20261112141200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Los guerreros definitivos de la antigüedad</sub-title><desc lang="es">Joseph y Speedwagon llegan a Roma. Allí, oyen hablar de los otros hombres del pilar y conocen a Caesar, el nieto de Zeppeli.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130111</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.13.0/1</episode-num><episode-num system="onscreen">S01E14</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112141200 +0000" stop="20261112144100 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El requisito para ser un héroe</sub-title><desc lang="es">Wamuu, un hombre del pilar, hiere con facilidad a Caesar Zeppeli. Joseph revela su técnica secreta de reciente creación.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130118</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.14.0/1</episode-num><episode-num system="onscreen">S01E15</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112144100 +0000" stop="20261112151100 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Lisa, Lisa, la maestra del Hamon</sub-title><desc lang="es">Caesar lleva a Joseph a Venecia y le presenta a su maestra Lisa Lisa, quien comienza a entrenarle con disciplina para que aprenda a controlar sus poderes.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130125</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.15.0/1</episode-num><episode-num system="onscreen">S01E16</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112151100 +0000" stop="20261112154100 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Trampa sobre trampa</sub-title><desc lang="es">Lisa Lisa le cuenta a Joseph que, para destruir a los hombres del pilar, necesita la piedra Súper Aja. Joseph y Caesar se enfrentan a otros maestros con el mismo poder.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130201</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.16.0/1</episode-num><episode-num system="onscreen">S01E17</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112154100 +0000" stop="20261112161200 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">El escuadrón de Stroheim contraataca</sub-title><desc lang="es">Joseph y Caesar combinan sus poderes para atacar al hombre del pilar que se apoderó del cuerpo de Suzi Q para robar la piedra roja de Aja.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130208</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.17.0/1</episode-num><episode-num system="onscreen">S01E18</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261112161200 +0000" stop="20261112164100 +0000" channel="JoJo’s Bizarre Adventure"><title lang="es">JoJo&apos;s Bizarre Adventure</title><sub-title lang="es">Carrera al acantilado mortal</sub-title><desc lang="es">Stroheim empieza a luchar contra Kars con su nuevo cuerpo mecánico. Mientras tanto, Joseph y Kars se caen por un precipicio intentando conseguir la piedra roja.</desc><credits><actor>Kazuyuki Okitsu</actor><actor>Tomokazu Sugita</actor><actor>Takehito Koyasu</actor><actor>Youji Ueda</actor><actor>Yoku Shioya</actor><actor>Takuya Satou</actor><actor>Atsuko Tanaka</actor></credits><date>20130215</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.18.0/1</episode-num><episode-num system="onscreen">S01E19</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/65bd42b9b65b870013b0bd02/tile_1769467681643.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
