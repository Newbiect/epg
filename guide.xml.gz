<programme start="20261119005100 +0000" stop="20261119014800 +0000" channel="The Walking Dead Channel"><title lang="es">The Walking Dead</title><sub-title lang="es">Still</sub-title><desc lang="es">In the woods after fleeing the prison, Beth makes a request that sends her and Daryl on an enlightening mission.</desc><credits><director>Julius Ramsay</director><actor>Andrew Lincoln</actor><actor>Norman Reedus</actor><actor>Steven Yeun</actor><actor>Lauren Cohan</actor><actor>Chandler Riggs</actor><actor>Danai Gurira</actor><actor>Melissa McBride</actor><actor>Scott Wilson</actor><actor>David Morrissey</actor><actor>Emily Kinney</actor><actor>Chad Coleman</actor><actor>Sonequa Martin-Green</actor><actor>Lawrence Gilliard Jr.</actor></credits><date>20140302</date><episode-num system="xmltv_ns">3.11.0/1</episode-num><episode-num system="onscreen">S04E12</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/80b4a85a24ffed63863b5dd298114ff9389cd79f.jpg"/></programme>
