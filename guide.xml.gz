<programme start="20261022215800 +0000" stop="20261022225000 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Tiempo De Gracia</sub-title><desc lang="es">Gibbs y el equipo investigan cuando una llamada de fin de semana al NCIS resulta en la muerte de dos agentes. El equipo descubre que esa pista telefónica fue una trampa para terminar en la muerte de los agentes.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.18.0/1</episode-num><episode-num system="onscreen">S04E19</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261022225000 +0000" stop="20261022234100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Historia Principal</sub-title><desc lang="es">Gibbs y el equipo investigan cuando el libro ficticio de McGee sobre un agente del NCIS se vuelve realidad. McGee se horroriza cuando un suboficial en el que basó el personaje de su último libro resulta asesinado.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.19.0/1</episode-num><episode-num system="onscreen">S04E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261022234100 +0000" stop="20261023003300 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Hermano En Armas</sub-title><desc lang="es">El director Shepard corre un gran riesgo y acepta reunirse con un informante a solas para hablar sobre &quot;La Grenouille&quot;, pero la reunión sale mal y su contacto muere.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.20.0/1</episode-num><episode-num system="onscreen">S04E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261023003300 +0000" stop="20261023012500 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">En La Oscuridad</sub-title><desc lang="es">Gibbs y el equipo investigan cuando un fotógrafo ciego toma sin darse cuenta la fotografía del asesinato de un suboficial.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.21.0/1</episode-num><episode-num system="onscreen">S04E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261023012500 +0000" stop="20261023021700 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Caballo De Troya</sub-title><desc lang="es">Gibbs ignora la burocracia asociada con sus deberes de director &quot;interino&quot; y dirige una investigación sobre una víctima de asesinato encontrada en un taxi que se dirigía a la sede del NCIS. Además, Jenny descubre un secreto sobre su pasado.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.22.0/1</episode-num><episode-num system="onscreen">S04E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261023021700 +0000" stop="20261023030900 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Àngel De La Muerte</sub-title><desc lang="es">El director del NCIS regresa de una polémica gira europea. Gibbs y sus agentes se preparan a regañadientes para las pruebas de polígrafo del Departamento de Seguridad Nacional. Se revelan secretos del equipo.</desc><credits><actor>Brian Dietzen</actor><actor>Cote De Pablo</actor><actor>David Mccallum</actor><actor>Lauren Holly</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sean Murray</actor></credits><date>20070101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">3.23.0/1</episode-num><episode-num system="onscreen">S04E24</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261023030900 +0000" stop="20261023040100 +0000" channel="NCIS"><title lang="es">NCIS LT</title><sub-title lang="es">Yanqui blanco</sub-title><desc lang="es">Mientras estaba en el Air Force One, muere un comandante de la Marina. Los agentes del NCIS deciden tomar la investigación en sus propias manos y también obligan a la agente del Servicio Secreto Kate Todd a ayudar.</desc><credits><actor>David Mccallum</actor><actor>Mark Harmon</actor><actor>Michael Weatherly</actor><actor>Pauley Perrette</actor><actor>Sasha Alexander</actor></credits><date>20030101</date><category lang="es">Crime</category><category lang="es">Crime</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/64413b886113a5001afb0856/tile_1784569682020.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
