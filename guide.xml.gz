<programme start="20261021032900 +0000" stop="20261021035800 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Adelante, Furano</sub-title><desc lang="es">En el arduo segundo partido de los cuartos de final del Torneo Nacional, Matsuyama se empeña en demostrar que un partido solo se gana en equipo.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190107</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.39.0/1</episode-num><episode-num system="onscreen">S01E40</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021035800 +0000" stop="20261021042700 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El caballo negro</sub-title><desc lang="es">Nankatsu e Hirado se baten por las semifinales del Torneo Nacional. Tsubasa enfrenta al poderoso Hiroshi Jito, capitán y defensa central de Hirado.</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20190114</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.40.0/1</episode-num><episode-num system="onscreen">S01E41</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021042700 +0000" stop="20261021045700 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El fénix Tsubasa</sub-title><desc lang="es">Tras una aplastante desventaja, Tsubasa decide arriesgarlo todo: intentará el famoso tiro con efecto de Roberto por la oportunidad de ganar.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190121</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.41.0/1</episode-num><episode-num system="onscreen">S01E42</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021045700 +0000" stop="20261021052700 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El tigre caído</sub-title><desc lang="es">En las semifinales del Torneo, los primeros en batirse son Meiwa y Toho. Con Hyuga en el banco, Meiwa saca ventaja, haciendo sufrir a Takeshi Sawada.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190128</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.42.0/1</episode-num><episode-num system="onscreen">S01E43</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021052700 +0000" stop="20261021055700 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Un duelo de diez</sub-title><desc lang="es">En el último partido de las semifinales, Nankatsu se bate con los de Furano, famosos por su gran trabajo en equipo y su capitán Hikaru Matsuyama.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190204</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.43.0/1</episode-num><episode-num system="onscreen">S01E44</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021055700 +0000" stop="20261021062600 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Lágrimas en el aeropuerto</sub-title><desc lang="es">En el segundo tiempo, Furano empata. Gravemente lesionado, Tsubasa intenta hacer su tiro con efecto una vez más. Matsuyama hará todo por impedirlo.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190211</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.44.0/1</episode-num><episode-num system="onscreen">S01E45</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021062600 +0000" stop="20261021065500 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">el juego del siglo</sub-title><desc lang="es">Tsubasa espera recuperarse de su lesión para enfrentar a Toho, y Hyuga abandona su orgullo para pedirle al entrenador Kitazune que le permita jugar.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190218</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.45.0/1</episode-num><episode-num system="onscreen">S01E46</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021065500 +0000" stop="20261021072400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Una batalla fulminante</sub-title><desc lang="es">Los capitanes de Nankatsu y Toho están empecinados en ganar. Hyuga demostrará su fuerza con su tiro de tigre; Tsubasa usará su tiro con efecto.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190225</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.46.0/1</episode-num><episode-num system="onscreen">S01E47</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021072400 +0000" stop="20261021075300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El Toho contraataca</sub-title><desc lang="es">Toho se impone por dos goles. Tsubasa, lesionado, cae en la desesperación. Pero tiene una idea, y decide arriesgar su físico para detener a Hyuga.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190304</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.47.0/1</episode-num><episode-num system="onscreen">S01E48</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021075300 +0000" stop="20261021082300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El tigre contra Tsubasa</sub-title><desc lang="es">Nankatsu defiende a toda costa la portería a la espera de su capitán Tsubasa, quien se empecina en volver a la cancha. Hyuga aprovecha la situación.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190311</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.48.0/1</episode-num><episode-num system="onscreen">S01E49</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021082300 +0000" stop="20261021085300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Una feroz batalla</sub-title><desc lang="es">Nankatsu y Toho anotan tres goles cada uno. Una falta de Takasugi le regala un tiro libre a Hyuga, quien se dispone a usar su poderoso tiro de tigre.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190318</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.49.0/1</episode-num><episode-num system="onscreen">S01E50</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021085300 +0000" stop="20261021092300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">El tiro milagroso</sub-title><desc lang="es">La final va a tiempo extra. Ni Tsubasa ni Hyuga desean compartir el título, y están dispuestos a arriesgar su físico por el Torneo Nacional.</desc><credits><actor>Emilio Ángeles (Tsubasa Ozora)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Rangel (Kodai Ozora)</actor></credits><date>20190325</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.50.0/1</episode-num><episode-num system="onscreen">S01E51</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021092300 +0000" stop="20261021095300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa LATAM</title><sub-title lang="es">Un sueño sin fin</sub-title><desc lang="es">En la emocionante final, Hyuga y Tsubasa demuestran de qué están hechos. Es un duelo futbolístico, pero también personal. ¿Quién será el campeón?</desc><credits><actor>Oscar Rangel (Kodai Ozora)</actor><actor>Alejandria De Los Santos (Natsuko Ozora)</actor><actor>Oscar Gomez (Tatsuo Mikami)</actor><actor>Jorge Roig JR (Kojiro Hyuga)</actor><actor>Annie Rojas (Taro Misaki)</actor><actor>Ricardo Tejedo (Roberto Hongo)</actor><actor>Carlos Siller (Ryo Ishizaki)</actor><actor>Luis Navarro (Genzo Wakabayashi)</actor><actor>Emilio Ángeles (Tsubasa Ozora)</actor></credits><date>20190401</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.51.0/1</episode-num><episode-num system="onscreen">S01E52</episode-num><rating><value>PG</value></rating><icon src="https://images.pluto.tv/series/646bcdf917da09001a32ae02/tile_1769546521026.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021095300 +0000" stop="20261021102500 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Un Nuevo Desafío</sub-title><desc lang="es">La final del Campeonato Japonés Juvenil termina con un giro inesperado. Ahora, con Tsubasa fuera de combate, ¡es el turno de Kojiro Hyuga! Un partido entre increíbles estudiantes de secundaria será la próxima prueba. ¿Superarán el desafío?</desc><credits><actor>Ayaka Fukuhara</actor><actor>Federico Pezet</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Satō</actor><actor>Yuko Sanpei</actor></credits><date>20230106</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021102500 +0000" stop="20261021105500 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Saludos A Un Antiguo Rival</sub-title><desc lang="es">¡Se anuncia el viaje del equipo a Europa! Hyuga es el capitán, pero Tsubasa está decidido a jugar.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuko Sanpei</actor></credits><date>20231008</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021105500 +0000" stop="20261021112400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Guerrero Profesional</sub-title><desc lang="es">Los equipos de Japón y Hamburgo tienen un partido de práctica y Wakabayashi muestra su férrea defensa. Schneider inicia un ataque feroz y hace imposible anotar. Mientras tanto, Hyuga está furioso. Luego está Tsubasa...</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20231015</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021112400 +0000" stop="20261021115400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Empezando desde Cero</sub-title><desc lang="es">Si bien el partido contra Hamburgo resultó desastroso para Japón, todos prometen empezar de nuevo. El capitán Matsuyama desea la confianza de sus compañeros, mientras que Hyuga se centra en superar a Schneider. Wakabayashi hace un anuncio sorprendente.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20231022</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021115400 +0000" stop="20261021122400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Otro Gran Jugador</sub-title><desc lang="es">Taro Misaki, ahora en Francia, se une al Equipo Juvenil de Japón. El tiempo que ha pasado fuera no le ha dado seguridad, pero el volver a jugar con Tsubasa lo ilusiona. ¡Ahora Misaki desafía al equipo de Francia para demostrar su habilidad!</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20231029</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021122400 +0000" stop="20261021125400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">¡En acción! ¡Equipo Juvenil de Japón!</sub-title><desc lang="es">¡Tsubasa regresa al campo con estilo! El partido contra el Munich se torna interesante. Con Tsubasa nuevamente en acción, sus compañeros de equipo juegan como atletas completamente diferentes. Hyuga y Tsubasa deciden hacer las cosas aún más interesantes.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20231105</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.5.0/1</episode-num><episode-num system="onscreen">S01E06</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021125400 +0000" stop="20261021132400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">¡Encuento en París!</sub-title><desc lang="es">El equipo aterriza en Francia y se prepara para los partidos. El entrenador ordena un día de descanso, pero Tsubasa no puede relajarse. Mientras pasea por París, ve a alguien que le resulta conocido y tiene habilidades asombrosas.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20231112</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.6.0/1</episode-num><episode-num system="onscreen">S01E07</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021132400 +0000" stop="20261021135400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Soy Taro Misaki</sub-title><desc lang="es">Es la ceremonia de apertura del Torneo Internacional Juvenil, y Misaki está pensando en su tiempo en Japón y lo lejos que ha llegado. Pero no todos los recuerdos son felices. La carrera de su padre como artista no ha sido fácil para ninguno de los dos.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20231119</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.7.0/1</episode-num><episode-num system="onscreen">S01E08</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021135400 +0000" stop="20261021142400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Un Gran Camino</sub-title><desc lang="es">Japón enfrenta a Italia en el partido inaugural del torneo y las tensiones aumentan. El equipo japonés está encendido por los comentarios negativos de Italia. Aún así, Tsubasa está a la altura de las circunstancias y determinado.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20231126</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.8.0/1</episode-num><episode-num system="onscreen">S01E09</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021142400 +0000" stop="20261021145400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">¡Ha regresado! ¡¡El Dúo Dorado!!</sub-title><desc lang="es">El portero de Italia, Gino Hernández, hace paradas increíbles. Su récord perfecto le ha dado la reputación de ser el mejor portero de Europa. Su habilidad pone a Japón a la ofensiva, pero Misaki está observando. El entrenador hace un cambio sorprendente.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20231203</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.9.0/1</episode-num><episode-num system="onscreen">S01E10</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021145400 +0000" stop="20261021152400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">El Tigre Feroz Despierta</sub-title><desc lang="es">Gracias a Tsubasa y Misaki, Japón empata con Italia, dejando a los europeos reforzando sus defensas con la esperanza de nivelarse. Mientras tanto, cuando sólo falta un minuto para el final, la multitud clama por el equipo de Japón. Tsubasa se arriesga...</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20231210</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.10.0/1</episode-num><episode-num system="onscreen">S01E11</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021152400 +0000" stop="20261021155400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Destinados a la Victoria</sub-title><desc lang="es">Francia, el país anfitrión, tiene su primer partido contra Inglaterra. Elle Sid Pierre, el capitán francés, sorprende con su elegante juego. Mientras tanto, aun cuando Tsubasa y sus amigos están impresionados, el equipo de Francia siente la presión.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20231217</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.11.0/1</episode-num><episode-num system="onscreen">S01E12</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021155400 +0000" stop="20261021162400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Una Promesa en el Cielo de Estrellas</sub-title><desc lang="es">Roberto Hongo, habla con Katagiri en las afueras de París y no quiere que Tsubasa se entere que está a sólo kilómetros de distancia. Como ex entrenador de Tsubasa, Roberto todavía se siente culpable de haber roto la promesa que le hizo.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20231224</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.12.0/1</episode-num><episode-num system="onscreen">S01E13</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021162400 +0000" stop="20261021165400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Nunca te Rindas</sub-title><desc lang="es">Japón enfrenta a Argentina y el ganador pasa a la final. Tsubasa, sin embargo, está preocupado. Mientras está en el campo se entera de que su ex entrenador Roberto, a quien no ha visto en un largo tiempo, está observando desde las gradas.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240107</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.13.0/1</episode-num><episode-num system="onscreen">S01E14</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021165400 +0000" stop="20261021172400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">La Selección Juvenil Japonesa Contraataca</sub-title><desc lang="es">Mientras Japón se recupera de la última hazaña futbolística de Díaz, Tsubasa y Hyuga unen fuerzas para un ataque especial. Tsubasa recupera su ritmo. Aprovechando, los Gemelos Tachibana y Jito corren hacia la meta. ¡El momento de contraatacar es ahora!</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240114</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.14.0/1</episode-num><episode-num system="onscreen">S01E15</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021172400 +0000" stop="20261021175600 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Una Batalla de Altas y Bajas</sub-title><desc lang="es">Misaki logra un tiro milagroso, empatando el marcador para Japón. Sin embargo, un empate no es suficiente si quieren llegar a las semifinales. Dado que ambos equipos no están dispuestos a ceder, nadie sabe quién saldrá victorioso.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240121</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.15.0/1</episode-num><episode-num system="onscreen">S01E16</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021175600 +0000" stop="20261021182500 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">¡¡El Príncipe del Campo Regresa!!</sub-title><desc lang="es">El marcador está empatado 4x4 en el segundo tiempo. Japón mete a la cancha a Jun Misugi, un jugador excepcionalmente hábil con una enfermedad cardíaca. Jun tiene la oportunidad de compartir el campo con Tsubasa. ¡Argentina está lista para pelear!</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240128</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.16.0/1</episode-num><episode-num system="onscreen">S01E17</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021182500 +0000" stop="20261021185400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">¡Los Cuatro Finalistas se Reúnen!</sub-title><desc lang="es">Gracias a la destreza de Misugi, Japón gana por primera vez. Pero el autoproclamado genio arremete con su &quot;Tiro Banana, sobre las cabezas de todos, formando un enorme arco en el cielo. ¿Quién avanzará a las semifinales?</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240204</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.17.0/1</episode-num><episode-num system="onscreen">S01E18</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021185400 +0000" stop="20261021192300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Surge el Balón de Fuego</sub-title><desc lang="es">Es el primer partido de la fase final. Uruguay comienza con ataques ultrarrápidos, que logra un gol en apenas los primeros cincuenta segundos. Pero el alemán Schneider logra igualar el marcador. Nadie sabe qué delantero dominará el juego...</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240211</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.18.0/1</episode-num><episode-num system="onscreen">S01E19</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021192300 +0000" stop="20261021195500 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">¡¡Es la Guerra!! Japón contra Francia</sub-title><desc lang="es">En el segundo partido de la final, Japón se enfrenta al anfitrión Francia en un estadio lleno de seguidores del equipo local. Japón ejecuta un ataque triple, recuperando el balón de un furioso capitán francés, Pierre, quien parece estar planeando algo...</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240218</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.19.0/1</episode-num><episode-num system="onscreen">S01E20</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021195500 +0000" stop="20261021202400 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">10 Contra 11</sub-title><desc lang="es">A los diez minutos del primer tiempo, Soda recibe su segunda tarjeta amarilla, lo que obliga a Japón a continuar con sólo diez jugadores. Pierre recibe un penalty, dejando el marcador 2-1. Hyuga no se rinde, pero Japón parece no tener suerte...</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240225</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.20.0/1</episode-num><episode-num system="onscreen">S01E21</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021202400 +0000" stop="20261021205300 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">La Bestia Elegante Ataca</sub-title><desc lang="es">En la segunda mitad, la lluvia azota a los jugadores y al campo. Francia intensifica su ataque, pero Japón logra resistir. Izawa queda gravemente herido y en su lugar emerge Misugi creando esperanza. ¡Es hora de que inicie la guerra entre capitanes!</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240303</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.21.0/1</episode-num><episode-num system="onscreen">S01E22</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021205300 +0000" stop="20261021212200 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Misaki contra Pierre</sub-title><desc lang="es">¡He aquí el enigmático Ataque Eiffel de Francia! El equipo de Japón está listo, pero Pierre y Napoleón van con todo. El trabajo de pase perfecto es prueba de la fuerza francesa en su camino hacia la portería. ¿Podrá Tsubasa reanimar al equipo?</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240310</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.22.0/1</episode-num><episode-num system="onscreen">S01E23</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021212200 +0000" stop="20261021215100 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Tiempo Extra en la Lluvia</sub-title><desc lang="es">Gracias a Misaki, el marcador está empatado, dando inicio al primer tiempo extra del partido. El entrenador Mikami se ha quedado sin suplentes y todos están muy cansados. Ahora los peores temores de Japón se han hecho realidad. Las cosas no se ven bien…</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240317</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.23.0/1</episode-num><episode-num system="onscreen">S01E24</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021215100 +0000" stop="20261021222000 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">Una Defensa Final Herida</sub-title><desc lang="es">Es tiempo extra y Hyuga está preparado para luchar. Ahora enfrenta a Pierre, pero su pierna gravemente herida le impide mantener el control del balón. Francia continúa lanzando una feroz ola de ataques. Mientras tanto, Wakashimazu se retuerce de dolor.</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240324</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.24.0/1</episode-num><episode-num system="onscreen">S01E25</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021222000 +0000" stop="20261021224900 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">La Mano Milagrosa</sub-title><desc lang="es">Los tiempos extra y los saques de salida causan presión. El silbato suena. ¿Quién tendrá suerte hoy?</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuko Sanpei</actor></credits><date>20240331</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.25.0/1</episode-num><episode-num system="onscreen">S01E26</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261021224900 +0000" stop="20261021231800 +0000" channel="Captain Tsubasa"><title lang="es">Captain Tsubasa: Junior Youth Arc</title><sub-title lang="es">¡Los Leones de la Gran Final!</sub-title><desc lang="es">Finalmente, la gran final. Japón se enfrentará a Alemania. Aunque el equipo japonés ha llegado lejos, hay varios jugadores lesionados. La gran sorpresa es la alineación inicial y el debut de Wakabayashi es ahora. ¡Japón emerge como el país más fuerte!</desc><credits><actor>Ayaka Fukuhara</actor><actor>Jun Fukuyama</actor><actor>Kenichi Suzumura</actor><actor>Takuya Sato</actor><actor>Yuichiro Umehara</actor><actor>Yuko Sanpei</actor></credits><date>20240407</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">0.26.0/1</episode-num><episode-num system="onscreen">S01E27</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/651aea8505bcdf001ac1bebe/tile_1769464441747.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
