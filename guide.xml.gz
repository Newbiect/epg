<programme start="20261110035300 +0000" stop="20261110042200 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Sacrificio</sub-title><desc lang="es">Boruto lleva a Isshiki a otra dimensión para el enfrentamiento final. Naruto y Sasuke los siguen.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210919</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.215.0/1</episode-num><episode-num system="onscreen">S14E216</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110042200 +0000" stop="20261110045100 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Decisión</sub-title><desc lang="es">Naruto y Sasuke pelean ferozmente, pero sus esfuerzos son en vano ya que Isshiki los acorrala. Boruto toma medidas desesperadas para vencerlo, pero falla.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20210926</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.216.0/1</episode-num><episode-num system="onscreen">S14E217</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110045100 +0000" stop="20261110052000 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Compañero</sub-title><desc lang="es">Naruto y los demás están exhaustos por la batalla contra Isshiki. Momoshiki toma el control de la conciencia de Boruto y se muestra frente a ellos como un enemigo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211003</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.217.0/1</episode-num><episode-num system="onscreen">S14E218</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110052000 +0000" stop="20261110054900 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">Regreso</sub-title><desc lang="es">Al finalizar la batalla contra Isshiki, Boruto y los demás regresan a la aldea. Gracias a su trabajo, la aldea se mantuvo a salvo.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211010</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.218.0/1</episode-num><episode-num system="onscreen">S14E219</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110054900 +0000" stop="20261110061800 +0000" channel="Pluto TV Anime"><title lang="es">Boruto: Naruto Next Generations</title><sub-title lang="es">El Tiempo que Queda</sub-title><desc lang="es">Aquellos con el Karma comienzan a perder el control de su mente y cuerpo mientras pasan por la Otsutsukificación.</desc><credits><actor>Karen Vallejo</actor><actor>Azul Valadez</actor><actor>Alan Velazquez</actor><actor>Isabel Martiñón</actor><actor>Victor Ugarte</actor><actor>Montserrat Aguilar</actor></credits><date>20211017</date><category lang="es">Anime</category><category lang="es">Anime Series</category><episode-num system="xmltv_ns">13.219.0/1</episode-num><episode-num system="onscreen">S14E220</episode-num><rating><value>TV-14</value></rating><icon src="https://images.pluto.tv/series/69e651b83f22a165b0909073/tile_1780324181493.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110061800 +0000" stop="20261110064600 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Encuentro en San Francisco</sub-title><desc lang="es">Ryu va a los Estados Unidos para visitar a Ken, su compañero de entrenamiento. Después de luchar contra los soldados en un bar, se enfrentan a un nuevo retador.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110064600 +0000" stop="20261110071400 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">El jefe de las Fuerzas Armadas</sub-title><desc lang="es">Después de recuperar la conciencia, Ryu y Ken buscan a Guile y están interesados en viajar por el mundo para obtener más fuerza y habilidad.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110071400 +0000" stop="20261110074100 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Duelo en Hong Kong</sub-title><desc lang="es">Al llegar a Hong Kong, Ken y Ryu son llevados a una arena de combate por la bella y peligrosa guía Chun-Li.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110074100 +0000" stop="20261110080900 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Infierno de Hong Kong</sub-title><desc lang="es">Ryu, Ken y Chun Li intentan escapar del Palacio de Kowloon pero son atacados por un grupo de luchadores callejeros.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110080900 +0000" stop="20261110083700 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Un hombre llamado Dragón Volador</sub-title><desc lang="es">Después del incidente en el Palacio Kowloon, Ryu y los demás van a Hong Kong y terminan en una película producida por un amigo.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110083700 +0000" stop="20261110090500 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">El secreto de las Artes Marciales</sub-title><desc lang="es">Después de ayudar a un anciano moribundo, Ryu descubre la historia de una energía mística de Ki y descubre una nueva técnica de lucha.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.5.0/1</episode-num><episode-num system="onscreen">S01E06</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110090500 +0000" stop="20261110093300 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">La venganza de Ashura</sub-title><desc lang="es">Después de acechar y capturar a varios miembros de Ashura, el Capitán Dorai siente la ira de la organización criminal.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.6.0/1</episode-num><episode-num system="onscreen">S01E07</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110093300 +0000" stop="20261110100100 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">La sombra del terror</sub-title><desc lang="es">Ken y Ryu persiguen a Ashura a Tailandia, pero la caza se interrumpe cuando Ryu es arrestado por un cargo de posesión de drogas falsas.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.7.0/1</episode-num><episode-num system="onscreen">S01E08</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110100100 +0000" stop="20261110102900 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Karate contra Boxeo Tailandés</sub-title><desc lang="es">Encarcelado, Ryu se enfrenta a Sagat. Ken finalmente encuentra a la persona que incriminó a Ryu con las drogas</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.8.0/1</episode-num><episode-num system="onscreen">S01E09</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110102900 +0000" stop="20261110105700 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Antes del anochecer</sub-title><desc lang="es">Acompañados por el Capitán Dorai, Ryu y Ken deben luchar contra varios oponentes para llegar al líder de Ashura.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.9.0/1</episode-num><episode-num system="onscreen">S01E10</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110105700 +0000" stop="20261110112500 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Las garras de las fieras</sub-title><desc lang="es">Mientras viajan a lo largo del río Ganges, Ryu y Ken se encuentran con el místico Dhalsim, que se niega a enseñar el arte de Ki.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.10.0/1</episode-num><episode-num system="onscreen">S01E11</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110112500 +0000" stop="20261110115300 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">En la caverna del demonio</sub-title><desc lang="es">Después de que Dhalsim les indicó que se dirigieran al templo prohibido, Ryu y Ken encuentran dos estatuas aparentemente indestructibles.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.11.0/1</episode-num><episode-num system="onscreen">S01E12</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110115300 +0000" stop="20261110122100 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">En busca del karate Hadou</sub-title><desc lang="es">Dhalsim acepta enseñarle a Ryu y Ken una energía mística llamada Hadou, pero Ryu no puede controlar la energía y debe ingresar al templo una vez más.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.12.0/1</episode-num><episode-num system="onscreen">S01E13</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110122100 +0000" stop="20261110124900 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">El Príncipe Sanguinario</sub-title><desc lang="es">Viajando a Barcelona por un premio especial, Ryu, Ken y Chun-Li se encuentran con Vega, uno de los mejores toreros de España.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.13.0/1</episode-num><episode-num system="onscreen">S01E14</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110124900 +0000" stop="20261110131700 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Encuentro de Titanes</sub-title><desc lang="es">Mientras asiste a un misterioso baile formal en Barcelona, Ken se da cuenta de que la apariencia de Vega parece tener un efecto muy extraño en Chun-Li.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.14.0/1</episode-num><episode-num system="onscreen">S01E15</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110131700 +0000" stop="20261110134500 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">La máscara del Poderoso</sub-title><desc lang="es">Ken pierde su ventaja en la lucha contra Vega. El líder de la organización criminal Shadaloo revela su identidad.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.15.0/1</episode-num><episode-num system="onscreen">S01E16</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110134500 +0000" stop="20261110141300 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Los Tentáculos de la Muerte</sub-title><desc lang="es">Chun-Li se da cuenta de que ella y Ken están siendo engañados por Bison. Ella hace todo lo posible para detenerlo, pero sus ataques no parecen funcionar.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.16.0/1</episode-num><episode-num system="onscreen">S01E17</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110141300 +0000" stop="20261110144000 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Una Hermosa Asesina</sub-title><desc lang="es">Cuando Bison captura a Ken y Chun-Li y envía una nota de rescate, el padre de Ken envía a los pilotos de Guile y Nash Air Force para encontrarlos.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.17.0/1</episode-num><episode-num system="onscreen">S01E18</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110144000 +0000" stop="20261110150700 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Los Agentes Secreto</sub-title><desc lang="es">Guile y Nash buscan pistas sobre la desaparición de Ken en Barcelona. Bison envía al luchador ruso Zangief para capturar a Ryu.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.18.0/1</episode-num><episode-num system="onscreen">S01E19</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110150700 +0000" stop="20261110153400 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Hadou la fuerza preponderante del Cosmos</sub-title><desc lang="es">Debilitado, Ryu se ve obligado a luchar con Zangief. Cammy ataca al Capitán Dorai. Guile finalmente encuentra pistas en Barcelona.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.19.0/1</episode-num><episode-num system="onscreen">S01E20</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110153400 +0000" stop="20261110160200 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Los prisioneros del castillo</sub-title><desc lang="es">Guile y Nash planean infiltrarse en la isla donde se encuentra Ken. Bison se divierte con el nuevo dispositivo: un microchip que controla el pensamiento de las personas.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.20.0/1</episode-num><episode-num system="onscreen">S01E21</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110160200 +0000" stop="20261110162800 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">La manifestación del Hadou</sub-title><desc lang="es">Ryu usa Hadou para deshacerse de las cadenas y encontrar a sus amigos. Guile ve el talento de Ryu y decide involucrarse.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.21.0/1</episode-num><episode-num system="onscreen">S01E22</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110162800 +0000" stop="20261110165600 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">El brillo misterioso</sub-title><desc lang="es">Ken ve a Chun-Li matar a un soldado. Balrog es informado de que Dorai está muerto y envía a Cammy al hospital para confirmar.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.22.0/1</episode-num><episode-num system="onscreen">S01E23</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110165600 +0000" stop="20261110172400 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Al encuentro de una pesadilla</sub-title><desc lang="es">Bajo el control de Bison, Ryu entra en la arena de prueba. En la base, Guile y Nash deciden separarse para cubrir un área más grande.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.23.0/1</episode-num><episode-num system="onscreen">S01E24</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110172400 +0000" stop="20261110175200 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Una lucha violenta</sub-title><desc lang="es">Guile se enfrenta al poderoso Zangief. Fei-Long se enfrenta a Cammy en el hospital. Ryu se ve obligado a luchar contra Ken bajo el control de Bison.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.24.0/1</episode-num><episode-num system="onscreen">S01E25</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110175200 +0000" stop="20261110182000 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Grito último del amigo que muere</sub-title><desc lang="es">Zangief tiene una ventaja sobre Guile. Ken se ve obligado a defenderse contra Ryu. Cammy y Fei-Long continúan luchando en el hospital.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.25.0/1</episode-num><episode-num system="onscreen">S01E26</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110182000 +0000" stop="20261110184800 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Energías Hadou al límite</sub-title><desc lang="es">Guile derrota a Zangief, pero termina recibiendo una trágica sorpresa. Fei-Long le explica a Cammy que Shadaloo la engañó.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.26.0/1</episode-num><episode-num system="onscreen">S01E27</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110184800 +0000" stop="20261110191600 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Fuerza de destrucción de tornado</sub-title><desc lang="es">La gran explosión causada por el Hadou combinado de Ryu y Ken desplaza el chip de la cabeza de Ryu y destruye toda la base.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.27.0/1</episode-num><episode-num system="onscreen">S01E28</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110191600 +0000" stop="20261110194400 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Encuentro en San Francisco</sub-title><desc lang="es">Ryu va a los Estados Unidos para visitar a Ken, su compañero de entrenamiento. Después de luchar contra los soldados en un bar, se enfrentan a un nuevo retador.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.0.0/1</episode-num><episode-num system="onscreen">S01E01</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110194400 +0000" stop="20261110201200 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">El jefe de las Fuerzas Armadas</sub-title><desc lang="es">Después de recuperar la conciencia, Ryu y Ken buscan a Guile y están interesados en viajar por el mundo para obtener más fuerza y habilidad.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.1.0/1</episode-num><episode-num system="onscreen">S01E02</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110201200 +0000" stop="20261110203900 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Duelo en Hong Kong</sub-title><desc lang="es">Al llegar a Hong Kong, Ken y Ryu son llevados a una arena de combate por la bella y peligrosa guía Chun-Li.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.2.0/1</episode-num><episode-num system="onscreen">S01E03</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110203900 +0000" stop="20261110210700 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Infierno de Hong Kong</sub-title><desc lang="es">Ryu, Ken y Chun Li intentan escapar del Palacio de Kowloon pero son atacados por un grupo de luchadores callejeros.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.3.0/1</episode-num><episode-num system="onscreen">S01E04</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110210700 +0000" stop="20261110213500 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">Un hombre llamado Dragón Volador</sub-title><desc lang="es">Después del incidente en el Palacio Kowloon, Ryu y los demás van a Hong Kong y terminan en una película producida por un amigo.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.4.0/1</episode-num><episode-num system="onscreen">S01E05</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110213500 +0000" stop="20261110220300 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">El secreto de las Artes Marciales</sub-title><desc lang="es">Después de ayudar a un anciano moribundo, Ryu descubre la historia de una energía mística de Ki y descubre una nueva técnica de lucha.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.5.0/1</episode-num><episode-num system="onscreen">S01E06</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
<programme start="20261110220300 +0000" stop="20261110223100 +0000" channel="Pluto TV Anime"><title lang="es">Street Fighter V - Victory</title><sub-title lang="es">La venganza de Ashura</sub-title><desc lang="es">Después de acechar y capturar a varios miembros de Ashura, el Capitán Dorai siente la ira de la organización criminal.</desc><credits><actor>Kouji Tsujitani</actor><actor>Kenji Haga</actor><actor>Tesshõ Genda</actor><actor>Chisa Yokoyama</actor><actor>Kenji Utsumi</actor></credits><date>19950410</date><category lang="es">Anime</category><category lang="es">Anime Action &amp; Adventure</category><episode-num system="xmltv_ns">0.6.0/1</episode-num><episode-num system="onscreen">S01E07</episode-num><rating><value>TV-Y7</value></rating><icon src="https://images.pluto.tv/series/67507412c814a90013977a6c/tile_1790725322621.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=660&amp;q=75&amp;w=660"/></programme>
