<programme start="20261015233700 +0000" stop="20261016003000 +0000" channel="The Walking Dead Channel"><title lang="es">The Walking Dead</title><sub-title lang="es">Alone</sub-title><desc lang="es">Daryl and Beth find shelter while another group has a realization about their own protection; Sasha, Bob and Maggie clash over a search mission.</desc><credits><director>Ernest Dickerson</director><actor>Andrew Lincoln</actor><actor>Norman Reedus</actor><actor>Steven Yeun</actor><actor>Lauren Cohan</actor><actor>Chandler Riggs</actor><actor>Danai Gurira</actor><actor>Melissa McBride</actor><actor>Scott Wilson</actor><actor>David Morrissey</actor><actor>Emily Kinney</actor><actor>Chad Coleman</actor><actor>Sonequa Martin-Green</actor><actor>Lawrence Gilliard Jr.</actor><actor>Jeff Kober</actor><actor>Keith Brooks</actor><actor>JD Evermore</actor><actor>Marcus Hester</actor></credits><date>20140309</date><episode-num system="xmltv_ns">3.12.0/1</episode-num><episode-num system="onscreen">S04E13</episode-num><rating><value>US_UPR_TV-MA</value></rating><icon src="http://p-img.movetv.com/cms/images/bf1bd47ba3a006ab5a92b46b1ed6697b582e8c0f.jpg"/></programme>
